{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codingcatdev-dev",
  "account_id": "c46bd0f3b9ed47b8692cca098030edbf",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: Sanity client + Portable Text pull Node built-ins.
  // global_fetch_strictly_public: OG endpoints fetch this site's own origin;
  // without it those loop back into the same Worker and can deadlock.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": true,
  "ai": { "binding": "AI" },
  // Uncomment after clicking "Enable Analytics Engine" once at:
  // https://dash.cloudflare.com/c46bd0f3b9ed47b8692cca098030edbf/workers/analytics-engine
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "ANALYTICS",
  //     "dataset": "codingcat_events_dev"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codingcat-auth-dev",
      "database_id": "802a4e11-fa76-4e19-aef2-3bd8e6c214df"
    }
  ],
  "routes": [
    {
      "pattern": "dev.codingcat.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "PUBLIC_SANITY_PROJECT_ID": "hfh83o0w",
    "PUBLIC_SANITY_DATASET": "dev",
    "PUBLIC_SANITY_API_VERSION": "2025-09-30",
    "PUBLIC_SANITY_STUDIO_URL": "https://codingcat-dev.sanity.studio",
    "SITE_URL": "https://dev.codingcat.dev",
    "FLIPCORE_API_URL": "https://api.flipfeeds.dev",
    "PUBLIC_FLIPCORE_WEB_URL": "https://flipfeeds.dev"
  },

  // NOTE: bindings are NOT inherited into `env.*`. Every binding added to the
  // top level must be repeated under env.production, or it will 503 in prod.
  "env": {
    "production": {
      "name": "codingcatdev-prod",
      "account_id": "c46bd0f3b9ed47b8692cca098030edbf",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "codingcat.dev",
          "custom_domain": true
        }
      ],
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "codingcat-auth",
          "database_id": "a2f53117-5919-4224-95a2-dc3847bea540"
        }
      ],
      // "analytics_engine_datasets": [
      //   {
      //     "binding": "ANALYTICS",
      //     "dataset": "codingcat_events_prod"
      //   }
      // ],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_SANITY_PROJECT_ID": "hfh83o0w",
        "PUBLIC_SANITY_DATASET": "production",
        "PUBLIC_SANITY_API_VERSION": "2025-09-30",
        "PUBLIC_SANITY_STUDIO_URL": "https://codingcat-prod.sanity.studio",
        "SITE_URL": "https://codingcat.dev",
        "FLIPCORE_API_URL": "https://api.flipfeeds.com",
        "PUBLIC_FLIPCORE_WEB_URL": "https://flipfeeds.com"
      }
    }
  }
}
