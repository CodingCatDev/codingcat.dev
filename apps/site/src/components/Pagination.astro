---
/**
 * Dual-Theme Chalkboard & Royal Purple Pagination component.
 * Preserves canonical `/{base}/page/{n}` URLs for SEO.
 */
interface Props {
	base: string;
	page: number;
	totalPages: number;
}

const { base, page, totalPages } = Astro.props;

const href = (n: number) => `/${base}/page/${n}`;

const linkClass =
	"inline-flex items-center justify-center h-10 min-w-10 px-3.5 rounded-xl border-2 border-[#2A1155] bg-white font-display text-sm font-black text-[#2A1155] shadow-sketch-sm transition-all hover:-translate-y-0.5 hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#131B2E] dark:text-white dark:hover:bg-purple-950/60 dark:hover:text-[#C084FC]";
const activeClass =
	"!bg-[#7C3AED] !text-white !border-[#2A1155] dark:!border-white/50";
---

{
	totalPages > 1 && (
		<nav class="mt-12 flex justify-center" aria-label="Pagination">
			<ul class="flex flex-wrap items-center gap-2">
				{page > 1 && (
					<>
						<li>
							<a class={linkClass} href={href(page - 1)} rel="prev">
								&larr; <span class="ml-1.5">Previous</span>
							</a>
						</li>
						<li>
							<a class={linkClass} href={href(1)}>
								1
							</a>
						</li>
					</>
				)}
				{page > 2 && (
					<li
						aria-hidden="true"
						class="px-2 font-mono font-bold text-[#2A1155]/60 dark:text-slate-400"
					>
						&hellip;
					</li>
				)}
				<li>
					<a
						class:list={[linkClass, activeClass]}
						href={href(page)}
						aria-current="page"
					>
						{page}
					</a>
				</li>
				{page < totalPages - 1 && (
					<li
						aria-hidden="true"
						class="px-2 font-mono font-bold text-[#2A1155]/60 dark:text-slate-400"
					>
						&hellip;
					</li>
				)}
				{page !== totalPages && (
					<li>
						<a class={linkClass} href={href(totalPages)}>
							{totalPages}
						</a>
					</li>
				)}
				{page < totalPages && (
					<li>
						<a class={linkClass} href={href(page + 1)} rel="next">
							<span class="mr-1.5">Next</span> &rarr;
						</a>
					</li>
				)}
			</ul>
		</nav>
	)
}
