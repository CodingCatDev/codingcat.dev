---
import CoverImage from "@/components/CoverImage.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import type { ContentListItem } from "@/lib/content";
import { resolveHref } from "@/lib/sanity/resolve-href";

interface Props {
	title: string;
	description: string;
	items: ContentListItem[];
	/** Alternating band colour */
	muted?: boolean;
	accentColor?: "green" | "blue" | "orange" | "purple";
	ctaHref?: string;
	ctaLabel?: string;
}

const {
	title,
	description,
	items,
	muted = false,
	accentColor = "green",
	ctaHref,
	ctaLabel = "Explore All",
} = Astro.props;

const accentHex =
	accentColor === "blue"
		? "#B4A7D6"
		: accentColor === "orange"
			? "#86EFAC"
			: accentColor === "purple"
				? "#7C3AED"
				: "#C5E86C";
---

{
	items.length > 0 && (
		<section
			class:list={[
				"duo-scroll-reveal w-full py-16 md:py-20 flex flex-col items-center justify-center",
				muted ? "bg-[#000000]/60 border-y border-[#B4A7D6]/20" : "",
			]}
		>
			<div class="container mx-auto max-w-7xl px-4 md:px-6">
				<div class="flex flex-col items-center justify-between gap-4 text-center md:flex-row md:text-left">
					<div class="space-y-2">
						<h2
							class="font-display text-3xl font-black tracking-tight sm:text-5xl"
							style={`color: ${accentHex}`}
						>
							{title}
						</h2>
						<p class="excalidraw-explain max-w-[780px] text-[#B4A7D6]">
							{description}
						</p>
					</div>
					{ctaHref && (
						<a href={ctaHref} class="duo-btn cc-btn-outline shrink-0 px-5 py-3 text-xs sm:text-sm">
							{ctaLabel} →
						</a>
					)}
				</div>
				<div class="mx-auto grid max-w-7xl items-stretch gap-6 py-10 lg:grid-cols-2 lg:gap-8">
					{items.map((item) => {
						const href = resolveHref(item._type, item.slug ?? undefined);
						return (
							<a
								href={href}
								class="duo-card group flex flex-col overflow-hidden transition-all duration-200 hover:-translate-y-1.5 hover:border-[#C5E86C] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C5E86C]"
							>
								{item.coverImage && (
									<div class="border-b border-[#B4A7D6]/25 bg-[#000000]">
										<CoverImage
											image={item.coverImage}
											fallbackAlt={item.title || "CodingCat.dev tutorial cover image"}
											width={960}
											height={540}
											sizes="(max-width: 1024px) 100vw, 512px"
											class="aspect-video w-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02]"
										/>
									</div>
								)}
								<div class="flex flex-1 flex-col justify-between gap-3 p-6">
									<div>
										{item.date && (
											<div class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-[#C5E86C]">
												<FormattedDate dateString={item.date} />
											</div>
										)}
										<h3 class="text-xl font-extrabold leading-snug text-[#F8FAFC] transition-colors group-hover:text-[#C5E86C] sm:text-2xl">
											{item.title}
										</h3>
										{item.excerpt && (
											<p class="mt-2 text-sm leading-relaxed text-[#94A3B8] line-clamp-2">
												{item.excerpt}
											</p>
										)}
									</div>
									<span class="mt-2 inline-flex items-center gap-1.5 font-hand text-xl font-bold text-[#B4A7D6] group-hover:text-[#C5E86C]">
										Open Excalidraw Explanation →
									</span>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>
	)
}
