---
import CoverImage from "@/components/CoverImage.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import type { ContentListItem } from "@/lib/content";
import { resolveHref } from "@/lib/sanity/resolve-href";

interface Props {
	title: string;
	description: string;
	items: ContentListItem[];
	/** Alternating band colour */
	muted?: boolean;
	accentColor?: "green" | "blue" | "orange" | "purple";
	ctaHref?: string;
	ctaLabel?: string;
	actionLabel?: string;
}

const {
	title,
	description,
	items,
	muted = false,
	ctaHref,
	ctaLabel = "Explore All",
	actionLabel,
} = Astro.props;
---

{
	items.length > 0 && (
		<section
			class:list={[
				"duo-scroll-reveal w-full py-12 md:py-16 flex flex-col items-center justify-center",
				muted
					? "bg-[#F5F3FB] dark:bg-[#131B2E]/50 border-y-2 border-dashed border-[#2A1155]/15 dark:border-white/10"
					: "",
			]}
		>
			<div class="container mx-auto max-w-7xl px-4 sm:px-6">
				<div class="flex flex-col items-center justify-between gap-4 text-center md:flex-row md:text-left">
					<div class="space-y-1.5">
						<h2 class="font-display text-3xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-5xl">
							{title.replace(/\.$/, "")}<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
						</h2>
						<p class="font-hand text-2xl font-bold text-[#4C1D95] dark:text-purple-200 max-w-[780px]">
							{description}
						</p>
					</div>
					{ctaHref && (
						<a href={ctaHref} class="duo-btn cc-btn-outline shrink-0 px-5 py-3 text-xs sm:text-sm">
							<span>{ctaLabel}</span>
							<span class="text-[#7C3AED] dark:text-[#C084FC]">→</span>
						</a>
					)}
				</div>
				<div class="mx-auto grid max-w-7xl items-stretch gap-6 py-8 lg:grid-cols-2 lg:gap-8">
					{items.map((item, idx) => {
						const href = resolveHref(item._type, item.slug ?? undefined);
						const defaultAction =
							item._type === "podcast"
								? "Watch Episode →"
								: item._type === "course"
									? "Start Course →"
									: "Read Post →";
						const cardAction = actionLabel ?? defaultAction;
						const typeBadge =
							item._type === "podcast"
								? "Podcast"
								: item._type === "course"
									? "Course"
									: "Blog Post";
						const badgeBg =
							idx % 3 === 0
								? "bg-[#EDE9FE] text-[#7C3AED] dark:bg-purple-950/80 dark:text-purple-200"
								: idx % 3 === 1
									? "bg-[#BAE6FD] text-[#0369A1] dark:bg-sky-950/80 dark:text-sky-200"
									: "bg-[#FBCFE8] text-[#9D174D] dark:bg-pink-950/80 dark:text-pink-200";
						return (
							<a
								href={href}
								class="duo-card hand-border group flex flex-col overflow-hidden p-5 transition-all duration-200 hover:-translate-y-1.5 hover:border-[#7C3AED] dark:hover:border-[#C084FC] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#7C3AED]"
							>
								{item.coverImage && (
									<div class="overflow-hidden rounded-2xl border-2 border-[#2A1155] bg-[#2A1155] dark:border-white/20 dark:bg-[#060E20]">
										<CoverImage
											image={item.coverImage}
											fallbackAlt={item.title || "CodingCat.dev cover image"}
											width={960}
											height={540}
											sizes="(max-width: 1024px) 100vw, 512px"
											class="aspect-video w-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02]"
										/>
									</div>
								)}
								<div class="flex flex-1 flex-col justify-between gap-3 pt-5">
									<div>
										<div class="mb-2 flex items-center justify-between gap-2">
											{item.date && (
												<span class={`rounded-full border border-[#2A1155]/30 dark:border-white/20 px-3 py-0.5 font-mono text-xs font-extrabold uppercase tracking-wider ${badgeBg}`}>
													<FormattedDate dateString={item.date} />
												</span>
											)}
											<span class="rounded-full border border-[#166534]/30 bg-[#DCFCE7] px-2.5 py-0.5 font-mono text-[11px] font-bold text-[#166534] dark:border-emerald-400/30 dark:bg-emerald-950/80 dark:text-emerald-300">
												{typeBadge}
											</span>
										</div>
										<h3 class="font-display text-xl font-black leading-snug text-[#2A1155] transition-colors group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC] sm:text-2xl">
											{item.title}
										</h3>
										{item.excerpt && (
											<p class="mt-2 text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300 line-clamp-2">
												{item.excerpt}
											</p>
										)}
									</div>
									<div class="mt-3 flex items-center justify-between border-t-2 border-dashed border-[#2A1155]/15 pt-3 dark:border-white/15">
										<span class="font-hand text-xl font-bold text-[#7C3AED] group-hover:translate-x-1 transition-transform dark:text-[#C084FC]">
											{cardAction}
										</span>
									</div>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>
	)
}
