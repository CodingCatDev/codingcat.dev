---
/**
 * CodingCat.dev 2026 — Duolingo Chalkboard & Hand-Drawn Excalidraw Hero.
 *
 * Combines Duolingo's giant lowercase Feather Green ("free. fun. purrfect.")
 * scrollytelling energy and tactile 4px-lip 3D buttons with AJ the Mascot
 * chasing his glowing Flame Orange (#FF9600) yarn ball across a hand-drawn
 * Excalidraw chalkboard diagram.
 */
import AjMascot from "@/components/AjMascot.astro";
import ExcalidrawDiagram from "@/components/ExcalidrawDiagram.astro";
import { HERO_ICONS } from "@/lib/hero-icons";
---

<section class="relative w-full overflow-hidden border-b-2 border-[#37464F] bg-[#131F24] py-14 md:py-24">
	{/* Subtle floating tech chalk icons in background */}
	<div class="pointer-events-none absolute inset-0 grid grid-cols-4 grid-rows-3 gap-4 opacity-10" aria-hidden="true">
		{
			HERO_ICONS.map((icon, index) => (
				<div
					class="flex items-center justify-center text-[#1CB0F6] animate-float"
					style={`animation-delay: ${index * 0.45}s`}
				>
					<svg class="size-14" viewBox={icon.viewBox} fill="currentColor">
						{icon.paths.map((d) => (
							<path d={d} />
						))}
					</svg>
				</div>
			))
		}
	</div>

	<div class="container relative z-10 mx-auto max-w-6xl px-5">
		<div class="grid items-center gap-12 lg:grid-cols-12">
			{/* Left Column: Duolingo Playful Lowercase Copy + Tactile 3D CTAs */}
			<div class="flex flex-col items-center text-center lg:col-span-6 lg:items-start lg:text-left">
				<span class="mb-4 inline-flex items-center gap-2 rounded-full border-2 border-[#37464F] bg-[#202F36] px-4 py-1.5 font-hand text-xl font-bold text-[#FFC800] shadow-[0_3px_0_#37464F]">
					🧶 Hand-Drawn Web Dev & AI for Humans
				</span>
				<h1 class="text-5xl font-black leading-[1.04] tracking-tight text-white sm:text-6xl md:text-7xl">
					<span class="text-[#58CC02]">free.</span>{" "}
					<span class="text-[#1CB0F6]">fun.</span>{" "}
					<span class="text-[#FF9600]">purrfect.</span>
				</h1>
				<p class="mt-3 text-xl font-extrabold text-white sm:text-2xl">
					CodingCat.dev Podcast, Courses & Visual Blueprints
				</p>
				<p class="mt-3 max-w-xl text-base leading-relaxed text-[#DCE6EC] md:text-lg">
					Learn to code from your very first HTML tag all the way to production cloud & AI agent architectures — explained with playful hand-drawn Excalidraw chalkboard diagrams and AJ the cat.
				</p>

				<div class="mt-8 flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
					<a
						href="/courses"
						class="duo-btn duo-btn-green px-7 py-4 text-sm sm:text-base"
					>
						🧶 Start Learning Path
					</a>
					<a
						href="/podcasts"
						class="duo-btn duo-btn-blue px-7 py-4 text-sm sm:text-base"
					>
						🎙️ Watch Podcasts
					</a>
					<a
						href="/blog"
						class="duo-btn duo-btn-outline px-6 py-4 text-sm sm:text-base"
					>
						✏️ Read Blueprints
					</a>
				</div>
			</div>

			{/* Right Column: AJ Mascot + Interactive Hand-Drawn Excalidraw Diagram */}
			<div class="flex flex-col items-center lg:col-span-6">
				<div class="mb-2 flex items-center justify-center">
					<AjMascot
						pose="yarn-chase"
						cls="w-36 h-36 md:w-44 md:h-44"
						caption="Follow the orange yarn! ↓"
					/>
				</div>
				<div class="w-full">
					<ExcalidrawDiagram
						title="How You Level Up on CodingCat.dev"
						caption="Every course, podcast & blog post breaks down complex tech into hand-drawn sketches."
						compact={true}
						nodes={[
							{
								id: "curious",
								badge: "Level 1",
								label: "First Line of Code",
								sublabel: "HTML, CSS & micro:bit",
								color: "green",
							},
							{
								id: "builder",
								badge: "Level 2",
								label: "Modern Frameworks",
								sublabel: "Svelte, Solid, Astro",
								color: "blue",
							},
							{
								id: "architect",
								badge: "Level 3",
								label: "Production & AI",
								sublabel: "Agents, Cloud & Scale",
								color: "orange",
							},
						]}
						edges={[
							{ from: "curious", to: "builder", label: "build projects" },
							{ from: "builder", to: "architect", label: "ship to prod!" },
						]}
					/>
				</div>
			</div>
		</div>
	</div>
</section>
