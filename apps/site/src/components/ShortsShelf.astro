---
import type { ShortItem } from "@/lib/sanity/queries/shorts";

interface Props {
	title?: string;
	description?: string;
	shorts: ShortItem[];
	muted?: boolean;
	showViewAll?: boolean;
}

const {
	title = "Purrfect Tech Shorts",
	description = "60-second architectural breakdowns, AI benchmarks, and web development insights.",
	shorts,
	muted = false,
	showViewAll = true,
} = Astro.props;
---

{
	shorts.length > 0 && (
		<section
			class:list={[
				"w-full py-12 md:py-24 lg:py-28 flex flex-col items-center justify-center",
				muted && "bg-muted",
			]}
		>
			<div class="container px-4 md:px-6">
				<div class="flex flex-col items-center justify-center space-y-4 text-center mb-10">
					<div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3.5 py-1 text-xs font-semibold text-primary border border-primary/20">
						<svg class="size-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z" />
						</svg>
						<span>9:16 Vertical Deep Dives</span>
					</div>
					<h2 class="text-3xl font-bold tracking-tighter sm:text-5xl">{title}</h2>
					<p class="max-w-[800px] text-muted-foreground md:text-xl/relaxed">
						{description}
					</p>
				</div>

				<div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
					{shorts.map((short) => {
						const ytId = short.youtubeShortId;
						const thumbUrl = ytId
							? `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`
							: undefined;
						const ytUrl =
							short.youtube ||
							(ytId ? `https://www.youtube.com/shorts/${ytId}` : "#");

						return (
							<article
								class="group relative flex flex-col overflow-hidden rounded-2xl border border-border/60 bg-black shadow-lg transition-all duration-200 hover:-translate-y-1 hover:shadow-xl"
								data-short-card
								data-video-url={short.shortVideoUrl ?? ""}
								data-yt-id={ytId ?? ""}
							>
								<div class="relative aspect-[9/16] w-full overflow-hidden bg-zinc-950">
									{thumbUrl && (
										<img
											src={thumbUrl}
											alt={short.title || "CodingCat.dev Short"}
											loading="lazy"
											class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
											data-short-poster
										/>
									)}
									<div
										class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/20 pointer-events-none"
										data-short-overlay
									/>

									<button
										type="button"
										class="absolute inset-0 flex items-center justify-center cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
										aria-label={`Play short video: ${short.title || "CodingCat.dev Short"}`}
										data-short-play
									>
										<span class="flex size-14 items-center justify-center rounded-full bg-primary/90 text-primary-foreground shadow-lg backdrop-blur transition-transform duration-200 group-hover:scale-110">
											<svg
												class="size-6 translate-x-0.5 fill-current"
												viewBox="0 0 24 24"
												aria-hidden="true"
											>
												<path d="M8 5v14l11-7z" />
											</svg>
										</span>
									</button>

									<div
										class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none"
										data-short-badges
									>
										<span class="inline-flex items-center gap-1 rounded-full bg-black/70 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur-sm">
											<span class="size-2 rounded-full bg-red-500 animate-pulse" />
											SHORT
										</span>
										{short.viewCount && short.viewCount > 0 ? (
											<span class="rounded-full bg-black/70 px-2.5 py-1 text-[11px] font-medium text-zinc-200 backdrop-blur-sm">
												{Intl.NumberFormat("en-US", {
													notation: "compact",
												}).format(short.viewCount)}{" "}
												views
											</span>
										) : null}
									</div>

									<div
										class="absolute inset-x-0 bottom-0 flex flex-col gap-2 p-4 text-left pointer-events-none"
										data-short-caption
									>
										<h3 class="text-base font-bold leading-snug text-white line-clamp-2">
											{short.title}
										</h3>
										{short.description && (
											<p class="text-xs text-zinc-300 line-clamp-2">
												{short.description}
											</p>
										)}
									</div>
								</div>

								<div class="flex items-center justify-between bg-card px-4 py-2.5 text-xs text-muted-foreground border-t border-border/40">
									<a
										href={ytUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 font-medium text-foreground hover:text-primary transition-colors"
									>
										<span>Watch on YouTube</span>
										<svg
											class="size-3.5"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											aria-hidden="true"
										>
											<path d="M7 17L17 7M7 7h10v10" />
										</svg>
									</a>
									<span>~{short.duration ?? 60}s</span>
								</div>
							</article>
						);
					})}
				</div>

				{showViewAll && (
					<div class="mt-10 flex justify-center">
						<a
							href="/shorts"
							class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-colors"
						>
							<span>Explore All Shorts</span>
							<svg
								class="size-4"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
							>
								<path d="M5 12h14M12 5l7 7-7 7" />
							</svg>
						</a>
					</div>
				)}
			</div>
		</section>
	)
}

<script>
	function initShortCards() {
		const cards = document.querySelectorAll<HTMLElement>("[data-short-card]");
		for (const card of cards) {
			const playBtn = card.querySelector<HTMLButtonElement>("[data-short-play]");
			if (!playBtn || playBtn.dataset.bound === "true") continue;
			playBtn.dataset.bound = "true";

			playBtn.addEventListener("click", () => {
				const videoUrl = card.dataset.videoUrl;
				const ytId = card.dataset.ytId;
				const container = playBtn.parentElement;
				if (!container) return;

				if (videoUrl) {
					const video = document.createElement("video");
					video.src = videoUrl;
					video.controls = true;
					video.autoplay = true;
					video.playsInline = true;
					video.className = "h-full w-full object-contain bg-black";
					container.replaceChildren(video);
				} else if (ytId) {
					const iframe = document.createElement("iframe");
					iframe.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
					iframe.title = "YouTube Short player";
					iframe.allow =
						"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
					iframe.allowFullscreen = true;
					iframe.className = "h-full w-full border-0";
					container.replaceChildren(iframe);
				}
			});
		}
	}

	initShortCards();
	document.addEventListener("astro:page-load", initShortCards);
</script>
