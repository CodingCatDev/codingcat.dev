---
import AjHeadphones from "@/components/icons/AjHeadphones.astro";
import NavLink from "./NavLink.astro";

const year = new Date().getUTCFullYear();

const legalLinks = [
	{ href: "/courses", label: "Courses" },
	{ href: "/podcasts", label: "Podcasts" },
	{ href: "/blog", label: "Blog" },
	{ href: "/about", label: "About" },
	{ href: "/contact", label: "Contact" },
	{ href: "/developers", label: "Developers" },
	{ href: "/privacy", label: "Privacy" },
	{ href: "/terms-of-use", label: "Terms" },
	{ href: "/ftc-disclosure", label: "FTC Disclosure" },
	{ href: "/sponsors", label: "Sponsors" },
	{ href: "/sponsorships", label: "Sponsorships" },
];

const llmResourceLinks = [
	{ href: "/llms.txt", label: "llms.txt" },
	{ href: "/llms-full.txt", label: "llms-full.txt" },
	{ href: "/.well-known/agent-skills/index.json", label: "Agent Skills" },
	{ href: "/.well-known/mcp/server-card.json", label: "MCP Card" },
];

const socialLinks = [
	{
		href: "https://twitter.com/codingcatdev",
		label: "X",
		path: "M18.9 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
	},
	{
		href: "https://github.com/codingcatdev",
		label: "GitHub",
		path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
	},
	{
		href: "https://linkedin.com/company/codingcatdev",
		label: "LinkedIn",
		path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z",
	},
	{
		href: "https://youtube.com/codingcatdev",
		label: "YouTube",
		path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z",
	},
];
---

<footer class="mx-auto w-full max-w-7xl px-4 pb-12 pt-8 sm:px-6">
	<div class="rounded-3xl bg-white p-8 md:p-12 dark:bg-[#131B2E]/90 hand-border shadow-sketch">
		<div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">
			{/* Brand & AJ Bio */}
			<div class="space-y-4 lg:col-span-4">
				<a href="/" class="flex items-center gap-3">
					<div class="flex size-10 items-center justify-center overflow-hidden rounded-full bg-[#7C3AED] hand-border shadow-sketch-sm">
						<AjHeadphones cls="block size-8" />
					</div>
					<span class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
						CodingCat<span class="text-[#7C3AED] dark:text-[#C084FC]">.dev</span>
					</span>
				</a>
				<p class="max-w-sm text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300">
					Purrfect web tutorials, architecture teardowns, and weekly developer podcasts hosted by Alex Patterson &amp; AJ.
				</p>
				<div class="flex items-center gap-3 pt-1">
					{
						socialLinks.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex size-9 items-center justify-center rounded-full border-2 border-[#2A1155] bg-[#FAF9FC] text-[#2A1155] transition-colors hover:bg-[#7C3AED] hover:text-white dark:border-white/20 dark:bg-[#0B1326] dark:text-slate-300 dark:hover:bg-[#7C3AED] dark:hover:text-white shadow-sketch-sm"
							>
								<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d={link.path} />
								</svg>
								<span class="sr-only">{link.label}</span>
							</a>
						))
					}
				</div>
			</div>

			{/* Navigation & LLM Resources */}
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-4">
				<div class="space-y-2.5">
					<h4 class="font-display text-sm font-black uppercase tracking-wider text-[#2A1155] dark:text-white">
						Explore
					</h4>
					<nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Legal">
						{
							legalLinks.map((link) => (
								<NavLink
									href={link.href}
									class="text-xs font-bold text-[#2A1155]/75 hover:text-[#7C3AED] hover:underline underline-offset-4 dark:text-slate-300 dark:hover:text-[#C084FC]"
									prefix={false}
								>
									{link.label}
								</NavLink>
							))
						}
					</nav>
				</div>
				<div class="space-y-2.5">
					<h4 class="font-display text-sm font-black uppercase tracking-wider text-[#7C3AED] dark:text-[#C084FC]">
						LLM &amp; Agent Ready
					</h4>
					<nav class="flex flex-col gap-1.5" aria-label="LLM Resources">
						{
							llmResourceLinks.map((link) => (
								<a
									href={link.href}
									class="font-mono text-xs font-bold text-[#2A1155]/80 hover:text-[#7C3AED] hover:underline underline-offset-4 dark:text-slate-300 dark:hover:text-[#C084FC]"
								>
									{link.label}
								</a>
							))
						}
					</nav>
				</div>
			</div>

			{/* Newsletter Box ("The Purrfect Dispatch" from Stitch 8d131990 & b9e00f99) */}
			<div class="rounded-2xl border-2 border-[#2A1155] bg-[#EDE9FE] p-6 dark:border-purple-400/30 dark:bg-purple-950/50 lg:col-span-4 hand-border-rect shadow-sketch-sm">
				<h4 class="font-display text-lg font-black text-[#2A1155] dark:text-white">
					The Purrfect Dispatch 🐾
				</h4>
				<p class="mt-1 mb-4 text-xs font-medium text-[#2A1155]/75 dark:text-purple-200/80">
					Get weekly Excalidraw system diagrams &amp; new video drops in your inbox.
				</p>
				<form
					class="flex gap-2"
					action="https://buttondown.email/api/emails/embed-subscribe/codingcatdev"
					method="post"
					target="popupwindow"
					toolname="subscribe_newsletter"
					tooldescription="Subscribe to the CodingCat.dev web development newsletter"
				>
					<label class="sr-only" for="footer-email">Email</label>
					<input
						id="footer-email"
						name="email"
						type="email"
						autocomplete="email"
						required
						placeholder="you@domain.dev"
						toolparamdescription="Subscriber email address"
						class="h-10 flex-1 rounded-xl border-2 border-[#2A1155] bg-white px-3 py-2 text-sm font-medium text-[#2A1155] placeholder:text-[#2A1155]/40 focus:outline-none focus:ring-2 focus:ring-[#7C3AED] dark:border-white/25 dark:bg-[#060E20] dark:text-white dark:placeholder:text-slate-500"
					/>
					<input type="hidden" value="1" name="embed" />
					<button
						type="submit"
						class="tactile-btn h-10 px-4 text-xs font-extrabold"
					>
						Join
					</button>
				</form>
			</div>
		</div>

		<div class="mt-8 flex flex-col items-center justify-between gap-2 border-t-2 border-dashed border-[#2A1155]/15 pt-6 text-xs font-bold text-[#2A1155]/60 dark:border-white/10 dark:text-slate-400 sm:flex-row">
			<p>&copy; {year} CodingCat.dev. Purrfect Web Tutorials.</p>
			<p class="font-hand text-base text-[#7C3AED] dark:text-[#C084FC]">
				✏️ Drawn with Excalidraw &amp; built on Astro + Cloudflare Workers
			</p>
		</div>
	</div>
</footer>
