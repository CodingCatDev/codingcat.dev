---

<footer
	class="flex w-full shrink-0 flex-col items-center justify-center gap-6 border-t-2 border-[#37464F] bg-[#0D1519] px-4 py-10 md:px-6 lg:flex-row"
>
	<div class="flex flex-col items-center gap-4 sm:flex-row">
		<p class="text-xs font-bold text-[#DCE6EC]">
			&copy; {year} CodingCat.dev. free. fun. purrfect.
		</p>
		<nav
			class="flex flex-wrap items-center justify-center gap-4 sm:gap-6"
			aria-label="Legal"
		>
			{
				legalLinks.map((link) => (
					<NavLink
						href={link.href}
						class="text-xs font-semibold hover:text-[#58CC02] hover:underline underline-offset-4"
						prefix={false}
					>
						{link.label}
					</NavLink>
				))
			}
		</nav>
		<nav
			class="flex flex-wrap items-center justify-center gap-3 border-l-2 border-[#37464F] pl-4"
			aria-label="LLM Resources"
		>
			<span class="text-xs font-extrabold text-[#FFC800]">LLM Resources:</span>
			{
				llmResourceLinks.map((link) => (
					<a
						href={link.href}
						class="font-mono text-xs text-[#DCE6EC] hover:text-[#1CB0F6] hover:underline underline-offset-4"
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="flex items-center gap-4">
		{
			socialLinks.map((link) => (
				<a
					href={link.href}
					target="_blank"
					rel="noopener noreferrer"
					class="text-[#DCE6EC] transition-colors hover:text-[#58CC02]"
				>
					<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d={link.path} />
					</svg>
					<span class="sr-only">{link.label}</span>
				</a>
			))
		}
	</div>
	<div class="max-w-[320px] flex-1">
		<form
			class="flex gap-2"
			action="https://buttondown.email/api/emails/embed-subscribe/codingcatdev"
			method="post"
			target="popupwindow"
			toolname="subscribe_newsletter"
			tooldescription="Subscribe to the CodingCat.dev web development newsletter"
		>
			<label class="sr-only" for="footer-email">Email</label>
			<input
				id="footer-email"
				name="email"
				type="email"
				autocomplete="email"
				required
				placeholder="Enter your email"
				toolparamdescription="Subscriber email address"
				class="h-10 flex-1 rounded-xl border-2 border-[#37464F] bg-[#202F36] px-3 py-1 text-sm text-white outline-none focus-visible:border-[#1CB0F6]"
			/>
			<input type="hidden" value="1" name="embed" />
			<button
				type="submit"
				class="duo-btn duo-btn-green h-10 px-4 text-xs"
			>
				Subscribe
			</button>
		</form>
	</div>
</footer>
