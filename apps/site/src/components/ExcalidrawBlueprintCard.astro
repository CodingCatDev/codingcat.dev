---
/**
 * Auto-generated Content-Driven Hand-Drawn Visual & UML Diagram Card for every
 * Podcast (`/podcast/[slug]`), Blog Post (`/post/[slug]`), and Course (`/course/[slug]`).
 */
import ExcalidrawDiagram, {
	type ExcalidrawLayout,
	type ExcalidrawNode,
} from "@/components/ExcalidrawDiagram.astro";
import AjMascot from "@/components/AjMascot.astro";

interface Props {
	title: string;
	kind?: "podcast" | "post" | "course";
	tags?: Array<string | null | undefined>;
	layout?: ExcalidrawLayout;
}

const { title, kind = "post", tags = [], layout: propLayout } = Astro.props;

const cleanTags = tags
	.filter((t): t is string => Boolean(t && t.trim()))
	.slice(0, 3);

const cleanTitle = title.replace(/^(CodingCat\.dev|Purrfect\.dev)\s*[-:]?\s*/i, "").trim();
const titleSegments = cleanTitle
	.split(/[:|,]|\s+&\s+|\s+with\s+|\s+in\s+/i)
	.map((s) => s.trim())
	.filter((s) => s.length >= 3);

const primaryConcept = cleanTags[0] || titleSegments[0]?.slice(0, 24) || "Core Architecture";
const secondaryConcept =
	cleanTags[1] ||
	titleSegments[1]?.slice(0, 24) ||
	(kind === "podcast" ? "Runtime Trade-Offs" : kind === "course" ? "Deterministic Engine" : "System Implementation");
const tertiaryConcept =
	cleanTags[2] ||
	titleSegments[2]?.slice(0, 24) ||
	(kind === "course" ? "Verified Production Artifact" : "Edge Delivery & Telemetry");

function pickLayout(text: string, contentKind: string): ExcalidrawLayout {
	const hay = text.toLowerCase();
	if (/\b(vs\.?|versus|anti-pattern|myth|mistake)\b/.test(hay)) return "comparison";
	if (/\b(auth|oauth|mcp|protocol|webhook|ssr|stream|request|seek|whisper|rpc|api)\b/.test(hay)) return "sequence";
	if (/\b(3d|blender|three|glb|rig|class|schema|type|component|react|astro|dom|sdk)\b/.test(hay)) return "uml-class";
	if (/\b(state|loop|agent|critic|clock|bpm|gsap|spring|audio|chatterbox|workflow)\b/.test(hay)) return "state-machine";
	if (/\b(stack|layer|remotion|cloudflare|worker|next\.?js|sanity|platform|studio)\b/.test(hay)) return "layered-stack";
	return contentKind === "course" ? "layered-stack" : "pipeline";
}

const resolvedLayout: ExcalidrawLayout =
	propLayout || pickLayout(`${cleanTitle} ${cleanTags.join(" ")}`, kind);

const nodes: ExcalidrawNode[] = [
	{
		id: "stage_1",
		badge: resolvedLayout === "state-machine" ? "STATE 01" : "STAGE 01",
		stereotype: "«Input / Spec»",
		label: primaryConcept,
		sublabel: "Schema & deterministic boundary",
		color: "purple",
		fields: [`+ spec: "${primaryConcept.slice(0, 16)}"`, `+ strict: boolean = true`],
		methods: [`+ parseInput(raw): AST`, `+ validateSchema(): bool`],
	},
	{
		id: "stage_2",
		badge: resolvedLayout === "state-machine" ? "STATE 02" : "STAGE 02",
		stereotype: "«Core Runtime»",
		label: secondaryConcept,
		sublabel: "Execution & state transitions",
		color: "blue",
		fields: [`+ engine: "${secondaryConcept.slice(0, 16)}"`, `+ latency: "< 5ms"`],
		methods: [`+ execute(ctx): State`, `+ seekFrame(t: f64): Pose`],
	},
	{
		id: "stage_3",
		badge: resolvedLayout === "state-machine" ? "STATE 03" : "STAGE 03",
		stereotype: "«Verified Output»",
		label: tertiaryConcept,
		sublabel: "Production output & telemetry",
		color: "green",
		fields: [`+ target: "${tertiaryConcept.slice(0, 16)}"`, `+ status: "verified"`],
		methods: [`+ verifyContract(): Pass`, `+ emitArtifact(): Stream`],
	},
];

const edges = [
	{ from: "stage_1", to: "stage_2", label: `1. ${primaryConcept.slice(0, 18)}` },
	{ from: "stage_2", to: "stage_3", label: `2. ${secondaryConcept.slice(0, 18)}` },
];
---

<section
	aria-label="Visual Architecture Diagram"
	class="duo-card hand-border my-8 p-5 md:p-7"
>
	<div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
		<div>
			<span class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-3.5 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 shadow-sketch-sm">
				✏️ Visual Architecture Diagram
			</span>
			<h2 class="mt-2 font-display text-2xl font-black tracking-tight text-[#2A1155] dark:text-white md:text-3xl">
				how this {kind === "podcast" ? "episode" : kind === "course" ? "course" : "post"} connects together<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
			</h2>
			<p class="font-hand mt-1 text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				Follow AJ through the {resolvedLayout.replace("-", " ")} topology from input contract to production output.
			</p>
		</div>
		<div class="hidden shrink-0 sm:block">
			<AjMascot
				variant="head"
				state="point-diagram"
				angle="three-quarter-left"
				showYarnBall={false}
				cls="w-20 h-20"
				caption="Let’s build it!"
			/>
		</div>
	</div>

	<ExcalidrawDiagram
		title={`Architecture Diagram: ${cleanTitle.slice(0, 48)}${cleanTitle.length > 48 ? "…" : ""}`}
		caption={`Content-driven ${resolvedLayout} diagram for ${cleanTitle}: ${primaryConcept} -> ${secondaryConcept} -> ${tertiaryConcept}.`}
		layout={resolvedLayout}
		nodes={nodes}
		edges={edges}
		compact={true}
	/>
</section>
