---
/**
 * Auto-generated Hand-Drawn Visual Diagram Card for every
 * Podcast (`/podcast/[slug]`), Blog Post (`/post/[slug]`), and Course (`/course/[slug]`).
 */
import ExcalidrawDiagram, {
	type ExcalidrawNode,
} from "@/components/ExcalidrawDiagram.astro";
import AjMascot from "@/components/AjMascot.astro";

interface Props {
	title: string;
	kind?: "podcast" | "post" | "course";
	tags?: Array<string | null | undefined>;
}

const { title, kind = "post", tags = [] } = Astro.props;

const cleanTags = tags
	.filter((t): t is string => Boolean(t && t.trim()))
	.slice(0, 2);

const topicHook =
	cleanTags[0] ||
	title
		.replace(/^(CodingCat\.dev|Purrfect\.dev)\s*[-:]?\s*/i, "")
		.split(/[:\-–|]/)[0]
		.trim()
		.slice(0, 22);

const secondHook =
	cleanTags[1] ||
	(kind === "podcast" ? "Architecture & Patterns" : "Hands-On Implementation");

const nodes: ExcalidrawNode[] = [
	{
		id: "fundamentals",
		badge: "Step 01",
		label: topicHook || "Core Concept",
		sublabel: "Mental model & why it matters",
		color: "purple",
	},
	{
		id: "build",
		badge: "Step 02",
		label: secondHook,
		sublabel: "Under the hood & live code",
		color: "blue",
		status: "good",
	},
	{
		id: "production",
		badge: "Step 03",
		label: "Ship It Purrfectly",
		sublabel: "✓ Production trade-offs",
		color: "green",
		status: "good",
	},
];

const edges = [
	{ from: "fundamentals", to: "build", label: "unroll the yarn" },
	{ from: "build", to: "production", label: "✓ production ready" },
];
---

<section
	aria-label="Visual Architecture Diagram"
	class="duo-card hand-border my-8 p-5 md:p-7"
>
	<div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
		<div>
			<span class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-3.5 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 shadow-sketch-sm">
				✏️ Visual Architecture Diagram
			</span>
			<h2 class="mt-2 font-display text-2xl font-black tracking-tight text-[#2A1155] dark:text-white md:text-3xl">
				how this {kind === "podcast" ? "episode" : kind === "course" ? "course" : "post"} connects together<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
			</h2>
			<p class="font-hand mt-1 text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				Follow AJ from first principles to production-ready architecture.
			</p>
		</div>
		<div class="hidden shrink-0 sm:block">
			<AjMascot
				variant="head"
				state="point-diagram"
				angle="three-quarter-left"
				showYarnBall={false}
				cls="w-20 h-20"
				caption="Let’s build it!"
			/>
		</div>
	</div>

	<ExcalidrawDiagram
		title={`Visual Diagram: ${title.slice(0, 48)}${title.length > 48 ? "…" : ""}`}
		caption={`Step-by-step diagram breakdown for ${title}: start with ${topicHook || "core fundamentals"}, implement ${secondHook}, and ship to production.`}
		nodes={nodes}
		edges={edges}
		compact={true}
	/>
</section>
