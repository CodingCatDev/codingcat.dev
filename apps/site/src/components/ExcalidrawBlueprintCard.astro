---
/**
 * Auto-generated Hand-Drawn Excalidraw "Visual Blueprint" Card for every
 * Podcast (`/podcast/[slug]`), Blog Post (`/post/[slug]`), and Course (`/course/[slug]`).
 *
 * Uses CodingCat Royal Purple (#4B2E83), Soft Lavender (#B4A7D6), Electric Lime (#C5E86C),
 * Pure Void (#000000) Excalidraw canvases, Virgil hand-drawn explanations, and the
 * canonical 2D upright bipedal AJ mascot.
 */
import ExcalidrawDiagram, {
	type ExcalidrawNode,
} from "@/components/ExcalidrawDiagram.astro";
import AjMascot from "@/components/AjMascot.astro";

interface Props {
	title: string;
	kind?: "podcast" | "post" | "course";
	tags?: Array<string | null | undefined>;
}

const { title, kind = "post", tags = [] } = Astro.props;

const cleanTags = tags
	.filter((t): t is string => Boolean(t && t.trim()))
	.slice(0, 2);

const topicHook =
	cleanTags[0] ||
	title
		.replace(/^(CodingCat\.dev|Purrfect\.dev)\s*[-:]?\s*/i, "")
		.split(/[:\-–|]/)[0]
		.trim()
		.slice(0, 22);

const secondHook =
	cleanTags[1] ||
	(kind === "podcast" ? "Architecture & Patterns" : "Hands-On Implementation");

const nodes: ExcalidrawNode[] = [
	{
		id: "fundamentals",
		badge: "Step 01",
		label: topicHook || "Core Concept",
		sublabel: "Mental model & why it matters",
		color: "purple",
	},
	{
		id: "build",
		badge: "Step 02",
		label: secondHook,
		sublabel: "Under the hood & live code",
		color: "blue",
		status: "good",
	},
	{
		id: "production",
		badge: "Step 03",
		label: "Ship It Purrfectly",
		sublabel: "✓ Production trade-offs",
		color: "green",
		status: "good",
	},
];

const edges = [
	{ from: "fundamentals", to: "build", label: "unroll the yarn" },
	{ from: "build", to: "production", label: "✓ production ready" },
];
---

<section
	aria-label="Excalidraw Visual Blueprint"
	class="my-8 rounded-2xl border border-[#B4A7D6]/30 bg-[#1E293B] p-5 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.7)] md:p-7"
>
	<div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
		<div>
			<span class="inline-flex items-center gap-1.5 rounded-full border border-[#B4A7D6]/40 bg-[#4B2E83]/60 px-3.5 py-1 font-mono text-xs font-bold uppercase tracking-wider text-[#C5E86C]">
				✏️ Excalidraw Architecture Explanation
			</span>
			<h2 class="mt-2 font-display text-2xl font-black tracking-tight text-[#F8FAFC] md:text-3xl">
				how this {kind === "podcast" ? "episode" : kind === "course" ? "course" : "lesson"} connects together.
			</h2>
			<p class="excalidraw-explain mt-1 text-[#B4A7D6]">
				Follow AJ from first principles to production-ready architecture.
			</p>
		</div>
		<div class="hidden shrink-0 sm:block">
			<AjMascot
				pose="code-peek"
				cls="w-24 h-auto"
				caption="Let’s sketch it!"
			/>
		</div>
	</div>

	<ExcalidrawDiagram
		title={`Visual Map: ${title.slice(0, 48)}${title.length > 48 ? "…" : ""}`}
		caption={`Step-by-step Excalidraw breakdown for ${title}: start with ${topicHook || "core fundamentals"}, implement ${secondHook}, and ship to production.`}
		nodes={nodes}
		edges={edges}
		compact={true}
	/>
</section>
