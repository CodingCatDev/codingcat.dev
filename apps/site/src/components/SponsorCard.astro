---
import { stegaClean } from "@sanity/client/stega";
import CoverImage from "@/components/CoverImage.astro";
import { resolvePartnerUrl } from "@/lib/partner-links";
import type { CoverImage as CoverImageType } from "@/lib/sanity/types.gen";

interface Sponsor {
	_id: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	url?: string | null;
}

interface Props {
	sponsors?: Sponsor[] | null;
}

const { sponsors } = Astro.props;
const items = sponsors ?? [];
---

{
	items.length > 0 && (
		<div class="grid justify-center gap-6 p-4 md:p-6 lg:auto-cols-[1fr] lg:grid-flow-col">
			{items.map((sponsor) => {
				const rawExternal = stegaClean(sponsor.url);
				const external = rawExternal ? resolvePartnerUrl(rawExternal) : "";
				const href = external || `/sponsor/${sponsor.slug}`;
				return (
					<a
						href={href}
						target={external ? "_blank" : undefined}
						rel={external ? "noopener noreferrer sponsored" : undefined}
						data-track="sponsor_click"
						data-track-label={sponsor.title}
						data-track-target={href}
						class="flex"
					>
						<article class="duo-card flex max-w-xl grow flex-col overflow-hidden rounded-2xl border border-[#B4A7D6]/25 bg-[#1E293B] text-[#F8FAFC] shadow-md transition-all hover:-translate-y-1 hover:border-[#C5E86C]">
							<CoverImage image={sponsor.coverImage} />
							<div class="grow p-6">
								<h3 class="mb-3 text-3xl font-extrabold text-balance text-[#F8FAFC]">{sponsor.title}</h3>
							</div>
							{sponsor.excerpt && (
								<p class="px-6 pb-6 text-lg leading-relaxed text-[#94A3B8] text-pretty">
									{sponsor.excerpt}
								</p>
							)}
						</article>
					</a>
				);
			})}
		</div>
	)
}
