---
import { stegaClean } from "@sanity/client/stega";
import CoverImage from "@/components/CoverImage.astro";
import { resolvePartnerUrl } from "@/lib/partner-links";
import type { CoverImage as CoverImageType } from "@/lib/sanity/types.gen";

interface Sponsor {
	_id: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	url?: string | null;
}

interface Props {
	sponsors?: Sponsor[] | null;
}

const { sponsors } = Astro.props;
const items = sponsors ?? [];
---

{
	items.length > 0 && (
		<div class="grid justify-center gap-6 py-4 lg:auto-cols-[1fr] lg:grid-flow-col">
			{items.map((sponsor) => {
				const rawExternal = stegaClean(sponsor.url);
				const external = rawExternal ? resolvePartnerUrl(rawExternal) : "";
				const href = external || `/sponsor/${sponsor.slug}`;
				return (
					<a
						href={href}
						target={external ? "_blank" : undefined}
						rel={external ? "noopener noreferrer sponsored" : undefined}
						data-track="sponsor_click"
						data-track-label={sponsor.title}
						data-track-target={href}
						class="flex"
					>
						<article class="duo-card hand-border group flex max-w-xl grow flex-col overflow-hidden p-5 transition-all hover:-translate-y-1.5 hover:border-[#7C3AED] dark:hover:border-[#C084FC]">
							<div class="mb-4 overflow-hidden rounded-2xl border-2 border-[#2A1155] bg-[#2A1155] dark:border-white/20 dark:bg-[#060E20]">
								<CoverImage image={sponsor.coverImage} />
							</div>
							<div class="grow">
								<span class="mb-2 inline-block rounded-full border border-[#2A1155]/30 bg-[#EDE9FE] px-3 py-0.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/30 dark:bg-purple-950/80 dark:text-purple-200">
									Partner &amp; Sponsor
								</span>
								<h3 class="mb-2 font-display text-2xl font-black text-balance text-[#2A1155] group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
									{sponsor.title}
								</h3>
							</div>
							{sponsor.excerpt && (
								<p class="text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300 text-pretty">
									{sponsor.excerpt}
								</p>
							)}
						</article>
					</a>
				);
			})}
		</div>
	)
}
