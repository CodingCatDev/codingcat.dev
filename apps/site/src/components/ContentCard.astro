---
import Avatar from "@/components/Avatar.astro";
import CoverImage from "@/components/CoverImage.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { type ContentListItem, isPerson } from "@/lib/content";
import { resolveHref } from "@/lib/sanity/resolve-href";

interface Props {
	item: ContentListItem;
	priority?: boolean;
}

const { item, priority = false } = Astro.props;

const href = resolveHref(item._type, item.slug ?? undefined);
const person = isPerson(item._type);
const people = [
	...(item.author ?? []).map((p) => ({ ...p, type: "author" })),
	...(item.guest ?? []).map((p) => ({ ...p, type: "guest" })),
];
---

<article class="duo-card hand-border group flex h-full flex-col overflow-hidden p-5 transition-all duration-200 hover:-translate-y-1.5 hover:border-[#7C3AED] dark:hover:border-[#C084FC]">
	{
		href && (
			<a href={href} class="mb-4 block overflow-hidden rounded-2xl border-2 border-[#2A1155] bg-[#2A1155] dark:border-white/20 dark:bg-[#060E20]">
				{person ? (
					<CoverImage
						image={item.coverImage}
						fallbackAlt={item.title || "CodingCat.dev author photo"}
						width={640}
						height={640}
						sizes="(max-width: 768px) 100vw, 560px"
						class="aspect-square h-auto w-full object-cover transition-transform duration-300 group-hover:scale-105"
						priority={priority}
					/>
				) : (
					<CoverImage
						image={item.coverImage}
						fallbackAlt={item.title || "CodingCat.dev tutorial cover image"}
						sizes="(max-width: 768px) 100vw, 560px"
						priority={priority}
					/>
				)}
			</a>
		)
	}
	<div class="flex flex-1 flex-col justify-between">
		<div>
			{
				!person && item.date && (
					<div class="mb-2 inline-flex rounded-full border border-[#2A1155]/30 bg-[#EDE9FE] px-3 py-0.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/30 dark:bg-purple-950/80 dark:text-purple-200">
						<FormattedDate dateString={item.date} />
					</div>
				)
			}
			<h3 class="mb-2.5 font-display text-2xl font-black leading-snug text-balance text-[#2A1155] transition-colors group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
				{
					href ? (
						<a href={href} class="hover:underline">
							{item.title}
						</a>
					) : (
						item.title
					)
				}
			</h3>
			{item.excerpt && <p class="mb-4 text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300 text-pretty line-clamp-3">{item.excerpt}</p>}
		</div>
		{
			people.length > 0 && (
				<div class="mt-2 flex flex-wrap gap-2 border-t-2 border-dashed border-[#2A1155]/15 pt-3 dark:border-white/15">
					{people.map((p) => (
						<Avatar
							name={p.title}
							href={resolveHref(p.type, p.slug ?? undefined)}
							coverImage={p.coverImage}
						/>
					))}
				</div>
			)
		}
	</div>
</article>
