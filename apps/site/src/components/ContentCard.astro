---
import Avatar from "@/components/Avatar.astro";
import CoverImage from "@/components/CoverImage.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { type ContentListItem, isPerson } from "@/lib/content";
import { resolveHref } from "@/lib/sanity/resolve-href";

interface Props {
	item: ContentListItem;
	priority?: boolean;
}

const { item, priority = false } = Astro.props;

const href = resolveHref(item._type, item.slug ?? undefined);
const person = isPerson(item._type);
const people = [
	...(item.author ?? []).map((p) => ({ ...p, type: "author" })),
	...(item.guest ?? []).map((p) => ({ ...p, type: "guest" })),
];
---

<article class="duo-card group flex h-full flex-col overflow-hidden p-5 transition-all duration-200 hover:-translate-y-1 hover:border-[#58CC02]">
	{
		href && (
			<a href={href} class="mb-5 block overflow-hidden rounded-xl border-2 border-[#37464F] bg-[#0D1519]">
				{person ? (
					<CoverImage
						image={item.coverImage}
						fallbackAlt={item.title || "CodingCat.dev author photo"}
						width={640}
						height={640}
						sizes="(max-width: 768px) 100vw, 560px"
						class="aspect-square h-auto w-full object-cover transition-transform duration-300 group-hover:scale-105"
						priority={priority}
					/>
				) : (
					<CoverImage
						image={item.coverImage}
						fallbackAlt={item.title || "CodingCat.dev tutorial cover image"}
						sizes="(max-width: 768px) 100vw, 560px"
						priority={priority}
					/>
				)}
			</a>
		)
	}
	<div class="flex flex-1 flex-col justify-between">
		<div>
			{
				!person && item.date && (
					<div class="mb-2 font-mono text-xs font-extrabold uppercase tracking-wider text-[#FFC800]">
						<FormattedDate dateString={item.date} />
					</div>
				)
			}
			<h3 class="mb-3 text-2xl font-extrabold leading-snug text-balance text-white transition-colors group-hover:text-[#58CC02] md:text-3xl">
				{
					href ? (
						<a href={href} class="hover:underline">
							{item.title}
						</a>
					) : (
						item.title
					)
				}
			</h3>
			{item.excerpt && <p class="mb-4 text-base leading-relaxed text-[#DCE6EC] text-pretty line-clamp-3">{item.excerpt}</p>}
		</div>
		{
			people.length > 0 && (
				<div class="mt-2 flex flex-wrap gap-2 border-t border-dashed border-[#37464F] pt-3">
					{people.map((p) => (
						<Avatar
							name={p.title}
							href={resolveHref(p.type, p.slug ?? undefined)}
							coverImage={p.coverImage}
						/>
					))}
				</div>
			)
		}
	</div>
</article>
