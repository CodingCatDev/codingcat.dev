---
/**
 * `TopicFilterStrip.astro` | Compact 1-Row Quick-Filter Pills + Searchable "Filter by Tag ▾" Combobox Popover.
 *
 * Designed to embed directly inside the unified filter toolbars on `/courses`, `/podcasts`, and `/blog`
 * (or render as a compact 1-row bar), never dumping 110+ pills onto the page at once.
 */
import {
	QUICK_FILTER_TOPICS,
	TOPIC_CATEGORIES,
	TOPICS,
	getTopicBySlug,
} from "@/lib/topics";

interface Props {
	activeSlug?: string;
	label?: string;
	/** When set (e.g. "/courses", "/podcasts", or "/blog"), pills filter the current listing page in-place. */
	basePath?: string;
	allLabel?: string;
	/** "inline" embeds seamlessly inside an existing toolbar; "bar" renders a 1-row container. */
	variant?: "inline" | "bar";
}

const {
	activeSlug = "",
	label,
	basePath,
	allLabel = "All",
	variant = "inline",
} = Astro.props;

const allHref = basePath ?? "/topics";
const activeTopicDef = activeSlug ? getTopicBySlug(activeSlug) : undefined;
const quickSlugs = new Set(QUICK_FILTER_TOPICS.map((t) => t.slug));
const isExtraActiveTopic = Boolean(
	activeTopicDef && !quickSlugs.has(activeTopicDef.slug),
);
---

<div
	class:list={[
		"topic-filter-strip-root relative flex flex-wrap items-center gap-1.5",
		variant === "bar" &&
			"my-4 rounded-2xl border-2 border-[#2A1155]/20 bg-[#FAF9FC] px-4 py-2.5 shadow-sketch-sm dark:border-white/15 dark:bg-[#131B2E]/80",
	]}
	aria-label="Filter by Topic or Vendor"
	data-topic-filter-strip={basePath ? "in-page" : "hub"}
	data-base-path={basePath}
>
	{
		label && (
			<span class="mr-1 font-mono text-[11px] font-extrabold uppercase tracking-wider text-[#2A1155]/70 dark:text-slate-400">
				{label}
			</span>
		)
	}

	{/* "All" Reset Pill */}
	<a
		href={allHref}
		data-topic-pill={basePath ? "" : undefined}
		data-topic-title={basePath ? allLabel : undefined}
		aria-current={!activeSlug ? "true" : undefined}
		class:list={[
			"topic-filter-pill inline-flex items-center gap-1.5 rounded-full border-2 border-[#2A1155] px-3 py-1 font-display text-xs font-black transition-all hover:-translate-y-0.5 shadow-sketch-sm",
			!activeSlug
				? "bg-[#7C3AED] text-white dark:border-white/50"
				: "bg-white text-[#2A1155] hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#0B132E] dark:text-slate-100 dark:hover:bg-purple-950/60",
		]}
	>
		<span>{allLabel}</span>
	</a>

	{/* 6 Core Quick-Filter Pills (visible on sm+ screens to keep mobile 1-row clean) */}
	<div class="hidden flex-wrap items-center gap-1.5 md:flex">
		{
			QUICK_FILTER_TOPICS.map((topic) => {
				const isActive = activeSlug === topic.slug;
				const pillHref = basePath
					? `${basePath}?topic=${topic.slug}`
					: `/topic/${topic.slug}`;
				return (
					<a
						href={pillHref}
						data-topic-pill={basePath ? topic.slug : undefined}
						data-topic-title={topic.title}
						data-topic-hub={`/topic/${topic.slug}`}
						aria-current={isActive ? "true" : undefined}
						class:list={[
							"topic-filter-pill inline-flex items-center gap-1.5 rounded-full border-2 border-[#2A1155] px-3 py-1 font-display text-xs font-black transition-all hover:-translate-y-0.5 shadow-sketch-sm",
							isActive
								? "bg-[#7C3AED] text-white dark:border-white/50"
								: "bg-white text-[#2A1155] hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#0B1326] dark:text-slate-100 dark:hover:bg-purple-950/60",
						]}
					>
						{topic.kind === "brand" && topic.symbolLight ? (
							<>
								<img
									src={topic.symbolLight}
									alt=""
									aria-hidden="true"
									class="h-3.5 w-auto shrink-0 object-contain dark:hidden"
									loading="lazy"
									decoding="async"
								/>
								<img
									src={topic.symbolDark || topic.symbolLight}
									alt=""
									aria-hidden="true"
									class="hidden h-3.5 w-auto shrink-0 object-contain dark:block"
									loading="lazy"
									decoding="async"
								/>
							</>
						) : (
							<span
								class="font-mono font-extrabold text-[#7C3AED] dark:text-[#C084FC]"
								aria-hidden="true"
							>
								#
							</span>
						)}
						<span>{topic.title}</span>
					</a>
				);
			})
		}
	</div>

	{/* Searchable "Filter by Tag ▾" Combobox Popover Trigger */}
	<div class="relative" data-topic-popover-wrapper>
		<button
			type="button"
			data-topic-popover-trigger
			aria-expanded="false"
			aria-haspopup="dialog"
			class:list={[
				"inline-flex cursor-pointer items-center gap-1.5 rounded-full border-2 border-[#2A1155] px-3 py-1 font-mono text-xs font-extrabold transition-all hover:-translate-y-0.5 shadow-sketch-sm",
				isExtraActiveTopic
					? "bg-[#7C3AED] text-white dark:border-white/50"
					: "bg-[#EDE9FE] text-[#4C1D95] hover:bg-[#DDD6FE] dark:border-purple-400/40 dark:bg-purple-950/70 dark:text-purple-200",
			]}
		>
			<svg
				class="size-3.5 shrink-0"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
			</svg>
			<span data-topic-popover-label>
				{isExtraActiveTopic && activeTopicDef
					? `Tag: ${activeTopicDef.title}`
					: `Filter by Tag (${TOPICS.length})`}
			</span>
			<span aria-hidden="true" class="text-[10px]">▾</span>
		</button>

		{/* Floating Combobox Popover Panel */}
		<div
			data-topic-popover-panel
			role="dialog"
			aria-label="Search and select a topic or vendor tag"
			class="hidden fixed inset-x-3 top-20 z-50 rounded-3xl border-2 border-[#2A1155] bg-[#FAF9FC] p-4 shadow-sketch dark:border-white/25 dark:bg-[#131B2E] sm:absolute sm:inset-x-auto sm:left-0 sm:top-full sm:mt-2 sm:w-[min(92vw,34rem)]"
		>
			{/* Search Input + Close Button */}
			<div class="flex items-center gap-2">
				<div class="relative flex-1">
					<input
						type="search"
						placeholder="Search 110+ vendors, frameworks, languages & tags..."
						aria-label="Search tags by name"
						data-strip-tag-search
						class="w-full rounded-full border-2 border-[#2A1155] bg-white px-3.5 py-1.5 font-sans text-xs font-bold text-[#2A1155] placeholder-[#2A1155]/45 focus:border-[#7C3AED] focus:outline-none dark:border-white/25 dark:bg-[#0B1326] dark:text-white dark:placeholder-slate-400"
					/>
				</div>
				<button
					type="button"
					data-topic-popover-close
					aria-label="Close tag filter menu"
					class="inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-full border border-[#2A1155]/30 bg-white font-mono text-xs font-extrabold text-[#2A1155] hover:bg-[#EDE9FE] dark:border-white/20 dark:bg-[#0B1326] dark:text-slate-200"
				>
					✕
				</button>
			</div>

			{/* Category Filter Tabs */}
			<div class="mt-2.5 flex flex-wrap items-center gap-1 border-b border-dashed border-[#2A1155]/15 pb-2.5 dark:border-white/15">
				<button
					type="button"
					data-strip-cat-tab="featured"
					aria-pressed="true"
					class="strip-cat-btn cursor-pointer rounded-full border border-[#2A1155] bg-[#7C3AED] px-2.5 py-0.5 font-mono text-[10px] font-extrabold text-white transition"
				>
					★ Featured
				</button>
				{
					TOPIC_CATEGORIES.map((cat) => (
						<button
							type="button"
							data-strip-cat-tab={cat.id}
							aria-pressed="false"
							class="strip-cat-btn cursor-pointer rounded-full border border-[#2A1155]/30 bg-white px-2.5 py-0.5 font-mono text-[10px] font-bold text-[#2A1155] transition hover:bg-[#EDE9FE] dark:border-white/20 dark:bg-[#0B1326] dark:text-slate-200"
						>
							{cat.shortLabel}
						</button>
					))
				}
				<button
					type="button"
					data-strip-cat-tab="all"
					aria-pressed="false"
					class="strip-cat-btn cursor-pointer rounded-full border border-[#2A1155]/30 bg-[#EDE9FE] px-2.5 py-0.5 font-mono text-[10px] font-extrabold text-[#7C3AED] transition dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200"
				>
					All ({TOPICS.length})
				</button>
			</div>

			{/* Scrollable Tag Pills Grid */}
			<div
				class="mt-3 flex max-h-60 flex-wrap items-center gap-1.5 overflow-y-auto pr-1"
				data-strip-pills-container
			>
				{
					TOPICS.map((topic) => {
						const isActive = activeSlug === topic.slug;
						const showInitially = Boolean(topic.featured || isActive);
						const pillHref = basePath
							? `${basePath}?topic=${topic.slug}`
							: `/topic/${topic.slug}`;
						return (
							<a
								href={pillHref}
								data-topic-pill={basePath ? topic.slug : undefined}
								data-topic-slug={topic.slug}
								data-topic-title={topic.title}
								data-topic-category={topic.category}
								data-topic-featured={topic.featured ? "true" : "false"}
								data-topic-keywords={`${topic.title.toLowerCase()} ${topic.slug} ${(topic.aliases ?? []).join(" ")}`}
								data-topic-hub={`/topic/${topic.slug}`}
								aria-current={isActive ? "true" : undefined}
								class:list={[
									"topic-filter-pill inline-flex items-center gap-1.5 rounded-full border border-[#2A1155] px-2.5 py-1 font-display text-xs font-bold transition-all hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25",
									isActive
										? "bg-[#7C3AED] text-white dark:border-white/50"
										: "bg-white text-[#2A1155] dark:bg-[#0B1326] dark:text-slate-100 dark:hover:bg-purple-950/60",
									!showInitially && "hidden",
								]}
							>
								{topic.kind === "brand" && topic.symbolLight ? (
									<>
										<img
											src={topic.symbolLight}
											alt=""
											aria-hidden="true"
											class="h-3.5 w-auto shrink-0 object-contain dark:hidden"
											loading="lazy"
											decoding="async"
										/>
										<img
											src={topic.symbolDark || topic.symbolLight}
											alt=""
											aria-hidden="true"
											class="hidden h-3.5 w-auto shrink-0 object-contain dark:block"
											loading="lazy"
											decoding="async"
										/>
									</>
								) : (
									<span
										class="font-mono text-[11px] font-extrabold text-[#7C3AED] dark:text-[#C084FC]"
										aria-hidden="true"
									>
										#
									</span>
								)}
								<span>{topic.title}</span>
							</a>
						);
					})
				}
			</div>

			{/* Popover Footer */}
			<div class="mt-3 flex items-center justify-between border-t border-dashed border-[#2A1155]/15 pt-2.5 font-mono text-[11px] font-bold text-[#2A1155]/70 dark:border-white/15 dark:text-slate-400">
				<span>Official brand logos &amp; topic hubs</span>
				<a
					href="/topics"
					class="font-extrabold text-[#7C3AED] hover:underline dark:text-[#C084FC]"
				>
					Browse All Topic Hubs &rarr;
				</a>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	(function () {
		function initTopicFilterStrips() {
			var strips = document.querySelectorAll(".topic-filter-strip-root");
			for (var i = 0; i < strips.length; i++) {
				var strip = strips[i];
				if (strip.dataset.stripTabsInit === "true") continue;
				strip.dataset.stripTabsInit = "true";
				setupStripPopoverAndTabs(strip);
			}
		}

		function setupStripPopoverAndTabs(strip) {
			var trigger = strip.querySelector("[data-topic-popover-trigger]");
			var panel = strip.querySelector("[data-topic-popover-panel]");
			var closeBtn = strip.querySelector("[data-topic-popover-close]");
			var tabBtns = Array.from(strip.querySelectorAll("[data-strip-cat-tab]"));
			var searchInput = strip.querySelector("[data-strip-tag-search]");
			var pills = Array.from(strip.querySelectorAll("[data-topic-slug]"));
			var currentCat = "featured";
			var currentSearch = "";

			function closePopover() {
				if (!panel || !trigger) return;
				panel.classList.add("hidden");
				trigger.setAttribute("aria-expanded", "false");
			}

			function togglePopover() {
				if (!panel || !trigger) return;
				var isHidden = panel.classList.contains("hidden");
				if (isHidden) {
					panel.classList.remove("hidden");
					trigger.setAttribute("aria-expanded", "true");
					if (searchInput) {
						setTimeout(function () {
							searchInput.focus();
						}, 20);
					}
				} else {
					closePopover();
				}
			}

			if (trigger) {
				trigger.addEventListener("click", function (e) {
					e.stopPropagation();
					togglePopover();
				});
			}

			if (closeBtn) {
				closeBtn.addEventListener("click", function () {
					closePopover();
				});
			}

			document.addEventListener("click", function (e) {
				if (!panel || panel.classList.contains("hidden")) return;
				if (!strip.contains(e.target)) {
					closePopover();
				}
			});

			document.addEventListener("keydown", function (e) {
				if (e.key === "Escape") {
					closePopover();
				}
			});

			// Auto-close popover when a tag pill inside it is clicked
			if (panel) {
				panel.addEventListener("click", function (e) {
					var pill = e.target.closest("[data-topic-slug]");
					if (pill) {
						closePopover();
					}
				});
			}

			function applyVisibility() {
				var q = currentSearch.trim().toLowerCase();
				for (var p = 0; p < pills.length; p++) {
					var pill = pills[p];
					var isCurrentActive = pill.getAttribute("aria-current") === "true";
					var isFeatured = pill.dataset.topicFeatured === "true";
					var cat = pill.dataset.topicCategory || "";
					var kw = pill.dataset.topicKeywords || "";

					var visible = false;
					if (q.length > 0) {
						visible = kw.indexOf(q) !== -1;
					} else if (currentCat === "featured") {
						visible = isFeatured || isCurrentActive;
					} else if (currentCat === "all") {
						visible = true;
					} else {
						visible = cat === currentCat || isCurrentActive;
					}

					pill.classList.toggle("hidden", !visible);
				}

				for (var t = 0; t < tabBtns.length; t++) {
					var btn = tabBtns[t];
					var tabId = btn.dataset.stripCatTab || "";
					var active = q.length === 0 && tabId === currentCat;
					btn.setAttribute("aria-pressed", active ? "true" : "false");
					if (active) {
						btn.classList.add("bg-[#7C3AED]", "text-white", "border-[#2A1155]");
						btn.classList.remove(
							"bg-white",
							"text-[#2A1155]",
							"bg-[#EDE9FE]",
							"text-[#7C3AED]",
							"dark:bg-[#0B1326]",
							"dark:text-slate-200",
						);
					} else {
						btn.classList.remove("bg-[#7C3AED]", "text-white");
						if (tabId === "all") {
							btn.classList.add(
								"bg-[#EDE9FE]",
								"text-[#7C3AED]",
								"dark:bg-purple-950/60",
								"dark:text-purple-200",
							);
						} else {
							btn.classList.add(
								"bg-white",
								"text-[#2A1155]",
								"dark:bg-[#0B1326]",
								"dark:text-slate-200",
							);
						}
					}
				}
			}

			for (var b = 0; b < tabBtns.length; b++) {
				(function (btn) {
					btn.addEventListener("click", function () {
						currentCat = btn.dataset.stripCatTab || "featured";
						if (searchInput && searchInput.value) {
							searchInput.value = "";
							currentSearch = "";
						}
						applyVisibility();
					});
				})(tabBtns[b]);
			}

			if (searchInput) {
				searchInput.addEventListener("input", function () {
					currentSearch = searchInput.value || "";
					applyVisibility();
				});
			}
		}

		document.addEventListener("DOMContentLoaded", initTopicFilterStrips);
		window.addEventListener("load", initTopicFilterStrips);
		document.addEventListener("astro:page-load", initTopicFilterStrips);
		window.addEventListener("cc:page-load", initTopicFilterStrips);
		initTopicFilterStrips();
	})();
</script>
