---
/**
 * CodingCat.dev Chalkboard Tier List (`TierList.astro`)
 *
 * Renders an opinionated S / A / B / C / D Tier List modeled after classic
 * tier lists (https://en.wikipedia.org/wiki/Tier_list) in CodingCat.dev's
 * dual-theme Chalkboard & Royal Purple design system.
 *
 * Always features a tiny animated AJ the Cat (`<AjMascot pose="code-peek" />`)
 * peeking over the top edge, blinking his eyes and tracking the cursor, paired
 * with a hand-drawn yellow sticky-note comment bubble.
 */
import AjMascot from "@/components/AjMascot.astro";

export type TierRank = "S" | "A" | "B" | "C" | "D";

export interface TierDetail {
	label: string;
	value: string;
}

export interface TierItem {
	name: string;
	tier: TierRank;
	category?: string;
	summary?: string;
	badge?: string;
	url?: string;
	details?: TierDetail[];
}

export interface Props {
	title?: string;
	subtitle?: string;
	ajComment?: string;
	headers?: string[];
	rows?: string[][];
	items?: TierItem[];
}

const {
	title = "Alex's Architectural Tier List",
	subtitle = "Ranked from S-Tier (Purrfect Production Pick) to D-Tier based on security boundaries, memory architecture, and real-world DX.",
	ajComment = "I ranked all of them! Watch out for shared VMs... 👀🐾",
	headers = [],
	rows = [],
	items: propItems,
} = Astro.props;

const TIER_META: Record<
	TierRank,
	{
		rank: TierRank;
		label: string;
		tagline: string;
		bgLight: string;
		bgDark: string;
		textLight: string;
		textDark: string;
		pillBorder: string;
	}
> = {
	S: {
		rank: "S",
		label: "Purrfect",
		tagline: "Production Gold & Best-in-Class Isolation",
		bgLight: "bg-[#FF7F7F]",
		bgDark: "dark:bg-[#FF7F7F]",
		textLight: "text-[#2A1155]",
		textDark: "dark:text-[#2A1155]",
		pillBorder: "border-[#FF7F7F]/60",
	},
	A: {
		rank: "A",
		label: "Strong Pick",
		tagline: "Production Ready with Minor Trade-Offs",
		bgLight: "bg-[#FFBF7F]",
		bgDark: "dark:bg-[#FFBF7F]",
		textLight: "text-[#2A1155]",
		textDark: "dark:text-[#2A1155]",
		pillBorder: "border-[#FFBF7F]/60",
	},
	B: {
		rank: "B",
		label: "Solid w/ Caveats",
		tagline: "Powerful Features, Watch the Sharp Edges",
		bgLight: "bg-[#FFDF7F]",
		bgDark: "dark:bg-[#FFDF7F]",
		textLight: "text-[#2A1155]",
		textDark: "dark:text-[#2A1155]",
		pillBorder: "border-[#FFDF7F]/60",
	},
	C: {
		rank: "C",
		label: "Situational",
		tagline: "Niche Fit, Early Preview, or Steep Quotas",
		bgLight: "bg-[#BFFF7F]",
		bgDark: "dark:bg-[#BFFF7F]",
		textLight: "text-[#2A1155]",
		textDark: "dark:text-[#2A1155]",
		pillBorder: "border-[#BFFF7F]/60",
	},
	D: {
		rank: "D",
		label: "Pass / Caution",
		tagline: "Skip for High-Stakes Production Workloads",
		bgLight: "bg-[#7FFFFF]",
		bgDark: "dark:bg-[#7FFFFF]",
		textLight: "text-[#2A1155]",
		textDark: "dark:text-[#2A1155]",
		pillBorder: "border-[#7FFFFF]/60",
	},
};

const TIER_ORDER: TierRank[] = ["S", "A", "B", "C", "D"];

function normalizeTierRank(raw: string): TierRank {
	const cleaned = (raw || "").trim().toUpperCase();
	const firstChar = cleaned.charAt(0);
	if (firstChar === "S" || firstChar === "A" || firstChar === "B" || firstChar === "C" || firstChar === "D") {
		return firstChar;
	}
	return "B";
}

const resolvedItems: TierItem[] =
	propItems && propItems.length > 0
		? propItems
		: rows.map((cells) => {
				const tier = normalizeTierRank(cells[0] ?? "B");
				const name = (cells[1] ?? "Platform").trim();
				const category = (cells[2] ?? "").trim();

				// Pair remaining cells with headers[3..]
				const extraDetails: TierDetail[] = [];
				for (let idx = 3; idx < cells.length; idx++) {
					const val = (cells[idx] ?? "").trim();
					if (!val) continue;
					const hdr = (headers[idx] ?? `Detail ${idx - 2}`).trim();
					extraDetails.push({ label: hdr, value: val });
				}

				const verdictHeaderIdx = headers.findIndex((h) =>
					/verdict|why|summary|notes/i.test(h),
				);
				const pricingHeaderIdx = headers.findIndex((h) =>
					/price|pricing|cost|quota/i.test(h),
				);

				let summary: string | undefined;
				if (verdictHeaderIdx >= 3 && cells[verdictHeaderIdx]) {
					summary = cells[verdictHeaderIdx].trim();
				} else if (cells[3]) {
					summary = cells[3].trim();
				}

				const filteredDetails = extraDetails.filter(
					(d) => d.value !== summary,
				);

				const badge =
					pricingHeaderIdx >= 2 && cells[pricingHeaderIdx]
						? cells[pricingHeaderIdx].trim()
						: undefined;

				return {
					name,
					tier,
					category: category || undefined,
					summary: summary || undefined,
					badge,
					details: filteredDetails,
				};
			});

const groupedByTier: Record<TierRank, TierItem[]> = {
	S: [],
	A: [],
	B: [],
	C: [],
	D: [],
};

for (const item of resolvedItems) {
	groupedByTier[item.tier].push(item);
}

// Show S, A, B, C always; show D if it has items or if fewer than 4 tiers have items
const activeTiers = TIER_ORDER.filter(
	(t) => groupedByTier[t].length > 0 || t === "S" || t === "A" || t === "B" || t === "C",
);
---

<section
	class="tier-list-wrapper not-prose relative my-12 pt-10"
	aria-label={title}
>
	{/* Tiny AJ Peeking Over the Top of the Tier List (Always Visible, Blinking Eyes + Sticky Note) */}
	<div class="pointer-events-auto absolute -top-5 right-4 z-20 flex items-end gap-2 sm:-top-7 sm:right-8">
		<div class="relative -rotate-2 rounded-2xl border-2 border-[#2A1155] bg-[#FEF08A] px-3.5 py-1.5 font-hand text-sm font-bold text-[#2A1155] shadow-sketch-sm transition-transform duration-200 hover:rotate-0 sm:text-base dark:border-yellow-400">
			<span>{ajComment}</span>
			{/* Speech bubble tail pointing right toward AJ */}
			<span
				class="absolute -right-2 bottom-2.5 size-3 rotate-45 border-r-2 border-t-2 border-[#2A1155] bg-[#FEF08A] dark:border-yellow-400"
				aria-hidden="true"
			></span>
		</div>
		<div class="relative -mb-3 shrink-0 overflow-hidden pt-1">
			<AjMascot
				pose="code-peek"
				angle="three-quarter-left"
				fullBody={false}
				showYarnBall={false}
				cls="w-16 h-16 sm:w-20 sm:h-20 drop-shadow-[2px_3px_0px_rgba(42,17,85,0.65)]"
			/>
		</div>
	</div>

	{/* Outer Chalkboard Tier List Frame */}
	<div class="overflow-hidden rounded-3xl border-2 border-[#2A1155] bg-[#FAF9FC] shadow-sketch dark:border-white/25 dark:bg-[#0B1326]">
		{/* Top Header Bar */}
		<div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-[#2A1155] bg-[#2A1155] px-5 py-4 pr-36 text-white sm:pr-64 dark:border-white/20 dark:bg-[#131B2E]">
			<div>
				<div class="flex items-center gap-2">
					<span class="rounded-lg border border-[#2A1155] bg-[#C5E86C] px-2 py-0.5 font-mono text-[11px] font-black uppercase tracking-wider text-[#2A1155]">
						TIER LIST
					</span>
					<h3 class="font-display text-lg font-black tracking-tight text-white sm:text-xl">
						{title}
					</h3>
				</div>
				{subtitle && (
					<p class="mt-1 text-xs text-[#E2E8F0]/90 sm:text-sm">
						{subtitle}
					</p>
				)}
			</div>
		</div>

		{/* Classic S / A / B / C / D Tier Rows */}
		<div class="divide-y-2 divide-[#2A1155] dark:divide-white/20">
			{activeTiers.map((tierKey) => {
				const meta = TIER_META[tierKey];
				const tierItems = groupedByTier[tierKey];

				return (
					<div class="flex flex-col sm:flex-row">
						{/* Left Tier Letter Badge Column */}
						<div
							class:list={[
								"flex shrink-0 flex-row items-center justify-between border-b-2 border-[#2A1155] px-4 py-3 sm:w-32 sm:flex-col sm:justify-center sm:border-b-0 sm:border-r-2 sm:py-5 dark:border-white/20",
								meta.bgLight,
								meta.bgDark,
								meta.textLight,
								meta.textDark,
							]}
						>
							<div class="flex items-baseline gap-2 sm:flex-col sm:items-center sm:gap-0.5">
								<span class="font-display text-3xl font-black leading-none tracking-tight sm:text-5xl">
									{meta.rank}
								</span>
								<span class="font-mono text-xs font-extrabold uppercase tracking-wider text-[#2A1155]">
									{meta.label}
								</span>
							</div>
							<span class="rounded-full border border-[#2A1155]/40 bg-white/60 px-2 py-0.5 font-mono text-[11px] font-bold text-[#2A1155] sm:mt-2">
								{tierItems.length} {tierItems.length === 1 ? "pick" : "picks"}
							</span>
						</div>

						{/* Right Tier Items Cell */}
						<div class="flex-1 bg-[#FAF9FC] p-3.5 sm:p-4 dark:bg-[#0B1326]">
							{tierItems.length === 0 ? (
								<div class="flex h-full min-h-[64px] items-center justify-center rounded-2xl border-2 border-dashed border-[#2A1155]/20 px-4 py-3 font-hand text-base text-[#2A1155]/60 dark:border-white/15 dark:text-slate-400">
									No platforms currently in {meta.rank}-Tier ({meta.tagline})
								</div>
							) : (
								<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
									{tierItems.map((item) => (
										<article class="group relative flex flex-col justify-between rounded-2xl border-2 border-[#2A1155] bg-white p-3.5 shadow-sketch-sm transition-all duration-150 hover:-translate-y-0.5 dark:border-white/20 dark:bg-[#131B2E]">
											<div>
												{/* Top Row: Platform Name + Category Pill */}
												<div class="flex flex-wrap items-start justify-between gap-2">
													<h4 class="font-display text-base font-extrabold text-[#2A1155] dark:text-white">
														{item.url ? (
															<a
																href={item.url}
																target="_blank"
																rel="noopener noreferrer"
																class="underline decoration-[#7C3AED]/40 underline-offset-2 hover:text-[#7C3AED] dark:hover:text-[#C084FC]"
															>
																{item.name} ↗
															</a>
														) : (
															item.name
														)}
													</h4>
													{item.category && (
														<span class="rounded-full border border-[#7C3AED]/35 bg-[#EDE9FE] px-2.5 py-0.5 font-mono text-[11px] font-bold text-[#4C1D95] dark:border-purple-400/35 dark:bg-purple-950/70 dark:text-purple-200">
															{item.category}
														</span>
													)}
												</div>

												{/* Primary Architectural Verdict / Summary */}
												{item.summary && (
													<p class="mt-1.5 text-xs leading-relaxed text-[#334155] dark:text-slate-300">
														{item.summary}
													</p>
												)}
											</div>

											{/* Expandable / Structured Spec Pills from Remaining Columns */}
											{item.details && item.details.length > 0 && (
												<div class="mt-3 space-y-1.5 border-t border-dashed border-[#2A1155]/15 pt-2.5 text-xs dark:border-white/15">
													{item.details.map((d) => (
														<div class="flex items-start gap-1.5">
															<span class="shrink-0 font-mono text-[10px] font-bold uppercase tracking-wider text-[#7C3AED] dark:text-[#C084FC]">
																{d.label}:
															</span>
															<span class="text-[11px] leading-snug text-[#1E293B] dark:text-slate-200">
																{d.value}
															</span>
														</div>
													))}
												</div>
											)}
										</article>
									))}
								</div>
							)}
						</div>
					</div>
				);
			})}
		</div>

		{/* Bottom Legend Strip */}
		<div class="flex flex-wrap items-center justify-between gap-2 border-t-2 border-[#2A1155] bg-[#EDE9FE]/55 px-4 py-2.5 text-xs text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-slate-300">
			<div class="flex flex-wrap items-center gap-3 font-mono text-[11px] font-bold">
				<span class="inline-flex items-center gap-1">
					<span class="inline-block size-2.5 rounded-sm border border-[#2A1155] bg-[#FF7F7F]"></span>
					S: Purrfect
				</span>
				<span class="inline-flex items-center gap-1">
					<span class="inline-block size-2.5 rounded-sm border border-[#2A1155] bg-[#FFBF7F]"></span>
					A: Production Ready
				</span>
				<span class="inline-flex items-center gap-1">
					<span class="inline-block size-2.5 rounded-sm border border-[#2A1155] bg-[#FFDF7F]"></span>
					B: Solid w/ Caveats
				</span>
				<span class="inline-flex items-center gap-1">
					<span class="inline-block size-2.5 rounded-sm border border-[#2A1155] bg-[#BFFF7F]"></span>
					C: Situational
				</span>
				<span class="inline-flex items-center gap-1">
					<span class="inline-block size-2.5 rounded-sm border border-[#2A1155] bg-[#7FFFFF]"></span>
					D: Pass
				</span>
			</div>
			<span class="font-hand text-sm font-bold text-[#4C1D95] dark:text-[#C084FC]">
				Click AJ to celebrate! 🐾
			</span>
		</div>
	</div>
</section>
