---
import AjHeadphones from "@/components/icons/AjHeadphones.astro";
import { settingsQuery } from "@/lib/sanity/queries";
import NavLink from "./NavLink.astro";
import SearchModal from "./SearchModal.astro";
import ThemeToggle from "./ThemeToggle.astro";

const settings = await Astro.locals.sanity.loadQuery(settingsQuery);
const navLinks = settings?.navLinks ?? [];

const desktopLinks = navLinks.filter((link) => link?.sideOnly !== true);
const hasCoursesLink = desktopLinks.some((link) =>
	(link?.path ?? "").startsWith("/course"),
);
---

<header
	class="fixed left-0 right-0 top-0 z-40 flex items-center justify-between border-b-2 border-[#37464F] bg-[#131F24]/95 px-5 py-3.5 backdrop-blur-md"
>
	<div class="flex items-center gap-5">
		<a
			class="group flex items-center gap-2.5 text-lg font-black tracking-tight text-white md:text-2xl"
			href="/"
		>
			<AjHeadphones cls="block size-9 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-6" />
			<span>
				codingcat<span class="text-[#58CC02]">.dev</span>
			</span>
		</a>
		<nav class="hidden items-center gap-5 md:flex" aria-label="Main">
			{
				!hasCoursesLink && (
					<NavLink href="/courses">
						<span class="inline-flex items-center gap-1.5 font-extrabold text-[#58CC02]">
							🧶 Courses
						</span>
					</NavLink>
				)
			}
			{
				desktopLinks.map((link) => (
					<NavLink href={link?.path ?? "/"}>{link?.title}</NavLink>
				))
			}
		</nav>
	</div>
	<div class="flex items-center gap-2.5">
		<a
			href="/courses"
			class="duo-btn duo-btn-green hidden px-3.5 py-1.5 text-xs sm:inline-flex"
		>
			Start Learning
		</a>
		<button
			type="button"
			id="search-header-trigger"
			data-track="search_open"
			data-track-label="header_search"
			class="inline-flex cursor-pointer items-center justify-center gap-1.5 rounded-xl border-2 border-[#37464F] bg-[#202F36] px-3 py-1.5 text-xs font-bold text-[#DCE6EC] shadow-[0_3px_0_#37464F] transition-colors hover:border-[#1CB0F6] hover:text-white"
			aria-label="Search CodingCat.dev (⌘K)"
		>
			<svg
				class="size-4 text-[#1CB0F6]"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			</svg>
			<span class="hidden items-center rounded border border-[#37464F] bg-[#131F24] px-1.5 py-0.5 font-mono text-[10px] text-[#FFC800] md:inline-flex">⌘K</span>
		</button>
		<ThemeToggle />
		<button
			type="button"
			id="nav-drawer-toggle"
			class="inline-flex size-9 items-center justify-center rounded-xl border-2 border-[#37464F] bg-[#202F36] transition-colors hover:border-[#58CC02] md:hidden"
			aria-controls="nav-drawer"
			aria-expanded="false"
		>
			<svg
				class="size-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M3 6h18M3 12h18M3 18h18"></path>
			</svg>
			<span class="sr-only">Toggle navigation menu</span>
		</button>
	</div>
</header>

<div
	id="nav-drawer"
	hidden
	class="fixed inset-0 z-50 bg-[#131F24]/98 backdrop-blur md:hidden"
>
	<div class="flex items-center justify-end px-6 py-4">
		<button
			type="button"
			id="nav-drawer-close"
			class="inline-flex size-9 items-center justify-center rounded-xl border-2 border-[#37464F] bg-[#202F36]"
			aria-label="Close navigation menu"
		>
			<svg
				class="size-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M18 6 6 18M6 6l12 12"></path>
			</svg>
		</button>
	</div>
	<nav class="grid gap-3 px-6 py-6 text-lg font-extrabold" aria-label="Mobile">
		<NavLink href="/courses">🧶 Courses & Learning Map</NavLink>
		{navLinks.map((link) => <NavLink href={link?.path ?? "/"}>{link?.title}</NavLink>)}
	</nav>
</div>

<SearchModal />

<script>
	const drawer = document.getElementById("nav-drawer");
	const openButton = document.getElementById("nav-drawer-toggle");
	const closeButton = document.getElementById("nav-drawer-close");
	const searchTrigger = document.getElementById("search-header-trigger");

	searchTrigger?.addEventListener("click", () => {
		(window as unknown as { openSearchModal?: () => void }).openSearchModal?.();
	});

	const setOpen = (open: boolean) => {
		if (!drawer) {
			return;
		}
		drawer.hidden = !open;
		openButton?.setAttribute("aria-expanded", String(open));
		document.body.style.overflow = open ? "hidden" : "";
	};

	openButton?.addEventListener("click", () => setOpen(true));
	closeButton?.addEventListener("click", () => setOpen(false));
	drawer?.addEventListener("click", (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			setOpen(false);
		}
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && drawer && !drawer.hidden) {
			setOpen(false);
		}
	});
</script>
