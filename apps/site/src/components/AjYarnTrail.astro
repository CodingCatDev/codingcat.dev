---
/**
 * Scroll-driven CodingCat Royal Purple (#7C3AED), Soft Lavender (#B4A7D6),
 * and Electric Lime (#C5E86C) unwinding yarn string that connects
 * Excalidraw explanation sections down the page.
 */
interface Props {
	variant?: "left-to-right" | "right-to-left" | "center-wave";
}

const { variant = "left-to-right" } = Astro.props;

const pathD =
	variant === "left-to-right"
		? "M 180 0 C 180 70, 820 50, 820 120"
		: variant === "right-to-left"
			? "M 820 0 C 820 70, 180 50, 180 120"
			: "M 500 0 C 360 40, 640 80, 500 120";
---

<div class="relative mx-auto my-2 hidden w-full max-w-5xl select-none md:block" aria-hidden="true">
	<svg
		viewBox="0 0 1000 120"
		fill="none"
		class="h-24 w-full overflow-visible"
		preserveAspectRatio="none"
	>
		{/* Sketchy Soft Lavender guide shadow */}
		<path
			d={pathD}
			stroke="#4B2E83"
			stroke-width="7"
			stroke-dasharray="10 10"
			stroke-linecap="round"
		/>
		{/* Glowing Electric Lime & Lavender Yarn String */}
		<path
			d={pathD}
			stroke="#C5E86C"
			stroke-width="4.5"
			stroke-linecap="round"
			class="yarn-glow"
		/>
		{/* Playful yarn knot midpoint */}
		<circle
			cx="500"
			cy="60"
			r="9"
			fill="#4B2E83"
			stroke="#C5E86C"
			stroke-width="3"
		/>
	</svg>
</div>
