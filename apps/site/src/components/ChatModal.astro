---
// ChatModal.astro — Persistent Right-Side Resizable "Ask Agent" Drawer (Survives across page changes via soft-navigation + pre-paint storage sync)
---

<aside
	id="aj-agent-drawer"
	data-markdown-ignore="true"
	class="hidden fixed top-0 right-0 bottom-0 z-50 w-full sm:w-[var(--aj-drawer-width,420px)] flex-col border-l border-border bg-card text-foreground shadow-2xl select-none sm:select-auto"
	aria-label="Ask Agent AJ"
>
	<!-- Desktop Left-Edge Drag Resize Handle -->
	<div
		id="aj-drawer-resize-handle"
		class="hidden sm:flex absolute left-0 top-0 bottom-0 w-2 -translate-x-1/2 cursor-col-resize items-center justify-center group z-20"
		title="Drag to resize Ask Agent panel"
		aria-hidden="true"
	>
		<div class="h-full w-0.5 bg-transparent group-hover:bg-primary/60 group-active:bg-primary transition-colors"></div>
	</div>

	<!-- Drawer Header (Matches Sanity Docs "ASK AGENT" bar) -->
	<header class="flex items-center justify-between border-b border-border px-4 py-3.5 bg-background/60 shrink-0">
		<div class="flex items-center gap-2.5 min-w-0">
			<span class="font-mono text-xs font-semibold uppercase tracking-widest text-foreground">
				ASK AGENT
			</span>
			<span
				id="aj-drawer-telemetry-pill"
				class="hidden truncate rounded-full border border-primary/30 bg-primary/10 px-2 py-0.5 font-mono text-[10px] font-medium text-primary"
				title="Cloudflare Clairic Extraction Telemetry"
			></span>
		</div>

		<div class="flex items-center gap-1">
			<!-- New Conversation / Clear Button (Compose Icon) -->
			<button
				type="button"
				id="aj-drawer-new-btn"
				class="rounded-md p-1.5 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors cursor-pointer"
				title="New conversation"
				aria-label="New conversation"
			>
				<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
					<path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path>
				</svg>
			</button>

			<!-- Close Drawer Button -->
			<button
				type="button"
				id="aj-drawer-close-btn"
				class="rounded-md p-1.5 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors cursor-pointer"
				title="Close Ask Agent"
				aria-label="Close Ask Agent"
			>
				<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</header>

	<!-- Messages Container -->
	<div
		id="ai-chat-messages"
		class="flex-1 overflow-y-auto px-4 py-5 flex flex-col gap-5 text-sm select-text"
	>
		<!-- Welcome / Initial State -->
		<div id="ai-chat-welcome" class="flex flex-col gap-4 my-auto py-6">
			<div class="flex items-center gap-2.5">
				<img src="/icon.svg" alt="Agent AJ" class="size-8 rounded-lg object-contain bg-primary/10 p-1" width="32" height="32" />
				<div>
					<div class="font-semibold text-sm text-foreground">Agent AJ</div>
					<p class="text-[11px] text-muted-foreground">Sanity Content Lake • Cloudflare Clairic</p>
				</div>
			</div>
			<p class="text-sm text-muted-foreground leading-relaxed">
				Ask anything about CodingCat.dev podcasts, tutorials, guests, or transcripts. This panel stays open as you browse episodes.
			</p>
			<div class="flex flex-col items-start gap-2 pt-1">
				<button
					type="button"
					class="ai-prompt-chip inline-flex items-center gap-2 rounded-full border border-border bg-background/60 hover:bg-accent px-3.5 py-1.5 text-[11px] font-mono uppercase tracking-wider text-foreground transition-colors cursor-pointer"
					data-prompt="What is the latest podcast episode?"
				>
					LATEST PODCAST EPISODE
				</button>
				<button
					type="button"
					class="ai-prompt-chip inline-flex items-center gap-2 rounded-full border border-border bg-background/60 hover:bg-accent px-3.5 py-1.5 text-[11px] font-mono uppercase tracking-wider text-foreground transition-colors cursor-pointer"
					data-prompt="What is the latest blog post?"
				>
					LATEST BLOG POST
				</button>
				<button
					type="button"
					class="ai-prompt-chip inline-flex items-center gap-2 rounded-full border border-border bg-background/60 hover:bg-accent px-3.5 py-1.5 text-[11px] font-mono uppercase tracking-wider text-foreground transition-colors cursor-pointer"
					data-prompt="What are the top videos on CodingCat.dev?"
				>
					TOP YOUTUBE VIDEOS
				</button>
				<button
					type="button"
					class="ai-prompt-chip inline-flex items-center gap-2 rounded-full border border-border bg-background/60 hover:bg-accent px-3.5 py-1.5 text-[11px] font-mono uppercase tracking-wider text-foreground transition-colors cursor-pointer"
					data-prompt="Tell me a programming dad joke!"
				>
					PROGRAMMING DAD JOKE
				</button>
			</div>
		</div>
	</div>

	<!-- Input Footer (Matches Sanity Docs boxed input + Enter/Shift+Enter + circular up arrow) -->
	<form
		id="ai-chat-form"
		class="border-t border-border p-3 bg-background/40 flex flex-col gap-2 shrink-0"
		toolname="ask_agent_aj"
		tooldescription="Ask Agent AJ questions about CodingCat.dev podcasts, tutorials, guests, and transcripts"
	>
		<div class="rounded-lg border border-border bg-background focus-within:border-primary/60 focus-within:ring-1 focus-within:ring-primary/40 transition-all p-2.5">
			<label for="ai-chat-input" class="sr-only">Ask anything about CodingCat.dev</label>
			<textarea
				id="ai-chat-input"
				name="prompt"
				rows="2"
				placeholder="Ask anything about CodingCat.dev..."
				class="w-full resize-none bg-transparent text-sm text-foreground placeholder:text-muted-foreground focus:outline-none leading-relaxed"
				toolparamdescription="Natural language question for Agent AJ"
			></textarea>
		</div>
		<div class="flex items-center justify-between px-0.5">
			<span class="font-mono text-[11px] text-muted-foreground">
				Enter to send, Shift+Enter for a new line
			</span>
			<button
				type="submit"
				id="ai-chat-send-btn"
				class="size-7 rounded-full bg-foreground text-background hover:opacity-90 disabled:opacity-40 flex items-center justify-center transition-opacity cursor-pointer shrink-0"
				aria-label="Send message"
			>
				<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="19" x2="12" y2="5"></line>
					<polyline points="5 12 12 5 19 12"></polyline>
				</svg>
			</button>
		</div>
	</form>
</aside>

<!-- Synchronous pre-paint script so the drawer survives across navigations without flicker -->
<script is:inline>
	(function () {
		try {
			var savedWidth = localStorage.getItem("cc_aj_drawer_width");
			var widthPx = savedWidth ? Math.min(Math.max(parseInt(savedWidth, 10) || 420, 320), 780) : 420;
			document.documentElement.style.setProperty("--aj-drawer-width", widthPx + "px");

			var isOpen =
				localStorage.getItem("cc_aj_drawer_open") === "true" ||
				sessionStorage.getItem("cc_aj_drawer_open") === "true";

			if (isOpen) {
				var drawer = document.getElementById("aj-agent-drawer");
				if (drawer) {
					drawer.classList.remove("hidden");
					drawer.classList.add("flex");
				}
				document.documentElement.classList.add("aj-drawer-open");
			}
		} catch (e) {}
	})();
</script>

<script>
	interface StoredMessage {
		role: "user" | "assistant";
		text: string;
		telemetry?: string;
		timestamp: number;
	}

	interface RecentAskItem {
		prompt: string;
		timestamp: number;
	}

	const STORAGE_OPEN_KEY = "cc_aj_drawer_open";
	const STORAGE_WIDTH_KEY = "cc_aj_drawer_width";
	const STORAGE_MESSAGES_KEY = "cc_aj_messages";
	const STORAGE_RECENT_ASKS_KEY = "cc_aj_recent_asks";

	const drawer = document.getElementById("aj-agent-drawer");
	const resizeHandle = document.getElementById("aj-drawer-resize-handle");
	const closeBtn = document.getElementById("aj-drawer-close-btn");
	const newChatBtn = document.getElementById("aj-drawer-new-btn");
	const headerTelemetryPill = document.getElementById("aj-drawer-telemetry-pill");
	const form = document.getElementById("ai-chat-form") as HTMLFormElement | null;
	const input = document.getElementById("ai-chat-input") as HTMLTextAreaElement | null;
	const sendBtn = document.getElementById("ai-chat-send-btn") as HTMLButtonElement | null;
	const messagesContainer = document.getElementById("ai-chat-messages");
	const welcomeContainer = document.getElementById("ai-chat-welcome");

	let isStreaming = false;
	let storedMessages: StoredMessage[] = [];
	let loadedModuleScripts = new Set<string>();
	document.querySelectorAll('script[type="module"][src]').forEach((s) => {
		const src = s.getAttribute("src");
		if (src) loadedModuleScripts.add(new URL(src, window.location.origin).pathname);
	});

	function isDrawerSavedOpen(): boolean {
		try {
			return (
				localStorage.getItem(STORAGE_OPEN_KEY) === "true" ||
				sessionStorage.getItem(STORAGE_OPEN_KEY) === "true"
			);
		} catch {
			return false;
		}
	}

	function loadStoredMessages(): StoredMessage[] {
		try {
			const raw =
				localStorage.getItem(STORAGE_MESSAGES_KEY) ||
				sessionStorage.getItem(STORAGE_MESSAGES_KEY);
			if (!raw) return [];
			const parsed = JSON.parse(raw);
			return Array.isArray(parsed) ? parsed.slice(-30) : [];
		} catch {
			return [];
		}
	}

	function saveStoredMessages() {
		const serialized = JSON.stringify(storedMessages.slice(-30));
		try {
			localStorage.setItem(STORAGE_MESSAGES_KEY, serialized);
		} catch {}
		try {
			sessionStorage.setItem(STORAGE_MESSAGES_KEY, serialized);
		} catch {}
	}

	function recordRecentAsk(prompt: string) {
		try {
			const raw = localStorage.getItem(STORAGE_RECENT_ASKS_KEY);
			const list: RecentAskItem[] = raw ? JSON.parse(raw) : [];
			const filtered = Array.isArray(list)
				? list.filter((item) => item.prompt.toLowerCase() !== prompt.toLowerCase())
				: [];
			filtered.unshift({ prompt, timestamp: Date.now() });
			localStorage.setItem(
				STORAGE_RECENT_ASKS_KEY,
				JSON.stringify(filtered.slice(0, 6)),
			);
		} catch {}
	}

	function setDrawerOpen(open: boolean, initialPrompt?: string) {
		if (!drawer) return;
		if (open) {
			drawer.classList.remove("hidden");
			drawer.classList.add("flex");
			document.documentElement.classList.add("aj-drawer-open");
			try {
				localStorage.setItem(STORAGE_OPEN_KEY, "true");
			} catch {}
			try {
				sessionStorage.setItem(STORAGE_OPEN_KEY, "true");
			} catch {}
			if (initialPrompt && input) {
				input.value = initialPrompt;
				submitPrompt(initialPrompt);
			} else if (!initialPrompt) {
				setTimeout(() => input?.focus(), 30);
			}
		} else {
			drawer.classList.add("hidden");
			drawer.classList.remove("flex");
			document.documentElement.classList.remove("aj-drawer-open");
			try {
				localStorage.setItem(STORAGE_OPEN_KEY, "false");
			} catch {}
			try {
				sessionStorage.setItem(STORAGE_OPEN_KEY, "false");
			} catch {}
		}
		window.dispatchEvent(
			new CustomEvent("aj-drawer-change", { detail: { open } }),
		);
	}

	function syncDrawerFromStorage() {
		if (isDrawerSavedOpen()) {
			drawer?.classList.remove("hidden");
			drawer?.classList.add("flex");
			document.documentElement.classList.add("aj-drawer-open");
		}
	}

	// Ensure drawer open state is enforced on module execution and bfcache restore
	syncDrawerFromStorage();
	window.addEventListener("pageshow", syncDrawerFromStorage);
	window.addEventListener("storage", (e) => {
		if (e.key === STORAGE_OPEN_KEY) {
			syncDrawerFromStorage();
		}
	});

	function toggleDrawer() {
		const isOpen =
			document.documentElement.classList.contains("aj-drawer-open") ||
			(drawer && !drawer.classList.contains("hidden"));
		setDrawerOpen(!isOpen);
	}

	// Soft-navigation helper so page changes swap <main> without unmounting the Ask Agent drawer
	let navAbortController: AbortController | null = null;

	async function navigateInPlace(rawUrl: string | URL, pushState = true): Promise<boolean> {
		try {
			const targetUrl = new URL(rawUrl, window.location.origin);
			if (targetUrl.origin !== window.location.origin) {
				return false;
			}
			const path = targetUrl.pathname;
			if (
				path.startsWith("/api/") ||
				path.startsWith("/oauth") ||
				path.startsWith("/.well-known/") ||
				/\.(xml|json|md|txt|png|jpg|jpeg|svg|ico|pdf|mp3)$/i.test(path)
			) {
				return false;
			}

			// If same pathname & search & only hash changed, let browser scroll to hash
			if (
				targetUrl.pathname === window.location.pathname &&
				targetUrl.search === window.location.search &&
				targetUrl.hash
			) {
				return false;
			}

			if (navAbortController) {
				navAbortController.abort();
			}
			navAbortController = new AbortController();

			const res = await fetch(targetUrl.href, {
				headers: { Accept: "text/html" },
				signal: navAbortController.signal,
			});
			if (!res.ok || !res.headers.get("content-type")?.includes("text/html")) {
				window.location.href = targetUrl.href;
				return true;
			}

			const html = await res.text();
			const doc = new DOMParser().parseFromString(html, "text/html");
			const newMain = doc.querySelector("main");
			const currentMain = document.querySelector("main");

			if (!newMain || !currentMain) {
				window.location.href = targetUrl.href;
				return true;
			}

			// Swap <main> content while keeping <aside id="aj-agent-drawer"> completely untouched
			currentMain.replaceWith(newMain);

			// Update document title & canonical URL
			if (doc.title) {
				document.title = doc.title;
			}
			const newCanonical = doc.querySelector('link[rel="canonical"]')?.getAttribute("href");
			const curCanonical = document.querySelector('link[rel="canonical"]');
			if (newCanonical && curCanonical) {
				curCanonical.setAttribute("href", newCanonical);
			}

			// Update header nav active states
			const newHeaderNav = doc.querySelector("#site-header nav");
			const curHeaderNav = document.querySelector("#site-header nav");
			if (newHeaderNav && curHeaderNav) {
				curHeaderNav.innerHTML = newHeaderNav.innerHTML;
			}

			// Close SearchModal or mobile nav drawer if open
			const searchDialog = document.getElementById("search-modal") as HTMLDialogElement | null;
			if (searchDialog?.open) {
				searchDialog.close();
				document.body.style.overflow = "";
			}
			const mobileNav = document.getElementById("nav-drawer");
			if (mobileNav && !mobileNav.hidden) {
				mobileNav.hidden = true;
				document.body.style.overflow = "";
			}

			if (pushState) {
				window.history.pushState({}, "", targetUrl.href);
			}
			if (targetUrl.hash) {
				const hashEl = document.querySelector(targetUrl.hash);
				hashEl?.scrollIntoView();
			} else {
				window.scrollTo({ top: 0, behavior: "instant" as ScrollBehavior });
			}

			// Load any new page-level module scripts not yet loaded (e.g. search.astro, TranscriptModal)
			doc.querySelectorAll('script[type="module"][src]').forEach((s) => {
				const src = s.getAttribute("src");
				if (!src) return;
				const pathname = new URL(src, window.location.origin).pathname;
				if (!loadedModuleScripts.has(pathname)) {
					loadedModuleScripts.add(pathname);
					const scriptEl = document.createElement("script");
					scriptEl.type = "module";
					scriptEl.src = src;
					document.head.appendChild(scriptEl);
				}
			});

			// Re-ensure drawer stays open if saved open
			syncDrawerFromStorage();

			// Notify page widgets (e.g. TranscriptModal, Recently Viewed tracker)
			window.dispatchEvent(new CustomEvent("cc:page-load"));
			return true;
		} catch (err: unknown) {
			if (err instanceof Error && err.name === "AbortError") {
				return true;
			}
			return false;
		}
	}

	// Intercept internal link clicks across the document so the drawer stays open without page reload
	document.addEventListener("click", (e: MouseEvent) => {
		if (
			e.defaultPrevented ||
			e.button !== 0 ||
			e.metaKey ||
			e.ctrlKey ||
			e.shiftKey ||
			e.altKey
		) {
			return;
		}

		const anchor = (e.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
		if (!anchor) return;
		if (
			anchor.target &&
			anchor.target !== "_self"
		) {
			return;
		}
		if (anchor.hasAttribute("download") || anchor.getAttribute("rel") === "external") {
			return;
		}

		const href = anchor.getAttribute("href");
		if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:") || href.startsWith("javascript:")) {
			return;
		}

		// Normalize any hardcoded codingcat.dev links inside the drawer to current origin
		let resolvedHref = href;
		if (anchor.closest("#aj-agent-drawer")) {
			resolvedHref = href.replace(
				/^https?:\/\/(?:www\.|dev\.)?codingcat\.dev(\/|$)/i,
				"/",
			);
		}

		let targetUrl: URL;
		try {
			targetUrl = new URL(resolvedHref, window.location.origin);
		} catch {
			return;
		}

		if (targetUrl.origin !== window.location.origin) {
			return;
		}

		const path = targetUrl.pathname;
		if (
			path.startsWith("/api/") ||
			path.startsWith("/oauth") ||
			path.startsWith("/.well-known/") ||
			/\.(xml|json|md|txt|png|jpg|jpeg|svg|ico|pdf|mp3)$/i.test(path)
		) {
			return;
		}

		e.preventDefault();
		navigateInPlace(targetUrl, true);
	});

	window.addEventListener("popstate", () => {
		navigateInPlace(window.location.href, false);
	});

	// Expose global APIs for SearchModal, Header, and pages
	(
		window as unknown as {
			openAgentAjModal?: (prompt?: string) => void;
			openAgentAjDrawer?: (prompt?: string) => void;
			toggleAgentAjDrawer?: () => void;
			navigateWithDrawer?: (url: string) => Promise<boolean>;
		}
	).openAgentAjModal = (prompt?: string) => setDrawerOpen(true, prompt);
	(
		window as unknown as {
			openAgentAjDrawer?: (prompt?: string) => void;
		}
	).openAgentAjDrawer = (prompt?: string) => setDrawerOpen(true, prompt);
	(
		window as unknown as {
			toggleAgentAjDrawer?: () => void;
		}
	).toggleAgentAjDrawer = toggleDrawer;
	(
		window as unknown as {
			navigateWithDrawer?: (url: string) => Promise<boolean>;
		}
	).navigateWithDrawer = (url: string) => navigateInPlace(url, true);

	closeBtn?.addEventListener("click", () => setDrawerOpen(false));

	newChatBtn?.addEventListener("click", () => {
		storedMessages = [];
		saveStoredMessages();
		if (messagesContainer) {
			Array.from(messagesContainer.children).forEach((child) => {
				if (child.id !== "ai-chat-welcome") {
					child.remove();
				}
			});
		}
		welcomeContainer?.classList.remove("hidden");
		headerTelemetryPill?.classList.add("hidden");
		input?.focus();
	});

	// Desktop Drag Resizing
	if (resizeHandle && drawer) {
		let isResizing = false;

		resizeHandle.addEventListener("pointerdown", (e: PointerEvent) => {
			if (window.innerWidth < 640) return;
			isResizing = true;
			resizeHandle.setPointerCapture(e.pointerId);
			document.body.style.cursor = "col-resize";
			document.body.style.userSelect = "none";
		});

		resizeHandle.addEventListener("pointermove", (e: PointerEvent) => {
			if (!isResizing) return;
			const newWidth = Math.min(
				Math.max(window.innerWidth - e.clientX, 320),
				Math.min(780, window.innerWidth - 240),
			);
			document.documentElement.style.setProperty(
				"--aj-drawer-width",
				`${newWidth}px`,
			);
			try {
				localStorage.setItem(STORAGE_WIDTH_KEY, String(Math.round(newWidth)));
			} catch {}
		});

		const stopResize = (e: PointerEvent) => {
			if (!isResizing) return;
			isResizing = false;
			try {
				resizeHandle.releasePointerCapture(e.pointerId);
			} catch {}
			document.body.style.cursor = "";
			document.body.style.userSelect = "";
		};

		resizeHandle.addEventListener("pointerup", stopResize);
		resizeHandle.addEventListener("pointercancel", stopResize);
	}

	document.querySelectorAll(".ai-prompt-chip").forEach((chip) => {
		chip.addEventListener("click", () => {
			const prompt = chip.getAttribute("data-prompt");
			if (prompt) {
				submitPrompt(prompt);
			}
		});
	});

	function escapeHtml(text: string): string {
		return text
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#039;");
	}

	const PROVIDER_CONFIG: Array<{
		key: string;
		label: string;
		colorClass: string;
		svg: string;
	}> = [
		{
			key: "spotify",
			label: "Spotify",
			colorClass: "text-[#1DB954]",
			svg: '<svg class="size-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0Zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02Zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2Zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3Z"/></svg>',
		},
		{
			key: "apple",
			label: "Apple",
			colorClass: "text-[#A555F7]",
			svg: '<svg class="size-3.5 fill-current" viewBox="0 0 24 24"><path d="M5.34 0A5.328 5.328 0 0 0 0 5.34v13.32A5.328 5.328 0 0 0 5.34 24h13.32A5.328 5.328 0 0 0 24 18.66V5.34A5.328 5.328 0 0 0 18.66 0Zm6.525 2.568c2.336 0 4.448.902 6.056 2.587 1.224 1.272 1.912 2.619 2.264 4.392.12.59.12 2.2.007 2.864a8.506 8.506 0 0 1-3.24 5.296c-.608.46-2.096 1.261-2.336 1.261-.088 0-.096-.091-.056-.46.072-.592.144-.715.48-.856.535-.224 1.447-.874 2.008-1.435a7.644 7.644 0 0 0 2.008-3.536c.208-.824.184-2.656-.048-3.504-.728-2.672-2.512-4.544-5.096-5.336-.784-.24-2.44-.336-3.384-.2-2.36.32-4.448 1.664-5.616 3.616-1.096 1.832-1.264 4.24-.44 6.224.6 1.448 1.784 2.792 3.048 3.472.28.152.352.28.416.72.048.36.024.44-.056.44-.048 0-.416-.16-.816-.36l-.024-.008c-1.472-.72-2.72-2.032-3.448-3.648-1.472-3.248-.688-7.02 1.928-9.352 1.72-1.53 3.88-2.28 6.344-2.28z"/></svg>',
		},
		{
			key: "youtube",
			label: "YouTube",
			colorClass: "text-[#FF0000]",
			svg: '<svg class="size-3.5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>',
		},
		{
			key: "rss",
			label: "RSS",
			colorClass: "text-[#FFA500]",
			svg: '<svg class="size-3.5 fill-current" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>',
