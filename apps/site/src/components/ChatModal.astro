	function stripProviderTrailer(text: string): string {
		return text.replace(/\n?<!--AJ_PODCAST_PROVIDERS:[\s\S]*?(?:-->|$)/g, "");
	}

	function normalizeInternalPath(url: string): string {
		return url
			.replace(/^https?:\/\/(?:www\.|dev\.)?codingcat\.dev(?=\/|$)/i, "")
			.replace(/^https?:\/\/[a-z0-9-]+-codingcatdev-dev\.codingcatdev\.workers\.dev(?=\/|$)/i, "");
	}

	function renderRichAssistantContent(container: HTMLElement, rawText: string) {
		const providerMap = new Map<string, Record<string, string>>();
		const providerItems: Array<{
			title: string;
			url: string;
			listenLinks: Record<string, string>;
		}> = [];
		const trailerMatch = rawText.match(
			/<!--AJ_PODCAST_PROVIDERS:([\s\S]*?)-->/,
		);
		if (trailerMatch?.[1]) {
			try {
				const parsed = JSON.parse(trailerMatch[1]);
				if (Array.isArray(parsed)) {
					for (const item of parsed) {
						if (item?.url && item?.listenLinks) {
							const normUrl = normalizeInternalPath(item.url);
							providerMap.set(normUrl, item.listenLinks);
							providerItems.push({ ...item, url: normUrl });
						}
					}
				}
			} catch {}
		}

		let cleanedText = stripProviderTrailer(rawText)
			.replace(/http:\/\/localhost:\d+/g, "")
			.replace(/https?:\/\/(?:www\.|dev\.)?codingcat\.dev(?=\/)/gi, "")
			.replace(
				/\[\s*["']?(\/[a-zA-Z0-9_\-\/]+)["']?\s*\]\((?:http:\/\/localhost:\d+)?(\/[a-zA-Z0-9_\-\/]+)\)/g,
				"[$1]($2)",
			)
			.replace(/\[\s*["']?(\/[a-zA-Z0-9_\-\/]+)["']?\s*\]/g, "[$1]($1)");

		const ytRegex =
			/(?:https?:\/\/)?(?:www\.)?(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|live\/))([\w-]{11})/gi;
		const youtubeIds = new Set<string>();
		let ytMatch: RegExpExecArray | null;
		while ((ytMatch = ytRegex.exec(cleanedText)) !== null) {
			if (ytMatch[1]) {
				youtubeIds.add(ytMatch[1]);
			}
		}

		const internalLinkRegex =
			/\[([^\]]+)\]\(((\/(?:podcast|post)\/[a-zA-Z0-9_\-.]+))\)/gi;
		const internalLinks: Array<{
			title: string;
			url: string;
			type: "podcast" | "post";
		}> = [];
		let intMatch: RegExpExecArray | null;
		while ((intMatch = internalLinkRegex.exec(cleanedText)) !== null) {
			const linkUrl = intMatch[2];
			const linkTitle = intMatch[1];
			const type = linkUrl.startsWith("/podcast") ? "podcast" : "post";
			if (!internalLinks.some((l) => l.url === linkUrl)) {
				internalLinks.push({ title: linkTitle, url: linkUrl, type });
			}
		}

		for (const pItem of providerItems) {
			if (
				!internalLinks.some((l) => l.url === pItem.url) &&
				(internalLinks.length === 0 ||
					cleanedText
						.toLowerCase()
						.includes(pItem.title.toLowerCase().slice(0, 24)))
			) {
				internalLinks.push({
					title: pItem.title,
					url: pItem.url,
					type: "podcast",
				});
			}
		}

		let html = escapeHtml(cleanedText);
		html = html.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
		html = html.replace(
			/^[ \t]*-[ \t]+(.*)$/gm,
			"<li class='ml-4 list-disc'>$1</li>",
		);
		html = html.replace(
			/\[([^\]]+)\]\(([^)]+)\)/g,
			(_match, label, rawHref) => {
				const href = normalizeInternalPath(rawHref);
				const isInternal = href.startsWith("/");
				return isInternal
					? `<a href='${href}' class='aj-internal-nav text-primary font-medium underline underline-offset-2 hover:opacity-80'>${label}</a>`
					: `<a href='${href}' class='text-primary font-medium underline underline-offset-2 hover:opacity-80' target='_blank' rel='noopener noreferrer'>${label}</a>`;
			},
		);

		html = html.replace(
			/(https?:\/\/(?:www\.)?(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|live\/))[\w-]+[^\s<]*)/gi,
			"<a href='$1' class='text-primary font-medium hover:underline' target='_blank' rel='noopener noreferrer'>$1</a>",
		);

		html = html.replace(/\n\n/g, "<div class='h-2.5'></div>");
		html = html.replace(/\n/g, "<br />");

		let cardsHtml = "";

		if (youtubeIds.size > 0) {
			cardsHtml += `<div class="mt-3 flex flex-col gap-2">`;
			for (const ytId of youtubeIds) {
				const thumbUrl = `https://img.youtube.com/vi/${ytId}/mqdefault.jpg`;
				const ytUrl = `https://www.youtube.com/watch?v=${ytId}`;
				cardsHtml += `
					<a href="${ytUrl}" target="_blank" rel="noopener noreferrer" class="group relative flex items-center gap-3 p-2 rounded-xl border border-border bg-background/60 hover:bg-accent/60 transition-all overflow-hidden text-left no-underline">
						<div class="relative shrink-0 w-24 h-14 rounded-lg overflow-hidden bg-black/20 flex items-center justify-center">
							<img src="${thumbUrl}" alt="YouTube Preview" class="w-full h-full object-cover" loading="lazy" />
						</div>
						<div class="flex-1 min-w-0">
							<div class="text-[10px] uppercase font-bold tracking-wider text-red-500">YouTube Video</div>
							<div class="text-xs font-semibold text-foreground truncate group-hover:text-primary">Watch on YouTube</div>
						</div>
					</a>
				`;
			}
			cardsHtml += `</div>`;
		}

		if (internalLinks.length > 0) {
			cardsHtml += `<div class="mt-3 flex flex-col gap-2">`;
			for (const link of internalLinks) {
				const isPodcast = link.type === "podcast";
				const linksForEp = providerMap.get(link.url);
				let providerBadgesHtml = "";
				if (isPodcast && linksForEp) {
					const badges = PROVIDER_CONFIG.filter((p) =>
						Boolean(linksForEp[p.key]),
					)
						.map(
							(p) => `
								<a
									href="${escapeHtml(linksForEp[p.key])}"
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1 rounded-md border border-border/70 bg-background/80 px-2 py-0.5 text-[10px] font-medium text-foreground hover:bg-accent transition-colors no-underline"
								>
									<span class="${p.colorClass}">${p.svg}</span>
									<span>${p.label}</span>
								</a>
							`,
						)
						.join("");
					if (badges) {
						providerBadgesHtml = `
							<div class="mt-2 pt-2 border-t border-border/60 flex flex-wrap items-center gap-1">
								${badges}
							</div>
						`;
					}
				}

				cardsHtml += `
					<div class="flex flex-col p-2.5 rounded-xl border border-border bg-background/70 hover:border-primary/50 transition-all text-left">
						<a href="${link.url}" class="aj-internal-nav group flex items-center justify-between gap-2.5 no-underline">
							<div class="min-w-0">
								<div class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors truncate">${escapeHtml(link.title)}</div>
								<div class="text-[10px] font-mono text-muted-foreground uppercase tracking-wider">${isPodcast ? "Podcast Episode" : "Blog Post"}</div>
							</div>
							<span class="shrink-0 text-xs font-medium text-primary">Open →</span>
						</a>
						${providerBadgesHtml}
					</div>
				`;
			}
			cardsHtml += `</div>`;
		}

		container.innerHTML = html + cardsHtml;
	}

	function appendMessageElement(
		role: "user" | "assistant",
		initialText = "",
		telemetryText?: string,
	): { contentEl: HTMLElement; telemetryEl?: HTMLElement } {
		welcomeContainer?.classList.add("hidden");

		const msgDiv = document.createElement("div");
		if (role === "user") {
			msgDiv.className =
				"ml-auto max-w-[85%] rounded-lg border border-border bg-muted/80 px-3.5 py-2 text-sm text-foreground";
			const contentDiv = document.createElement("div");
			contentDiv.textContent = initialText;
			msgDiv.appendChild(contentDiv);
			messagesContainer?.appendChild(msgDiv);
			return { contentEl: contentDiv };
		}

		msgDiv.className = "flex flex-col gap-1.5 w-full text-foreground";

		const telemetryEl = document.createElement("div");
		telemetryEl.className =
			"font-mono text-[10px] text-primary/90 flex items-center gap-1.5";
		if (telemetryText) {
			telemetryEl.textContent = telemetryText;
		} else {
			telemetryEl.classList.add("hidden");
		}
		msgDiv.appendChild(telemetryEl);

		const contentDiv = document.createElement("div");
		contentDiv.className = "leading-relaxed text-sm text-foreground/95";
		contentDiv.textContent = initialText;

		msgDiv.appendChild(contentDiv);
		messagesContainer?.appendChild(msgDiv);
		messagesContainer?.scrollTo({
			top: messagesContainer.scrollHeight,
			behavior: "smooth",
		});

		return { contentEl: contentDiv, telemetryEl };
	}

	// Restore conversation history from localStorage across page navigations
	function hydrateStoredConversation() {
		storedMessages = loadStoredMessages();
		if (storedMessages.length === 0) return;

		welcomeContainer?.classList.add("hidden");
		for (const msg of storedMessages) {
			const { contentEl } = appendMessageElement(
				msg.role,
				msg.role === "user" ? msg.text : "",
				msg.telemetry,
			);
			if (msg.role === "assistant") {
				renderRichAssistantContent(contentEl, msg.text);
			}
			if (msg.telemetry && headerTelemetryPill) {
				headerTelemetryPill.textContent = msg.telemetry;
				headerTelemetryPill.classList.remove("hidden");
			}
		}
		if (messagesContainer) {
			messagesContainer.scrollTop = messagesContainer.scrollHeight;
		}
	}

	hydrateStoredConversation();

	async function submitPrompt(rawPrompt: string) {
		const prompt = rawPrompt.trim();
		if (!prompt || isStreaming) return;

		if (input) input.value = "";
		isStreaming = true;
		if (sendBtn) sendBtn.disabled = true;

		recordRecentAsk(prompt);
		storedMessages.push({
			role: "user",
			text: prompt,
			timestamp: Date.now(),
		});
		const assistantEntry: StoredMessage = {
			role: "assistant",
			text: "Thinking...",
			timestamp: Date.now(),
		};
		storedMessages.push(assistantEntry);
		saveStoredMessages();

		appendMessageElement("user", prompt);
		const { contentEl: assistantContent, telemetryEl } = appendMessageElement(
			"assistant",
			"Thinking...",
		);

		let telemetryLabel = "";

		try {
			const res = await fetch("/api/chat", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ prompt }),
			});

			const extSource = res.headers.get("x-aj-extraction-source");
			const extIntent = res.headers.get("x-aj-intent");
			const extLatency = res.headers.get("x-aj-extraction-latency-ms");
			if (extSource && extIntent) {
				telemetryLabel = `⚡ ${extSource}: ${extIntent} (${extLatency ?? "0"}ms)`;
				assistantEntry.telemetry = telemetryLabel;
				if (telemetryEl) {
					telemetryEl.textContent = telemetryLabel;
					telemetryEl.classList.remove("hidden");
				}
				if (headerTelemetryPill) {
					headerTelemetryPill.textContent = telemetryLabel;
					headerTelemetryPill.classList.remove("hidden");
				}
			}

			if (!res.ok) {
				const errorJson = (await res.json().catch(() => ({}))) as {
					error?: string;
				};
				const errText = `Error: ${errorJson.error || "Failed to generate answer"}`;
				assistantContent.textContent = errText;
				assistantEntry.text = errText;
				saveStoredMessages();
				return;
			}

			if (!res.body) {
				assistantContent.textContent = "No response stream received.";
				assistantEntry.text = "No response stream received.";
				saveStoredMessages();
				return;
			}

			let accumulatedText = "";
			const reader = res.body.getReader();
			const decoder = new TextDecoder();

			while (true) {
				const { done, value } = await reader.read();
				if (done) break;
				const chunk = decoder.decode(value, { stream: true });
				accumulatedText += chunk;
				assistantContent.textContent = stripProviderTrailer(accumulatedText);
				assistantEntry.text = accumulatedText;
				saveStoredMessages();
				messagesContainer?.scrollTo({
					top: messagesContainer.scrollHeight,
					behavior: "smooth",
				});
			}

			renderRichAssistantContent(assistantContent, accumulatedText);
			assistantEntry.text = accumulatedText;
			saveStoredMessages();
			messagesContainer?.scrollTo({
				top: messagesContainer.scrollHeight,
				behavior: "smooth",
			});
		} catch (err) {
			const errMsg = `Connection error: ${err instanceof Error ? err.message : String(err)}`;
			assistantContent.textContent = errMsg;
			assistantEntry.text = errMsg;
			saveStoredMessages();
		} finally {
			isStreaming = false;
			if (sendBtn) sendBtn.disabled = false;
			input?.focus();
		}
	}

	// Enter to send, Shift+Enter for newline
	input?.addEventListener("keydown", (e: KeyboardEvent) => {
		if (e.key === "Enter" && !e.shiftKey) {
			e.preventDefault();
			submitPrompt(input.value);
		}
	});

	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		if (input) {
			submitPrompt(input.value);
		}
	});
</script>
