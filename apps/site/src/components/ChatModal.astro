---
---

<div id="ai-chat-widget">
	<!-- Floating Trigger Button -->
	<button
		type="button"
		id="ai-chat-open-btn"
		class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 rounded-full bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground shadow-lg hover:opacity-90 transition-all hover:scale-105 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
		aria-label="Open Agent AJ"
	>
		<img src="/icon.svg" alt="" class="size-5 object-contain" width="20" height="20" />
		<span>Ask Agent AJ</span>
	</button>

	<!-- Modal Backdrop & Window -->
	<div
		id="ai-chat-modal"
		class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs transition-opacity"
		role="dialog"
		aria-modal="true"
		aria-labelledby="ai-chat-title"
	>
		<div class="relative flex flex-col w-full max-w-2xl h-[640px] max-h-[90vh] rounded-2xl border border-border bg-card shadow-2xl overflow-hidden">
			<!-- Header -->
			<header class="flex items-center justify-between border-b border-border px-5 py-3.5 bg-muted/40">
				<div class="flex items-center gap-3">
					<img
						src="/icon.svg"
						alt="Agent AJ Logo"
						class="size-8 rounded-lg object-contain bg-primary/10 p-1"
						width="32"
						height="32"
					/>
					<div>
						<h2 id="ai-chat-title" class="text-sm font-bold tracking-tight">Agent AJ</h2>
						<p class="text-[11px] text-muted-foreground">Grounded in Sanity Content Lake & Workers AI</p>
					</div>
				</div>
				<button
					type="button"
					id="ai-chat-close-btn"
					class="rounded-md p-1.5 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors cursor-pointer"
					aria-label="Close dialog"
				>
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</header>

			<!-- Messages Container -->
			<div id="ai-chat-messages" class="flex-1 overflow-y-auto p-4 sm:p-5 flex flex-col gap-4 text-sm">
				<!-- Welcome / Prompt chips -->
				<div id="ai-chat-welcome" class="flex flex-col gap-3 my-auto text-center items-center py-6">
					<img src="/icon.svg" alt="Agent AJ" class="size-14 rounded-2xl object-contain bg-primary/10 p-2 shadow-sm" width="56" height="56" />
					<h3 class="font-semibold text-base">Hi, I'm Agent AJ!</h3>
					<p class="text-xs text-muted-foreground max-w-sm">
						I query live CodingCat.dev podcasts, tutorials, and transcripts. Ask me anything or select a quick request:
					</p>
					<div class="flex flex-wrap gap-2 justify-center max-w-md pt-2">
						<button
							type="button"
							class="ai-prompt-chip inline-flex items-center gap-1.5 text-xs px-3.5 py-2 rounded-full border border-border bg-card hover:bg-accent text-foreground cursor-pointer transition-all font-medium shadow-2xs hover:scale-105"
							data-prompt="What is the latest podcast episode?"
						>
							<svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
								<path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
								<line x1="12" x2="12" y1="19" y2="22"></line>
							</svg>
							<span>Latest podcast</span>
						</button>
						<button
							type="button"
							class="ai-prompt-chip inline-flex items-center gap-1.5 text-xs px-3.5 py-2 rounded-full border border-border bg-card hover:bg-accent text-foreground cursor-pointer transition-all font-medium shadow-2xs hover:scale-105"
							data-prompt="What is the latest blog post?"
						>
							<svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
								<polyline points="14 2 14 8 20 8"></polyline>
								<line x1="16" y1="13" x2="8" y2="13"></line>
								<line x1="16" y1="17" x2="8" y2="17"></line>
							</svg>
							<span>Latest blog post</span>
						</button>
						<button
							type="button"
							class="ai-prompt-chip inline-flex items-center gap-1.5 text-xs px-3.5 py-2 rounded-full border border-border bg-card hover:bg-accent text-foreground cursor-pointer transition-all font-medium shadow-2xs hover:scale-105"
							data-prompt="What are the top videos on CodingCat.dev?"
						>
							<svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polygon points="23 7 16 12 23 17 23 7"></polygon>
								<rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
							</svg>
							<span>Top videos</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Predefined Quick Request Buttons (Sticky Bar) -->
			<div class="flex items-center gap-1.5 px-3 sm:px-4 py-2 border-t border-border/40 bg-muted/20 overflow-x-auto no-scrollbar">
				<span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider shrink-0 mr-1">Quick:</span>
				<button
					type="button"
					class="ai-prompt-chip shrink-0 inline-flex items-center gap-1.5 text-xs px-3 py-1 rounded-full border border-border bg-card hover:bg-accent text-muted-foreground hover:text-foreground cursor-pointer transition-colors font-medium shadow-2xs"
					data-prompt="What is the latest podcast episode?"
				>
					<svg class="size-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
						<path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
						<line x1="12" x2="12" y1="19" y2="22"></line>
					</svg>
					<span>Latest podcast</span>
				</button>
				<button
					type="button"
					class="ai-prompt-chip shrink-0 inline-flex items-center gap-1.5 text-xs px-3 py-1 rounded-full border border-border bg-card hover:bg-accent text-muted-foreground hover:text-foreground cursor-pointer transition-colors font-medium shadow-2xs"
					data-prompt="What is the latest blog post?"
				>
					<svg class="size-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="16" y1="13" x2="8" y2="13"></line>
						<line x1="16" y1="17" x2="8" y2="17"></line>
					</svg>
					<span>Latest blog post</span>
				</button>
				<button
					type="button"
					class="ai-prompt-chip shrink-0 inline-flex items-center gap-1.5 text-xs px-3 py-1 rounded-full border border-border bg-card hover:bg-accent text-muted-foreground hover:text-foreground cursor-pointer transition-colors font-medium shadow-2xs"
					data-prompt="What are the top videos on CodingCat.dev?"
				>
					<svg class="size-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polygon points="23 7 16 12 23 17 23 7"></polygon>
						<rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
					</svg>
					<span>Top videos</span>
				</button>
			</div>

			<!-- Input Form -->
			<form id="ai-chat-form" class="border-t border-border p-3 sm:p-4 bg-card flex items-center gap-2">
				<input
					type="text"
					id="ai-chat-input"
					placeholder="Ask Agent AJ about CodingCat.dev..."
					class="flex-1 rounded-xl border border-input bg-background px-4 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-all"
					autocomplete="off"
				/>
				<button
					type="submit"
					id="ai-chat-send-btn"
					class="rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90 disabled:opacity-50 transition-all cursor-pointer"
				>
					Send
				</button>
			</form>
		</div>
	</div>
</div>

<script>
	const openBtn = document.getElementById("ai-chat-open-btn");
	const closeBtn = document.getElementById("ai-chat-close-btn");
	const modal = document.getElementById("ai-chat-modal");
	const form = document.getElementById("ai-chat-form") as HTMLFormElement | null;
	const input = document.getElementById("ai-chat-input") as HTMLInputElement | null;
	const sendBtn = document.getElementById("ai-chat-send-btn") as HTMLButtonElement | null;
	const messagesContainer = document.getElementById("ai-chat-messages");
	const welcomeContainer = document.getElementById("ai-chat-welcome");

	let isStreaming = false;

	function openModal() {
		if (modal) {
			modal.classList.remove("hidden");
			input?.focus();
		}
	}

	function closeModal() {
		if (modal) {
			modal.classList.add("hidden");
		}
	}

	openBtn?.addEventListener("click", openModal);
	closeBtn?.addEventListener("click", closeModal);

	modal?.addEventListener("click", (e) => {
		if (e.target === modal) {
			closeModal();
		}
	});

	window.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
			closeModal();
		}
	});

	document.querySelectorAll(".ai-prompt-chip").forEach((chip) => {
		chip.addEventListener("click", () => {
			const prompt = chip.getAttribute("data-prompt");
			if (prompt && input) {
				input.value = prompt;
				form?.dispatchEvent(new Event("submit", { cancelable: true }));
			}
		});
	});

	function escapeHtml(text: string): string {
		return text
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#039;");
	}

	function renderRichAssistantContent(container: HTMLElement, rawText: string) {
		// Clean up any localhost or malformed url artifacts
		let cleanedText = rawText
			.replace(/http:\/\/localhost:\d+/g, "")
			.replace(/\[\s*["']?(\/[a-zA-Z0-9_\-\/]+)["']?\s*\]\((?:http:\/\/localhost:\d+)?(\/[a-zA-Z0-9_\-\/]+)\)/g, "[$1]($2)")
			.replace(/\[\s*["']?(\/[a-zA-Z0-9_\-\/]+)["']?\s*\]/g, "[$1]($1)");

		// Extract YouTube links
		const ytRegex = /(?:https?:\/\/)?(?:www\.)?(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|live\/))([\w-]{11})/gi;
		const youtubeIds = new Set<string>();
		let ytMatch: RegExpExecArray | null;
		while ((ytMatch = ytRegex.exec(cleanedText)) !== null) {
			if (ytMatch[1]) {
				youtubeIds.add(ytMatch[1]);
			}
		}

		// Extract Internal Episode / Post Links
		const internalLinkRegex = /\[([^\]]+)\]\(((\/(?:podcast|post)\/[a-zA-Z0-9_\-]+))\)/gi;
		const internalLinks: Array<{ title: string; url: string; type: "podcast" | "post" }> = [];
		let intMatch: RegExpExecArray | null;
		while ((intMatch = internalLinkRegex.exec(cleanedText)) !== null) {
			const linkUrl = intMatch[2];
			const linkTitle = intMatch[1];
			const type = linkUrl.startsWith("/podcast") ? "podcast" : "post";
			if (!internalLinks.some((l) => l.url === linkUrl)) {
				internalLinks.push({ title: linkTitle, url: linkUrl, type });
			}
		}

		// Convert markdown formatting to safe HTML
		let html = escapeHtml(cleanedText);

		// Bold: **text**
		html = html.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
		// Bullet list: - text
		html = html.replace(/^[ \t]*-[ \t]+(.*)$/gm, "<li class='ml-4 list-disc'>$1</li>");
		// Markdown links: [Title](url)
		html = html.replace(
			/\[([^\]]+)\]\(([^)]+)\)/g,
			"<a href='$2' class='text-primary font-medium hover:underline inline-flex items-center gap-0.5' target='_blank' rel='noopener noreferrer'>$1<svg class='size-3 inline opacity-70' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'></path><polyline points='15 3 21 3 21 9'></polyline><line x1='10' y1='14' x2='21' y2='3'></line></svg></a>",
		);

		// Naked YouTube URLs
		html = html.replace(
			/(https?:\/\/(?:www\.)?(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|live\/))[\w-]+[^\s<]*)/gi,
			"<a href='$1' class='text-primary font-medium hover:underline' target='_blank' rel='noopener noreferrer'>$1</a>",
		);

		// Newlines to <br> or <p>
		html = html.replace(/\n\n/g, "<div class='h-2'></div>");
		html = html.replace(/\n/g, "<br />");

		// Build Cards Section
		let cardsHtml = "";

		// 1. YouTube Preview Cards
		if (youtubeIds.size > 0) {
			cardsHtml += `<div class="mt-3 flex flex-col gap-2.5">`;
			for (const ytId of youtubeIds) {
				const thumbUrl = `https://img.youtube.com/vi/${ytId}/mqdefault.jpg`;
				const ytUrl = `https://www.youtube.com/watch?v=${ytId}`;
				cardsHtml += `
					<a href="${ytUrl}" target="_blank" rel="noopener noreferrer" class="group relative flex flex-col sm:flex-row items-center gap-3 p-2.5 rounded-xl border border-border bg-card/80 hover:bg-accent/60 transition-all hover:scale-[1.01] hover:shadow-md overflow-hidden text-left no-underline">
						<div class="relative shrink-0 w-full sm:w-36 h-24 sm:h-20 rounded-lg overflow-hidden bg-black/20 flex items-center justify-center">
							<img src="${thumbUrl}" alt="YouTube Preview" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" loading="lazy" />
							<div class="absolute inset-0 flex items-center justify-center bg-black/25 group-hover:bg-black/10 transition-colors">
								<div class="size-8 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
									<svg class="size-4 ml-0.5 fill-current" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
								</div>
							</div>
						</div>
						<div class="flex-1 min-w-0 py-0.5">
							<div class="inline-flex items-center gap-1.5 text-[10px] uppercase font-bold tracking-wider text-red-500 mb-0.5">
								<svg class="size-3.5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
								YouTube Video
							</div>
							<div class="text-xs font-semibold text-foreground truncate group-hover:text-primary transition-colors">Watch on YouTube</div>
							<div class="text-[11px] text-muted-foreground truncate">youtube.com/watch?v=${ytId}</div>
						</div>
					</a>
				`;
			}
			cardsHtml += `</div>`;
		}

		// 2. Clickable Episode / Post Cards
		if (internalLinks.length > 0) {
			cardsHtml += `<div class="mt-2.5 flex flex-col gap-2">`;
			for (const link of internalLinks) {
				const isPodcast = link.type === "podcast";
				cardsHtml += `
					<a href="${link.url}" class="group flex items-center justify-between gap-3 p-3 rounded-xl border border-border bg-card/90 hover:bg-accent hover:border-primary/40 transition-all hover:scale-[1.01] hover:shadow-xs text-left no-underline">
						<div class="flex items-center gap-2.5 min-w-0">
							<div class="size-8 rounded-lg ${isPodcast ? "bg-purple-500/10 text-purple-600 dark:text-purple-400" : "bg-blue-500/10 text-blue-600 dark:text-blue-400"} flex items-center justify-center shrink-0">
								${
									isPodcast
										? '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" x2="12" y1="19" y2="22"></line></svg>'
										: '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>'
								}
							</div>
							<div class="min-w-0">
								<div class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors truncate">${escapeHtml(link.title)}</div>
								<div class="text-[10px] text-muted-foreground uppercase tracking-wider">${isPodcast ? "Podcast Episode" : "Blog Post"} • CodingCat.dev</div>
							</div>
						</div>
						<div class="shrink-0 text-xs font-medium text-primary flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
							<span>View</span>
							<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
						</div>
					</a>
				`;
			}
			cardsHtml += `</div>`;
		}

		container.innerHTML = html + cardsHtml;
	}

	function appendMessage(role: "user" | "assistant", initialText = ""): HTMLElement {
		if (welcomeContainer) {
			welcomeContainer.classList.add("hidden");
		}

		const msgDiv = document.createElement("div");
		msgDiv.className = `flex flex-col gap-1 max-w-[85%] ${
			role === "user"
				? "ml-auto bg-primary text-primary-foreground rounded-2xl rounded-tr-xs px-4 py-2.5"
				: "mr-auto bg-muted/60 text-foreground rounded-2xl rounded-tl-xs px-4 py-2.5 border border-border"
		}`;

		if (role === "assistant") {
			const badge = document.createElement("div");
			badge.className = "flex items-center gap-1.5 text-[11px] font-semibold text-primary mb-0.5";
			badge.innerHTML = `<img src="/icon.svg" alt="" class="size-3.5 object-contain" width="14" height="14" /><span>Agent AJ</span>`;
			msgDiv.appendChild(badge);
		}

		const contentDiv = document.createElement("div");
		contentDiv.className = "leading-relaxed text-sm";
		contentDiv.textContent = initialText;

		msgDiv.appendChild(contentDiv);
		messagesContainer?.appendChild(msgDiv);
		messagesContainer?.scrollTo({ top: messagesContainer.scrollHeight, behavior: "smooth" });

		return contentDiv;
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!input) return;
		const prompt = input.value.trim();
		if (!prompt || isStreaming) return;

		input.value = "";
		isStreaming = true;
		if (sendBtn) sendBtn.disabled = true;

		appendMessage("user", prompt);
		const assistantContent = appendMessage("assistant", "Thinking...");

		try {
			const res = await fetch("/api/chat", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ prompt }),
			});

			if (!res.ok) {
				const errorJson = (await res.json().catch(() => ({}))) as {
					error?: string;
				};
				assistantContent.textContent = `Error: ${errorJson.error || "Failed to generate answer"}`;
				return;
			}

			if (!res.body) {
				assistantContent.textContent = "No response stream received.";
				return;
			}

			let accumulatedText = "";
			const reader = res.body.getReader();
			const decoder = new TextDecoder();

			while (true) {
				const { done, value } = await reader.read();
				if (done) break;
				const chunk = decoder.decode(value, { stream: true });
				accumulatedText += chunk;
				// Render progressive text during streaming
				assistantContent.textContent = accumulatedText;
				messagesContainer?.scrollTo({ top: messagesContainer.scrollHeight, behavior: "smooth" });
			}

			// On complete stream finish: render full rich content with cards & links
			renderRichAssistantContent(assistantContent, accumulatedText);
			messagesContainer?.scrollTo({ top: messagesContainer.scrollHeight, behavior: "smooth" });
		} catch (err) {
			assistantContent.textContent = `Connection error: ${err instanceof Error ? err.message : String(err)}`;
		} finally {
			isStreaming = false;
			if (sendBtn) sendBtn.disabled = false;
			input?.focus();
		}
	});
</script>
