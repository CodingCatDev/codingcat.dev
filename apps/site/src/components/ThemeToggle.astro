---
/**
 * Dual-theme toggle button switching between CodingCat.dev 2026
 * Chalkboard Paper Light Mode (`8d1319903d504a79ae56110486455e17`) and
 * Obsidian Chalkboard Dark Mode (`b9e00f99c0d34e9884bf7766a014577b`).
 */
---

<button
	type="button"
	id="theme-toggle"
	class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full border-2 border-[#2A1155] bg-[#FAF9FC] text-[#2A1155] transition-colors hover:bg-[#EDE9FE] dark:border-white/20 dark:bg-[#0B1326] dark:text-[#C084FC] dark:hover:border-[#C084FC] shadow-sketch-sm"
	aria-label="Toggle Light and Dark Chalkboard theme"
	title="Toggle Light / Dark Mode"
>
	<svg
		class="size-4 dark:hidden"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
	<svg
		class="hidden size-4 dark:block"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
	</svg>
</button>

<script>
	const button = document.getElementById("theme-toggle");
	button?.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		document.documentElement.style.colorScheme = dark ? "dark" : "light";
		try {
			localStorage.setItem("theme", dark ? "dark" : "light");
		} catch {
			// Private mode fallback.
		}
	});
</script>
