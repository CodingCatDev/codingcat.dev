---
import { stegaClean } from "@sanity/client/stega";
import { SITE_NAME } from "@/lib/site";

/**
 * Every value here lands in a `content` attribute, so all of it is
 * stegaClean'd. Zero-width characters are invisible in a rendered page and
 * corrupting in an OG scrape or a canonical URL.
 */
interface Props {
	title: string;
	ogTitle?: string | null;
	description?: string | null;
	ogDescription?: string | null;
	image?: { url: string; alt?: string; width?: number; height?: number } | null;
	type?: "website" | "article";
	twitterCard?: string | null;
	publishedAt?: string | null;
	modifiedAt?: string | null;
	authors?: Array<string | null | undefined>;
	canonical?: string | URL;
	noindex?: boolean;
}

const {
	title,
	ogTitle,
	description,
	ogDescription,
	image,
	type = "website",
	twitterCard,
	publishedAt,
	modifiedAt,
	authors = [],
	canonical = Astro.url,
	noindex = false,
} = Astro.props;

function cleanMetaText(value: string | null | undefined): string | undefined {
	const cleaned = stegaClean(value)?.trim();
	if (!cleaned || cleaned.toLowerCase() === "fix me") {
		return undefined;
	}
	return cleaned;
}

// Per-request, not `Astro.site`: the origin differs between the dev and
// production Workers but the build is shared.
const site = Astro.locals.siteUrl;
const canonicalUrl = new URL(
	stegaClean(typeof canonical === "string" ? canonical : canonical.pathname),
	site,
).href;

const cleanTitle = cleanMetaText(title) ?? SITE_NAME;
const cleanOgTitle = cleanMetaText(ogTitle) ?? cleanTitle;
const cleanDescription = cleanMetaText(description);
const cleanOgDescription = cleanMetaText(ogDescription) ?? cleanDescription;
const imageUrl = image?.url ? new URL(stegaClean(image.url), site).href : undefined;
const imageAlt = cleanMetaText(image?.alt) ?? cleanOgTitle;
const cardType =
	cleanMetaText(twitterCard) === "summary"
		? "summary"
		: imageUrl
			? "summary_large_image"
			: "summary";
---

<title>{cleanTitle}</title>
{cleanDescription && <meta name="description" content={cleanDescription} />}
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={cleanOgTitle} />
{cleanOgDescription && <meta property="og:description" content={cleanOgDescription} />}
<meta property="og:url" content={canonicalUrl} />
{
	imageUrl && (
		<>
			<meta property="og:image" content={imageUrl} />
			{image?.width && <meta property="og:image:width" content={String(image.width)} />}
			{image?.height && <meta property="og:image:height" content={String(image.height)} />}
			{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		</>
	)
}

<meta name="twitter:card" content={cardType} />
<meta name="twitter:site" content="@CodingCatDev" />
<meta name="twitter:title" content={cleanOgTitle} />
{cleanOgDescription && <meta name="twitter:description" content={cleanOgDescription} />}
{
	imageUrl && (
		<>
			<meta name="twitter:image" content={imageUrl} />
			{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
		</>
	)
}

{
	type === "article" && (
		<>
			{publishedAt && (
				<meta property="article:published_time" content={stegaClean(publishedAt)} />
			)}
			{modifiedAt && (
				<meta property="article:modified_time" content={stegaClean(modifiedAt)} />
			)}
			{authors
				.filter((name): name is string => Boolean(name))
				.map((name) => (
					<meta property="article:author" content={stegaClean(name)} />
				))}
		</>
	)
}
