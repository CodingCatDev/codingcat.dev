---
import { PortableText } from "astro-portabletext";
import type { TypedObject } from "astro-portabletext/types";
import PtCode from "./PtCode.astro";
import PtCodePen from "./PtCodePen.astro";
import PtCodeSandbox from "./PtCodeSandbox.astro";
import PtHeading5 from "./PtHeading5.astro";
import PtHeading6 from "./PtHeading6.astro";
import PtHtml from "./PtHtml.astro";
import PtImage from "./PtImage.astro";
import PtInternalLink from "./PtInternalLink.astro";
import PtLink from "./PtLink.astro";
import PtQuote from "./PtQuote.astro";
import PtSocialEmbed from "./PtSocialEmbed.astro";
import PtTable from "./PtTable.astro";
import PtTweet from "./PtTweet.astro";
import PtYouTube from "./PtYouTube.astro";
import PtYouTubeShorts from "./PtYouTubeShorts.astro";

interface Props {
	/**
	 * Sanity TypeGen emits `children?:` as optional on blocks, while
	 * `PortableTextBlock` requires it, so the generated content types are not
	 * assignable to it. `TypedObject` is the library's own minimum contract
	 * (`{_type: string}`), which the generated types do satisfy, and it is what
	 * PortableText actually needs to dispatch on.
	 */
	value?: TypedObject[] | null;
	class?: string;
}

const { value, class: className } = Astro.props;

/**
	* astro-portabletext uses SINGULAR keys (`type`, `block`, `mark`) where
	* @portabletext/react uses `types` / `marks`.
	*/
const components = {
	type: {
		image: PtImage,
		code: PtCode,
		codepen: PtCodePen,
		codesandbox: PtCodeSandbox,
		youtube: PtYouTube,
		youtubeShorts: PtYouTubeShorts,
		twitter: PtTweet,
		socialEmbed: PtSocialEmbed,
		bluesky: PtSocialEmbed,
		linkedin: PtSocialEmbed,
		reddit: PtSocialEmbed,
		tiktok: PtSocialEmbed,
		instagram: PtSocialEmbed,
		threads: PtSocialEmbed,
		mastodon: PtSocialEmbed,
		githubGist: PtSocialEmbed,
		htmlBlock: PtHtml,
		quote: PtQuote,
		table: PtTable,
	},
	block: {
		h5: PtHeading5,
		h6: PtHeading6,
	},
	mark: {
		link: PtLink,
		internalLink: PtInternalLink,
	},
};
---

{
	value && value.length > 0 && (
		<div class:list={["prose dark:prose-invert max-w-4xl", className]}>
			<PortableText value={value} components={components} />
		</div>
	)
}

{/* One delegated listener per page rather than one island per block. */}
<script>
	const embedWidgets: Array<{ selector: string; src: string }> = [
		{ selector: ".twitter-tweet", src: "https://platform.twitter.com/widgets.js" },
		{ selector: ".bluesky-embed", src: "https://embed.bsky.app/static/embed.js" },
		{ selector: ".reddit-embed-bq", src: "https://embed.reddit.com/widgets.js" },
		{ selector: ".tiktok-embed", src: "https://www.tiktok.com/embed.js" },
		{ selector: ".instagram-media", src: "https://www.instagram.com/embed.js" },
		{ selector: ".text-post-media", src: "https://www.threads.net/embed.js" },
	];

	for (const { selector, src } of embedWidgets) {
		if (document.querySelector(selector)) {
			const script = document.createElement("script");
			script.src = src;
			script.async = true;
			document.head.appendChild(script);
		}
	}

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) {
			return;
		}

		const copy = target.closest<HTMLElement>("button.copy-code");
		if (copy) {
			const code = copy.dataset.code ?? "";
			navigator.clipboard?.writeText(code).then(() => {
				copy.classList.add("copied");
				setTimeout(() => copy.classList.remove("copied"), 1500);
			});
			return;
		}

		// Click-to-load keeps YouTube's player (and its cookies) off the page
		// until a visitor actually asks for it.
		const play = target.closest("button");
		const embed = play?.closest<HTMLElement>(".yt-embed");
		if (!play || !embed) {
			return;
		}
		const id = embed.dataset.yt;
		if (!id) {
			return;
		}
		const iframe = document.createElement("iframe");
		iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&fs=0`;
		iframe.allow =
			"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
		iframe.allowFullscreen = true;
		iframe.title = "YouTube video player";
		iframe.className = "absolute inset-0 size-full border-0";
		embed.replaceChildren(iframe);
	});
</script>
