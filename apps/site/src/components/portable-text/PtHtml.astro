---
import type { Props as PtProps } from "astro-portabletext/types";

type HtmlNode = { _type: "htmlBlock"; html?: string };

type Props = PtProps<HtmlNode>;

const { node } = Astro.props;
/*
 * Author-written HTML block from Sanity Studio.
 * It is trusted because only authenticated Studio users can write it.
 *
 * Strip zero-width Stega watermark characters (when previewing drafts) so inline
 * <script>, <style>, and <svg> blocks execute cleanly without syntax errors,
 * while preserving 100% of visible author markup.
 */
const STEGA_REGEX = /[\u200B-\u200F\u202A-\u202E\u2060-\u206F\uFEFF]|\uDB40[\uDC20-\uDC7F]/g;
const html = typeof node.html === "string" ? node.html.replace(STEGA_REGEX, "") : undefined;
---

{html && <div class="not-prose my-6" set:html={html} />}
