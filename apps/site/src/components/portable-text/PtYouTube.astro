---
import { stegaClean } from "@sanity/client/stega";
import type { SanityImageSource } from "@sanity/image-url";
import type { Props as PtProps } from "astro-portabletext/types";
import { youtubeId } from "@/lib/youtube";

type YouTubeNode = { _type: "youtube"; youtube?: string; url?: string };

type Props = PtProps<YouTubeNode> & {
	coverImage?: (SanityImageSource & { alt?: string }) | null;
	priority?: boolean;
};

const { node, coverImage, priority = false } = Astro.props;
const rawYoutubeUrl = stegaClean(node.youtube ?? node.url) ?? "";
const id = youtubeId(rawYoutubeUrl);
const customListMatch = rawYoutubeUrl.match(/[?&]list=([A-Za-z0-9_-]+)/);
const playlistId = customListMatch?.[1] || "UUnKZ8gEb78zXKMi1ns-IQ2g";

const builder = Astro.locals.sanity.urlForImage(coverImage ?? undefined);
const sanitySrc = builder?.width(1920).height(1080).quality(82).url();
const sanitySrcset = builder
	? [480, 640, 960, 1280, 1600, 1920]
			.map((w) => {
				const h = Math.round((w * 9) / 16);
				return `${builder.width(w).height(h).quality(82).url()} ${w}w`;
			})
			.join(", ")
	: undefined;
const rawAlt = stegaClean((coverImage as { alt?: string } | null)?.alt);
const alt = rawAlt && rawAlt.trim().length > 0 ? rawAlt : "";
---

{
	id && (
		<div class="not-prose my-6">
			<div class="yt-embed relative aspect-video isolate overflow-hidden rounded-md" data-yt={id}>
				{sanitySrc ? (
					<img
						class="size-full object-cover"
						src={sanitySrc}
						srcset={sanitySrcset}
						sizes="(max-width: 1280px) 100vw, 1280px"
						alt={alt}
						width={1920}
						height={1080}
						loading={priority ? "eager" : "lazy"}
						fetchpriority={priority ? "high" : "auto"}
						decoding={priority ? "sync" : "async"}
					/>
				) : (
					<picture>
						<source
							type="image/webp"
							sizes="(max-width: 1280px) 100vw, 1280px"
							srcset={[
								`https://i.ytimg.com/vi_webp/${id}/mqdefault.webp 320w`,
								`https://i.ytimg.com/vi_webp/${id}/hqdefault.webp 480w`,
								`https://i.ytimg.com/vi_webp/${id}/sddefault.webp 640w`,
								`https://i.ytimg.com/vi_webp/${id}/maxresdefault.webp 1280w`,
							].join(", ")}
						/>
						<img
							class="size-full object-cover"
							src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`}
							alt=""
							width={1280}
							height={720}
							loading={priority ? "eager" : "lazy"}
							fetchpriority={priority ? "high" : "auto"}
							decoding={priority ? "sync" : "async"}
						/>
					</picture>
				)}
				<button
					type="button"
					class="absolute inset-0 grid size-full place-items-center border-0 bg-transparent"
					aria-label="Play video"
				>
					<svg viewBox="0 0 68 48" height="48" width="68" aria-hidden="true">
						<path
							d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z"
							fill="#f00"
						/>
						<path d="M 45,24 27,14 27,34" fill="#fff" />
					</svg>
				</button>
			</div>

			{/* High-Conversion CodingCat.dev YouTube Subscribe & Continuous Playlist Action Bar */}
			<div class="mt-3 flex flex-wrap items-center justify-between gap-3 rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] px-4 py-3 shadow-sketch-sm dark:border-white/25 dark:bg-[#131B2E]">
				<div class="flex flex-wrap items-center gap-3">
					<a
						href="https://www.youtube.com/@codingcatdev?sub_confirmation=1"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-2.5 group"
					>
						<span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-[#2A1155] bg-[#FF0000] text-white shadow-sketch-sm dark:border-white/60">
							<svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
							</svg>
						</span>
						<span class="flex flex-col">
							<span class="font-display text-sm font-black leading-tight text-[#2A1155] group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
								@CodingCatDev
							</span>
							<span class="font-mono text-[11px] font-bold text-[#2A1155]/75 dark:text-slate-300">
								62.5K / 100K Subscribers Goal
							</span>
						</span>
					</a>

					<a
						href="https://www.youtube.com/@codingcatdev?sub_confirmation=1"
						target="_blank"
						rel="noopener noreferrer"
						class="tactile-btn inline-flex items-center gap-1.5 rounded-xl border-2 border-[#2A1155] bg-[#FF0000] px-3.5 py-1.5 font-display text-xs font-black text-white shadow-sketch-sm transition hover:bg-[#DC2626] dark:border-white/70"
					>
						<span>Subscribe on YouTube</span>
						<span>→</span>
					</a>
				</div>

				<div class="flex flex-wrap items-center gap-2">
					<a
						href={`https://www.youtube.com/watch?v=${id}&list=${playlistId}`}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-xl border-2 border-[#2A1155] bg-white px-3.5 py-1.5 font-mono text-xs font-extrabold text-[#2A1155] shadow-sketch-sm transition hover:border-[#7C3AED] hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#0B1326] dark:text-white dark:hover:border-[#C084FC] dark:hover:bg-purple-950/60"
					>
						<span>Watch on YouTube App ↗</span>
					</a>
				</div>
			</div>
		</div>
	)
}

<script>
	if (!(window as unknown as { __ccYtEmbedInit?: boolean }).__ccYtEmbedInit) {
		(window as unknown as { __ccYtEmbedInit?: boolean }).__ccYtEmbedInit = true;
		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) {
				return;
			}
			const play = target.closest("button");
			const embed = play?.closest<HTMLElement>(".yt-embed");
			if (!play || !embed || embed.querySelector("iframe")) {
				return;
			}
			const id = embed.dataset.yt;
			if (!id) {
				return;
			}
			const iframe = document.createElement("iframe");
			iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&fs=0`;
			iframe.allow =
				"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
			iframe.allowFullscreen = true;
			iframe.title = "YouTube video player";
			iframe.className = "absolute inset-0 size-full border-0";
			embed.replaceChildren(iframe);
		});
	}
</script>
