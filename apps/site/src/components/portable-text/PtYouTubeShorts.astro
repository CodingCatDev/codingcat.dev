---
import { stegaClean } from "@sanity/client/stega";
import type { Props as PtProps } from "astro-portabletext/types";
import { youtubeId } from "@/lib/youtube";

type ShortsNode = { _type: "youtubeShorts"; shorts?: string[] };

type Props = PtProps<ShortsNode>;

const { node } = Astro.props;

/**
 * The Next version was an embla-carousel island (plus Radix card wrappers) for
 * what is a horizontal list. A scroll-snap row is the same interaction —
 * swipe on touch, drag or shift-scroll on desktop — with no JavaScript.
 */
const ids = (node.shorts ?? [])
	.map((url) => youtubeId(stegaClean(url)))
	.filter((id): id is string => Boolean(id));
---

{
	ids.length > 0 && (
		<div class="not-prose my-6">
			<ul
				class:list={[
					"flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2",
					ids.length === 1 && "justify-center",
				]}
			>
				{ids.map((id) => (
					<li class="w-full max-w-xs shrink-0 snap-center">
						<div class="yt-embed relative isolate aspect-[9/16] overflow-hidden rounded-md" data-yt={id}>
							<img
								class="size-full object-cover"
								src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
								alt=""
								width={480}
								height={360}
								loading="lazy"
								decoding="async"
							/>
							<button
								type="button"
								class="absolute inset-0 grid size-full place-items-center border-0 bg-transparent"
								aria-label="Play short"
							>
								<svg viewBox="0 0 68 48" height="48" width="68" aria-hidden="true">
									<path
										d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z"
										fill="#f00"
									/>
									<path d="M 45,24 27,14 27,34" fill="#fff" />
								</svg>
							</button>
						</div>
					</li>
				))}
			</ul>
		</div>
	)
}
