---
import { stegaClean } from "@sanity/client/stega";

interface Props {
	title: string;
	href?: string;
	linkText?: string;
	showHr?: boolean;
}

const { title, href, linkText = "View All", showHr = true } = Astro.props;
---

{
	showHr && (
		<hr class="mb-8 mt-10 border-t-2 border-dashed border-[#2A1155]/20 dark:border-white/15 sm:mb-12 sm:mt-16" />
	)
}

<div class="mb-8 flex flex-col gap-4 sm:mb-12 md:flex-row md:items-center md:justify-between">
	<h2 class="font-display text-4xl font-black leading-tight tracking-tight text-[#2A1155] dark:text-white md:text-5xl">
		{title}<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
	</h2>
	{
		href && (
			<a
				href={stegaClean(href)}
				class="tactile-btn inline-flex items-center justify-center px-6 py-2.5 text-sm"
			>
				<span>{linkText}</span>
				<span class="text-[#86EFAC]">&rarr;</span>
			</a>
		)
	}
</div>
