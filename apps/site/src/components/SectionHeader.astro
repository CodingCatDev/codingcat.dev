---
import { stegaClean } from "@sanity/client/stega";

interface Props {
	title: string;
	href?: string;
	linkText?: string;
	showHr?: boolean;
}

const { title, href, linkText = "View More", showHr = true } = Astro.props;
---

{showHr && <hr class="mb-8 sm:mb-16 mt-8 sm:mt-24 border-border" />}

<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 sm:mb-16 gap-4">
	<h2 class="text-5xl font-bold leading-tight tracking-tighter md:text-6xl">
		{title}
	</h2>
	{
		href && (
			<a
				href={stegaClean(href)}
				class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-xl font-bold text-primary-foreground hover:bg-primary/90 transition-colors md:text-2xl"
			>
				{linkText}
			</a>
		)
	}
</div>
