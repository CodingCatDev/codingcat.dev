			</div>

			{/* Unified 1-Row Quick Tag Pills + Popover + Status Bar */}
			<div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-dashed border-[#2A1155]/15 pt-3 font-mono text-xs font-bold text-[#2A1155]/80 dark:border-white/15 dark:text-slate-300">
				<div class="flex flex-wrap items-center gap-2">
					<TopicFilterStrip
						basePath="/courses"
						allLabel="All Tags"
						activeSlug={initialTopicDef ? initialTopicDef.slug : ""}
						variant="inline"
					/>
					<span data-courses-count-label class="ml-1">
						Showing {initialVisibleCount} of {enrichedCourses.length} courses ({totalLessonsCount} video lessons)
					</span>
					<span
						data-courses-active-topic-badge
						class:list={[
							"inline-flex items-center gap-1.5 rounded-full border border-[#2A1155] bg-[#EDE9FE] px-2.5 py-0.5 font-mono text-[11px] font-extrabold text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/70 dark:text-purple-200",
							!initialTopicDef && "hidden",
						]}
					>
						<span data-courses-active-topic-text>
							{initialTopicDef ? `Tag: ${initialTopicDef.title}` : ""}
						</span>
					</span>
				</div>

				<div class="flex items-center gap-3">
					<button
						type="button"
						data-courses-clear-filters
						class:list={[
							"font-mono text-xs font-extrabold text-[#7C3AED] hover:underline dark:text-[#C084FC] cursor-pointer",
							!initialTopicDef &&
								initialTrackParam === "all" &&
								!initialQueryParam &&
								"hidden",
						]}
					>
						Clear Filters ✕
					</button>
					<a
						href={initialTopicDef ? `/topic/${initialTopicDef.slug}` : "/topics"}
						data-courses-hub-link
						class:list={[
							"font-display text-xs font-black text-[#7C3AED] hover:underline dark:text-[#C084FC]",
							!initialTopicDef && "hidden",
						]}
					>
						Open Topic Hub &rarr;
					</a>
				</div>
			</div>
		</div>

		{/* Track-Grouped 2-Column Responsive Courses Grid */}
		<div class="mx-auto mt-12 max-w-5xl space-y-14" data-courses-list>
			{
				COURSE_TRACK_SECTIONS.map((trackSection) => {
					const trackCourses = enrichedCourses.filter(
						(entry) => entry.meta.track === trackSection.id,
					);
					const visibleTrackCourses = trackCourses.filter(
						(entry) => entry.initiallyVisible,
					);

					return (
						<section
							data-course-track-section={trackSection.id}
							class:list={[
								"space-y-6",
								visibleTrackCourses.length === 0 && "hidden",
							]}
						>
							<div class="flex flex-wrap items-end justify-between gap-3 border-b-2 border-dashed border-[#2A1155]/15 pb-3 dark:border-white/15">
								<div class="min-w-0">
									<span class="inline-flex items-center gap-1.5 rounded-full border border-[#2A1155] bg-[#EDE9FE] px-3 py-0.5 font-mono text-[11px] font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/80 dark:text-purple-200">
										{trackSection.badge}
									</span>
									<h2 class="mt-1.5 font-display text-2xl font-black text-[#2A1155] dark:text-white sm:text-3xl">
										{trackSection.title}
										<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
									</h2>
									<p class="mt-1 max-w-3xl text-sm font-medium text-[#2A1155]/75 dark:text-slate-300">
										{trackSection.subtitle}
									</p>
								</div>
								<span
									data-track-section-count
									class="shrink-0 font-mono text-xs font-bold text-[#2A1155]/65 dark:text-slate-400"
								>
									{visibleTrackCourses.length}{" "}
									{visibleTrackCourses.length === 1 ? "course" : "courses"}
								</span>
							</div>

							<div class="grid grid-cols-1 min-w-0 gap-6 md:grid-cols-2">
								{trackCourses.map((entry) => {
									const {
										course,
										meta,
										combinedTags,
										topicSlugs,
										searchHaystack,
										initiallyVisible,
									} = entry;
									const href = `/course/${course.slug}`;

									return (
										<article
											data-course-row
											data-course-track={meta.track}
											data-course-topics={topicSlugs.join(",")}
											data-course-lessons={String(course.lessonsCount || 0)}
											data-course-haystack={searchHaystack}
											class:list={[
												"duo-card hand-border group flex min-w-0 max-w-full flex-col justify-between overflow-hidden p-5 sm:p-6 transition-all duration-200 hover:-translate-y-1.5 hover:border-[#7C3AED] dark:hover:border-[#C084FC]",
												!initiallyVisible && "hidden",
											]}
										>
											<div class="min-w-0">
												<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
													<span
														class="rounded-full border border-[#2A1155] px-3 py-1 font-mono text-[11px] font-black uppercase tracking-wider"
														style={`background-color: ${meta.color}; color: ${meta.textColor};`}
													>
														{meta.tier}
													</span>
													<span class="font-hand text-lg font-bold text-[#7C3AED] dark:text-[#C084FC]">
														{meta.badge}
													</span>
												</div>

												{course.coverImage && (
													<a
														href={href}
														class="mb-4 block overflow-hidden rounded-2xl border-2 border-[#2A1155] bg-[#2A1155] dark:border-white/20 dark:bg-[#060E20]"
													>
														<CoverImage
															image={course.coverImage}
															fallbackAlt={course.title}
															width={640}
															height={360}
														/>
													</a>
												)}

												{/* Logo Tag Pills (up to 4 + overflow indicator) */}
												<div class="mb-3 flex flex-wrap items-center gap-1.5">
													<TagPills
														title={course.title}
														excerpt={course.excerpt}
														tags={combinedTags}
														maxCount={4}
														size="sm"
														overflowHref={href}
														inPageFilter={true}
													/>
												</div>

												<h3 class="font-display text-2xl font-black text-[#2A1155] transition-colors group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
													<a href={href} class="hover:underline">
														{course.title}
													</a>
												</h3>
												{course.excerpt && (
													<p class="mt-2 text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300 line-clamp-3">
														{course.excerpt}
													</p>
												)}
											</div>

											<div class="mt-5 flex items-center justify-between border-t-2 border-dashed border-[#2A1155]/15 pt-3.5 dark:border-white/15">
												<span class="font-mono text-xs font-bold text-[#4C1D95] dark:text-purple-200">
													{course.lessonsCount
														? `${course.lessonsCount} Lessons`
														: "Course Lessons"}
												</span>
												<a href={href} class="tactile-btn px-4 py-1.5 text-xs">
													<span>Start Course</span>
													<span class="text-[#86EFAC]">→</span>
												</a>
											</div>
										</article>
									);
								})}
							</div>
						</section>
					);
				})
			}

			{/* Empty Filter State */}
			<div
				data-courses-empty
				class:list={[
					"duo-card hand-border my-12 p-10 text-center",
					initialVisibleCount > 0 && "hidden",
				]}
			>
				<p class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
					No matching courses found for this filter.
				</p>
				<p class="font-hand mt-2 text-xl font-bold text-[#4C1D95] dark:text-purple-200">
					Try clearing the tag, track, or search filter above to view all {enrichedCourses.length} courses.
				</p>
			</div>
		</div>
	</section>

	<script is:inline>
		(function () {
			function initCoursesFilter() {
				var root = document.getElementById("courses-page-root");
				if (!root || root.dataset.bound === "true") return;
				root.dataset.bound = "true";

				var rows = Array.from(root.querySelectorAll("[data-course-row]"));
				var trackSections = Array.from(
					root.querySelectorAll("[data-course-track-section]"),
				);
				var trackBtns = Array.from(
					root.querySelectorAll("[data-course-track-tab]"),
				);
				var searchInput = root.querySelector("[data-courses-search-input]");
				var countLabel = root.querySelector("[data-courses-count-label]");
				var topicBadge = root.querySelector("[data-courses-active-topic-badge]");
				var topicText = root.querySelector("[data-courses-active-topic-text]");
				var clearBtn = root.querySelector("[data-courses-clear-filters]");
				var hubLink = root.querySelector("[data-courses-hub-link]");
				var emptyBox = root.querySelector("[data-courses-empty]");
				var filterStrip = root.querySelector(
					'[data-topic-filter-strip="in-page"]',
				);
				var stripPills = filterStrip
					? Array.from(filterStrip.querySelectorAll("[data-topic-pill]"))
					: [];

				var activeTopic = root.dataset.initialTopic || "";
				var activeTopicTitle = "";
				var activeTrack = root.dataset.initialTrack || "all";
				var activeQuery = root.dataset.initialQuery || "";

				if (activeTopic && stripPills.length > 0) {
					var initPill = stripPills.find(function (p) {
						return (p.dataset.topicPill || "") === activeTopic;
					});
					if (initPill) {
						activeTopicTitle = initPill.dataset.topicTitle || activeTopic;
					}
				}

				function syncUrl(push) {
					var url = new URL(window.location.href);
					if (activeTopic) {
						url.searchParams.set("topic", activeTopic);
					} else {
						url.searchParams.delete("topic");
					}
					if (activeTrack && activeTrack !== "all") {
						url.searchParams.set("track", activeTrack);
					} else {
						url.searchParams.delete("track");
					}
					if (activeQuery.trim()) {
						url.searchParams.set("q", activeQuery.trim());
					} else {
						url.searchParams.delete("q");
					}
					var state = {
						topic: activeTopic,
						track: activeTrack,
						q: activeQuery,
					};
					if (push) {
						window.history.pushState(state, "", url.toString());
					} else {
						window.history.replaceState(state, "", url.toString());
					}
				}

				function syncStripPills() {
					for (var i = 0; i < stripPills.length; i++) {
						var pill = stripPills[i];
						var slug = pill.dataset.topicPill || "";
						var isActive = slug === activeTopic;
						pill.setAttribute("aria-current", isActive ? "true" : "false");
						if (isActive) {
							pill.classList.add(
								"bg-[#7C3AED]",
								"text-white",
								"dark:border-white/50",
							);
							pill.classList.remove(
								"bg-white",
								"text-[#2A1155]",
								"hover:bg-[#EDE9FE]",
								"hover:text-[#7C3AED]",
								"dark:border-white/25",
								"dark:bg-[#131B2E]",
								"dark:text-slate-100",
							);
							pill.classList.remove("hidden");
						} else {
							pill.classList.remove(
								"bg-[#7C3AED]",
								"text-white",
								"dark:border-white/50",
							);
							pill.classList.add(
								"bg-white",
								"text-[#2A1155]",
								"hover:bg-[#EDE9FE]",
								"hover:text-[#7C3AED]",
								"dark:border-white/25",
								"dark:bg-[#131B2E]",
								"dark:text-slate-100",
							);
						}
					}
				}

				function syncTrackTabs() {
					for (var i = 0; i < trackBtns.length; i++) {
						var btn = trackBtns[i];
						var t = btn.dataset.courseTrackTab || "all";
						var isActive = t === activeTrack;
						btn.setAttribute("aria-selected", isActive ? "true" : "false");
						if (isActive) {
							btn.classList.add(
								"bg-[#7C3AED]",
								"text-white",
								"dark:border-white/50",
							);
							btn.classList.remove(
								"bg-white",
								"text-[#2A1155]",
								"hover:bg-[#EDE9FE]",
								"hover:text-[#7C3AED]",
								"dark:border-white/25",
								"dark:bg-[#131B2E]",
								"dark:text-slate-100",
							);
						} else {
							btn.classList.remove(
								"bg-[#7C3AED]",
								"text-white",
								"dark:border-white/50",
							);
							btn.classList.add(
								"bg-white",
								"text-[#2A1155]",
								"hover:bg-[#EDE9FE]",
								"hover:text-[#7C3AED]",
								"dark:border-white/25",
								"dark:bg-[#131B2E]",
								"dark:text-slate-100",
							);
						}
					}
				}

				function applyFilters() {
					var q = activeQuery.trim().toLowerCase();
					var visibleIndex = 0;
					var visibleLessons = 0;

					for (var i = 0; i < rows.length; i++) {
						var row = rows[i];
						var rowTrack = row.dataset.courseTrack || "flagship";
						var rowTopics = (row.dataset.courseTopics || "").split(",");
						var rowHay = row.dataset.courseHaystack || "";
						var rowLessons = Number.parseInt(
							row.dataset.courseLessons || "0",
							10,
						);

						var okTrack = activeTrack === "all" || rowTrack === activeTrack;
						var okTopic =
							!activeTopic || rowTopics.indexOf(activeTopic) !== -1;
						var okQuery = !q || rowHay.indexOf(q) !== -1;

						var show = okTrack && okTopic && okQuery;
						row.classList.toggle("hidden", !show);

						if (show) {
							visibleIndex++;
							visibleLessons += rowLessons;
						}
					}

					for (var s = 0; s < trackSections.length; s++) {
						var sec = trackSections[s];
						var secRows = Array.from(sec.querySelectorAll("[data-course-row]"));
						var secVisible = secRows.filter(function (r) {
							return !r.classList.contains("hidden");
						}).length;
						sec.classList.toggle("hidden", secVisible === 0);
						var secCountEl = sec.querySelector("[data-track-section-count]");
						if (secCountEl) {
							secCountEl.textContent =
								secVisible + " " + (secVisible === 1 ? "course" : "courses");
						}
					}

					if (countLabel) {
						countLabel.textContent =
							"Showing " +
							visibleIndex +
							" of " +
							rows.length +
							" courses (" +
							visibleLessons +
							" video lessons)";
					}

					if (topicBadge && topicText) {
						if (activeTopic) {
							topicText.textContent =
								"Tag: " + (activeTopicTitle || activeTopic);
							topicBadge.classList.remove("hidden");
						} else {
							topicBadge.classList.add("hidden");
						}
					}

					if (hubLink) {
						if (activeTopic) {
							hubLink.href = "/topic/" + activeTopic;
							hubLink.classList.remove("hidden");
						} else {
							hubLink.classList.add("hidden");
						}
					}

					if (clearBtn) {
						var hasAnyFilter =
							Boolean(activeTopic) ||
							activeTrack !== "all" ||
							Boolean(q);
						clearBtn.classList.toggle("hidden", !hasAnyFilter);
					}

					if (emptyBox) {
						emptyBox.classList.toggle("hidden", visibleIndex > 0);
					}
				}

				// 1. Bind Track Tabs
				for (var t = 0; t < trackBtns.length; t++) {
					(function (btn) {
						btn.addEventListener("click", function () {
							activeTrack = btn.dataset.courseTrackTab || "all";
							syncTrackTabs();
							applyFilters();
							syncUrl(true);
						});
					})(trackBtns[t]);
				}

				// 2. Bind TopicFilterStrip pills
				for (var p = 0; p < stripPills.length; p++) {
					(function (pill) {
						pill.addEventListener("click", function (ev) {
							ev.preventDefault();
							var slug = pill.dataset.topicPill || "";
							var title = pill.dataset.topicTitle || slug;
							activeTopic = slug;
							activeTopicTitle = title;
							syncStripPills();
							applyFilters();
							syncUrl(true);
						});
					})(stripPills[p]);
				}

				// 3. Bind delegated click on course card TagPills
				root.addEventListener("click", function (ev) {
					var target = ev.target;
					if (!(target instanceof Element)) return;
					var tagEl = target.closest("[data-tag-pill]");
					if (!tagEl) return;
					var slug = tagEl.getAttribute("data-tag-pill") || "";
					var title = tagEl.getAttribute("data-tag-title") || slug;
					if (!slug) return;
					ev.preventDefault();
					activeTopic = slug;
					activeTopicTitle = title;
					syncStripPills();
					applyFilters();
					syncUrl(true);
				});

				// 4. Bind Search Input
				if (searchInput) {
					searchInput.addEventListener("input", function () {
						activeQuery = searchInput.value || "";
						applyFilters();
						syncUrl(false);
					});
				}

				// 5. Bind Clear Filters button
				if (clearBtn) {
					clearBtn.addEventListener("click", function () {
						activeTopic = "";
						activeTopicTitle = "";
						activeTrack = "all";
						activeQuery = "";
						if (searchInput) searchInput.value = "";
						syncStripPills();
						syncTrackTabs();
						applyFilters();
						syncUrl(true);
					});
				}

				// 6. Handle browser Back/Forward navigation
				window.addEventListener("popstate", function () {
					var url = new URL(window.location.href);
					activeTopic = url.searchParams.get("topic") || "";
					activeTrack = url.searchParams.get("track") || "all";
					activeQuery = url.searchParams.get("q") || "";
					if (searchInput) searchInput.value = activeQuery;
					var matchPill = stripPills.find(function (p) {
						return (p.dataset.topicPill || "") === activeTopic;
					});
					activeTopicTitle =
						(matchPill && matchPill.dataset.topicTitle) || activeTopic;
					syncStripPills();
					syncTrackTabs();
					applyFilters();
				});
			}

			document.addEventListener("DOMContentLoaded", initCoursesFilter);
			window.addEventListener("load", initCoursesFilter);
			document.addEventListener("astro:page-load", initCoursesFilter);
			window.addEventListener("cc:page-load", initCoursesFilter);
			initCoursesFilter();
		})();
	</script>
</BaseLayout>
