---
/**
 * `/courses` | CodingCat.dev Courses & Lessons Page.
 *
 * Dual-Theme Chalkboard Paper (`8d1319903d504a79ae56110486455e17`) &
 * Obsidian Chalkboard (`b9e00f99c0d34e9884bf7766a014577b`) Courses Page.
 */
import AjMascot from "@/components/AjMascot.astro";
import CoverImage from "@/components/CoverImage.astro";
import ExcalidrawDiagram from "@/components/ExcalidrawDiagram.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { coursesQuery } from "@/lib/sanity/queries";
import type { CoverImage as CoverImageType } from "@/lib/sanity/types.gen";

interface CourseListItem {
	_id: string;
	_type?: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	lessonsCount?: number | null;
}

const { sanity } = Astro.locals;
const rawCourses = ((await sanity.loadQuery(coursesQuery)) ??
	[]) as unknown as CourseListItem[];

const LEARNING_ORDER: Record<
	string,
	{
		rank: number;
		tier: string;
		color: string;
		lip: string;
		textColor: string;
		badge: string;
	}
> = {
	"mcp-in-production": {
		rank: 1,
		tier: "Course 1 · 2026 Flagship",
		color: "#86EFAC",
		lip: "#2A1155",
		textColor: "#166534",
		badge: "🤖 Model Context Protocol",
	},
	"zero-cold-start-edge-stack": {
		rank: 2,
		tier: "Course 2 · 2026 Flagship",
		color: "#EDE9FE",
		lip: "#2A1155",
		textColor: "#5B21B6",
		badge: "⚡ Astro 7, Workers, D1 & Auth",
	},
	"sanity-content-operating-system": {
		rank: 3,
		tier: "Course 3 · 2026 Flagship",
		color: "#FEF08A",
		lip: "#2A1155",
		textColor: "#713F12",
		badge: "📚 Sanity Content OS",
	},
	"full-stack-ai-agents-typescript": {
		rank: 4,
		tier: "Course 4 · 2026 Flagship",
		color: "#7C3AED",
		lip: "#2A1155",
		textColor: "#FFFFFF",
		badge: "🧠 TypeScript AI Agents",
	},
	"css-animations": {
		rank: 5,
		tier: "Course 5 · Style & Motion",
		color: "#FBCFE8",
		lip: "#2A1155",
		textColor: "#9D174D",
		badge: "🎨 UI & Modern CSS",
	},
	"intro-to-svelte": {
		rank: 6,
		tier: "Course 6 · Reactive UI",
		color: "#EDE9FE",
		lip: "#2A1155",
		textColor: "#5B21B6",
		badge: "⚡ Frontend Frameworks",
	},
	"intro-to-solid-js": {
		rank: 7,
		tier: "Course 7 · Fine-Grained Reactivity",
		color: "#86EFAC",
		lip: "#2A1155",
		textColor: "#166534",
		badge: "⚡ Frontend Frameworks",
	},
	svelte: {
		rank: 8,
		tier: "Course 8 · Component Architecture",
		color: "#FEF08A",
		lip: "#2A1155",
		textColor: "#713F12",
		badge: "🧶 Intermediate",
	},
	"sveltekit-firebase": {
		rank: 9,
		tier: "Course 9 · Full-Stack Apps",
		color: "#BAE6FD",
		lip: "#2A1155",
		textColor: "#0369A1",
		badge: "🚀 Full-Stack",
	},
	angularmaterial: {
		rank: 10,
		tier: "Course 10 · Enterprise UI",
		color: "#BAE6FD",
		lip: "#2A1155",
		textColor: "#0369A1",
		badge: "🏗️ Design Systems",
	},
};

const courses = [...rawCourses].sort((a, b) => {
	const rA = LEARNING_ORDER[a.slug ?? ""]?.rank ?? 99;
	const rB = LEARNING_ORDER[b.slug ?? ""]?.rank ?? 99;
	return rA - rB;
});
---

<BaseLayout
	title="Courses & Lessons | CodingCat.dev"
	description="Explore CodingCat.dev hands-on courses and video lessons covering Model Context Protocol (MCP), Astro 7, Cloudflare Workers, D1, Better-Auth, Sanity Content OS, and Full-Stack AI Agents in TypeScript."
	ogFallback={{
		title: "CodingCat.dev Courses",
		subtitle: "Hands-On Web Development Courses & Lessons",
		type: "Blog",
	}}
>
	<section class="py-10 md:py-16">
		{/* Top Hero Banner */}
		<div class="mx-auto max-w-4xl text-center">
			<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
				🧶 Hands-On Courses &amp; Video Lessons
			</span>
			<h1 class="mt-4 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-6xl">
				pick your <span class="text-[#7C3AED] dark:text-[#C084FC]">next</span>{" "}
				course<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
			</h1>
			<p class="font-hand mx-auto mt-3 max-w-2xl text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				Start with our 2026 Flagship Courses on MCP, the Zero-Cold-Start Edge Stack, Sanity Content OS, and TypeScript AI Agents.
			</p>
			<div class="mt-5 flex flex-wrap items-center justify-center gap-3">
				<a
					href="https://www.youtube.com/@codingcatdev?sub_confirmation=1"
					target="_blank"
					rel="noopener noreferrer"
					class="tactile-btn inline-flex items-center gap-2 rounded-xl border-2 border-[#2A1155] bg-[#FF0000] px-4 py-2 font-display text-xs font-black text-white shadow-sketch-sm transition hover:bg-[#DC2626] dark:border-white/70"
				>
					<span>▶ Subscribe on YouTube for New Video Lessons (62.5K / 100K) →</span>
				</a>
			</div>
		</div>

		{/* Hand-Drawn Courses Progression Diagram */}
		<div class="mx-auto mt-8 max-w-5xl">
			<ExcalidrawDiagram
				title="2026 Courses Progression Diagram"
				caption="Select any course below to open its bite-sized video lessons and production TypeScript code."
				compact={true}
				nodes={[
					{
						id: "c1",
						badge: "Edge & Content OS",
						label: "Astro 7, Workers & Sanity",
						sublabel: "✓ Zero cold start + TypeGen",
						color: "purple",
						status: "good",
					},
					{
						id: "c2",
						badge: "Context Protocol",
						label: "MCP in Production",
						sublabel: "✓ Streamable HTTP & OAuth 2.1",
						color: "blue",
						status: "good",
					},
					{
						id: "c3",
						badge: "Agent Systems",
						label: "TypeScript AI Agents",
						sublabel: "✓ Deterministic Tool Calling",
						color: "green",
						status: "good",
					},
				]}
				edges={[
					{ from: "c1", to: "c2", label: "expose tools" },
					{ from: "c2", to: "c3", label: "✓ ship agents" },
				]}
			/>
		</div>

		{/* Winding Courses List */}
		<div class="relative mx-auto mt-14 max-w-4xl">
			{/* Central Vertical Glowing Purple-to-Fuchsia Yarn Spine */}
			<div
				class="pointer-events-none absolute bottom-10 left-1/2 top-10 hidden w-1.5 -translate-x-1/2 rounded-full bg-gradient-to-b from-[#7C3AED] via-[#C084FC] to-[#D946EF] opacity-85 md:block"
				aria-hidden="true"
			></div>

			<div class="flex flex-col gap-12">
				{
					courses.map((course, index) => {
						const meta = LEARNING_ORDER[course.slug ?? ""] ?? {
							rank: index + 1,
							tier: `Course ${index + 1} · Hands-On Lessons`,
							color: "#EDE9FE",
							lip: "#2A1155",
							textColor: "#2A1155",
							badge: "🧶 CodingCat Course",
						};
						const isEven = index % 2 === 0;
						const href = `/course/${course.slug}`;

						return (
							<div
								class:list={[
									"duo-scroll-reveal relative flex flex-col items-center gap-6 md:flex-row",
									isEven ? "md:flex-row" : "md:flex-row-reverse",
								]}
							>
								{/* Course Card */}
								<div class="w-full md:w-[46%]">
									<a
										href={href}
										class="duo-card hand-border group block overflow-hidden p-6 transition-all duration-200 hover:-translate-y-1.5 hover:border-[#7C3AED] dark:hover:border-[#C084FC]"
									>
										<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
											<span
												class="rounded-full border border-[#2A1155] px-3 py-1 font-mono text-xs font-black uppercase tracking-wider"
												style={`background-color: ${meta.color}; color: ${meta.textColor};`}
											>
												{meta.tier}
											</span>
											<span class="font-hand text-lg font-bold text-[#7C3AED] dark:text-[#C084FC]">
												{meta.badge}
											</span>
										</div>

										{course.coverImage && (
											<div class="mb-4 overflow-hidden rounded-2xl border-2 border-[#2A1155] bg-[#2A1155] dark:border-white/20 dark:bg-[#060E20]">
												<CoverImage
													image={course.coverImage}
													fallbackAlt={course.title}
													width={640}
													height={360}
												/>
											</div>
										)}

										<h2 class="font-display text-2xl font-black text-[#2A1155] transition-colors group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
											{course.title}
										</h2>
										{course.excerpt && (
											<p class="mt-2 text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300 line-clamp-3">
												{course.excerpt}
											</p>
										)}

										<div class="mt-4 flex items-center justify-between border-t-2 border-dashed border-[#2A1155]/15 pt-3 dark:border-white/15">
											<span class="font-mono text-xs font-bold text-[#4C1D95] dark:text-purple-200">
												{course.lessonsCount
													? `${course.lessonsCount} Lessons`
													: "Course Lessons"}
											</span>
											<span class="tactile-btn px-4 py-1.5 text-xs">
												<span>Start Course</span>
												<span class="text-[#86EFAC]">→</span>
											</span>
										</div>
									</a>
								</div>

								{/* Center Tactile 3D Course Number Circle */}
								<div class="z-10 flex shrink-0 flex-col items-center justify-center md:w-[8%]">
									<a
										href={href}
										class="flex size-16 items-center justify-center rounded-full border-2 border-[#2A1155] font-display text-xl font-black transition-transform hover:scale-110 shadow-sketch"
										style={`background-color: ${meta.color}; color: ${meta.textColor};`}
										aria-label={`Course ${index + 1}: ${course.title}`}
									>
										{index + 1}
									</a>
								</div>

								{/* Opposite Side Mascot or Handwritten Sticky Note */}
								<div class="hidden md:flex md:w-[46%] md:justify-center">
									{index === 0 ? (
										<AjMascot
											state="idle-wave"
											angle="three-quarter-left"
											cls="w-32 h-auto"
											caption="Great place to start!"
										/>
									) : index === 3 ? (
										<AjMascot
											state="point-diagram"
											angle="three-quarter-right"
											cls="w-28 h-auto"
											caption="Reactive frameworks! ⚡"
										/>
									) : index === courses.length - 1 ? (
										<AjMascot
											state="podcast-groove"
											angle={isEven ? "three-quarter-left" : "three-quarter-right"}
											cls="w-32 h-auto"
											caption="Full-stack apps! 🚀"
										/>
									) : (
										<div class="-rotate-1 rounded-2xl border-2 border-[#2A1155] bg-[#FEF08A] px-5 py-4 font-hand text-xl font-bold text-[#713F12] shadow-sketch-sm dark:border-yellow-600">
											✏️ Course #{index + 1}: Video lessons, code &amp; visual diagrams
										</div>
									)}
								</div>
							</div>
						);
					})
				}
			</div>
		</div>
	</section>
</BaseLayout>
