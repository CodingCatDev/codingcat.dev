type CourseTrack = "flagship" | "odin" | "frameworks";

interface CourseLessonSummary {
	title?: string | null;
	slug?: string | null;
	excerpt?: string | null;
	tags?: SanityTagItem[] | null;
}

interface CourseSectionSummary {
	title?: string | null;
	lessons?: CourseLessonSummary[] | null;
}

interface CourseListItem {
	_id: string;
	_type?: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	lessonsCount?: number | null;
	tags?: SanityTagItem[] | null;
	sections?: CourseSectionSummary[] | null;
}

const { sanity } = Astro.locals;
const rawCourses = ((await sanity.loadQuery(coursesQuery)) ??
	[]) as unknown as CourseListItem[];

const initialTopicParam = Astro.url.searchParams.get("topic")?.trim() || "";
const initialTopicDef = initialTopicParam
	? getTopicBySlug(initialTopicParam)
	: undefined;
const initialTrackParam = (
	Astro.url.searchParams.get("track")?.trim() || "all"
).toLowerCase();
const initialQueryParam = Astro.url.searchParams.get("q")?.trim() || "";

interface CourseOrderMeta {
