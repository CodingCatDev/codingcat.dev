---
/**
 * `/courses` | CodingCat.dev Beginner-to-Pro Excalidraw Learning Path Map.
 *
 * Dual-Theme Chalkboard Paper (`8d1319903d504a79ae56110486455e17`) &
 * Obsidian Chalkboard (`b9e00f99c0d34e9884bf7766a014577b`) Course Map.
 */
import AjMascot from "@/components/AjMascot.astro";
import CoverImage from "@/components/CoverImage.astro";
import ExcalidrawDiagram from "@/components/ExcalidrawDiagram.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { coursesQuery } from "@/lib/sanity/queries";
import type { CoverImage as CoverImageType } from "@/lib/sanity/types.gen";

interface CourseListItem {
	_id: string;
	_type?: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	lessonsCount?: number | null;
}

const { sanity } = Astro.locals;
const rawCourses = ((await sanity.loadQuery(coursesQuery)) ??
	[]) as unknown as CourseListItem[];

const LEARNING_ORDER: Record<
	string,
	{
		rank: number;
		tier: string;
		color: string;
		lip: string;
		textColor: string;
		badge: string;
	}
> = {
	"html-for-a-10-year-old": {
		rank: 1,
		tier: "Unit 1 · First Lines of Code",
		color: "#FEF08A",
		lip: "#2A1155",
		textColor: "#713F12",
		badge: "🌱 Curious Kitten",
	},
	"micro-bit-for-a-10-year-old": {
		rank: 2,
		tier: "Unit 1 · Hardware & Play",
		color: "#BAE6FD",
		lip: "#2A1155",
		textColor: "#0369A1",
		badge: "🌱 Curious Kitten",
	},
	"css-animations": {
		rank: 3,
		tier: "Unit 2 · Style & Motion",
		color: "#FBCFE8",
		lip: "#2A1155",
		textColor: "#9D174D",
		badge: "🎨 Visual Builder",
	},
	"intro-to-svelte": {
		rank: 4,
		tier: "Unit 3 · Reactive UI",
		color: "#EDE9FE",
		lip: "#2A1155",
		textColor: "#5B21B6",
		badge: "⚡ Code Pouncer",
	},
	"intro-to-solid-js": {
		rank: 5,
		tier: "Unit 3 · Fine-Grained Reactivity",
		color: "#86EFAC",
		lip: "#2A1155",
		textColor: "#166534",
		badge: "⚡ Code Pouncer",
	},
	svelte: {
		rank: 6,
		tier: "Unit 4 · Component Mastery",
		color: "#FEF08A",
		lip: "#2A1155",
		textColor: "#713F12",
		badge: "🧶 Yarn Master",
	},
	angularmaterial: {
		rank: 7,
		tier: "Unit 4 · Enterprise Design Systems",
		color: "#BAE6FD",
		lip: "#2A1155",
		textColor: "#0369A1",
		badge: "🏗️ System Architect",
	},
	"sveltekit-firebase": {
		rank: 8,
		tier: "Unit 5 · Full-Stack Production",
		color: "#7C3AED",
		lip: "#2A1155",
		textColor: "#FFFFFF",
		badge: "🚀 Production Cat",
	},
};

const courses = [...rawCourses].sort((a, b) => {
	const rA = LEARNING_ORDER[a.slug ?? ""]?.rank ?? 99;
	const rB = LEARNING_ORDER[b.slug ?? ""]?.rank ?? 99;
	return rA - rB;
});
---

<BaseLayout
	title="Courses & Learning Path Map | CodingCat.dev"
	description="Follow AJ's winding Excalidraw course map from HTML & micro:bit for a 10 Year Old all the way to full-stack SvelteKit, SolidJS, and Firebase."
	ogFallback={{
		title: "CodingCat.dev Learning Map",
		subtitle: "Beginner-to-Pro Excalidraw Course Path",
		type: "Blog",
	}}
>
	<section class="py-10 md:py-16">
		{/* Top Hero Banner */}
		<div class="mx-auto max-w-4xl text-center">
			<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
				🧶 Excalidraw Winding Course Map
			</span>
			<h1 class="mt-4 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-6xl">
				pick your <span class="text-[#7C3AED] dark:text-[#C084FC]">starting</span>{" "}
				node<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
			</h1>
			<p class="font-hand mx-auto mt-3 max-w-2xl text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				Start at Node #1 if you are brand new to coding, or jump straight to the framework and full-stack units down the purple yarn trail.
			</p>
		</div>

		{/* Hand-Drawn Excalidraw Skill Tree Overview */}
		<div class="mx-auto mt-8 max-w-5xl">
			<ExcalidrawDiagram
				title="CodingCat.dev Skill Tree Overview"
				caption="Click any course node below to open its interactive video & code lessons."
				compact={true}
				nodes={[
					{
						id: "u1",
						badge: "Unit 01",
						label: "HTML & micro:bit",
						sublabel: "Zero prior experience",
						color: "purple",
					},
					{
						id: "u2",
						badge: "Unit 02-03",
						label: "CSS, Svelte & Solid",
						sublabel: "✓ Interactive web apps",
						color: "blue",
						status: "good",
					},
					{
						id: "u3",
						badge: "Unit 04-05",
						label: "SvelteKit + Firebase",
						sublabel: "✓ Full-stack & Auth",
						color: "green",
						status: "good",
					},
				]}
				edges={[
					{ from: "u1", to: "u2", label: "build UI" },
					{ from: "u2", to: "u3", label: "✓ ship full-stack" },
				]}
			/>
		</div>

		{/* Winding Learning Path Nodes */}
		<div class="relative mx-auto mt-14 max-w-4xl">
			{/* Central Vertical Glowing Purple-to-Fuchsia Yarn Spine */}
			<div
				class="pointer-events-none absolute bottom-10 left-1/2 top-10 hidden w-1.5 -translate-x-1/2 rounded-full bg-gradient-to-b from-[#7C3AED] via-[#C084FC] to-[#D946EF] opacity-85 md:block"
				aria-hidden="true"
			></div>

			<div class="flex flex-col gap-12">
				{
					courses.map((course, index) => {
						const meta = LEARNING_ORDER[course.slug ?? ""] ?? {
							rank: index + 1,
							tier: `Unit ${index + 1} · Hands-On Course`,
							color: "#EDE9FE",
							lip: "#2A1155",
							textColor: "#2A1155",
							badge: "🧶 CodingCat Course",
						};
						const isEven = index % 2 === 0;
						const href = `/course/${course.slug}`;

						return (
							<div
								class:list={[
									"duo-scroll-reveal relative flex flex-col items-center gap-6 md:flex-row",
									isEven ? "md:flex-row" : "md:flex-row-reverse",
								]}
							>
								{/* Course Card */}
								<div class="w-full md:w-[46%]">
									<a
										href={href}
										class="duo-card hand-border group block overflow-hidden p-6 transition-all duration-200 hover:-translate-y-1.5 hover:border-[#7C3AED] dark:hover:border-[#C084FC]"
									>
										<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
											<span
												class="rounded-full border border-[#2A1155] px-3 py-1 font-mono text-xs font-black uppercase tracking-wider"
												style={`background-color: ${meta.color}; color: ${meta.textColor};`}
											>
												{meta.tier}
											</span>
											<span class="font-hand text-lg font-bold text-[#7C3AED] dark:text-[#C084FC]">
												{meta.badge}
											</span>
										</div>

										{course.coverImage && (
											<div class="mb-4 overflow-hidden rounded-2xl border-2 border-[#2A1155] bg-[#2A1155] dark:border-white/20 dark:bg-[#060E20]">
												<CoverImage
													image={course.coverImage}
													fallbackAlt={course.title}
													width={640}
													height={360}
												/>
											</div>
										)}

										<h2 class="font-display text-2xl font-black text-[#2A1155] transition-colors group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
											{course.title}
										</h2>
										{course.excerpt && (
											<p class="mt-2 text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300 line-clamp-3">
												{course.excerpt}
											</p>
										)}

										<div class="mt-4 flex items-center justify-between border-t-2 border-dashed border-[#2A1155]/15 pt-3 dark:border-white/15">
											<span class="font-mono text-xs font-bold text-[#4C1D95] dark:text-purple-200">
												{course.lessonsCount
													? `${course.lessonsCount} Lessons`
													: "Interactive Course"}
											</span>
											<span class="tactile-btn px-4 py-1.5 text-xs">
												<span>Start Unit</span>
												<span class="text-[#86EFAC]">→</span>
											</span>
										</div>
									</a>
								</div>

								{/* Center Tactile 3D Level Node Circle */}
								<div class="z-10 flex shrink-0 flex-col items-center justify-center md:w-[8%]">
									<a
										href={href}
										class="flex size-16 items-center justify-center rounded-full border-2 border-[#2A1155] font-display text-xl font-black transition-transform hover:scale-110 shadow-sketch"
										style={`background-color: ${meta.color}; color: ${meta.textColor};`}
										aria-label={`Node ${index + 1}: ${course.title}`}
									>
										{index + 1}
									</a>
								</div>

								{/* Opposite Side Mascot Milestone or Handwritten Excalidraw Sticky Note */}
								<div class="hidden md:flex md:w-[46%] md:justify-center">
									{index === 0 ? (
										<AjMascot
											pose="yarn-chase"
											cls="w-32 h-auto"
											caption="Great place to start!"
										/>
									) : index === 3 ? (
										<AjMascot
											pose="code-peek"
											cls="w-28 h-auto"
											caption="Reactive frameworks! ⚡"
										/>
									) : index === courses.length - 1 ? (
										<AjMascot
											pose="headphones"
											cls="w-32 h-auto"
											caption="Full-stack boss node! 🚀"
										/>
									) : (
										<div class="-rotate-1 rounded-2xl border-2 border-[#2A1155] bg-[#FEF08A] px-5 py-4 font-hand text-xl font-bold text-[#713F12] shadow-sketch-sm dark:border-yellow-600">
											✏️ Milestone #{index + 1}: Hands-on code &amp; Excalidraw diagrams
										</div>
									)}
								</div>
							</div>
						);
					})
				}
			</div>
		</div>
	</section>
</BaseLayout>
