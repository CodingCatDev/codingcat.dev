function resolveCourseMeta(course: CourseListItem, fallbackIdx: number): CourseOrderMeta {
	const slug = course.slug ?? "";
	if (LEARNING_ORDER[slug]) {
		return LEARNING_ORDER[slug];
	}
	if (slug.startsWith("odin-")) {
		return {
			rank: 30 + fallbackIdx,
			track: "odin",
			tier: "Odin Project Series",
			color: "#FEF08A",
			lip: "#2A1155",
			textColor: "#713F12",
			badge: "🛡️ Full-Stack Foundations",
		};
	}
	return {
		rank: 15 + fallbackIdx,
		track: "flagship",
		tier: "2026 Flagship Course",
		color: "#EDE9FE",
		lip: "#2A1155",
		textColor: "#5B21B6",
		badge: "🧶 Hands-On Course",
	};
}

const courses = [...rawCourses].sort((a, b) => {
	const rA = LEARNING_ORDER[a.slug ?? ""]?.rank ?? 35;
	const rB = LEARNING_ORDER[b.slug ?? ""]?.rank ?? 35;
	return rA - rB;
});

const enrichedCourses = courses.map((course, idx) => {
	const meta = resolveCourseMeta(course, idx);
	const sectionTitles = (course.sections ?? [])
		.map((s) => s?.title || "")
		.filter(Boolean);
	const lessons = (course.sections ?? []).flatMap((s) => s?.lessons ?? []);
	const lessonTitles = lessons.map((l) => l?.title || "").filter(Boolean);
	const lessonExcerpts = lessons.map((l) => l?.excerpt || "").filter(Boolean);
	const lessonTags = lessons.flatMap((l) => l?.tags ?? []);
	const combinedTags: SanityTagItem[] = [
		...(course.tags ?? []),
		...lessonTags,
	];

	const resolvedTopics = resolveItemTopics({
		title: `${course.title} ${sectionTitles.join(" ")} ${lessonTitles.join(" ")}`,
		excerpt: `${course.excerpt ?? ""} ${lessonExcerpts.join(" ")}`,
		tags: combinedTags,
	});

	const topicSlugs = resolvedTopics.visible.map((t) => t.slug);
	const topicTitles = resolvedTopics.visible.map((t) => t.title);
	const searchHaystack = [
		course.title,
		course.slug ?? "",
		course.excerpt ?? "",
		meta.tier,
		meta.badge,
		...sectionTitles,
		...lessonTitles,
		...topicSlugs,
		...topicTitles,
	]
		.join(" ")
		.toLowerCase();

	const matchesInitialTopic = initialTopicDef
		? topicSlugs.includes(initialTopicDef.slug)
		: true;
	const matchesInitialTrack =
		initialTrackParam === "all" || meta.track === initialTrackParam;
	const matchesInitialQuery = initialQueryParam
		? searchHaystack.includes(initialQueryParam.toLowerCase())
		: true;

	return {
		course,
		meta,
		combinedTags,
		topicSlugs,
		searchHaystack,
		initiallyVisible:
			matchesInitialTopic && matchesInitialTrack && matchesInitialQuery,
	};
});

const totalLessonsCount = enrichedCourses.reduce(
	(acc, item) => acc + (item.course.lessonsCount || 0),
	0,
);
const initialVisibleCount = enrichedCourses.filter(
	(c) => c.initiallyVisible,
).length;
const flagshipCount = enrichedCourses.filter(
	(c) => c.meta.track === "flagship",
).length;
const odinCount = enrichedCourses.filter(
