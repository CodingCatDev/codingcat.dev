---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentGrid from "@/components/ContentGrid.astro";
import Pagination from "@/components/Pagination.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { resolvePage } from "@/lib/pagination";
import { authorCountQuery, moreAuthorQuery } from "@/lib/sanity/queries";

const { sanity } = Astro.locals;

const count = await sanity.loadQuery(authorCountQuery);
const resolved = resolvePage({
	raw: Astro.params.num,
	count,
	base: "authors",
	redirect: Astro.redirect,
});
if (!resolved.ok) {
	return resolved.response;
}
const { page, totalPages, offset, limit } = resolved.bounds;

const items = await sanity.loadQuery(moreAuthorQuery, {
	skip: "none",
	offset,
	limit,
});

const title = page === 1 ? "Authors" : `Authors: Page ${page}`;
---

<BaseLayout
	title={`${title} | CodingCat.dev`}
	description="The engineers and educators writing tutorials and blog posts on CodingCat.dev."
	canonical={`/authors/page/${page}`}
>
	<Fragment slot="head">
		{page > 1 && <link rel="prev" href={`/authors/page/${page - 1}`} />}
		{page < totalPages && <link rel="next" href={`/authors/page/${page + 1}`} />}
	</Fragment>

	<Breadcrumbs links={[{ title: "Authors" }]} />

	<div class="mb-24">
		<SectionHeader title="authors" showHr={false} />
		<ContentGrid items={items as ContentListItem[]} />
		<Pagination base="authors" page={page} totalPages={totalPages} />
	</div>
</BaseLayout>
