---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CoverImage from "@/components/CoverImage.astro";
import InfiniteContentGrid from "@/components/InfiniteContentGrid.astro";
import Pagination from "@/components/Pagination.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { resolvePage } from "@/lib/pagination";
import { authorCountQuery, moreAuthorQuery } from "@/lib/sanity/queries";

const { sanity } = Astro.locals;

const count = await sanity.loadQuery(authorCountQuery);
const resolved = resolvePage({
	raw: Astro.params.num,
	count,
	base: "authors",
	redirect: Astro.redirect,
});
if (!resolved.ok) {
	return resolved.response;
}
const { page, totalPages, offset, limit } = resolved.bounds;
const initialQuery = Astro.url.searchParams.get("q")?.trim() || "";

const items = await sanity.loadQuery(moreAuthorQuery, {
	skip: "none",
	offset,
	limit,
});

const featuredAuthor =
	items.find((a) => a.slug === "alex-patterson") ?? items[0];
const featuredHref = featuredAuthor?.slug
	? `/author/${featuredAuthor.slug}`
	: undefined;

const title = page === 1 ? "Authors" : `Authors: Page ${page}`;
---

<BaseLayout
	title={`${title} | CodingCat.dev`}
	description="The engineers and educators writing tutorials and blog posts on CodingCat.dev."
	canonical={`/authors/page/${page}`}
>
	<Fragment slot="head">
		{page > 1 && <link rel="prev" href={`/authors/page/${page - 1}`} />}
		{page < totalPages && <link rel="next" href={`/authors/page/${page + 1}`} />}
	</Fragment>

	<Breadcrumbs links={[{ title: "Authors" }]} />

	<section class="py-4 md:py-8">
		<div class="mb-6">
			<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
				✏️ CodingCat.dev Authors &amp; Educators
			</span>
			<h1 class="mt-4 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-6xl">
				authors &amp; <span class="text-[#7C3AED] dark:text-[#C084FC]">educators</span>
				<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
			</h1>
			<p class="font-hand mt-2 max-w-2xl text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				Practicing engineers and developer educators building real production systems and teaching through visual diagrams.
			</p>
		</div>

		{
			featuredAuthor && page === 1 && (
				<article class="duo-card hand-border my-8 overflow-hidden p-6 md:p-8">
					<div class="grid items-center gap-8 lg:grid-cols-12">
						<div class="flex flex-col gap-5 sm:flex-row sm:items-center lg:col-span-8">
							{featuredHref && (
								<a
									href={featuredHref}
									class="group block size-28 shrink-0 overflow-hidden rounded-3xl border-2 border-[#2A1155] bg-[#2A1155] shadow-sketch-sm dark:border-white/25 dark:bg-[#060E20] sm:size-36"
								>
									<CoverImage
										image={featuredAuthor.coverImage}
										fallbackAlt={featuredAuthor.title}
										width={320}
										height={320}
										sizes="144px"
										class="aspect-square h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
										priority
									/>
								</a>
							)}
							<div>
								<span class="inline-flex rounded-full border border-[#2A1155] bg-[#FEF08A] px-3 py-0.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#713F12]">
									★ Founder &amp; Lead Educator
								</span>
								<h2 class="mt-2 font-display text-3xl font-black text-[#2A1155] dark:text-white">
									{featuredHref ? (
										<a
											href={featuredHref}
											class="hover:text-[#7C3AED] hover:underline dark:hover:text-[#C084FC]"
										>
											{featuredAuthor.title}
										</a>
									) : (
										featuredAuthor.title
									)}
								</h2>
								<p class="mt-2 text-sm font-medium text-[#2A1155]/80 dark:text-slate-300">
									Host of the Purrfect Web Tutorials podcast and creator of CodingCat.dev courses, visual architecture diagrams, and deep-dive engineering guides.
								</p>
								{featuredHref && (
									<div class="mt-3">
										<a
											href={featuredHref}
											class="font-display text-sm font-black text-[#7C3AED] hover:underline dark:text-[#C084FC]"
										>
											Browse All Posts &amp; Episodes by {featuredAuthor.title} &rarr;
										</a>
									</div>
								)}
							</div>
						</div>

						<div class="flex flex-col justify-between gap-3 rounded-2xl border-2 border-dashed border-[#2A1155]/25 bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] lg:col-span-4">
							<span class="font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:text-[#C084FC]">
								🧶 Explore Pillars
							</span>
							<div class="flex flex-wrap gap-2 pt-1">
								<a href="/courses" class="tactile-btn px-4 py-2 text-xs">
									<span>Explore Courses</span>
									<span class="text-[#86EFAC]">&rarr;</span>
								</a>
								<a href="/blog" class="duo-btn duo-btn-outline px-4 py-2 text-xs">
									Read Blog
								</a>
							</div>
						</div>
					</div>
				</article>
			)
		}

		<div class="mb-24">
			<SectionHeader title="all authors" showHr={false} />
			<InfiniteContentGrid
				type="author"
				items={items as ContentListItem[]}
				skipId="none"
				initialOffset={offset + items.length}
				totalCount={count}
				initialQuery={initialQuery}
				showSearch={true}
				searchPlaceholder="Filter authors by name..."
				priorityCount={2}
				nounPlural="authors"
			/>
			<noscript>
				<Pagination base="authors" page={page} totalPages={totalPages} />
			</noscript>
		</div>
	</section>
</BaseLayout>
