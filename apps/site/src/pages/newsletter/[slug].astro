---
import Avatar from "@/components/Avatar.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CoverImage from "@/components/CoverImage.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import TagPills from "@/components/TagPills.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { newsletterQuery } from "@/lib/sanity/queries";
import { articleSchema, breadcrumbSchema } from "@/lib/structured-data";

const { sanity } = Astro.locals;
const { slug } = Astro.params;

const issue = slug ? await sanity.loadQuery(newsletterQuery, { slug }) : null;
if (!issue?._id) {
	return new Response(null, { status: 404 });
}

const path = `/newsletter/${slug}`;
const origin = Astro.locals.siteUrl.origin;
const coverThumbnail = sanity.resolveOpenGraphImage(
	issue.coverImage ?? undefined,
);
const ogCardImageUrl = sanity
	.urlForImage(issue.coverImage ?? undefined)
	?.width(640)
	.height(360)
	.fit("crop")
	.url();
const catImageUrl = issue.catOfTheWeek?.image
	? sanity
			.urlForImage(issue.catOfTheWeek.image)
			?.width(800)
			.fit("max")
			.url()
	: null;
const authors = issue.author ?? [];
---

<BaseLayout
	title={issue.title}
	description={issue.preheader || issue.excerpt}
	ogFallback={{
		title: issue.title,
		subtitle: issue.preheader || issue.excerpt,
		type: "Blog",
		author: authors[0]?.title,
		image: ogCardImageUrl,
	}}
	type="article"
	publishedAt={issue.date}
	modifiedAt={issue._updatedAt}
	authors={authors.map((a) => a.title)}
	canonical={path}
	schema={[
		articleSchema(
			origin,
			{
				title: issue.title,
				excerpt: issue.preheader || issue.excerpt,
				date: issue.date,
				_updatedAt: issue._updatedAt,
				imageUrl: coverThumbnail?.url,
				authors,
			},
			path,
		),
		breadcrumbSchema(origin, [
			{ name: "Newsletter", path: "/newsletter" },
			{ name: issue.title, path },
		]),
	]}
>
	<article class="mx-auto max-w-4xl py-8 md:py-12">
		<Breadcrumbs
			links={[
				{ title: "The Purrfect Dispatch", href: "/newsletter" },
				{ title: `Issue #${issue.issueNumber || 1}` },
			]}
		/>

		<header class="mt-6 space-y-4">
			<div class="flex flex-wrap items-center gap-3 text-xs font-bold">
				<span class="rounded-full border-2 border-[#2A1155] bg-[#7C3AED] px-3.5 py-1 font-mono text-white shadow-sketch-sm">
					The Purrfect Dispatch #{issue.issueNumber || 1}
				</span>
				<span class="text-[#2A1155]/75 dark:text-slate-300">
					<FormattedDate dateString={issue.date} />
				</span>
			</div>

			<h1 class="font-display text-3xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-5xl">
				{issue.title}
			</h1>

			{issue.preheader && (
				<p class="text-lg font-medium text-[#2A1155]/80 dark:text-purple-200">
					{issue.preheader}
				</p>
			)}

			<div class="flex flex-wrap items-center gap-2 pt-1">
				<TagPills
					title={issue.title}
					excerpt={issue.preheader || issue.excerpt}
					tags={issue.tags}
					size="md"
				/>
			</div>

			<div class="flex flex-wrap items-center justify-between gap-4 pt-2">
				<div class="flex items-center gap-3">
					{authors.map((author) => (
						<Avatar
							name={author.title}
							coverImage={author.coverImage}
							href={author.slug ? `/author/${author.slug}` : undefined}
						/>
					))}
				</div>
				<a
					href="https://www.youtube.com/@CodingCatDev?sub_confirmation=1"
					target="_blank"
					rel="noopener noreferrer"
					class="tactile-btn inline-flex items-center gap-2 rounded-xl border-2 border-[#2A1155] bg-[#FF0000] px-4 py-2 font-display text-xs font-black text-white shadow-sketch-sm transition hover:bg-[#DC2626] dark:border-white/70"
				>
					<span>▶ Road to 100K on YouTube (62.5K / 100K) →</span>
				</a>
			</div>
		</header>

		{issue.coverImage && (
			<div class="my-8 overflow-hidden rounded-3xl border-2 border-[#2A1155] shadow-sketch dark:border-white/20">
				<CoverImage
					image={issue.coverImage}
					fallbackAlt={issue.title}
					width={1200}
					height={675}
				/>
			</div>
		)}

		<div class="prose prose-lg mt-8 max-w-none dark:prose-invert">
			<PortableTextContent value={issue.content} />
		</div>

		{issue.courseSpotlight?.slug && (
			<section class="duo-card hand-border my-10 bg-[#EDE9FE] p-6 md:p-8 dark:bg-purple-950/50">
				<span class="font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:text-[#C084FC]">
					🎓 Featured Course Spotlight
				</span>
				<h2 class="mt-2 font-display text-2xl font-black text-[#2A1155] dark:text-white">
					<a href={`/course/${issue.courseSpotlight.slug}`} class="hover:text-[#7C3AED] dark:hover:text-[#C084FC]">
						{issue.courseSpotlight.title}
					</a>
				</h2>
				{issue.courseSpotlight.excerpt && (
					<p class="mt-2 text-sm font-medium text-[#2A1155]/80 dark:text-purple-200">
						{issue.courseSpotlight.excerpt}
					</p>
				)}
				<div class="mt-4">
					<a
						href={`/course/${issue.courseSpotlight.slug}`}
						class="tactile-btn inline-block px-5 py-2.5 font-display text-xs font-black"
					>
						Start Course →
					</a>
				</div>
			</section>
		)}

		{catImageUrl && (
			<section class="duo-card hand-border my-10 p-6 md:p-8">
				<h2 class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
					Favorite Cat of the Week 🐱
				</h2>
				<div class="mt-4 overflow-hidden rounded-2xl border-2 border-[#2A1155] dark:border-white/20">
					<img
						src={catImageUrl}
						alt={issue.catOfTheWeek?.alt || "Favorite Cat of the Week"}
						class="w-full object-cover"
						loading="lazy"
					/>
				</div>
				{issue.catOfTheWeek?.caption && (
					<p class="mt-3 text-sm font-bold italic text-[#2A1155]/80 dark:text-purple-200">
						{issue.catOfTheWeek.caption}
					</p>
				)}
			</section>
		)}
	</article>
</BaseLayout>
