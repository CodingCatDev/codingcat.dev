---
import AjAnimatedMascot from "@/components/AjAnimatedMascot.astro";
import CoverImage from "@/components/CoverImage.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import TagPills from "@/components/TagPills.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { newsletterListQuery } from "@/lib/sanity/queries";
import type { SanityImageSource } from "@sanity/image-url";

const { sanity } = Astro.locals;
const issues = ((await sanity.loadQuery(newsletterListQuery)) ?? []) as Array<{
	_id: string;
	issueNumber?: number;
	title: string;
	slug: string;
	excerpt?: string;
	preheader?: string;
	date: string;
	deliveryStatus?: string;
	coverImage?: (SanityImageSource & { alt?: string }) | null;
	tags?: Array<{ label?: string | null; value?: string | null }> | null;
	courseSpotlight?: {
		title: string;
		slug: string;
	} | null;
}>;
---

<BaseLayout
	title="The Purrfect Dispatch Newsletter | CodingCat.dev"
	description="Weekly Web Dev & AI engineering signals, visual architecture diagrams, new CodingCat.dev courses, podcast episodes, blog posts, and Favorite Cat of the Week."
	ogFallback={{
		title: "The Purrfect Dispatch",
		subtitle: "Weekly Web Dev & AI engineering newsletter by Alex Patterson & AJ.",
		type: "Blog",
	}}
>
	<section class="py-8 md:py-12">
		<div class="mb-8 flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
			<div>
				<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
					✉️ Weekly Engineering Dispatch
				</span>
				<h1 class="mt-4 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-6xl">
					the purrfect <span class="text-[#7C3AED] dark:text-[#C084FC]">dispatch</span>
					<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
				</h1>
				<p class="font-hand mt-2 max-w-2xl text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
					Every Friday: Web Dev &amp; AI signals, visual architecture diagrams, new courses, podcast episodes, blog posts, and our Favorite Cat of the Week.
				</p>
			</div>
			<div class="hidden shrink-0 sm:block">
				<AjAnimatedMascot
					variant="full-body"
					state="ship-it-laptop"
					angle="three-quarter-left"
					cls="w-28 h-auto"
					caption="Purrfect!"
				/>
			</div>
		</div>

		{/* Subscribe Banner */}
		<div class="duo-card hand-border mb-10 bg-[#EDE9FE] p-6 md:p-8 dark:bg-purple-950/50">
			<div class="grid items-center gap-6 lg:grid-cols-12">
				<div class="lg:col-span-7">
					<h2 class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
						Subscribe to The Purrfect Dispatch
					</h2>
					<p class="mt-1 text-sm font-medium text-[#2A1155]/80 dark:text-purple-200">
						Sent from <code class="font-mono font-bold text-[#7C3AED] dark:text-[#C084FC]">newsletter@codingcat.dev</code> every Friday morning. Zero fluff, 1-click unsubscribe anytime.
					</p>
				</div>
				<div class="lg:col-span-5">
					<form
						class="flex flex-col gap-3 sm:flex-row"
						action="https://buttondown.com/api/emails/embed-subscribe/codingcatdev"
						method="post"
					>
						<label class="sr-only" for="archive-newsletter-email">Email</label>
						<input
							id="archive-newsletter-email"
							name="email"
							type="email"
							required
							placeholder="you@domain.dev"
							class="h-11 flex-1 rounded-xl border-2 border-[#2A1155] bg-white px-4 py-2 text-sm font-medium text-[#2A1155] placeholder:text-[#2A1155]/40 focus:outline-none focus:ring-2 focus:ring-[#7C3AED] dark:border-white/25 dark:bg-[#060E20] dark:text-white dark:placeholder:text-slate-500"
						/>
						<input type="hidden" value="1" name="embed" />
						<button
							type="submit"
							class="tactile-btn h-11 px-6 font-display text-sm font-black"
						>
							Subscribe →
						</button>
					</form>
				</div>
			</div>
		</div>

		{/* Issues List */}
		<div class="grid gap-6 md:grid-cols-2">
			{
				issues.map((issue) => (
					<article class="duo-card hand-border flex flex-col justify-between overflow-hidden p-6">
						<div>
							{issue.coverImage && (
								<a href={`/newsletter/${issue.slug}`} class="mb-4 block overflow-hidden rounded-2xl border-2 border-[#2A1155] dark:border-white/20">
									<CoverImage
										image={issue.coverImage}
										fallbackAlt={issue.title}
										width={640}
										height={360}
									/>
								</a>
							)}
							<div class="mb-2 flex flex-wrap items-center gap-2 text-xs font-bold">
								{issue.issueNumber && (
									<span class="rounded-full border border-[#2A1155] bg-[#7C3AED] px-3 py-0.5 font-mono text-white">
										Issue #{issue.issueNumber}
									</span>
								)}
								<span class="text-[#2A1155]/70 dark:text-slate-300">
									<FormattedDate dateString={issue.date} />
								</span>
							</div>
							<h2 class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
								<a href={`/newsletter/${issue.slug}`} class="hover:text-[#7C3AED] dark:hover:text-[#C084FC]">
									{issue.title}
								</a>
							</h2>
							<p class="mt-2 text-sm font-medium text-[#2A1155]/80 dark:text-slate-300">
								{issue.preheader || issue.excerpt}
							</p>
							<div class="mt-3 flex flex-wrap items-center gap-1.5">
								<TagPills
									title={issue.title}
									excerpt={issue.preheader || issue.excerpt}
									tags={issue.tags}
									maxCount={4}
									size="sm"
									overflowHref={`/newsletter/${issue.slug}`}
								/>
							</div>
						</div>
						<div class="mt-5 flex items-center justify-between border-t border-dashed border-[#2A1155]/15 pt-4 dark:border-white/10">
							<a
								href={`/newsletter/${issue.slug}`}
								class="font-display text-sm font-black text-[#7C3AED] hover:underline dark:text-[#C084FC]"
							>
								Read Issue #{issue.issueNumber || 1} →
							</a>
							{issue.courseSpotlight?.slug && (
								<a
									href={`/course/${issue.courseSpotlight.slug}`}
									class="font-mono text-xs font-bold text-[#2A1155]/70 hover:text-[#7C3AED] dark:text-slate-400 dark:hover:text-[#C084FC]"
								>
									🎓 {issue.courseSpotlight.title}
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
