---
/**
 * `/topic/[slug]` | Vendor & Technology Hub Page (e.g. `/topic/sanity`, `/topic/firebase`, `/topic/amplify`).
 *
 * Displays the official vendor logo (`Sanity-Full_logo`, `Firebase Primary Lockup`, `Amplify.svg`),
 * a hand-drawn architecture diagram, partner CTA (if applicable), and all matching
 * Courses, Podcasts (Episodes), and Blog Posts from Sanity.
 */
import groq from "groq";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentGrid from "@/components/ContentGrid.astro";
import ExcalidrawDiagram from "@/components/ExcalidrawDiagram.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TopicFilterStrip from "@/components/TopicFilterStrip.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { resolvePartnerUrl } from "@/lib/partner-links";
import { getTopicBySlug } from "@/lib/topics";

const { slug } = Astro.params;
const topic = slug ? getTopicBySlug(slug) : undefined;

if (!topic) {
	return new Response(null, { status: 404 });
}

const { sanity } = Astro.locals;
const primaryKeyword = `*${topic.keywords[0]}*`;
const secondaryKeyword = `*${topic.keywords[1] ?? topic.keywords[0]}*`;

const topicHubQuery = groq`{
	"courses": *[_type == "course" && defined(slug.current) && (title match $kw1 || excerpt match $kw1 || title match $kw2 || excerpt match $kw2)] | order(_createdAt desc)[0...6]{
		_id,
		_type,
		title,
		"slug": slug.current,
		excerpt,
		coverImage,
		date
	},
	"posts": *[_type == "post" && defined(slug.current) && (title match $kw1 || excerpt match $kw1 || title match $kw2 || excerpt match $kw2)] | order(date desc)[0...9]{
		_id,
		_type,
		title,
		"slug": slug.current,
		excerpt,
		coverImage,
		date,
		"author": author[]->{ _id, title, "slug": slug.current, coverImage }
	},
	"podcasts": *[_type == "podcast" && defined(slug.current) && (title match $kw1 || excerpt match $kw1 || title match $kw2 || excerpt match $kw2)] | order(date desc)[0...9]{
		_id,
		_type,
		title,
		"slug": slug.current,
		excerpt,
		coverImage,
		date,
		"author": author[]->{ _id, title, "slug": slug.current, coverImage },
		"guest": guest[]->{ _id, title, "slug": slug.current, coverImage }
	}
}`;

const data = (await sanity.loadQuery(topicHubQuery, {
	kw1: primaryKeyword,
	kw2: secondaryKeyword,
})) as unknown as {
	courses?: ContentListItem[];
	posts?: ContentListItem[];
	podcasts?: ContentListItem[];
};

const courses = data?.courses ?? [];
const posts = data?.posts ?? [];
const podcasts = data?.podcasts ?? [];
const partnerHref = topic.partnerUrl
	? resolvePartnerUrl(topic.partnerUrl)
	: undefined;
---

<BaseLayout
	title={`${topic.title} Courses, Podcasts & Blog Posts | CodingCat.dev`}
	description={topic.description}
	canonical={`/topic/${topic.slug}`}
>
	<Breadcrumbs
		links={[
			{ title: "Topics & Vendors", href: "/topics" },
			{ title: topic.title },
		]}
	/>

	<TopicFilterStrip activeSlug={topic.slug} />

	{/* Vendor / Topic Hero Header Card */}
	<section class="duo-card hand-border my-6 p-6 md:p-10">
		<div class="grid items-center gap-8 lg:grid-cols-12">
			<div class="space-y-4 lg:col-span-7">
				<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200">
					{topic.badge}
				</span>

				<h1 class="font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-6xl">
					{topic.title}<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
				</h1>

				<p class="font-hand text-2xl font-bold text-[#7C3AED] dark:text-[#C084FC]">
					{topic.tagline}
				</p>

				<p class="max-w-2xl text-base font-medium leading-relaxed text-[#2A1155]/80 dark:text-slate-300">
					{topic.description}
				</p>

				<div class="flex flex-wrap items-center gap-3 pt-2">
					{partnerHref && (
						<a
							href={partnerHref}
							target="_blank"
							rel="noopener noreferrer"
							class="tactile-btn px-6 py-3 text-sm"
						>
							<span>{topic.partnerCtaLabel || `Try ${topic.title}`}</span>
							<span class="text-[#86EFAC]">&nearr;</span>
						</a>
					)}
					<a
						href={`/search?q=${encodeURIComponent(topic.title)}`}
						class="tactile-btn-secondary px-5 py-3 text-sm font-extrabold"
					>
						Search All {topic.title} Content
					</a>
				</div>
			</div>

			{/* Official Vendor Light/Dark Logo Showcase */}
			<div class="lg:col-span-5">
				{topic.logoLight && topic.logoDark ? (
					<div class="flex flex-col items-center justify-center gap-4 rounded-3xl border-2 border-[#2A1155] bg-[#FAF9FC] p-8 shadow-sketch-sm dark:border-white/25 dark:bg-[#0B1326]">
						<img
							src={topic.logoLight}
							alt={`${topic.title} official logo`}
							class="max-h-20 w-auto object-contain dark:hidden"
						/>
						<img
							src={topic.logoDark}
							alt={`${topic.title} official logo`}
							class="hidden max-h-20 w-auto object-contain dark:block"
						/>
						<span class="font-mono text-xs font-bold text-[#2A1155]/65 dark:text-slate-400">
							Official {topic.title} Brand Lockup ({posts.length} Blog Posts · {podcasts.length} Episodes)
						</span>
					</div>
				) : (
					<div class="flex flex-col items-center justify-center gap-3 rounded-3xl border-2 border-[#2A1155] bg-[#EDE9FE] p-8 text-center shadow-sketch-sm dark:border-purple-400/30 dark:bg-purple-950/50">
						<span class="font-display text-4xl font-black text-[#2A1155] dark:text-white">
							{topic.title}
						</span>
						<span class="font-mono text-xs font-bold text-[#7C3AED] dark:text-[#C084FC]">
							{posts.length} Blog Posts · {podcasts.length} Podcast Episodes
						</span>
					</div>
				)}
			</div>
		</div>

		{/* Hand-Drawn Architecture Diagram */}
		<div class="mt-8">
			<ExcalidrawDiagram
				title={topic.diagram.title}
				caption={topic.diagram.caption}
				compact={true}
				nodes={topic.diagram.nodes}
				edges={topic.diagram.edges}
			/>
		</div>
	</section>

	{/* Matching Courses */}
	{
		courses.length > 0 && (
			<section class="my-12">
				<SectionHeader
					title={`${topic.title} Courses`}
					href="/courses"
					linkText="All Courses"
				/>
				<ContentGrid items={courses} priorityCount={0} />
			</section>
		)
	}

	{/* Matching Blog Posts */}
	{
		posts.length > 0 && (
			<section class="my-12">
				<SectionHeader
					title={`${topic.title} Blog Posts`}
					href="/blog/page/1"
					linkText="All Blog Posts"
				/>
				<ContentGrid items={posts} priorityCount={2} />
			</section>
		)
	}

	{/* Matching Podcast Episodes */}
	{
		podcasts.length > 0 && (
			<section class="my-12 mb-24">
				<SectionHeader
					title={`${topic.title} Podcast Episodes`}
					href="/podcasts/page/1"
					linkText="All Podcasts"
				/>
				<ContentGrid items={podcasts} priorityCount={0} />
			</section>
		)
	}
</BaseLayout>
