---
/**
 * `/topic/[slug]` | Vendor, Framework, Language & Technology Hub Page
 * (e.g. `/topic/sanity`, `/topic/firebase`, `/topic/amplify`, `/topic/typescript`, `/topic/hono`).
 *
 * Displays the official vendor/brand logo lockup, a hand-drawn architecture diagram,
 * partner CTA (if applicable), and matching Courses, Podcasts (Episodes), and Blog Posts from Sanity.
 */
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentGrid from "@/components/ContentGrid.astro";
import ExcalidrawDiagram from "@/components/ExcalidrawDiagram.astro";
import InfiniteContentGrid from "@/components/InfiniteContentGrid.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TopicFilterStrip from "@/components/TopicFilterStrip.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { resolvePartnerUrl } from "@/lib/partner-links";
import {
	coursesQuery,
	morePodcastQuery,
	morePostQuery,
} from "@/lib/sanity/queries";
import { getTopicBySlug, itemMatchesTopic } from "@/lib/topics";

const { slug } = Astro.params;
const topic = slug ? getTopicBySlug(slug) : undefined;

if (!topic) {
	return new Response(null, { status: 404 });
}

// Redirect alias slugs (e.g. /topic/next.js -> /topic/nextjs) to canonical slug
if (slug && slug !== topic.slug) {
	return Astro.redirect(`/topic/${topic.slug}`, 301);
}

const { sanity } = Astro.locals;

const [rawCourses, allPosts, allPodcasts] = await Promise.all([
	sanity.loadQuery(coursesQuery),
	sanity.loadQuery(morePostQuery, { skip: "none", offset: 0, limit: 300 }),
	sanity.loadQuery(morePodcastQuery, { skip: "none", offset: 0, limit: 300 }),
]);

interface RawCourseWithLessons extends ContentListItem {
	sections?: Array<{
		title?: string | null;
		lessons?: Array<{
			title?: string | null;
			excerpt?: string | null;
			tags?: Array<{ label?: string | null; value?: string | null }> | null;
		}> | null;
	}> | null;
}

const courses = ((rawCourses ?? []) as unknown as RawCourseWithLessons[]).filter(
	(course) => {
		if (itemMatchesTopic(course.title, course.excerpt, topic, course.tags)) {
			return true;
		}
		for (const sec of course.sections ?? []) {
			for (const lesson of sec?.lessons ?? []) {
				if (
					itemMatchesTopic(lesson?.title, lesson?.excerpt, topic, lesson?.tags)
				) {
					return true;
				}
			}
		}
		return false;
	},
);

const matchedPosts = ((allPosts ?? []) as ContentListItem[]).filter((item) =>
	itemMatchesTopic(item.title, item.excerpt, topic, item.tags),
);
const matchedPodcasts = ((allPodcasts ?? []) as ContentListItem[]).filter(
	(item) => itemMatchesTopic(item.title, item.excerpt, topic, item.tags),
);

const INITIAL_BATCH = 8;
const posts = matchedPosts.slice(0, INITIAL_BATCH);
const podcasts = matchedPodcasts.slice(0, INITIAL_BATCH);
const partnerHref = topic.partnerUrl
	? resolvePartnerUrl(topic.partnerUrl)
	: undefined;
---

<BaseLayout
	title={`${topic.title} Courses, Podcasts & Blog Posts | CodingCat.dev`}
	description={topic.description}
	canonical={`/topic/${topic.slug}`}
>
	<div class="flex flex-wrap items-center justify-between gap-3">
		<Breadcrumbs
			links={[
				{ title: "Topics & Vendors", href: "/topics" },
				{ title: topic.title },
			]}
		/>
		<TopicFilterStrip
			activeSlug={topic.slug}
			allLabel="All Hubs"
			variant="inline"
		/>
	</div>

	{/* Vendor / Topic Hero Header Card */}
	<section class="duo-card hand-border my-6 p-6 md:p-10">
		<div class="grid items-center gap-8 lg:grid-cols-12">
			<div class="space-y-4 lg:col-span-7">
				<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200">
					{topic.badge}
				</span>

				<h1 class="font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-6xl">
					{topic.title}<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
				</h1>

				<p class="font-hand text-2xl font-bold text-[#7C3AED] dark:text-[#C084FC]">
					{topic.tagline}
				</p>

				<p class="max-w-2xl text-base font-medium leading-relaxed text-[#2A1155]/80 dark:text-slate-300">
					{topic.description}
				</p>

				<div class="flex flex-wrap items-center gap-3 pt-2">
					{partnerHref && (
						<a
							href={partnerHref}
							target="_blank"
							rel="noopener noreferrer"
							class="tactile-btn px-6 py-3 text-sm"
						>
							<span>{topic.partnerCtaLabel || `Try ${topic.title}`}</span>
							<span class="text-[#86EFAC]">&nearr;</span>
						</a>
					)}
					<a
						href={`/courses?topic=${encodeURIComponent(topic.slug)}`}
						class="tactile-btn px-5 py-3 text-sm"
					>
						<span>Filter {topic.title} Courses</span>
						<span class="text-[#86EFAC]">&rarr;</span>
					</a>
					<a
						href={`/search?q=${encodeURIComponent(topic.title)}`}
						class="tactile-btn-secondary px-5 py-3 text-sm font-extrabold"
					>
						Search All {topic.title} Content
					</a>
				</div>
			</div>

			{/* Official Vendor / Tag Light/Dark Logo Showcase */}
			<div class="lg:col-span-5">
				{topic.kind === "brand" && topic.logoLight && topic.logoDark ? (
					<div class="flex flex-col items-center justify-center gap-4 rounded-3xl border-2 border-[#2A1155] bg-[#FAF9FC] p-8 shadow-sketch-sm dark:border-white/25 dark:bg-[#0B1326]">
						<img
							src={topic.logoLight}
							alt={`${topic.title} official logo`}
							class="max-h-20 w-auto object-contain dark:hidden"
						/>
						<img
							src={topic.logoDark}
							alt={`${topic.title} official logo`}
							class="hidden max-h-20 w-auto object-contain dark:block"
						/>
						<span class="font-mono text-xs font-bold text-[#2A1155]/65 dark:text-slate-400">
							{courses.length} Courses · {matchedPosts.length} Blog Posts · {matchedPodcasts.length} Episodes
						</span>
					</div>
				) : (
					<div class="flex flex-col items-center justify-center gap-3 rounded-3xl border-2 border-dashed border-[#2A1155]/40 bg-[#EDE9FE]/70 p-8 text-center shadow-sketch-sm dark:border-purple-400/30 dark:bg-purple-950/40">
						<span class="inline-flex size-12 items-center justify-center rounded-2xl border-2 border-[#2A1155] bg-white font-mono text-2xl font-black text-[#7C3AED] dark:border-white/25 dark:bg-[#0B1326] dark:text-[#C084FC]">
							#
						</span>
						<span class="font-display text-3xl font-black text-[#2A1155] dark:text-white">
							{topic.title}
						</span>
						<span class="font-mono text-xs font-bold text-[#7C3AED] dark:text-[#C084FC]">
							{courses.length} Courses · {matchedPosts.length} Blog Posts · {matchedPodcasts.length} Podcast Episodes
						</span>
					</div>
				)}
			</div>
		</div>

		{/* Hand-Drawn Architecture Diagram (only for technical & vendor hubs) */}
		{topic.hasArchitectureDiagram && (
			<div class="mt-8">
				<ExcalidrawDiagram
					title={topic.diagram.title}
					caption={topic.diagram.caption}
					compact={true}
					nodes={topic.diagram.nodes}
					edges={topic.diagram.edges}
				/>
			</div>
		)}
	</section>

	{/* Matching Courses */}
	{
		courses.length > 0 && (
			<section class="my-12">
				<SectionHeader
					title={`${topic.title} Courses`}
					href={`/courses?topic=${topic.slug}`}
					linkText="Filter on Courses Page"
				/>
				<ContentGrid items={courses} priorityCount={0} />
			</section>
		)
	}

	{/* Matching Blog Posts (Infinite Scroll) */}
	{
		posts.length > 0 && (
			<section class="my-12">
				<SectionHeader title={`${topic.title} Blog Posts`} />
				<InfiniteContentGrid
					type="post"
					items={posts}
					skipId="none"
					initialOffset={posts.length}
					totalCount={matchedPosts.length}
					batchSize={INITIAL_BATCH}
					activeTopic={topic.slug}
					showSearch={true}
					enableTopicFilter={false}
					searchPlaceholder={`Filter ${topic.title} blog posts...`}
					priorityCount={2}
					nounPlural="blog posts"
				/>
			</section>
		)
	}

	{/* Matching Podcast Episodes (Infinite Scroll) */}
	{
		podcasts.length > 0 && (
			<section class="my-12 mb-24">
				<SectionHeader title={`${topic.title} Podcast Episodes`} />
				<InfiniteContentGrid
					type="podcast"
					items={podcasts}
					skipId="none"
					initialOffset={podcasts.length}
					totalCount={matchedPodcasts.length}
					batchSize={INITIAL_BATCH}
					activeTopic={topic.slug}
					showSearch={true}
					enableTopicFilter={false}
					searchPlaceholder={`Filter ${topic.title} episodes...`}
					priorityCount={0}
					nounPlural="episodes"
				/>
			</section>
		)
	}
</BaseLayout>
