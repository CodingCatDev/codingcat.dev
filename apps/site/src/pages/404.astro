---
import BaseLayout from "@/layouts/BaseLayout.astro";

// `output: "server"` renders this on demand, so set the status explicitly —
// otherwise a missing page would answer 200 and get indexed as a soft 404.
Astro.response.status = 404;
---

<BaseLayout title="Page not found | CodingCat.dev" noindex>
	<div class="flex flex-col items-center justify-center gap-6 py-32 text-center">
		<p class="text-7xl font-bold tracking-tighter">404</p>
		<h1 class="text-3xl font-bold">This page wandered off</h1>
		<p class="max-w-prose text-lg text-muted-foreground">
			The page you were looking for does not exist, or it moved somewhere else.
		</p>
		<div class="flex flex-wrap justify-center gap-3">
			<a
				href="/"
				class="inline-flex items-center rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
			>
				Go home
			</a>
			<a
				href="/blog"
				class="inline-flex items-center rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-accent transition-colors"
			>
				Read the blog
			</a>
			<a
				href="/podcasts"
				class="inline-flex items-center rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-accent transition-colors"
			>
				Listen to podcasts
			</a>
		</div>
	</div>
</BaseLayout>
