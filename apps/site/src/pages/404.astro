---
import AjMascot from "@/components/AjMascot.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

Astro.response.status = 404;
---

<BaseLayout title="Page not found | CodingCat.dev" noindex>
	<section class="mx-auto max-w-2xl py-16 text-center">
		<div class="duo-card hand-border flex flex-col items-center gap-5 p-8 md:p-12">
			<AjMascot
				pose="yarn-chase"
				cls="w-36 h-auto"
				caption="404: Yarn tangled!"
			/>
			<h1 class="font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-5xl">
				This page wandered off<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
			</h1>
			<p class="font-hand text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				AJ chased the yarn string a little too far! Try one of our main sections below:
			</p>
			<div class="mt-2 flex flex-wrap justify-center gap-3">
				<a href="/" class="tactile-btn px-6 py-3 text-sm">
					<span>Go Home</span>
					<span class="text-[#86EFAC]">&rarr;</span>
				</a>
				<a href="/courses" class="tactile-btn-secondary px-5 py-3 text-sm font-extrabold">
					Browse Courses
				</a>
				<a href="/podcasts" class="tactile-btn-secondary px-5 py-3 text-sm font-extrabold">
					Listen to Podcasts
				</a>
				<a href="/blog" class="tactile-btn-secondary px-5 py-3 text-sm font-extrabold">
					Read the Blog
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
