---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMultiCalendarAvailableSlots } from "@/lib/google-calendar";
import { portableTextToHtml } from "@/lib/guest-portal";
import {
	extractPortalAllowedEmails,
	maskEmailAddress,
	verifyPortalRequestAuth,
} from "@/lib/portal-security";
import {
	getSanityServerClient,
	resolveSponsorTier,
} from "@/lib/sanity/write-client";

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");

const { token } = Astro.params;
const searchParams = Astro.url.searchParams;

const [
	{ slots: kickoffSlots, liveVerified: calendarLiveVerified },
	{ slots: recordingSlots },
] = await Promise.all([
	getMultiCalendarAvailableSlots(6, 15),
	getMultiCalendarAvailableSlots(6, 45),
]);

interface DeliverableItem {
	title: string;
	channel: string;
	status: string;
	url?: string;
	views?: number;
	publishedAt?: string;
}

interface VaultAssetItem {
	_key?: string;
	title: string;
	category?: string;
	visibility?: "private" | "public";
	uploadedBy?: "partner" | "codingcat" | "passionfroot";
	uploadedAt?: string;
	assetId?: string;
	mimeType?: string;
	fileSize?: number;
	externalUrl?: string;
}

interface LeadPortalData {
	_id: string;
	portalToken: string;
	companyName: string;
	contactName: string;
	contactEmail: string;
	source: string;
	billingProvider: string;
	status: string;
	rateCard: string;
	packageName: string;
	packageDescription: string;
	totalAmountCents: number;
	depositAmountCents: number;
	balanceAmountCents: number;
	depositPaidAt?: string;
	balancePaidAt?: string;
	stripeDepositCheckoutUrl?: string;
	stripeDepositInvoiceUrl?: string;
	stripeBalanceCheckoutUrl?: string;
	stripeBalanceInvoiceUrl?: string;
	deliverables: DeliverableItem[];
	sharedAssets: VaultAssetItem[];
	bookingStatus?: string;
	bookingSlotStartAt?: string;
	recordingUrl?: string;
	preMeetingStatus?: string;
	preMeetingSlotStartAt?: string;
	preMeetingMeetUrl?: string;
	topics?: string;
	preCallNotes?: string;
	runOfShowNotes?: string;
	guestQuestions?: string;
	runOfShowUpdatedAt?: string;
	runOfShowUpdatedBy?: string;
	hasSignedRelease?: boolean;
	signedAt?: string;
	signatureMode?: string;
	guestSlug?: string;
	guestTitle?: string;
	guestAvatarUrl?: string;
	guestExcerpt?: string;
	guestAboutHtml?: string;
	guestWebsiteUrl?: string;
	guestSocials?: Record<string, string>;
}

function slugifyGuestName(name: string): string {
	return (name || "")
		.toLowerCase()
		.normalize("NFKD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-+|-+$/g, "")
		.slice(0, 64);
}

const socialFields = [
	{
		key: "twitter",
		label: "X (Twitter)",
		placeholder: "@username or https://x.com/username",
		priority: true,
	},
	{
		key: "bluesky",
		label: "Bluesky",
		placeholder: "handle.bsky.social or https://bsky.app/profile/...",
		priority: true,
	},
	{
		key: "linkedin",
		label: "LinkedIn",
		placeholder: "https://www.linkedin.com/in/username",
		priority: true,
	},
	{
		key: "github",
		label: "GitHub",
		placeholder: "username or https://github.com/username",
		priority: true,
	},
	{
		key: "youtube",
		label: "YouTube Channel",
		placeholder: "@channel or https://www.youtube.com/@channel",
		priority: true,
	},
	{
		key: "twitch",
		label: "Twitch",
		placeholder: "https://www.twitch.tv/username",
		priority: true,
	},
	{
		key: "instagram",
		label: "Instagram",
		placeholder: "@username or https://www.instagram.com/username",
		priority: false,
	},
	{
		key: "threads",
		label: "Threads",
		placeholder: "@username or https://www.threads.net/@username",
		priority: false,
	},
	{
		key: "mastodon",
		label: "Mastodon",
		placeholder: "@user@mastodon.social or full URL",
		priority: false,
	},
	{
		key: "tiktok",
		label: "TikTok",
		placeholder: "@username or https://www.tiktok.com/@username",
		priority: false,
	},
	{
		key: "facebook",
		label: "Facebook",
		placeholder: "https://www.facebook.com/username",
		priority: false,
	},
	{
		key: "substack",
		label: "Substack",
		placeholder: "https://username.substack.com",
		priority: false,
	},
	{
		key: "devto",
		label: "Dev.to",
		placeholder: "https://dev.to/username",
		priority: false,
	},
	{
		key: "medium",
		label: "Medium",
		placeholder: "https://medium.com/@username",
		priority: false,
	},
];

const fallbackTier = resolveSponsorTier(searchParams.get("tier") || "full-stack-launch");
const fallbackCompany = searchParams.get("company") || "Sponsor Partner";
const fallbackName = searchParams.get("name") || "Sponsor Team";
const fallbackEmail = searchParams.get("email") || "";
const paymentNotice = searchParams.get("payment");
const bookedSlotParam = searchParams.get("bookedSlot");

let portalFound = false;
let isPortalAuthorized = false;
let isPortalAuthenticated = false;
let authReason: string | undefined;
let maskedEmailHint = "your invited email address";
let verifiedPortalEmail = "";

let portalData: LeadPortalData = {
	_id: `private.sponsorLead-${token}`,
	portalToken: token || "",
	companyName: fallbackCompany,
	contactName: fallbackName,
	contactEmail: fallbackEmail,
	source: token?.startsWith("spt_pf_") ? "passionfroot" : "booking",
	billingProvider: token?.startsWith("spt_pf_") ? "passionfroot" : "stripe",
	status: paymentNotice === "deposit_success" ? "deposit_paid" : "new",
	rateCard: fallbackTier.id,
	packageName: fallbackTier.name,
	packageDescription: fallbackTier.description,
	totalAmountCents: fallbackTier.totalAmountCents,
	depositAmountCents: fallbackTier.depositAmountCents,
	balanceAmountCents: fallbackTier.balanceAmountCents,
	deliverables: fallbackTier.deliverables.map((d) => ({
		title: d.title,
		channel: d.channel,
		status: paymentNotice === "deposit_success" ? "in-progress" : "pending",
	})),
	sharedAssets: [],
};

try {
	const { client } = getSanityServerClient();
	const [doc, bookingDoc] = await Promise.all([
		client.fetch<Record<string, any> | null>(
			`*[_type == "sponsorLead" && (portalToken == $portalToken || legacyPortalToken == $portalToken || _id == $privateLeadId || _id == $leadId)][0]`,
			{
				portalToken: token ?? "",
				privateLeadId: `private.sponsorLead-${token ?? ""}`,
				leadId: `sponsorLead-${token ?? ""}`,
			},
		),
		client.fetch<Record<string, any> | null>(
			`*[_type == "booking" && (portalToken == $portalToken || legacyPortalToken == $portalToken || _id == $privateBookingId)] | order(_createdAt desc)[0]`,
			{
				portalToken: token ?? "",
				privateBookingId: `private.booking-${token ?? ""}`,
			},
		),
	]);
	if (doc || bookingDoc) {
		portalFound = true;
		const canonicalToken =
			doc?.portalToken || bookingDoc?.portalToken || token || "";
		const allowedEmails = extractPortalAllowedEmails(doc, bookingDoc);
		maskedEmailHint = maskEmailAddress(
			bookingDoc?.guestEmail || doc?.contactEmail || allowedEmails[0],
		);

		const authResult = await verifyPortalRequestAuth({
			request: Astro.request,
			url: Astro.url,
			token: canonicalToken,
			allowedEmails,
		});
		isPortalAuthorized = authResult.authorized;
		isPortalAuthenticated = authResult.authenticated;
		authReason = authResult.reason;
		verifiedPortalEmail = authResult.verifiedEmail || "";

		const resolvedGuestName =
			bookingDoc?.guestName || doc?.contactName || fallbackName;
		const candidateSlug =
			bookingDoc?.guestSlug ||
			doc?.guestSlug ||
			slugifyGuestName(resolvedGuestName) ||
			canonicalToken;
		const guestProfileDoc = await client
			.fetch<{
				_id: string;
				title?: string;
				slug?: { current?: string };
				avatarUrl?: string;
				excerpt?: string;
				content?: unknown[];
				socials?: Record<string, string>;
				websites?: Array<{ site?: string; link?: { href?: string } }>;
			} | null>(
				`*[_type in ["guest", "author"] && (
					slug.current == $slug ||
					_id in [$docId, $draftId, $pubId] ||
					lower(title) == lower($guestName)
				)] | order(_id asc)[0]{
					_id,
					title,
					slug,
					"avatarUrl": coverImage.asset->url,
					excerpt,
					content,
					socials,
					websites
				}`,
				{
					slug: candidateSlug,
					docId: bookingDoc?.guestDocId || `drafts.guest-${candidateSlug}`,
					draftId: `drafts.guest-${candidateSlug}`,
					pubId: `guest-${candidateSlug}`,
					guestName: resolvedGuestName,
				},
			)
			.catch(() => null);

		const tier = resolveSponsorTier(doc?.rateCard || fallbackTier.id);
		const combinedAssets = [
			...(Array.isArray(doc?.sharedAssets) ? doc.sharedAssets : []),
			...(Array.isArray(bookingDoc?.sharedAssets) ? bookingDoc.sharedAssets : []),
		];
		const isPf =
			doc?.source === "passionfroot" ||
			doc?.billingProvider === "passionfroot" ||
			bookingDoc?.bookingSource === "passionfroot" ||
			Boolean(token?.startsWith("spt_pf_"));
		const resolvedBookingStatus = bookingDoc?.status;
		const isRecordingApproved =
			resolvedBookingStatus === "approved" ||
			resolvedBookingStatus === "scheduled" ||
			resolvedBookingStatus === "confirmed";

		portalData = {
			_id: doc?._id || bookingDoc?._id || `private.sponsorLead-${token}`,
			portalToken: canonicalToken,
			companyName:
				doc?.companyName || bookingDoc?.company || fallbackCompany,
			contactName:
				doc?.contactName || bookingDoc?.guestName || fallbackName,
			contactEmail:
				doc?.contactEmail || bookingDoc?.guestEmail || fallbackEmail,
			source: isPf
				? "passionfroot"
				: doc?.source || bookingDoc?.track || "booking",
			billingProvider: isPf ? "passionfroot" : doc?.billingProvider || "stripe",
			status:
				paymentNotice === "deposit_success"
					? "deposit_paid"
					: paymentNotice === "balance_success"
						? "paid"
						: doc?.status || bookingDoc?.status || "new",
			rateCard: tier.id,
			packageName:
				!doc && bookingDoc?.track === "editorial"
					? "Editorial Podcast Session"
					: tier.name,
			packageDescription:
				!doc && bookingDoc?.track === "editorial"
					? "45-minute technical deep-dive recording on CodingCat.dev Studio + Sanity Media Library Asset Vault."
					: tier.description,
			totalAmountCents:
				!doc && bookingDoc?.track === "editorial"
					? 0
					: doc?.totalAmountCents || tier.totalAmountCents,
			depositAmountCents: doc?.depositAmountCents || tier.depositAmountCents,
			balanceAmountCents: doc?.balanceAmountCents || tier.balanceAmountCents,
			depositPaidAt: doc?.depositPaidAt,
			balancePaidAt: doc?.balancePaidAt,
			stripeDepositCheckoutUrl: doc?.stripeDepositCheckoutUrl,
			stripeDepositInvoiceUrl: doc?.stripeDepositInvoiceUrl,
			stripeBalanceCheckoutUrl: doc?.stripeBalanceCheckoutUrl,
			stripeBalanceInvoiceUrl: doc?.stripeBalanceInvoiceUrl,
			deliverables:
				Array.isArray(doc?.deliverables) && doc.deliverables.length > 0
					? doc.deliverables
					: tier.deliverables.map((d) => ({
							title: d.title,
							channel: d.channel,
							status: "pending",
						})),
			sharedAssets: combinedAssets,
			bookingStatus: resolvedBookingStatus,
			bookingSlotStartAt: bookingDoc?.slotStartAt,
			recordingUrl: isRecordingApproved
				? bookingDoc?.recordingUrl || "https://streamyard.com/c4kv26is93"
				: undefined,
			preMeetingStatus: bookingDoc?.preMeetingStatus,
			preMeetingSlotStartAt: bookingDoc?.preMeetingSlotStartAt,
			preMeetingMeetUrl: bookingDoc?.preMeetingMeetUrl,
			topics: bookingDoc?.topics || doc?.intent || "",
			preCallNotes: bookingDoc?.preCallNotes || doc?.preCallNotes || "",
			runOfShowNotes: bookingDoc?.runOfShowNotes || doc?.runOfShowNotes || "",
			guestQuestions: bookingDoc?.guestQuestions || doc?.guestQuestions || "",
			runOfShowUpdatedAt:
				bookingDoc?.runOfShowUpdatedAt || doc?.runOfShowUpdatedAt,
			runOfShowUpdatedBy:
				bookingDoc?.runOfShowUpdatedBy || doc?.runOfShowUpdatedBy,
			hasSignedRelease: Boolean(bookingDoc?.signatureData),
			signedAt: bookingDoc?.signedAt,
			signatureMode: bookingDoc?.signatureMode,
			guestSlug: guestProfileDoc?.slug?.current || candidateSlug,
			guestTitle:
				guestProfileDoc?.title ||
				bookingDoc?.guestName ||
				doc?.contactName ||
				fallbackName,
			guestAvatarUrl: guestProfileDoc?.avatarUrl || "",
			guestExcerpt:
				guestProfileDoc?.excerpt &&
				guestProfileDoc.excerpt.trim().toLowerCase() !== "fix me"
					? guestProfileDoc.excerpt.trim()
					: `${bookingDoc?.guestName || doc?.contactName || fallbackName} (${bookingDoc?.company || doc?.companyName || fallbackCompany})`,
			guestAboutHtml: portableTextToHtml(guestProfileDoc?.content),
			guestWebsiteUrl:
				guestProfileDoc?.websites?.[0]?.link?.href ||
				guestProfileDoc?.websites?.[0]?.site ||
				bookingDoc?.socialUrl ||
				doc?.website ||
				"",
			guestSocials: guestProfileDoc?.socials || {},
		};
	}
} catch {
	// Handled by portalFound check below
}

if (!portalFound) {
	Astro.response.status = 404;
}

const formatUsd = (cents: number) =>
	new Intl.NumberFormat("en-US", {
		style: "currency",
		currency: "USD",
		maximumFractionDigits: 0,
	}).format(cents / 100);

const isDepositPaid =
	Boolean(portalData.depositPaidAt) ||
	portalData.status === "deposit_paid" ||
	portalData.status === "booked" ||
	portalData.status === "balance_sent" ||
	portalData.status === "paid";

const isBalancePaid =
	Boolean(portalData.balancePaidAt) || portalData.status === "paid";

const pageTitle = !portalFound
	? "Studio Portal Not Found | CodingCat.dev"
	: !isPortalAuthorized
		? "Verify Studio Portal Access | CodingCat.dev"
		: `${portalData.companyName} x CodingCat.dev: Studio & Deal Room`;

const pageDescription = !portalFound
	? "This CodingCat.dev Studio Portal link was not found."
	: !isPortalAuthorized
		? "Verify your invited guest or sponsor email address to unlock your private CodingCat.dev Studio Portal."
		: `Live studio coordination, run-of-show notes, calendar scheduling, and asset vault for ${portalData.companyName}.`;
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
>
	<Breadcrumbs
		links={[
			{ title: "Sponsorships", href: "/sponsorships" },
			{
				title:
					portalFound && isPortalAuthorized
						? `${portalData.companyName} Studio Portal`
						: "Studio Portal",
			},
		]}
	/>

	{!portalFound ? (
		<div class="w-full max-w-2xl mx-auto my-12 p-8 rounded-2xl border border-border bg-card shadow-xs flex flex-col gap-4 text-center">
			<span class="mx-auto px-3 py-1 rounded-full text-xs font-mono uppercase tracking-wider bg-destructive/15 text-destructive font-bold">
				404 &middot; Portal Token Not Found
			</span>
			<h1 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
				Studio Portal Link Not Recognized
			</h1>
			<p class="text-sm text-muted-foreground leading-relaxed">
				We could not find an active guest booking or sponsor deal room matching this token. If you recently received an updated portal invite from Alex Patterson, please use the latest link in your calendar invite or email.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-3 pt-2">
				<a
					href="/book"
					class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 transition-colors"
				>
					Book a Podcast or Sponsor Session &rarr;
				</a>
				<a
					href="mailto:alex@codingcat.dev"
					class="px-4 py-2 rounded-lg border border-border bg-background text-foreground text-xs font-semibold hover:bg-muted transition-colors"
				>
					Email alex@codingcat.dev
				</a>
			</div>
		</div>
	) : !isPortalAuthorized ? (
		<div class="w-full max-w-xl mx-auto my-12 p-6 md:p-8 rounded-2xl border-2 border-primary/40 bg-card shadow-xs flex flex-col gap-5">
			<div class="flex items-center justify-between gap-2">
				<span class="px-3 py-1 rounded-full text-xs font-mono uppercase tracking-wider bg-primary/15 text-primary font-bold">
					🔒 Better-Auth Studio Checkpoint
				</span>
				<span class="text-xs font-mono text-muted-foreground">
					6-Digit OTP &middot; Magic Link &middot; Google OAuth
				</span>
			</div>

			<div class="flex flex-col gap-2">
				<h1 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
					Sign In to Unlock Studio Portal
				</h1>
				<p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
					To protect private StreamYard studio links, Google Meet pre-call rooms, run-of-show outlines, and Sanity Media Library vault assets, this portal requires a verified Better-Auth session for the invited email address
					{maskedEmailHint ? (
						<span>
							{" "}(hint: <code class="px-1.5 py-0.5 rounded bg-muted text-foreground font-mono">{maskedEmailHint}</code> or the same company domain)
						</span>
					) : null}.
				</p>
			</div>

			{isPortalAuthenticated && authReason === "forbidden_email" ? (
				<div class="p-4 rounded-xl border border-amber-500/40 bg-amber-500/10 flex flex-col gap-3">
					<p class="text-xs text-foreground leading-relaxed">
						<strong>Account Mismatch:</strong> You are currently signed in via Better-Auth as <code class="px-1.5 py-0.5 rounded bg-background font-mono">{verifiedPortalEmail}</code>, which is not on the invite list for this Studio Portal ({maskedEmailHint}).
					</p>
					<button
						type="button"
						id="btn-portal-switch-account"
						class="self-start px-3.5 py-2 rounded-lg bg-foreground text-background text-xs font-bold hover:opacity-90 transition-opacity cursor-pointer"
					>
						Sign Out &amp; Switch Account &rarr;
					</button>
				</div>
			) : null}

			<!-- Method 1: Continue with Google OAuth -->
			<div class="flex flex-col gap-2.5">
				<button
					type="button"
					id="btn-portal-google"
					class="w-full flex items-center justify-center gap-2.5 px-4 py-2.5 rounded-lg border-2 border-border bg-background hover:bg-muted text-foreground text-xs font-bold transition-colors cursor-pointer"
				>
					<svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
						<path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.8C6.2 7.2 8.9 5 12 5z"/>
						<path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.6l3.7 2.9c2.2-2 3.7-5 3.7-8.7z"/>
						<path fill="#FBBC05" d="M5.3 14.8c-.2-.8-.4-1.6-.4-2.5s.2-1.7.4-2.5L1.6 7C.6 9 0 11.2 0 13.5s.6 4.5 1.6 6.5l3.7-2.9z"/>
						<path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5l-3.7 2.8C3.5 20.9 7.4 24 12 24z"/>
					</svg>
					<span>Continue with Google (OAuth)</span>
				</button>
			</div>

			<div class="relative flex items-center py-1">
				<div class="flex-grow border-t border-border"></div>
				<span class="flex-shrink mx-3 text-[11px] font-mono uppercase tracking-wider text-muted-foreground">
					or verify via One-Time Password / Magic Link
				</span>
				<div class="flex-grow border-t border-border"></div>
			</div>

			<!-- Method 2 & 3: 6-Digit Email OTP + 1-Click Magic Link -->
			<form id="portal-otp-request-form" class="flex flex-col gap-3">
				<div class="flex flex-col gap-1.5">
					<label for="portal-auth-email" class="text-xs font-semibold text-foreground">
						Invited Guest / Sponsor Email Address
					</label>
					<input
						type="email"
						id="portal-auth-email"
						name="email"
						required
						autocomplete="email"
						placeholder={maskedEmailHint || "you@company.com"}
						class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
					/>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
					<button
						type="submit"
						id="btn-portal-send-otp"
						class="w-full px-4 py-2.5 rounded-lg bg-primary text-primary-foreground text-xs font-bold hover:bg-primary/90 transition-colors cursor-pointer"
					>
						Send 6-Digit OTP Code &rarr;
					</button>
					<button
						type="button"
						id="btn-portal-send-magic"
						class="w-full px-4 py-2.5 rounded-lg border border-primary/50 bg-primary/10 text-primary text-xs font-bold hover:bg-primary/20 transition-colors cursor-pointer"
					>
						Send 1-Click Magic Link &#9993;
					</button>
				</div>
			</form>

			<!-- Step 2: 6-Digit OTP Code Entry (revealed after sending OTP or clicking toggle) -->
			<form id="portal-otp-verify-form" class="hidden flex-col gap-3 p-4 rounded-xl border border-primary/40 bg-primary/5">
				<div class="flex items-center justify-between gap-2">
					<label for="portal-otp-code" class="text-xs font-bold text-foreground">
						Enter 6-Digit Verification Code
					</label>
					<span class="text-[11px] font-mono text-muted-foreground">
						Expires in 5 minutes
					</span>
				</div>
				<input
					type="text"
					id="portal-otp-code"
					name="otp"
					inputmode="numeric"
					pattern="[0-9]{6}"
					maxlength="6"
					autocomplete="one-time-code"
					placeholder="123456"
					class="w-full rounded-lg border-2 border-primary/50 bg-background px-4 py-2.5 text-center font-mono text-lg font-bold tracking-[0.35em] text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
				/>
