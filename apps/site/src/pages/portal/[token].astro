						<div class="p-4 bg-background flex flex-col sm:flex-row sm:items-center justify-between gap-3">
							<div class="flex flex-col gap-1">
								<div class="flex flex-wrap items-center gap-2">
									<span class="text-sm font-semibold text-foreground">
										{asset.title}
									</span>
									<span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-muted text-muted-foreground">
										{asset.category || "brief"}
									</span>
									<span class={`px-2 py-0.5 rounded text-[10px] font-mono font-semibold ${
										asset.uploadedBy === "codingcat"
											? "bg-purple-500/15 text-purple-600 dark:text-purple-300"
											: asset.uploadedBy === "passionfroot"
												? "bg-amber-500/15 text-amber-600 dark:text-amber-300"
												: "bg-emerald-500/15 text-emerald-600 dark:text-emerald-300"
									}`}>
										{asset.uploadedBy === "codingcat"
											? "From CodingCat.dev"
											: asset.uploadedBy === "passionfroot"
												? "🌱 Passionfroot Auto-Mirrored"
												: "Uploaded by Partner"}
									</span>
									{asset.visibility !== "public" && (
										<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-primary/10 text-primary">
											🔒 Private
										</span>
									)}
								</div>
								{asset.uploadedAt && (
									<span class="text-[11px] text-muted-foreground font-mono">
										Added {new Date(asset.uploadedAt).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" })}
									</span>
								)}
							</div>
							{asset.externalUrl && (
								<a
									href={asset.externalUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="px-3.5 py-1.5 rounded-lg border border-primary bg-primary/10 text-primary text-xs font-semibold hover:bg-primary/20 transition-colors shrink-0"
								>
									Open / Download Asset &nearr;
								</a>
							)}
						</div>
					))
				)}
			</div>
		</section>
		<PortalFeedbackAnnotator
			portalToken={portalData.portalToken}
			docId={portalData._id}
			authorName={portalData.contactName || portalData.companyName}
			authorEmail={verifiedPortalEmail || portalData.contactEmail}
			companyName={portalData.companyName}
			pageContext="portal"
		/>
	</div>
	)}
</BaseLayout>

<script
	is:inline
	define:vars={{
		portalToken: portalData.portalToken,
		leadId: isPortalAuthorized ? portalData._id : "",
		bookingDocId: isPortalAuthorized ? (portalData.bookingDocId || "") : "",
		companyName: isPortalAuthorized ? portalData.companyName : "",
		contactName: isPortalAuthorized ? portalData.contactName : "",
		contactEmail: isPortalAuthorized ? portalData.contactEmail : "",
		tierId: isPortalAuthorized ? portalData.rateCard : "",
		isEditorialGuest: portalData.totalAmountCents === 0,
		hasExistingRecording: Boolean(portalData.bookingSlotStartAt),
		hasExistingPreMeeting: Boolean(portalData.preMeetingSlotStartAt),
	}}
>
	// 0. Better-Auth Studio Portal Sign-In Gate (Email OTP, Magic Link, Google OAuth, Sign-Out)
	(function () {
		const emailInput = document.getElementById("portal-auth-email");
		const otpRequestForm = document.getElementById("portal-otp-request-form");
		const sendOtpBtn = document.getElementById("btn-portal-send-otp");
		const sendMagicBtn = document.getElementById("btn-portal-send-magic");
		const otpVerifyForm = document.getElementById("portal-otp-verify-form");
		const otpCodeInput = document.getElementById("portal-otp-code");
		const verifyOtpBtn = document.getElementById("btn-portal-verify-otp");
		const toggleOtpBoxBtn = document.getElementById("btn-portal-toggle-otp-box");
		const googleBtn = document.getElementById("btn-portal-google");
		const feedbackEl = document.getElementById("portal-auth-feedback");

		function showFeedback(message, isSuccess) {
			if (!feedbackEl) return;
			feedbackEl.textContent = message;
			feedbackEl.className = isSuccess
				? "text-xs p-3 rounded-lg border border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-medium"
				: "text-xs p-3 rounded-lg border border-destructive/40 bg-destructive/10 text-destructive font-medium";
		}

		function getEnteredEmail() {
			return emailInput && emailInput instanceof HTMLInputElement
				? emailInput.value.trim().toLowerCase()
				: "";
		}

		function revealOtpVerifyPanel() {
			if (otpVerifyForm) {
				otpVerifyForm.classList.remove("hidden");
				otpVerifyForm.classList.add("flex");
			}
			if (otpCodeInput && otpCodeInput instanceof HTMLInputElement) {
				otpCodeInput.focus();
			}
		}

		if (toggleOtpBoxBtn) {
			toggleOtpBoxBtn.addEventListener("click", () => {
				revealOtpVerifyPanel();
			});
		}

		// 1. Continue with Google OAuth
		if (googleBtn) {
			googleBtn.addEventListener("click", async () => {
				googleBtn.setAttribute("disabled", "true");
				try {
					const callbackURL = window.location.origin + window.location.pathname;
					const res = await fetch("/api/auth/sign-in/social", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							provider: "google",
							callbackURL,
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && data.url) {
						window.location.href = data.url;
						return;
					}
					showFeedback(
						data.message ||
							"Could not start Google OAuth right now. Please use the 6-digit OTP or Magic Link below.",
						false,
					);
				} catch {
					showFeedback(
						"Network error starting Google Sign-In. Please use the 6-digit OTP below.",
						false,
					);
				} finally {
					googleBtn.removeAttribute("disabled");
				}
			});
		}

		// 2. Send 6-Digit Email OTP via Better-Auth
		if (otpRequestForm && otpRequestForm instanceof HTMLFormElement) {
			otpRequestForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const email = getEnteredEmail();
				if (!email || !email.includes("@")) {
					showFeedback(
						"Please enter the invited guest or sponsor email address.",
						false,
					);
					return;
				}
				if (sendOtpBtn) {
					sendOtpBtn.setAttribute("disabled", "true");
					sendOtpBtn.textContent = "Sending 6-Digit Code...";
				}
				try {
					const res = await fetch("/api/auth/email-otp/send-verification-otp", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"x-portal-token": portalToken,
						},
						body: JSON.stringify({
							email,
							type: "sign-in",
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && (data.success || data.status)) {
						revealOtpVerifyPanel();
						showFeedback(
							`✓ Sent a 6-digit verification code to ${email}. Enter it above within 5 minutes.`,
							true,
						);
						return;
					}
					showFeedback(
						data.message ||
							"Email is not on the invite list for this Studio Portal, or could not send code.",
						false,
					);
				} catch {
					showFeedback(
						"Network error while sending 6-digit OTP code. Please try again.",
						false,
					);
				} finally {
					if (sendOtpBtn) {
						sendOtpBtn.removeAttribute("disabled");
						sendOtpBtn.textContent = "Send 6-Digit OTP Code →";
					}
				}
			});
		}

		// 3. Send 1-Click Magic Link via Better-Auth
		if (sendMagicBtn) {
			sendMagicBtn.addEventListener("click", async () => {
				const email = getEnteredEmail();
				if (!email || !email.includes("@")) {
					showFeedback(
						"Please enter your invited guest or sponsor email address first.",
						false,
					);
					return;
				}
				sendMagicBtn.setAttribute("disabled", "true");
				const origText = sendMagicBtn.textContent;
				sendMagicBtn.textContent = "Sending Magic Link...";
				try {
					const callbackURL = window.location.origin + window.location.pathname;
					const res = await fetch("/api/auth/sign-in/magic-link", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"x-portal-token": portalToken,
						},
						body: JSON.stringify({
							email,
							callbackURL,
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && (data.status || data.success !== false)) {
						showFeedback(
							`✓ Sent a 1-click sign-in Magic Link to ${email}. Check your inbox to unlock this portal.`,
							true,
						);
						return;
					}
					showFeedback(
						data.message ||
							"Could not send Magic Link for that email address.",
						false,
					);
				} catch {
					showFeedback(
						"Network error while sending Magic Link. Please try again.",
						false,
					);
				} finally {
					sendMagicBtn.removeAttribute("disabled");
					sendMagicBtn.textContent = origText;
				}
			});
		}

		// 4. Verify 6-Digit OTP & Sign In via Better-Auth
		if (otpVerifyForm && otpVerifyForm instanceof HTMLFormElement) {
			otpVerifyForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const email = getEnteredEmail();
				const otp =
					otpCodeInput && otpCodeInput instanceof HTMLInputElement
						? otpCodeInput.value.replace(/\D/g, "").trim()
						: "";
				if (!email || !email.includes("@")) {
					showFeedback("Please enter your email address above.", false);
					return;
				}
				if (otp.length !== 6) {
					showFeedback("Please enter the 6-digit numeric code from your email.", false);
					return;
				}
				if (verifyOtpBtn) {
					verifyOtpBtn.setAttribute("disabled", "true");
					verifyOtpBtn.textContent = "Verifying 6-Digit Code...";
				}
				try {
					const res = await fetch("/api/auth/sign-in/email-otp", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							email,
							otp,
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && (data.token || data.user)) {
						showFeedback("✓ Verified! Unlocking Studio Portal...", true);
						window.location.reload();
						return;
					}
					showFeedback(
						data.message ||
							"Invalid or expired 6-digit code. Please request a fresh OTP code.",
						false,
					);
				} catch {
					showFeedback(
						"Network error while verifying 6-digit code. Please try again.",
						false,
					);
				} finally {
					if (verifyOtpBtn) {
						verifyOtpBtn.removeAttribute("disabled");
						verifyOtpBtn.textContent =
							"Verify 6-Digit Code & Unlock Studio Portal →";
					}
				}
			});
		}

		// 5. Sign Out / Switch Account
		async function signOutPortal() {
			try {
				await fetch("/api/auth/sign-out", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({}),
				});
			} finally {
				window.location.reload();
			}
		}

		const lockBtn = document.getElementById("btn-portal-lock");
		if (lockBtn) {
			lockBtn.addEventListener("click", signOutPortal);
		}
		const switchAccountBtn = document.getElementById("btn-portal-switch-account");
		if (switchAccountBtn) {
			switchAccountBtn.addEventListener("click", signOutPortal);
		}
	})();

	// 0.5 Shared 2-Way Run-of-Show & Pre-Call Notes Co-Editor
	(function () {
		const rosForm = document.getElementById("run-of-show-form");
		const rosSaveBtn = document.getElementById("btn-save-ros");
		const rosFeedback = document.getElementById("ros-save-feedback");
		const loadTemplateBtn = document.getElementById("btn-load-ros-template");

		if (loadTemplateBtn) {
			loadTemplateBtn.addEventListener("click", () => {
				const outlineEl = document.getElementById("ros-outline-notes");
				const precallEl = document.getElementById("ros-precall-notes");
				if (outlineEl && outlineEl instanceof HTMLTextAreaElement) {
					const existing = outlineEl.value.trim();
					if (
						existing &&
						!window.confirm(
							"Replace current Episode Run-of-Show text with the 5-Part CodingCat.dev Template?",
						)
					) {
						return;
					}
					outlineEl.value = [
						`00:00 - 03:00 | 1. Cold Open & Origin Story`,
						`  • Welcome ${contactName || companyName} to CodingCat.dev`,
						`  • The 30-second elevator pitch: What problem were you tired of hitting in production?`,
						``,
						`03:00 - 12:00 | 2. Architecture Mental Model`,
						`  • How developers used to wire this up vs. how ${companyName} approaches it`,
						`  • Under-the-hood primitives, state flow, and developer ergonomics`,
						``,
						`12:00 - 28:00 | 3. Show Me the Code (Live Screen-Share / Demo)`,
						`  • Step-by-step walkthrough in real code (zero slideware)`,
						`  • Key workflows, CLI/UI ergonomics, and live inspection`,
						``,
						`28:00 - 38:00 | 4. Production Trade-Offs & Sharp Edges`,
						`  • Where this shines vs. when teams should use something else`,
						`  • Security, performance, and scaling gotchas`,
						``,
						`38:00 - 45:00 | 5. Verdict, Roadmap & Where to Try It`,
						`  • What is shipping next on the roadmap`,
						`  • Links to docs, GitHub repo, and starter templates`,
					].join("\n");
				}
				if (
					precallEl &&
					precallEl instanceof HTMLTextAreaElement &&
					!precallEl.value.trim()
				) {
					precallEl.value = [
						`• Target Audience Takeaway: Practical architectural mental model + working demo`,
						`• Screen-Share Check: 1080p browser/editor zoomed to 125%-150% for mobile viewers`,
						`• Audio/Video Check: Headphones on (prevents echo in StreamYard), mic selected`,
					].join("\n");
				}
			});
		}

		if (rosForm && rosForm instanceof HTMLFormElement) {
			rosForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const precallEl = document.getElementById("ros-precall-notes");
				const outlineEl = document.getElementById("ros-outline-notes");
				const questionsEl = document.getElementById("ros-guest-questions");
				const updatedByEl = document.getElementById("ros-updated-by");

				const preCallNotes =
					precallEl && precallEl instanceof HTMLTextAreaElement
						? precallEl.value
						: "";
				const runOfShowNotes =
					outlineEl && outlineEl instanceof HTMLTextAreaElement
						? outlineEl.value
						: "";
				const guestQuestions =
					questionsEl && questionsEl instanceof HTMLTextAreaElement
						? questionsEl.value
						: "";
				const updatedBy =
					updatedByEl && updatedByEl instanceof HTMLInputElement
						? updatedByEl.value.trim()
						: contactName || companyName || "guest";
				const notifyEl = document.getElementById("ros-notify-counterpart");
				const notifyCounterpart =
					notifyEl && notifyEl instanceof HTMLInputElement
						? notifyEl.checked
						: true;

				if (rosSaveBtn) {
					rosSaveBtn.setAttribute("disabled", "true");
					rosSaveBtn.textContent = "Saving to Sanity...";
				}
				if (rosFeedback) {
					rosFeedback.classList.add("hidden");
				}

				try {
					const res = await fetch("/api/portal/notes", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							token: portalToken,
							preCallNotes,
							runOfShowNotes,
							guestQuestions,
							updatedBy,
							authorRole: "guest",
							notifyCounterpart,
						}),
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						if (rosFeedback) {
							const emailNote = data.emailResult?.sent ? " & emailed Alex" : "";
							rosFeedback.textContent = `✓ Saved to Sanity${emailNote} (${new Date(data.updatedAt || Date.now()).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })})`;
							rosFeedback.className =
								"text-xs font-semibold text-emerald-600 dark:text-emerald-400";
						}
						if (Array.isArray(data.collaborationThread)) {
							renderPortalCollaborationThread(data.collaborationThread);
						}
						return;
					}
					if (rosFeedback) {
						rosFeedback.textContent =
							data.message || "Could not save notes. Please try again.";
						rosFeedback.className = "text-xs font-semibold text-destructive";
					}
				} catch {
					if (rosFeedback) {
						rosFeedback.textContent =
							"Network error while saving notes to Sanity.";
						rosFeedback.className = "text-xs font-semibold text-destructive";
					}
				} finally {
					if (rosSaveBtn) {
						rosSaveBtn.removeAttribute("disabled");
						rosSaveBtn.textContent = "Save Run-of-Show & Notify Alex →";
					}
				}
			});
		}

		// Render & wire 2-Way Call Notes, Comments & File Drop Chat
		function escapeHtml(str) {
			return String(str || "")
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;");
		}

		function renderPortalCollaborationThread(items) {
			const listEl = document.getElementById("portal-collaboration-thread-list");
			const badgeEl = document.getElementById("portal-thread-count-badge");
			if (badgeEl) {
				badgeEl.textContent = `${items.length} ${items.length === 1 ? "note" : "notes"}`;
			}
			if (!listEl) return;
			if (!Array.isArray(items) || items.length === 0) {
				listEl.innerHTML = `<div id="portal-thread-empty-state" class="p-4 rounded-xl border border-dashed border-border bg-muted/20 text-center text-xs text-muted-foreground">No call notes or back-and-forth comments yet. Post a note or drop files below to kick off the thread with Alex!</div>`;
				return;
			}
			listEl.innerHTML = items
				.map((item) => {
					const isHost = item.authorRole === "host";
					const badgeLabel =
						item.noteType === "call_note"
							? "📞 Call Note"
							: item.noteType === "file_drop"
								? "📎 File Drop"
								: item.noteType === "ros_update"
									? "📝 Run-of-Show Update"
									: item.noteType === "feedback"
										? `🛠️ Portal Feedback${item.feedbackRating ? ` (${item.feedbackRating}/5)` : ""}`
										: "💬 Comment";
					const attachmentsHtml =
						Array.isArray(item.attachments) && item.attachments.length > 0
							? `<div class="flex flex-wrap gap-2 pt-1">${item.attachments
									.map((att) => {
										const href = att.assetId
											? `/api/portal/assets?token=${encodeURIComponent(portalToken)}&assetId=${encodeURIComponent(att.assetId)}`
											: att.externalUrl || "#vault";
										return `<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-primary/30 bg-background hover:bg-primary/10 text-xs font-semibold text-primary transition-colors"><span>📎 ${escapeHtml(att.title)}</span><span class="text-[10px] font-mono text-muted-foreground">(${escapeHtml(att.category || "other")})</span></a>`;
									})
									.join("")}</div>`
							: "";
					const timeLabel = item.createdAt
						? new Date(item.createdAt).toLocaleString("en-US", {
								dateStyle: "medium",
								timeStyle: "short",
							})
						: "";
					return `<div class="p-3.5 rounded-xl border ${isHost ? "border-primary/40 bg-primary/5" : "border-border bg-background"} flex flex-col gap-2">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<div class="flex flex-wrap items-center gap-2">
								<span class="text-xs font-bold px-2 py-0.5 rounded-md ${isHost ? "bg-primary text-primary-foreground" : "bg-secondary text-secondary-foreground"}">${isHost ? "🐱 " : "🎙️ "}${escapeHtml(item.authorName)}</span>
								<span class="text-[11px] font-mono px-2 py-0.5 rounded bg-muted text-muted-foreground">${badgeLabel}</span>
								${item.emailedToCounterpart ? `<span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">✓ Emailed in thread</span>` : ""}
							</div>
							<span class="text-[11px] font-mono text-muted-foreground">${escapeHtml(timeLabel)}</span>
						</div>
						${item.message ? `<div class="text-xs text-foreground whitespace-pre-wrap leading-relaxed font-sans">${escapeHtml(item.message)}</div>` : ""}
						${attachmentsHtml}
					</div>`;
				})
				.join("");
			listEl.scrollTop = listEl.scrollHeight;
		}

		window.addEventListener("portal-feedback-submitted", (evt) => {
			const customEvt = evt;
			if (customEvt && customEvt.detail && Array.isArray(customEvt.detail.collaborationThread)) {
				renderPortalCollaborationThread(customEvt.detail.collaborationThread);
			}
		});

		const chatFileInput = document.getElementById("chat-file-input");
		const chatFilesPill = document.getElementById("chat-selected-files-pill");
		const chatDropzone = document.getElementById("chat-dropzone-label");

		function updateSelectedFilesPill() {
			if (
				!chatFileInput ||
				!(chatFileInput instanceof HTMLInputElement) ||
				!chatFilesPill
			) {
				return;
			}
			const files = chatFileInput.files;
			if (!files || files.length === 0) {
				chatFilesPill.classList.add("hidden");
				chatFilesPill.textContent = "";
				return;
			}
			const names = Array.from(files)
				.map((f) => f.name)
				.join(", ");
			chatFilesPill.textContent = `📎 ${files.length} file${files.length === 1 ? "" : "s"} staged: ${names}`;
			chatFilesPill.classList.remove("hidden");
		}

		if (chatFileInput) {
			chatFileInput.addEventListener("change", updateSelectedFilesPill);
		}

		if (chatDropzone && chatFileInput && chatFileInput instanceof HTMLInputElement) {
			["dragenter", "dragover"].forEach((evtName) => {
				chatDropzone.addEventListener(evtName, (e) => {
					e.preventDefault();
					e.stopPropagation();
					chatDropzone.classList.add("border-primary", "bg-primary/10");
				});
			});
			["dragleave", "drop"].forEach((evtName) => {
				chatDropzone.addEventListener(evtName, (e) => {
					e.preventDefault();
					e.stopPropagation();
					chatDropzone.classList.remove("border-primary", "bg-primary/10");
				});
			});
			chatDropzone.addEventListener("drop", (e) => {
				const dt = e.dataTransfer;
				if (dt && dt.files && dt.files.length > 0) {
					chatFileInput.files = dt.files;
					updateSelectedFilesPill();
				}
			});
		}

		const refreshThreadBtn = document.getElementById("btn-refresh-portal-thread");
		if (refreshThreadBtn) {
			refreshThreadBtn.addEventListener("click", async () => {
				refreshThreadBtn.setAttribute("disabled", "true");
				refreshThreadBtn.textContent = "🔄 Syncing...";
				try {
					const res = await fetch(
						`/api/portal/notes?token=${encodeURIComponent(portalToken)}`,
					);
					const data = await res.json();
					if (res.ok && data.ok) {
						const precallEl = document.getElementById("ros-precall-notes");
						const outlineEl = document.getElementById("ros-outline-notes");
						const questionsEl = document.getElementById("ros-guest-questions");
						if (precallEl && precallEl instanceof HTMLTextAreaElement && typeof data.preCallNotes === "string") {
							precallEl.value = data.preCallNotes;
						}
						if (outlineEl && outlineEl instanceof HTMLTextAreaElement && typeof data.runOfShowNotes === "string") {
							outlineEl.value = data.runOfShowNotes;
						}
						if (questionsEl && questionsEl instanceof HTMLTextAreaElement && typeof data.guestQuestions === "string") {
							questionsEl.value = data.guestQuestions;
						}
						if (Array.isArray(data.collaborationThread)) {
							renderPortalCollaborationThread(data.collaborationThread);
						}
					}
				} finally {
					refreshThreadBtn.removeAttribute("disabled");
					refreshThreadBtn.textContent = "🔄 Refresh Live Feed";
				}
			});
		}

		const chatForm = document.getElementById("portal-chat-form");
		const postChatBtn = document.getElementById("btn-post-chat-note");
		const chatFeedback = document.getElementById("chat-post-feedback");

		if (chatForm && chatForm instanceof HTMLFormElement) {
			chatForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const authorEl = document.getElementById("chat-author-name");
				const noteTypeEl = document.getElementById("chat-note-type");
				const catEl = document.getElementById("chat-asset-category");
				const msgEl = document.getElementById("chat-message-input");
				const extTitleEl = document.getElementById("chat-external-title");
				const extUrlEl = document.getElementById("chat-external-url");
				const notifyEl = document.getElementById("chat-notify-counterpart");

				const authorName =
					authorEl && authorEl instanceof HTMLInputElement
						? authorEl.value.trim()
						: contactName || companyName || "Guest";
				const noteType =
					noteTypeEl && noteTypeEl instanceof HTMLSelectElement
						? noteTypeEl.value
						: "comment";
				const assetCategory =
					catEl && catEl instanceof HTMLSelectElement ? catEl.value : "deck";
				const message =
					msgEl && msgEl instanceof HTMLTextAreaElement
						? msgEl.value.trim()
						: "";
				const externalTitle =
					extTitleEl && extTitleEl instanceof HTMLInputElement
						? extTitleEl.value.trim()
						: "";
				const externalUrl =
					extUrlEl && extUrlEl instanceof HTMLInputElement
						? extUrlEl.value.trim()
						: "";
				const notifyCounterpart =
					notifyEl && notifyEl instanceof HTMLInputElement
						? notifyEl.checked
						: true;
				const hasFiles =
					chatFileInput &&
					chatFileInput instanceof HTMLInputElement &&
					chatFileInput.files &&
					chatFileInput.files.length > 0;

				if (!message && !hasFiles && !externalUrl) {
					if (chatFeedback) {
						chatFeedback.textContent =
							"Write a message, drop a file, or paste a URL first.";
						chatFeedback.className = "text-xs font-semibold text-destructive";
					}
					return;
				}

				if (postChatBtn) {
					postChatBtn.setAttribute("disabled", "true");
					postChatBtn.textContent = hasFiles
						? "Uploading to Sanity Vault & Posting..."
						: "Posting Note...";
				}
				if (chatFeedback) {
					chatFeedback.classList.add("hidden");
				}

				try {
					const fd = new FormData();
					fd.append("token", portalToken);
					fd.append("authorRole", "guest");
					fd.append("updatedBy", authorName);
					fd.append("noteType", hasFiles && noteType === "comment" ? "file_drop" : noteType);
					fd.append("assetCategory", assetCategory);
					fd.append("message", message);
					fd.append("externalTitle", externalTitle);
					fd.append("externalUrl", externalUrl);
					fd.append("notifyCounterpart", notifyCounterpart ? "true" : "false");

					if (
						chatFileInput &&
						chatFileInput instanceof HTMLInputElement &&
						chatFileInput.files
					) {
						Array.from(chatFileInput.files).forEach((file) => {
							fd.append("files", file);
						});
					}

					const res = await fetch("/api/portal/notes", {
						method: "POST",
						body: fd,
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						if (msgEl && msgEl instanceof HTMLTextAreaElement) msgEl.value = "";
						if (extTitleEl && extTitleEl instanceof HTMLInputElement) extTitleEl.value = "";
						if (extUrlEl && extUrlEl instanceof HTMLInputElement) extUrlEl.value = "";
						if (chatFileInput && chatFileInput instanceof HTMLInputElement) {
							chatFileInput.value = "";
							updateSelectedFilesPill();
						}
						if (Array.isArray(data.collaborationThread)) {
							renderPortalCollaborationThread(data.collaborationThread);
						}
						if (chatFeedback) {
							const fileCount = Array.isArray(data.uploadedAttachments)
								? data.uploadedAttachments.length
								: 0;
							const vaultMsg =
								fileCount > 0 ? ` + ${fileCount} file(s) synced to #vault` : "";
							const emailMsg = data.emailResult?.sent ? " & emailed Alex" : "";
							chatFeedback.textContent = `✓ Note posted${vaultMsg}${emailMsg}`;
							chatFeedback.className =
								"text-xs font-semibold text-emerald-600 dark:text-emerald-400";
						}
						return;
					}
					if (chatFeedback) {
						chatFeedback.textContent =
							data.message || "Could not post note. Please try again.";
						chatFeedback.className = "text-xs font-semibold text-destructive";
					}
				} catch {
					if (chatFeedback) {
						chatFeedback.textContent =
							"Network error while posting note to Sanity.";
						chatFeedback.className = "text-xs font-semibold text-destructive";
					}
				} finally {
					if (postChatBtn) {
						postChatBtn.removeAttribute("disabled");
						postChatBtn.textContent = "Post Note & Sync to Vault →";
					}
				}
			});
		}
	})();

	// 1-Click Deal Room Calendar Booking, Local Timezone Hydration & Inline Rebook Drawer
	(function () {
		// If arriving from an older Google Calendar invite link that had `#vault` appended,
		// scroll to the top of the portal so the Scheduled Sessions & Studio Links card is visible first.
		if (window.location.hash === "#vault") {
			const ref = document.referrer || "";
			if (!ref || !ref.includes(window.location.host)) {
				window.scrollTo({ top: 0, behavior: "instant" });
				try {
					window.history.replaceState(
						null,
						"",
						window.location.pathname + window.location.search,
					);
				} catch {
					// Ignore history errors
				}
			}
		}

		// Hydrate all booked session cards & slot buttons with the visitor's local browser timezone
		const visitorTz =
			Intl.DateTimeFormat().resolvedOptions().timeZone || "America/New_York";
		const tzPill = document.getElementById("visitor-timezone-pill");
		if (tzPill && visitorTz) {
			tzPill.textContent =
				visitorTz === "America/New_York"
					? "🕒 Times shown in US Eastern Time (America/New_York)"
					: `🕒 Times shown in your timezone (${visitorTz}) + US Eastern (ET)`;
		}

		function formatLocalRange(isoStr, durationMin) {
			const start = new Date(isoStr);
			if (Number.isNaN(start.getTime())) return null;
			const end = new Date(start.getTime() + durationMin * 60000);
			const fullDate = start.toLocaleDateString("en-US", {
				weekday: "long",
				month: "long",
				day: "numeric",
				year: "numeric",
			});
			const shortDate = start.toLocaleDateString("en-US", {
				weekday: "short",
				month: "short",
				day: "numeric",
			});
			const startLocal = start.toLocaleTimeString("en-US", {
				hour: "numeric",
				minute: "2-digit",
			});
			const endLocal = end.toLocaleTimeString("en-US", {
				hour: "numeric",
				minute: "2-digit",
				timeZoneName: "short",
			});
			const startEt = start.toLocaleTimeString("en-US", {
				hour: "numeric",
				minute: "2-digit",
				timeZone: "America/New_York",
			});
			const endEt = end.toLocaleTimeString("en-US", {
				hour: "numeric",
				minute: "2-digit",
				timeZone: "America/New_York",
				timeZoneName: "short",
			});
			return {
				fullDate,
				shortDate,
				localRange: `${startLocal} – ${endLocal}`,
				etRange: `${startEt} – ${endEt}`,
				shortLocal: `${shortDate} · ${startLocal}`,
				startMs: start.getTime(),
				endMs: end.getTime(),
			};
		}

		document.querySelectorAll("[data-session-local-date]").forEach((el) => {
			const iso = el.getAttribute("data-start-iso");
			if (!iso) return;
			const info = formatLocalRange(iso, 45);
			if (info) el.textContent = info.fullDate;
		});

		document.querySelectorAll("[data-session-local-time]").forEach((el) => {
			const iso = el.getAttribute("data-start-iso");
			const dur = Number(el.getAttribute("data-duration") || 45);
			if (!iso) return;
			const info = formatLocalRange(iso, dur);
			if (info) {
				el.textContent = `${info.localRange} (${dur} min)`;
			}
		});

		document.querySelectorAll("[data-session-tz-note]").forEach((el) => {
			const iso = el.getAttribute("data-start-iso");
			const dur = Number(el.getAttribute("data-duration") || 45);
			if (!iso) return;
			const info = formatLocalRange(iso, dur);
			if (!info) return;
			if (visitorTz === "America/New_York") {
				el.textContent = `Timezone: ${visitorTz}`;
			} else {
				el.textContent = `Your Timezone (${visitorTz}) · Host Time: ${info.etRange}`;
			}
		});

		document.querySelectorAll("[data-session-local-short]").forEach((el) => {
			const iso = el.getAttribute("data-start-iso");
			if (!iso) return;
			const info = formatLocalRange(iso, 45);
			if (info) el.textContent = `${info.shortLocal} (${visitorTz})`;
		});

		document.querySelectorAll("[data-session-relative-badge]").forEach((el) => {
			const iso = el.getAttribute("data-start-iso");
			const dur = Number(el.getAttribute("data-duration") || 45);
			if (!iso) return;
			const info = formatLocalRange(iso, dur);
			if (!info) return;
			const now = Date.now();
			const diffMs = info.startMs - now;
			if (info.endMs < now) {
				el.textContent = "⚠️ Past Slot — Click Rebook to Pick a New Window";
			} else if (diffMs <= 0 && info.endMs >= now) {
				el.textContent = "🔴 Live Now";
			} else if (diffMs < 3600000 * 18) {
				const hrs = Math.max(1, Math.round(diffMs / 3600000));
				el.textContent = `🟢 Starting in ~${hrs}h`;
			} else {
				const days = Math.max(1, Math.round(diffMs / 86400000));
				el.textContent = `📅 In ${days} day${days === 1 ? "" : "s"}`;
			}
		});

		function hydrateSlotButtonLabels(container) {
			const root = container || document;
			root.querySelectorAll("[data-slot-start]").forEach((btn) => {
				const iso = btn.getAttribute("data-slot-start");
				const dur = Number(btn.getAttribute("data-slot-duration") || 45);
				if (!iso) return;
				const info = formatLocalRange(iso, dur);
				if (!info) return;
				const dateEl = btn.querySelector("[data-slot-date-label]");
				const localEl = btn.querySelector("[data-slot-local-label]");
				const etEl = btn.querySelector("[data-slot-et-label]");
				if (dateEl) dateEl.textContent = info.shortDate;
				if (localEl) localEl.textContent = `${info.localRange} (${dur}m)`;
				if (etEl) {
					etEl.textContent =
						visitorTz === "America/New_York"
							? "US Eastern Time (ET)"
							: `Host: ${info.etRange}`;
				}
			});
		}

		hydrateSlotButtonLabels(document);

		let activeTrack = isEditorialGuest ? "editorial" : "sponsored";
		let activeDuration = 45;
		let selectedSlot15 = "";
		let selectedSlot45 = "";

		const scheduleDrawer = document.getElementById("schedule-section");
		const closeDrawerBtn = document.getElementById("btn-close-rebook-drawer");
		const drawerModeBadge = document.getElementById("rebook-drawer-mode-badge");
		const drawerSubtitle = document.getElementById("rebook-drawer-subtitle");
		const datePicker = document.getElementById("portal-rebook-date-picker");
		const loadingPill = document.getElementById("portal-slots-loading-pill");
		const grid15 = document.getElementById("portal-slots-15");
		const grid45 = document.getElementById("portal-slots-45");
		const trackBtns = document.querySelectorAll(".portal-track-btn");
		const bookBtn = document.getElementById("btn-portal-book-slot");
		const bookingFeedback = document.getElementById("portal-booking-feedback");

		function bindSlotClicks() {
			const btns15 = document.querySelectorAll(".portal-slot-btn-15");
			const btns45 = document.querySelectorAll(".portal-slot-btn-45");

			if (btns15.length > 0 && !selectedSlot15) {
				selectedSlot15 = btns15[0].getAttribute("data-slot-start") || "";
			}
			if (btns45.length > 0 && !selectedSlot45) {
				selectedSlot45 = btns45[0].getAttribute("data-slot-start") || "";
			}

			btns15.forEach((btn) => {
				btn.onclick = () => {
					btns15.forEach((b) => {
						b.classList.remove("border-primary", "bg-primary/10", "ring-1", "ring-primary");
						b.classList.add("border-border", "bg-card");
					});
					btn.classList.add("border-primary", "bg-primary/10", "ring-1", "ring-primary");
					btn.classList.remove("border-border", "bg-card");
					selectedSlot15 = btn.getAttribute("data-slot-start") || "";
				};
			});

			btns45.forEach((btn) => {
				btn.onclick = () => {
					btns45.forEach((b) => {
						b.classList.remove("border-primary", "bg-primary/10", "ring-1", "ring-primary");
						b.classList.add("border-border", "bg-card");
					});
					btn.classList.add("border-primary", "bg-primary/10", "ring-1", "ring-primary");
					btn.classList.remove("border-border", "bg-card");
					selectedSlot45 = btn.getAttribute("data-slot-start") || "";
				};
			});
		}

		bindSlotClicks();

		function setRebookMode(duration) {
			activeDuration = duration === 15 ? 15 : 45;
			activeTrack =
				activeDuration === 15
					? "sponsor-kickoff"
					: isEditorialGuest
						? "editorial"
						: "sponsored";

			trackBtns.forEach((b) => {
				const btnDur = Number(b.getAttribute("data-portal-duration")) || 45;
				if (btnDur === activeDuration) {
					b.classList.add("border-primary", "bg-primary/10", "ring-1", "ring-primary");
					b.classList.remove("border-border", "bg-card");
				} else {
					b.classList.remove("border-primary", "bg-primary/10", "ring-1", "ring-primary");
					b.classList.add("border-border", "bg-card");
				}
			});

			if (activeDuration === 15) {
				if (grid15) {
					grid15.classList.remove("hidden");
					grid15.classList.add("grid");
				}
				if (grid45) {
					grid45.classList.add("hidden");
					grid45.classList.remove("grid");
				}
				if (drawerModeBadge) {
					drawerModeBadge.textContent = hasExistingPreMeeting
						? "📹 Rescheduling: 15-Min Google Meet Pre-Meeting"
						: "📹 Booking: 15-Min Google Meet Pre-Meeting";
				}
				if (drawerSubtitle) {
					drawerSubtitle.innerHTML =
						"Pick a 15-minute slot below to auto-generate a Google Meet room with Alex. <strong>Your 45-minute StreamYard recording slot stays untouched.</strong>";
				}
				if (bookBtn) {
					bookBtn.textContent = hasExistingPreMeeting
						? "Confirm New 15-Min Pre-Meeting Time & Update Invite →"
						: "Book 15-Min Google Meet Pre-Meeting & Send Invite →";
				}
			} else {
				if (grid45) {
					grid45.classList.remove("hidden");
					grid45.classList.add("grid");
				}
				if (grid15) {
					grid15.classList.add("hidden");
					grid15.classList.remove("grid");
				}
				if (drawerModeBadge) {
					drawerModeBadge.textContent = hasExistingRecording
						? "🎙️ Rescheduling: 45-Min StreamYard Recording"
						: "🎙️ Booking: 45-Min StreamYard Recording";
				}
				if (drawerSubtitle) {
					drawerSubtitle.innerHTML =
						"Pick a conflict-free 45-minute window below. Confirming automatically updates your Google Calendar invite and replaces your previous recording slot.";
				}
				if (bookBtn) {
					bookBtn.textContent = hasExistingRecording
						? "Confirm New 45-Min Recording Time & Update Calendar Invite →"
						: "Confirm 45-Min Recording Slot & Send Calendar Invite →";
				}
			}
		}

		function openRebookDrawer(duration) {
			setRebookMode(duration);
			if (scheduleDrawer) {
				scheduleDrawer.classList.remove("hidden");
				scheduleDrawer.classList.add("flex");
				scheduleDrawer.scrollIntoView({ behavior: "smooth", block: "nearest" });
			}
		}

		document.querySelectorAll("[data-open-rebook]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const dur = Number(btn.getAttribute("data-open-rebook")) || 45;
				openRebookDrawer(dur);
			});
		});

		if (closeDrawerBtn && scheduleDrawer) {
			closeDrawerBtn.addEventListener("click", () => {
				scheduleDrawer.classList.add("hidden");
				scheduleDrawer.classList.remove("flex");
			});
		}

		trackBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const dur = Number(btn.getAttribute("data-portal-duration")) || 45;
				setRebookMode(dur);
			});
		});

		// Live Week / Date Picker inside Rebook Drawer
		if (datePicker && datePicker instanceof HTMLInputElement) {
			datePicker.addEventListener("change", async () => {
				const startDate = datePicker.value;
				if (!startDate) return;
				if (loadingPill) loadingPill.classList.remove("hidden");
				try {
					const [res15, res45] = await Promise.all([
						fetch(`/api/calendar/freebusy?limit=9&duration=15&startDate=${encodeURIComponent(startDate)}`),
						fetch(`/api/calendar/freebusy?limit=9&duration=45&startDate=${encodeURIComponent(startDate)}`),
					]);
					const [data15, data45] = await Promise.all([res15.json(), res45.json()]);
					if (data15?.slots && Array.isArray(data15.slots) && grid15) {
						selectedSlot15 = data15.slots[0]?.startAt || "";
						grid15.innerHTML = data15.slots
							.map(
								(s, idx) => `<button type="button" data-slot-start="${s.startAt}" data-slot-duration="15" class="portal-slot-btn-15 p-3 rounded-xl border text-left transition-all cursor-pointer flex flex-col gap-0.5 ${idx === 0 ? "border-primary bg-primary/10 ring-1 ring-primary" : "border-border bg-card hover:border-primary"}"><span class="font-bold text-xs text-foreground" data-slot-date-label>${s.displayDate}</span><span class="text-xs text-primary font-mono font-bold" data-slot-local-label>${s.displayTime}</span><span class="text-[10px] text-muted-foreground font-mono" data-slot-et-label>${s.displayTime}</span></button>`,
							)
							.join("");
						hydrateSlotButtonLabels(grid15);
					}
					if (data45?.slots && Array.isArray(data45.slots) && grid45) {
						selectedSlot45 = data45.slots[0]?.startAt || "";
						grid45.innerHTML = data45.slots
							.map(
								(s, idx) => `<button type="button" data-slot-start="${s.startAt}" data-slot-duration="45" class="portal-slot-btn-45 p-3 rounded-xl border text-left transition-all cursor-pointer flex flex-col gap-0.5 ${idx === 0 ? "border-primary bg-primary/10 ring-1 ring-primary" : "border-border bg-card hover:border-primary"}"><span class="font-bold text-xs text-foreground" data-slot-date-label>${s.displayDate}</span><span class="text-xs text-primary font-mono font-bold" data-slot-local-label>${s.displayTime}</span><span class="text-[10px] text-muted-foreground font-mono" data-slot-et-label>${s.displayTime}</span></button>`,
							)
							.join("");
						hydrateSlotButtonLabels(grid45);
					}
					bindSlotClicks();
				} catch {
					// Keep existing slots on network error
				} finally {
					if (loadingPill) loadingPill.classList.add("hidden");
				}
			});
		}

		if (bookBtn) {
			bookBtn.addEventListener("click", async () => {
				const emailInput = document.getElementById("portal-booking-email");
				const resolvedEmail =
					contactEmail || (emailInput && emailInput.value ? emailInput.value.trim() : "");
				const slotStartAt = activeDuration === 15 ? selectedSlot15 : selectedSlot45;

				if (!resolvedEmail || !resolvedEmail.includes("@")) {
					if (bookingFeedback) {
						bookingFeedback.textContent = "Please enter a valid attendee email address to receive the calendar invite.";
						bookingFeedback.classList.remove("hidden");
					}
					return;
				}
				if (!slotStartAt) {
					if (bookingFeedback) {
						bookingFeedback.textContent = "Please select an available time slot.";
						bookingFeedback.classList.remove("hidden");
					}
					return;
				}

				const originalText = bookBtn.textContent;
				bookBtn.setAttribute("disabled", "true");
				bookBtn.textContent = "Updating Google Calendar & Studio Portal...";
				if (bookingFeedback) bookingFeedback.classList.add("hidden");

				try {
					const res = await fetch("/api/booking", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							portalToken,
							bookingId: bookingDocId || undefined,
							preMeetingForBookingId:
								activeDuration === 15 && bookingDocId ? bookingDocId : undefined,
							guestName: contactName || companyName,
							guestEmail: resolvedEmail,
							company: companyName,
							track: activeTrack,
							durationMinutes: activeDuration,
							slotStartAt,
							topics:
								activeDuration === 15
									? `15-Min Pre-Meeting / Tech Check (${companyName})`
									: `45-Min Podcast Recording (${companyName})`,
						}),
					});
					const data = await res.json();
					if (res.ok && data.success) {
						if (bookingFeedback) {
							const calUrl = data.calendarEventUrl || data.addToCalendarUrl || "";
							bookingFeedback.innerHTML = `<strong>✓ Updated!</strong> ${
								data.calendarInviteSent
									? `An updated Google Calendar invite has been sent to <strong>${resolvedEmail}</strong>. Refreshing your session cards...`
									: "Your session time has been updated. Refreshing..."
							} ${
								calUrl
									? `<br><a href="${calUrl}" target="_blank" rel="noopener noreferrer" class="underline font-semibold text-primary">Open in Google Calendar &nearr;</a>`
									: ""
							}`;
							bookingFeedback.classList.remove("hidden");
						}
						bookBtn.textContent = "✓ Calendar Invite Updated!";
						setTimeout(() => {
							const nextUrl = new URL(window.location.href);
							nextUrl.hash = "booked-sessions";
							nextUrl.searchParams.set("bookedSlot", slotStartAt);
							window.location.href = nextUrl.toString();
						}, 900);
						return;
					}
					if (bookingFeedback) {
						bookingFeedback.textContent =
							data.message || "Could not book that slot. Please select another time.";
						bookingFeedback.classList.remove("hidden");
					}
				} catch {
					if (bookingFeedback) {
						bookingFeedback.textContent =
							"Network error while booking slot. Please try again.";
						bookingFeedback.classList.remove("hidden");
					}
				}
				bookBtn.removeAttribute("disabled");
				bookBtn.textContent = originalText;
			});
		}
	})();

	document.querySelectorAll(".stripe-action-btn").forEach((btn) => {
		btn.addEventListener("click", async () => {
			const milestone = btn.getAttribute("data-milestone") || "deposit";
			const mode = btn.getAttribute("data-mode") || "checkout";
			const feedback = document.getElementById("stripe-feedback");
			const originalText = btn.textContent;
			btn.setAttribute("disabled", "true");
			btn.textContent = "Generating Stripe Link...";

			try {
				const res = await fetch("/api/stripe/milestone", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						portalToken,
						leadId,
						companyName,
						contactEmail,
						tier: tierId,
						milestone,
						mode,
					}),
				});
				const data = await res.json();
				if (res.ok && data.url) {
					window.location.href = data.url;
					return;
				}
				if (feedback) {
					feedback.textContent =
						data.message ||
						"Stripe invoice generation queued. Alex will send your payment link directly, or email alex@codingcat.dev.";
					feedback.classList.remove("hidden");
				}
			} catch {
				if (feedback) {
					feedback.textContent =
						"Could not reach billing service right now. Please email alex@codingcat.dev.";
					feedback.classList.remove("hidden");
				}
			} finally {
				btn.removeAttribute("disabled");
				btn.textContent = originalText;
			}
		});
	});

	// Sanity Media Library 2-Way Asset Vault Upload Handler
	const vaultForm = document.getElementById("vault-upload-form");
	const vaultBtn = document.getElementById("btn-vault-upload");
	const vaultFeedback = document.getElementById("vault-upload-feedback");
	if (vaultForm && vaultForm instanceof HTMLFormElement) {
		vaultForm.addEventListener("submit", async (e) => {
			e.preventDefault();
			const fileInput = document.getElementById("vault-file");
			const titleInput = document.getElementById("vault-title");
			const categorySelect = document.getElementById("vault-category");
			const visibilitySelect = document.getElementById("vault-visibility");
			const extUrlInput = document.getElementById("vault-external-url");

			const file =
				fileInput && fileInput instanceof HTMLInputElement && fileInput.files
					? fileInput.files[0]
					: null;
			const extUrl =
				extUrlInput && extUrlInput instanceof HTMLInputElement
					? extUrlInput.value.trim()
					: "";

			if (!file && !extUrl) {
				if (vaultFeedback) {
					vaultFeedback.textContent =
						"Please choose a file to upload or paste an external link.";
					vaultFeedback.classList.remove("hidden");
				}
				return;
			}

			if (vaultBtn) {
				vaultBtn.setAttribute("disabled", "true");
				vaultBtn.textContent = "Uploading to Sanity...";
			}
			if (vaultFeedback) vaultFeedback.classList.add("hidden");

			try {
				const formData = new FormData();
				formData.set("token", portalToken);
				formData.set("docId", leadId);
				formData.set(
					"title",
					titleInput && titleInput instanceof HTMLInputElement
						? titleInput.value.trim()
						: "",
				);
				formData.set(
					"category",
					categorySelect && categorySelect instanceof HTMLSelectElement
						? categorySelect.value
						: "brief",
				);
				formData.set(
					"visibility",
					visibilitySelect && visibilitySelect instanceof HTMLSelectElement
						? visibilitySelect.value
						: "private",
				);
				formData.set("uploadedBy", "partner");
				if (extUrl) formData.set("externalUrl", extUrl);
				if (file) formData.set("file", file);

				const res = await fetch("/api/portal/assets", {
					method: "POST",
					body: formData,
				});
				const data = await res.json();
				if (res.ok && data.ok) {
					if (vaultFeedback) {
						vaultFeedback.innerHTML =
							"<strong>✓ Asset synced to Sanity Media Library Vault!</strong> Refreshing list...";
						vaultFeedback.classList.remove("hidden");
					}
					setTimeout(() => window.location.reload(), 800);
					return;
				}
				if (vaultFeedback) {
					vaultFeedback.textContent =
						data.message || "Could not upload asset. Please try again.";
					vaultFeedback.classList.remove("hidden");
				}
			} catch {
				if (vaultFeedback) {
					vaultFeedback.textContent =
						"Network error while uploading to Sanity Media Library.";
					vaultFeedback.classList.remove("hidden");
				}
			} finally {
				if (vaultBtn) {
					vaultBtn.removeAttribute("disabled");
					vaultBtn.textContent = "Upload →";
				}
			}
		});
	}

	// Self-Serve Speaker Bio, 512x512 Headshot Cropper & 14 Social Links Editor
	(function () {
		const gpForm = document.getElementById("guest-profile-form");
		const gpSaveBtn = document.getElementById("btn-save-guest-profile");
		const gpFeedback = document.getElementById("gp-save-feedback");
		const fileInput = document.getElementById("gp-avatar-file");
		const dataUrlInput = document.getElementById("gp-avatar-data-url");
		const previewImg = document.getElementById("gp-avatar-preview");
		const cropPanel = document.getElementById("gp-crop-panel");
		const cropCanvas = document.getElementById("gp-crop-canvas");
		const cropZoom = document.getElementById("gp-crop-zoom");
		const applyCropBtn = document.getElementById("btn-gp-apply-crop");

		let loadedImage = null;
		let zoom = 1;
		let offsetX = 0;
		let offsetY = 0;
		let isDragging = false;
		let startX = 0;
		let startY = 0;

		function renderCropCanvas() {
			if (!cropCanvas || !(cropCanvas instanceof HTMLCanvasElement) || !loadedImage) return;
			const ctx = cropCanvas.getContext("2d");
			if (!ctx) return;
			const size = 512;
			ctx.clearRect(0, 0, size, size);
			const iw = loadedImage.width;
			const ih = loadedImage.height;
			const baseScale = Math.max(size / iw, size / ih);
			const drawW = iw * baseScale * zoom;
			const drawH = ih * baseScale * zoom;
			const x = (size - drawW) / 2 + offsetX;
			const y = (size - drawH) / 2 + offsetY;
			ctx.drawImage(loadedImage, x, y, drawW, drawH);
		}

		if (fileInput && fileInput instanceof HTMLInputElement) {
			fileInput.addEventListener("change", () => {
				const file = fileInput.files && fileInput.files[0];
				if (!file) return;
				const reader = new FileReader();
				reader.onload = (ev) => {
					const src = ev.target && typeof ev.target.result === "string" ? ev.target.result : "";
					if (!src) return;
					const img = new Image();
					img.onload = () => {
						loadedImage = img;
						zoom = 1;
						offsetX = 0;
						offsetY = 0;
						if (cropZoom && cropZoom instanceof HTMLInputElement) cropZoom.value = "1";
						if (cropPanel) {
							cropPanel.classList.remove("hidden");
							cropPanel.classList.add("flex");
						}
						renderCropCanvas();
						if (cropCanvas && cropCanvas instanceof HTMLCanvasElement) {
							const cropped = cropCanvas.toDataURL("image/jpeg", 0.92);
							if (dataUrlInput && dataUrlInput instanceof HTMLInputElement) dataUrlInput.value = cropped;
							if (previewImg && previewImg instanceof HTMLImageElement) previewImg.src = cropped;
						}
					};
					img.src = src;
				};
				reader.readAsDataURL(file);
			});
		}

		if (cropZoom && cropZoom instanceof HTMLInputElement) {
			cropZoom.addEventListener("input", () => {
				zoom = Number(cropZoom.value) || 1;
				renderCropCanvas();
			});
		}

		if (cropCanvas && cropCanvas instanceof HTMLCanvasElement) {
			cropCanvas.addEventListener("pointerdown", (e) => {
				isDragging = true;
				startX = e.clientX - offsetX;
				startY = e.clientY - offsetY;
				cropCanvas.setPointerCapture(e.pointerId);
			});
			cropCanvas.addEventListener("pointermove", (e) => {
				if (!isDragging) return;
				offsetX = e.clientX - startX;
				offsetY = e.clientY - startY;
				renderCropCanvas();
			});
			cropCanvas.addEventListener("pointerup", () => {
				isDragging = false;
			});
		}

		if (applyCropBtn && cropCanvas && cropCanvas instanceof HTMLCanvasElement) {
			applyCropBtn.addEventListener("click", () => {
				renderCropCanvas();
				const cropped = cropCanvas.toDataURL("image/jpeg", 0.92);
				if (dataUrlInput && dataUrlInput instanceof HTMLInputElement) {
					dataUrlInput.value = cropped;
				}
				if (previewImg && previewImg instanceof HTMLImageElement) {
					previewImg.src = cropped;
				}
				if (cropPanel) {
					cropPanel.classList.add("hidden");
					cropPanel.classList.remove("flex");
				}
			});
		}

		if (gpForm && gpForm instanceof HTMLFormElement) {
			gpForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const titleEl = document.getElementById("gp-title");
				const websiteEl = document.getElementById("gp-website");
				const excerptEl = document.getElementById("gp-excerpt");
				const bioEl = document.getElementById("gp-bio-textarea");

				const title = titleEl && titleEl instanceof HTMLInputElement ? titleEl.value.trim() : "";
				const websiteUrl = websiteEl && websiteEl instanceof HTMLInputElement ? websiteEl.value.trim() : "";
				const excerpt = excerptEl && excerptEl instanceof HTMLInputElement ? excerptEl.value.trim() : "";
				const rawBio = bioEl && bioEl instanceof HTMLTextAreaElement ? bioEl.value.trim() : "";
				const aboutHtml = rawBio
					? rawBio
							.split(/\n{2,}/)
							.map((p) => `<p>${p.trim().replace(/\n/g, "<br/>")}</p>`)
							.join("")
					: "";
				const avatarDataUrl =
					dataUrlInput && dataUrlInput instanceof HTMLInputElement ? dataUrlInput.value : "";

				const socials = {};
				document.querySelectorAll(".gp-social-input").forEach((el) => {
					if (el instanceof HTMLInputElement) {
						const k = el.getAttribute("data-social-key");
						if (k) socials[k] = el.value.trim();
					}
				});

				if (gpSaveBtn) {
					gpSaveBtn.setAttribute("disabled", "true");
					gpSaveBtn.textContent = "Saving Guest Profile to Sanity...";
				}
				if (gpFeedback) gpFeedback.classList.add("hidden");

				try {
					const res = await fetch("/api/portal/guest-profile", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							token: portalToken,
							title,
							excerpt,
							rawBio,
							aboutHtml,
							websiteUrl,
							socials,
							avatarDataUrl: avatarDataUrl || undefined,
						}),
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						if (gpFeedback) {
							const savedDocId = data.draftId || data.guestId || "drafts.guest";
							gpFeedback.innerHTML = `✓ Saved to <code>${savedDocId}</code>! <a href="${data.previewUrl}" target="_blank" rel="noopener noreferrer" class="underline font-bold">Open Draft Preview &nearr;</a>`;
							gpFeedback.className = "text-xs font-semibold text-emerald-600 dark:text-emerald-400";
						}
						return;
					}
					if (gpFeedback) {
						gpFeedback.textContent = data.error || data.message || "Could not save guest profile.";
						gpFeedback.className = "text-xs font-semibold text-destructive";
					}
				} catch {
					if (gpFeedback) {
						gpFeedback.textContent = "Network error while saving guest profile.";
						gpFeedback.className = "text-xs font-semibold text-destructive";
					}
				} finally {
					if (gpSaveBtn) {
						gpSaveBtn.removeAttribute("disabled");
						gpSaveBtn.textContent = "Save Bio, Headshot & Socials to Sanity (Draft) →";
					}
				}
			});
		}
	})();

	// Inline E-SIGN Media Release Handler
	(function () {
		const esignForm = document.getElementById("portal-esign-form");
		const esignBtn = document.getElementById("btn-submit-esign");
		const esignFeedback = document.getElementById("esign-feedback");

		if (esignForm && esignForm instanceof HTMLFormElement) {
			esignForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const typedEl = document.getElementById("esign-typed-name");
				const recEl = document.getElementById("esign-consent-recording");
				const relEl = document.getElementById("esign-consent-release");

				const signatureData =
					typedEl && typedEl instanceof HTMLInputElement ? typedEl.value.trim() : "";
				const consentRecording =
					recEl && recEl instanceof HTMLInputElement ? recEl.checked : false;
				const consentRelease =
					relEl && relEl instanceof HTMLInputElement ? relEl.checked : false;

				if (!signatureData || signatureData.length < 2) {
					if (esignFeedback) {
						esignFeedback.textContent = "Please type your full legal name to sign.";
						esignFeedback.className = "text-xs font-semibold text-destructive";
					}
					return;
				}

				if (esignBtn) {
					esignBtn.setAttribute("disabled", "true");
					esignBtn.textContent = "Recording E-Signature...";
				}
				if (esignFeedback) esignFeedback.classList.add("hidden");

				try {
					const res = await fetch("/api/portal/sign-release", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							token: portalToken,
							signatureMode: "type",
							signatureData,
							consentRecording,
							consentRelease,
						}),
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						if (esignFeedback) {
							esignFeedback.textContent = "✓ Media Release Signed! Refreshing...";
							esignFeedback.className = "text-xs font-semibold text-emerald-600 dark:text-emerald-400";
						}
						setTimeout(() => window.location.reload(), 600);
						return;
					}
					if (esignFeedback) {
						esignFeedback.textContent = data.message || "Could not record signature.";
						esignFeedback.className = "text-xs font-semibold text-destructive";
					}
				} catch {
					if (esignFeedback) {
						esignFeedback.textContent = "Network error while recording signature.";
						esignFeedback.className = "text-xs font-semibold text-destructive";
					}
				} finally {
					if (esignBtn) {
						esignBtn.removeAttribute("disabled");
						esignBtn.textContent = "Sign Media Release →";
					}
				}
			});
		}
	})();
</script>
