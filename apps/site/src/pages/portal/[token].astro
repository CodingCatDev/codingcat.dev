					vaultFeedback.textContent =
						"Network error while uploading to Sanity Media Library.";
					vaultFeedback.classList.remove("hidden");
				}
			} finally {
				if (vaultBtn) {
					vaultBtn.removeAttribute("disabled");
					vaultBtn.textContent = "Upload →";
				}
			}
		});
	}

	// Self-Serve Speaker Bio, 512x512 Headshot Cropper & 14 Social Links Editor
	(function () {
		const gpForm = document.getElementById("guest-profile-form");
		const gpSaveBtn = document.getElementById("btn-save-guest-profile");
		const gpFeedback = document.getElementById("gp-save-feedback");
		const fileInput = document.getElementById("gp-avatar-file");
		const dataUrlInput = document.getElementById("gp-avatar-data-url");
		const previewImg = document.getElementById("gp-avatar-preview");
		const cropPanel = document.getElementById("gp-crop-panel");
		const cropCanvas = document.getElementById("gp-crop-canvas");
		const cropZoom = document.getElementById("gp-crop-zoom");
		const applyCropBtn = document.getElementById("btn-gp-apply-crop");

		let loadedImage = null;
		let zoom = 1;
		let offsetX = 0;
		let offsetY = 0;
		let isDragging = false;
		let startX = 0;
		let startY = 0;

		function renderCropCanvas() {
			if (!cropCanvas || !(cropCanvas instanceof HTMLCanvasElement) || !loadedImage) return;
			const ctx = cropCanvas.getContext("2d");
			if (!ctx) return;
			const size = 512;
			ctx.clearRect(0, 0, size, size);
			const iw = loadedImage.width;
			const ih = loadedImage.height;
			const baseScale = Math.max(size / iw, size / ih);
			const drawW = iw * baseScale * zoom;
			const drawH = ih * baseScale * zoom;
			const x = (size - drawW) / 2 + offsetX;
			const y = (size - drawH) / 2 + offsetY;
			ctx.drawImage(loadedImage, x, y, drawW, drawH);
		}

		if (fileInput && fileInput instanceof HTMLInputElement) {
			fileInput.addEventListener("change", () => {
				const file = fileInput.files && fileInput.files[0];
				if (!file) return;
				const reader = new FileReader();
				reader.onload = (ev) => {
					const src = ev.target && typeof ev.target.result === "string" ? ev.target.result : "";
					if (!src) return;
					const img = new Image();
					img.onload = () => {
						loadedImage = img;
						zoom = 1;
						offsetX = 0;
						offsetY = 0;
						if (cropZoom && cropZoom instanceof HTMLInputElement) cropZoom.value = "1";
						if (cropPanel) {
							cropPanel.classList.remove("hidden");
							cropPanel.classList.add("flex");
						}
						renderCropCanvas();
						if (cropCanvas && cropCanvas instanceof HTMLCanvasElement) {
							const cropped = cropCanvas.toDataURL("image/jpeg", 0.92);
							if (dataUrlInput && dataUrlInput instanceof HTMLInputElement) dataUrlInput.value = cropped;
							if (previewImg && previewImg instanceof HTMLImageElement) previewImg.src = cropped;
						}
					};
					img.src = src;
				};
				reader.readAsDataURL(file);
			});
		}

		if (cropZoom && cropZoom instanceof HTMLInputElement) {
			cropZoom.addEventListener("input", () => {
				zoom = Number(cropZoom.value) || 1;
				renderCropCanvas();
			});
		}

		if (cropCanvas && cropCanvas instanceof HTMLCanvasElement) {
			cropCanvas.addEventListener("pointerdown", (e) => {
				isDragging = true;
				startX = e.clientX - offsetX;
				startY = e.clientY - offsetY;
				cropCanvas.setPointerCapture(e.pointerId);
			});
			cropCanvas.addEventListener("pointermove", (e) => {
				if (!isDragging) return;
				offsetX = e.clientX - startX;
				offsetY = e.clientY - startY;
				renderCropCanvas();
			});
			cropCanvas.addEventListener("pointerup", () => {
				isDragging = false;
			});
		}

		if (applyCropBtn && cropCanvas && cropCanvas instanceof HTMLCanvasElement) {
			applyCropBtn.addEventListener("click", () => {
				renderCropCanvas();
				const cropped = cropCanvas.toDataURL("image/jpeg", 0.92);
				if (dataUrlInput && dataUrlInput instanceof HTMLInputElement) {
					dataUrlInput.value = cropped;
				}
				if (previewImg && previewImg instanceof HTMLImageElement) {
					previewImg.src = cropped;
				}
				if (cropPanel) {
					cropPanel.classList.add("hidden");
					cropPanel.classList.remove("flex");
				}
			});
		}

		if (gpForm && gpForm instanceof HTMLFormElement) {
			gpForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const titleEl = document.getElementById("gp-title");
				const websiteEl = document.getElementById("gp-website");
				const excerptEl = document.getElementById("gp-excerpt");
				const bioEl = document.getElementById("gp-bio-textarea");

				const title = titleEl && titleEl instanceof HTMLInputElement ? titleEl.value.trim() : "";
				const websiteUrl = websiteEl && websiteEl instanceof HTMLInputElement ? websiteEl.value.trim() : "";
				const excerpt = excerptEl && excerptEl instanceof HTMLInputElement ? excerptEl.value.trim() : "";
				const rawBio = bioEl && bioEl instanceof HTMLTextAreaElement ? bioEl.value.trim() : "";
				const aboutHtml = rawBio
					? rawBio
							.split(/\n{2,}/)
							.map((p) => `<p>${p.trim().replace(/\n/g, "<br/>")}</p>`)
							.join("")
					: "";
				const avatarDataUrl =
					dataUrlInput && dataUrlInput instanceof HTMLInputElement ? dataUrlInput.value : "";

				const socials = {};
				document.querySelectorAll(".gp-social-input").forEach((el) => {
					if (el instanceof HTMLInputElement) {
						const k = el.getAttribute("data-social-key");
						if (k) socials[k] = el.value.trim();
					}
				});

				if (gpSaveBtn) {
					gpSaveBtn.setAttribute("disabled", "true");
					gpSaveBtn.textContent = "Saving Guest Profile to Sanity...";
				}
				if (gpFeedback) gpFeedback.classList.add("hidden");

				try {
					const res = await fetch("/api/portal/guest-profile", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							token: portalToken,
							title,
							excerpt,
							aboutHtml,
							websiteUrl,
							socials,
							avatarDataUrl: avatarDataUrl || undefined,
						}),
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						if (gpFeedback) {
							gpFeedback.innerHTML = `✓ Saved to <code>${data.draftId}</code>! <a href="${data.previewUrl}" target="_blank" rel="noopener noreferrer" class="underline font-bold">Open Draft Preview &nearr;</a>`;
							gpFeedback.className = "text-xs font-semibold text-emerald-600 dark:text-emerald-400";
						}
						return;
					}
					if (gpFeedback) {
						gpFeedback.textContent = data.message || "Could not save guest profile.";
						gpFeedback.className = "text-xs font-semibold text-destructive";
					}
				} catch {
					if (gpFeedback) {
						gpFeedback.textContent = "Network error while saving guest profile.";
						gpFeedback.className = "text-xs font-semibold text-destructive";
					}
				} finally {
					if (gpSaveBtn) {
						gpSaveBtn.removeAttribute("disabled");
						gpSaveBtn.textContent = "Save Bio, Headshot & Socials to Sanity (Draft) →";
					}
				}
			});
		}
	})();

	// Inline E-SIGN Media Release Handler
	(function () {
		const esignForm = document.getElementById("portal-esign-form");
		const esignBtn = document.getElementById("btn-submit-esign");
		const esignFeedback = document.getElementById("esign-feedback");

		if (esignForm && esignForm instanceof HTMLFormElement) {
			esignForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const typedEl = document.getElementById("esign-typed-name");
				const recEl = document.getElementById("esign-consent-recording");
				const relEl = document.getElementById("esign-consent-release");

				const signatureData =
					typedEl && typedEl instanceof HTMLInputElement ? typedEl.value.trim() : "";
				const consentRecording =
					recEl && recEl instanceof HTMLInputElement ? recEl.checked : false;
				const consentRelease =
					relEl && relEl instanceof HTMLInputElement ? relEl.checked : false;

				if (!signatureData || signatureData.length < 2) {
					if (esignFeedback) {
						esignFeedback.textContent = "Please type your full legal name to sign.";
						esignFeedback.className = "text-xs font-semibold text-destructive";
					}
					return;
				}

				if (esignBtn) {
					esignBtn.setAttribute("disabled", "true");
					esignBtn.textContent = "Recording E-Signature...";
				}
				if (esignFeedback) esignFeedback.classList.add("hidden");

				try {
					const res = await fetch("/api/portal/sign-release", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							token: portalToken,
							signatureMode: "type",
							signatureData,
							consentRecording,
							consentRelease,
						}),
					});
					const data = await res.json();
					if (res.ok && data.ok) {
						if (esignFeedback) {
							esignFeedback.textContent = "✓ Media Release Signed! Refreshing...";
							esignFeedback.className = "text-xs font-semibold text-emerald-600 dark:text-emerald-400";
						}
						setTimeout(() => window.location.reload(), 600);
						return;
					}
					if (esignFeedback) {
						esignFeedback.textContent = data.message || "Could not record signature.";
						esignFeedback.className = "text-xs font-semibold text-destructive";
					}
				} catch {
					if (esignFeedback) {
						esignFeedback.textContent = "Network error while recording signature.";
						esignFeedback.className = "text-xs font-semibold text-destructive";
					}
				} finally {
					if (esignBtn) {
						esignBtn.removeAttribute("disabled");
						esignBtn.textContent = "Sign Media Release →";
					}
				}
			});
		}
	})();
</script>
