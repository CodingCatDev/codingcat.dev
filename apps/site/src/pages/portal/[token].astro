									<button
										type="button"
										data-slot-start={slot.startAt}
										class={`portal-slot-btn-15 p-2.5 rounded-lg border text-left transition-all cursor-pointer flex flex-col gap-0.5 ${
											index === 0
												? "border-primary bg-primary/5 ring-1 ring-primary"
												: "border-border bg-card hover:border-primary"
										}`}
									>
										<span class="font-semibold text-xs text-foreground">{slot.displayDate}</span>
										<span class="text-[11px] text-muted-foreground font-mono">{slot.displayTime}</span>
									</button>
								))
							}
						</div>

						<!-- 45-Min Recording Slots Grid -->
						<div id="portal-slots-45" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
							{
								recordingSlots.map((slot, index) => (
									<button
										type="button"
										data-slot-start={slot.startAt}
										class={`portal-slot-btn-45 p-2.5 rounded-lg border text-left transition-all cursor-pointer flex flex-col gap-0.5 ${
											index === 0
												? "border-primary bg-primary/5 ring-1 ring-primary"
												: "border-border bg-card hover:border-primary"
										}`}
									>
										<span class="font-semibold text-xs text-foreground">{slot.displayDate}</span>
										<span class="text-[11px] text-muted-foreground font-mono">{slot.displayTime}</span>
									</button>
								))
							}
						</div>

						<button
							type="button"
							id="btn-portal-book-slot"
							class="w-full px-4 py-2.5 rounded-lg bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 transition-colors cursor-pointer"
						>
							Confirm Slot &amp; Send Google Calendar Invite &rarr;
						</button>

						<div
							id="portal-booking-feedback"
							class="hidden text-xs p-3 rounded-lg border border-border bg-muted/50"
						></div>
					</div>

					<a
						href={`/book?track=${portalData.totalAmountCents === 0 ? "editorial" : "sponsored"}&portalToken=${encodeURIComponent(portalData.portalToken)}&company=${encodeURIComponent(portalData.companyName)}&name=${encodeURIComponent(portalData.contactName)}&email=${encodeURIComponent(portalData.contactEmail)}`}
						class="p-4 rounded-xl border border-border bg-background hover:border-primary transition-colors flex items-center justify-between"
					>
						<div class="flex flex-col gap-1">
							<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
								Full Calendar Date Picker
							</span>
							<span class="text-sm font-bold text-foreground">
								Browse All Dates &amp; Weeks on the Full Booking Page
							</span>
							<span class="text-xs text-muted-foreground">
								Pre-filled with your details &amp; existing E-SIGN release
							</span>
						</div>
						<span class="text-sm font-bold text-primary">&rarr;</span>
					</a>
				</div>
			</section>
		</div>

		<!-- Deliverables & Live ROI Tracking Table -->
		<section class="flex flex-col gap-4 p-6 rounded-2xl border border-border bg-card shadow-xs">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-xl font-bold tracking-tight">
						3. Multi-Channel Deliverables &amp; Live ROI Tracking
					</h2>
					<p class="text-xs text-muted-foreground">
						Every asset in your bundle is tracked here with live links and verified impression telemetry as it ships.
					</p>
				</div>
				<span class="text-xs font-mono px-2.5 py-1 rounded bg-muted text-muted-foreground">
					{portalData.deliverables.length} Deliverables
				</span>
			</div>

			<div class="divide-y divide-border rounded-xl border border-border overflow-hidden">
				{
					portalData.deliverables.map((item) => (
						<div class="p-4 bg-background flex flex-col sm:flex-row sm:items-center justify-between gap-3">
							<div class="flex flex-col gap-1">
								<span class="text-sm font-semibold text-foreground">
									{item.title}
								</span>
								<span class="text-xs text-muted-foreground font-mono uppercase">
									Channel: {item.channel}
								</span>
							</div>
							<div class="flex items-center gap-3">
								{typeof item.views === "number" && (
									<span class="text-xs font-semibold text-foreground">
										{item.views.toLocaleString()} views
									</span>
								)}
								{item.url && (
									<a
										href={item.url}
										target="_blank"
										rel="noopener noreferrer"
										class="text-xs font-semibold text-primary hover:underline"
									>
										View Live &nearr;
									</a>
								)}
								<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-muted text-foreground capitalize">
									{item.status.replace("-", " ")}
								</span>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- Section 4 (#vault): 2-Way Sanity Media Library Asset Vault -->
		<section id="vault" class="flex flex-col gap-5 p-6 rounded-2xl border-2 border-primary/40 bg-card shadow-xs">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
				<div class="flex flex-col gap-1">
					<div class="flex items-center gap-2">
						<h2 class="text-xl font-bold tracking-tight">
							4. Private Sanity Media Library Asset Vault
						</h2>
						<span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-primary/15 text-primary font-semibold">
							🔒 Token-Gated Exchange
						</span>
					</div>
					<p class="text-xs text-muted-foreground">
						Drop brand logos (SVG/PNG), talking-point briefs, slide decks, or demo clips directly into our Sanity Media Library. Files marked <strong>Private to Deal Room</strong> are proxied through your unique portal token.
					</p>
				</div>
				<span class="text-xs font-mono px-2.5 py-1 rounded bg-muted text-muted-foreground shrink-0">
					{portalData.sharedAssets.length} Vault Items
				</span>
			</div>

			<!-- Upload Dropzone Form -->
			<form id="vault-upload-form" class="grid grid-cols-1 md:grid-cols-12 gap-3 p-4 rounded-xl border border-dashed border-primary/40 bg-background">
				<div class="md:col-span-4 flex flex-col gap-1">
					<label for="vault-file" class="text-xs font-semibold text-foreground">
						Upload File (Logo, PDF Brief, Slides, Video)
					</label>
					<input
						type="file"
						id="vault-file"
						name="file"
						class="w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs text-foreground file:mr-2 file:rounded file:border-0 file:bg-primary/10 file:px-2 file:py-1 file:text-xs file:font-semibold file:text-primary"
					/>
				</div>
				<div class="md:col-span-3 flex flex-col gap-1">
					<label for="vault-title" class="text-xs font-semibold text-foreground">
						Asset Title / Note
					</label>
					<input
						type="text"
						id="vault-title"
						name="title"
						placeholder="e.g. Primary White SVG Logo or Ad Script"
						class="w-full rounded-lg border border-border bg-card px-3 py-1.5 text-xs text-foreground"
					/>
				</div>
				<div class="md:col-span-2 flex flex-col gap-1">
					<label for="vault-category" class="text-xs font-semibold text-foreground">
						Category
					</label>
					<select
						id="vault-category"
						name="category"
						class="w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs text-foreground"
					>
						<option value="logo">Brand Logo / SVG</option>
						<option value="brief">Talking Points / Brief</option>
						<option value="slides">Slide Deck / Demo</option>
						<option value="legal">Contract / Legal</option>
						<option value="media">Raw Audio / Video</option>
					</select>
				</div>
				<div class="md:col-span-3 flex flex-col justify-end gap-1">
					<label for="vault-visibility" class="text-xs font-semibold text-foreground">
						Access Level
					</label>
					<div class="flex items-center gap-2">
						<select
							id="vault-visibility"
							name="visibility"
							class="w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs text-foreground"
						>
							<option value="private">🔒 Private Vault</option>
							<option value="public">🌐 Public Brand Asset</option>
						</select>
						<button
							type="submit"
							id="btn-vault-upload"
							class="px-4 py-1.5 rounded-lg bg-primary text-primary-foreground text-xs font-bold hover:bg-primary/90 transition-colors cursor-pointer shrink-0"
						>
							Upload &rarr;
						</button>
					</div>
				</div>
				<div class="md:col-span-12 flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-1">
					<input
						type="url"
						id="vault-external-url"
						name="externalUrl"
						placeholder="Or paste an external Figma / Google Doc / Notion / GitHub repo link..."
						class="w-full rounded-lg border border-border bg-card px-3 py-1.5 text-xs text-foreground"
					/>
				</div>
				<div id="vault-upload-feedback" class="hidden md:col-span-12 text-xs p-2.5 rounded-lg border border-border bg-muted/50"></div>
			</form>

			<!-- Shared Assets List -->
			<div id="vault-assets-list" class="divide-y divide-border rounded-xl border border-border overflow-hidden">
				{portalData.sharedAssets.length === 0 ? (
					<div class="p-5 bg-background text-center text-xs text-muted-foreground">
						No assets uploaded yet. Drop your brand logos, talking points, or demo slides above to sync them directly to Sanity Media Library.
					</div>
				) : (
					portalData.sharedAssets.map((asset) => (
						<div class="p-4 bg-background flex flex-col sm:flex-row sm:items-center justify-between gap-3">
							<div class="flex flex-col gap-1">
								<div class="flex flex-wrap items-center gap-2">
									<span class="text-sm font-semibold text-foreground">
										{asset.title}
									</span>
									<span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-muted text-muted-foreground">
										{asset.category || "brief"}
									</span>
									<span class={`px-2 py-0.5 rounded text-[10px] font-mono font-semibold ${
										asset.uploadedBy === "codingcat"
											? "bg-purple-500/15 text-purple-600 dark:text-purple-300"
											: asset.uploadedBy === "passionfroot"
												? "bg-amber-500/15 text-amber-600 dark:text-amber-300"
												: "bg-emerald-500/15 text-emerald-600 dark:text-emerald-300"
									}`}>
										{asset.uploadedBy === "codingcat"
											? "From CodingCat.dev"
											: asset.uploadedBy === "passionfroot"
												? "🌱 Passionfroot Auto-Mirrored"
												: "Uploaded by Partner"}
									</span>
									{asset.visibility !== "public" && (
										<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-primary/10 text-primary">
											🔒 Private
										</span>
									)}
								</div>
								{asset.uploadedAt && (
									<span class="text-[11px] text-muted-foreground font-mono">
										Added {new Date(asset.uploadedAt).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" })}
									</span>
								)}
							</div>
							{asset.externalUrl && (
								<a
									href={asset.externalUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="px-3.5 py-1.5 rounded-lg border border-primary bg-primary/10 text-primary text-xs font-semibold hover:bg-primary/20 transition-colors shrink-0"
								>
									Open / Download Asset &nearr;
								</a>
							)}
						</div>
					))
				)}
			</div>
		</section>
	</div>
	)}
</BaseLayout>

<script
	is:inline
	define:vars={{
		portalToken: portalData.portalToken,
		leadId: isPortalAuthorized ? portalData._id : "",
		companyName: isPortalAuthorized ? portalData.companyName : "",
		contactName: isPortalAuthorized ? portalData.contactName : "",
		contactEmail: isPortalAuthorized ? portalData.contactEmail : "",
		tierId: isPortalAuthorized ? portalData.rateCard : "",
		isEditorialGuest: portalData.totalAmountCents === 0,
	}}
>
	// 0. Better-Auth Studio Portal Sign-In Gate (Email OTP, Magic Link, Google OAuth, Sign-Out)
	(function () {
		const emailInput = document.getElementById("portal-auth-email");
		const otpRequestForm = document.getElementById("portal-otp-request-form");
		const sendOtpBtn = document.getElementById("btn-portal-send-otp");
		const sendMagicBtn = document.getElementById("btn-portal-send-magic");
		const otpVerifyForm = document.getElementById("portal-otp-verify-form");
		const otpCodeInput = document.getElementById("portal-otp-code");
		const verifyOtpBtn = document.getElementById("btn-portal-verify-otp");
		const toggleOtpBoxBtn = document.getElementById("btn-portal-toggle-otp-box");
		const googleBtn = document.getElementById("btn-portal-google");
		const feedbackEl = document.getElementById("portal-auth-feedback");

		function showFeedback(message, isSuccess) {
			if (!feedbackEl) return;
			feedbackEl.textContent = message;
			feedbackEl.className = isSuccess
				? "text-xs p-3 rounded-lg border border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-medium"
				: "text-xs p-3 rounded-lg border border-destructive/40 bg-destructive/10 text-destructive font-medium";
		}

		function getEnteredEmail() {
			return emailInput && emailInput instanceof HTMLInputElement
				? emailInput.value.trim().toLowerCase()
				: "";
		}

		function revealOtpVerifyPanel() {
			if (otpVerifyForm) {
				otpVerifyForm.classList.remove("hidden");
				otpVerifyForm.classList.add("flex");
			}
			if (otpCodeInput && otpCodeInput instanceof HTMLInputElement) {
				otpCodeInput.focus();
			}
		}

		if (toggleOtpBoxBtn) {
			toggleOtpBoxBtn.addEventListener("click", () => {
				revealOtpVerifyPanel();
			});
		}

		// 1. Continue with Google OAuth
		if (googleBtn) {
			googleBtn.addEventListener("click", async () => {
				googleBtn.setAttribute("disabled", "true");
				try {
					const callbackURL = window.location.origin + window.location.pathname;
					const res = await fetch("/api/auth/sign-in/social", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							provider: "google",
							callbackURL,
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && data.url) {
						window.location.href = data.url;
						return;
					}
					showFeedback(
						data.message ||
							"Could not start Google OAuth right now. Please use the 6-digit OTP or Magic Link below.",
						false,
					);
				} catch {
					showFeedback(
						"Network error starting Google Sign-In. Please use the 6-digit OTP below.",
						false,
					);
				} finally {
					googleBtn.removeAttribute("disabled");
				}
			});
		}

		// 2. Send 6-Digit Email OTP via Better-Auth
		if (otpRequestForm && otpRequestForm instanceof HTMLFormElement) {
			otpRequestForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const email = getEnteredEmail();
				if (!email || !email.includes("@")) {
					showFeedback(
						"Please enter the invited guest or sponsor email address.",
						false,
					);
					return;
				}
				if (sendOtpBtn) {
					sendOtpBtn.setAttribute("disabled", "true");
					sendOtpBtn.textContent = "Sending 6-Digit Code...";
				}
				try {
					const res = await fetch("/api/auth/email-otp/send-verification-otp", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"x-portal-token": portalToken,
						},
						body: JSON.stringify({
							email,
							type: "sign-in",
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && (data.success || data.status)) {
						revealOtpVerifyPanel();
						showFeedback(
							`✓ Sent a 6-digit verification code to ${email}. Enter it above within 5 minutes.`,
							true,
						);
						return;
					}
					showFeedback(
						data.message ||
							"Email is not on the invite list for this Studio Portal, or could not send code.",
						false,
					);
				} catch {
					showFeedback(
						"Network error while sending 6-digit OTP code. Please try again.",
						false,
					);
				} finally {
					if (sendOtpBtn) {
						sendOtpBtn.removeAttribute("disabled");
						sendOtpBtn.textContent = "Send 6-Digit OTP Code →";
					}
				}
			});
		}

		// 3. Send 1-Click Magic Link via Better-Auth
		if (sendMagicBtn) {
			sendMagicBtn.addEventListener("click", async () => {
				const email = getEnteredEmail();
				if (!email || !email.includes("@")) {
					showFeedback(
						"Please enter your invited guest or sponsor email address first.",
						false,
					);
					return;
				}
				sendMagicBtn.setAttribute("disabled", "true");
				const origText = sendMagicBtn.textContent;
				sendMagicBtn.textContent = "Sending Magic Link...";
				try {
					const callbackURL = window.location.origin + window.location.pathname;
					const res = await fetch("/api/auth/sign-in/magic-link", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"x-portal-token": portalToken,
						},
						body: JSON.stringify({
							email,
							callbackURL,
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && (data.status || data.success !== false)) {
						showFeedback(
							`✓ Sent a 1-click sign-in Magic Link to ${email}. Check your inbox to unlock this portal.`,
							true,
						);
						return;
					}
					showFeedback(
						data.message ||
							"Could not send Magic Link for that email address.",
						false,
					);
				} catch {
					showFeedback(
						"Network error while sending Magic Link. Please try again.",
						false,
					);
				} finally {
					sendMagicBtn.removeAttribute("disabled");
					sendMagicBtn.textContent = origText;
				}
			});
		}

		// 4. Verify 6-Digit OTP & Sign In via Better-Auth
		if (otpVerifyForm && otpVerifyForm instanceof HTMLFormElement) {
			otpVerifyForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const email = getEnteredEmail();
				const otp =
					otpCodeInput && otpCodeInput instanceof HTMLInputElement
						? otpCodeInput.value.replace(/\D/g, "").trim()
						: "";
				if (!email || !email.includes("@")) {
					showFeedback("Please enter your email address above.", false);
					return;
				}
				if (otp.length !== 6) {
					showFeedback("Please enter the 6-digit numeric code from your email.", false);
					return;
				}
				if (verifyOtpBtn) {
					verifyOtpBtn.setAttribute("disabled", "true");
					verifyOtpBtn.textContent = "Verifying 6-Digit Code...";
				}
				try {
					const res = await fetch("/api/auth/sign-in/email-otp", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							email,
							otp,
						}),
					});
					const data = await res.json().catch(() => ({}));
					if (res.ok && (data.token || data.user)) {
						showFeedback("✓ Verified! Unlocking Studio Portal...", true);
						window.location.reload();
						return;
					}
					showFeedback(
						data.message ||
							"Invalid or expired 6-digit code. Please request a fresh OTP code.",
						false,
					);
				} catch {
					showFeedback(
						"Network error while verifying 6-digit code. Please try again.",
						false,
					);
				} finally {
					if (verifyOtpBtn) {
						verifyOtpBtn.removeAttribute("disabled");
						verifyOtpBtn.textContent =
							"Verify 6-Digit Code & Unlock Studio Portal →";
					}
				}
			});
		}

		// 5. Sign Out / Switch Account
		async function signOutPortal() {
			try {
				await fetch("/api/auth/sign-out", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({}),
				});
			} finally {
				window.location.reload();
			}
		}

		const lockBtn = document.getElementById("btn-portal-lock");
		if (lockBtn) {
			lockBtn.addEventListener("click", signOutPortal);
		}
		const switchAccountBtn = document.getElementById("btn-portal-switch-account");
		if (switchAccountBtn) {
			switchAccountBtn.addEventListener("click", signOutPortal);
		}
	})();

	// 0.5 Shared 2-Way Run-of-Show & Pre-Call Notes Co-Editor
	(function () {
		const rosForm = document.getElementById("run-of-show-form");
		const rosSaveBtn = document.getElementById("btn-save-ros");
		const rosFeedback = document.getElementById("ros-save-feedback");
		const loadTemplateBtn = document.getElementById("btn-load-ros-template");

		if (loadTemplateBtn) {
			loadTemplateBtn.addEventListener("click", () => {
				const outlineEl = document.getElementById("ros-outline-notes");
				const precallEl = document.getElementById("ros-precall-notes");
				if (outlineEl && outlineEl instanceof HTMLTextAreaElement) {
					const existing = outlineEl.value.trim();
					if (
						existing &&
						!window.confirm(
							"Replace current Episode Run-of-Show text with the 5-Part CodingCat.dev Template?",
						)
					) {
						return;
					}
					outlineEl.value = [
						`00:00 - 03:00 | 1. Cold Open & Origin Story`,
						`  • Welcome ${contactName || companyName} to CodingCat.dev`,
						`  • The 30-second elevator pitch: What problem were you tired of hitting in production?`,
						``,
						`03:00 - 12:00 | 2. Architecture Mental Model`,
						`  • How developers used to wire this up vs. how ${companyName} approaches it`,
						`  • Under-the-hood primitives, state flow, and developer ergonomics`,
						``,
						`12:00 - 28:00 | 3. Show Me the Code (Live Screen-Share / Demo)`,
						`  • Step-by-step walkthrough in real code (zero slideware)`,
						`  • Key workflows, CLI/UI ergonomics, and live inspection`,
						``,
						`28:00 - 38:00 | 4. Production Trade-Offs & Sharp Edges`,
						`  • Where this shines vs. when teams should use something else`,
						`  • Security, performance, and scaling gotchas`,
						``,
						`38:00 - 45:00 | 5. Verdict, Roadmap & Where to Try It`,
						`  • What is shipping next on the roadmap`,
						`  • Links to docs, GitHub repo, and starter templates`,
					].join("\n");
				}
				if (
					precallEl &&
					precallEl instanceof HTMLTextAreaElement &&
					!precallEl.value.trim()
				) {
					precallEl.value = [
						`• Target Audience Takeaway: Practical architectural mental model + working demo`,
						`• Screen-Share Check: 1080p browser/editor zoomed to 125%-150% for mobile viewers`,
						`• Audio/Video Check: Headphones on (prevents echo in StreamYard), mic selected`,
