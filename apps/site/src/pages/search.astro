---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TopicFilterStrip from "@/components/TopicFilterStrip.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Search | CodingCat.dev"
	description="Search CodingCat.dev courses, blog posts, podcast episodes, authors, and guests with Sanity Semantic Search."
>
	<Breadcrumbs links={[{ title: "Search" }]} />

	<div id="search-container" class="my-6 flex w-full flex-col gap-6 md:my-8">
		<header class="flex flex-col gap-2">
			<span class="w-fit rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200">
				🔍 Sanity Content Lake + Clairic Semantic Search
			</span>
			<h1 class="mt-2 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white md:text-6xl">
				search <span class="text-[#7C3AED] dark:text-[#C084FC]">codingcat.dev</span>
			</h1>
			<p class="font-hand text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				Find courses, blog posts, podcast episodes, authors, and guests, or jump straight into a vendor hub below.
			</p>
		</header>

		<TopicFilterStrip label="Official Vendor & Topic Hubs:" />

		<!-- Search Input Bar -->
		<div class="flex w-full max-w-4xl flex-col gap-3">
			<form
				id="search-page-form"
				action="/search"
				method="GET"
				class="relative w-full"
				toolname="search_content"
				tooldescription="Search CodingCat.dev web development tutorials, blog posts, and podcasts"
				onsubmit="return false"
			>
				<label for="search-input" class="sr-only">Search</label>
				<div class="relative flex items-center">
					<div
						class="pointer-events-none absolute left-4 text-[#7C3AED] dark:text-[#C084FC]"
						aria-hidden="true"
					>
						<svg
							class="size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
					</div>
					<input
						type="search"
						id="search-input"
						name="q"
						autocomplete="off"
						placeholder="Search courses, podcasts, and blog posts..."
						class="w-full rounded-2xl border-2 border-[#2A1155] bg-white py-4 pl-12 pr-12 font-display text-base font-bold text-[#2A1155] shadow-sketch-sm transition-all placeholder:text-[#2A1155]/45 focus:outline-none focus:ring-2 focus:ring-[#7C3AED] dark:border-white/25 dark:bg-[#131B2E] dark:text-white dark:placeholder:text-slate-400 md:text-lg"
						toolparamdescription="Search keyword or technical topic"
					/>
					<button
						type="button"
						id="search-clear-btn"
						class="absolute right-3.5 hidden size-8 cursor-pointer items-center justify-center rounded-xl text-[#2A1155]/60 transition-colors hover:text-[#2A1155] dark:text-slate-400 dark:hover:text-white"
						aria-label="Clear search query"
					>
						<svg
							class="size-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
			</form>

			<!-- First Item: ✨ Ask agent (Opens persistent right-side Agent AJ Drawer) -->
			<button
				type="button"
				id="search-mode-ai-btn"
				class="group flex w-full cursor-pointer items-center justify-between gap-3 rounded-2xl border-2 border-[#2A1155] bg-[#EDE9FE] px-5 py-3.5 text-left text-sm font-bold text-[#2A1155] shadow-sketch-sm transition-all hover:-translate-y-0.5 hover:border-[#7C3AED] dark:border-purple-400/30 dark:bg-purple-950/60 dark:text-white"
			>
				<div class="flex min-w-0 items-center gap-3">
					<svg
						class="size-4 shrink-0 text-[#7C3AED] dark:text-[#C084FC]"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
						<path d="M20 3v4"></path>
						<path d="M22 5h-4"></path>
						<path d="M4 17v2"></path>
						<path d="M5 18H3"></path>
					</svg>
					<span class="truncate font-display font-black">
						Ask Agent AJ<span id="search-ask-agent-query" class="text-[#7C3AED] dark:text-[#C084FC]"></span>
					</span>
				</div>
				<span class="shrink-0 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:text-[#C084FC]">
					Open Drawer &rarr;
				</span>
			</button>
		</div>

		<!-- Content Type Filters -->
		<div
			id="search-filter-toolbar"
			class="flex flex-wrap items-center gap-2 pt-1"
			role="toolbar"
			aria-label="Filter results by content type"
		>
			<span class="mr-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#2A1155]/70 dark:text-slate-400">
				Filter:
			</span>
			<button
				type="button"
				class="filter-pill active-pill cursor-pointer rounded-full border-2 border-[#2A1155] bg-[#7C3AED] px-4 py-1.5 font-display text-xs font-black text-white shadow-sketch-sm transition-colors"
				data-type="all"
			>
				All
			</button>
			<button
				type="button"
				class="filter-pill cursor-pointer rounded-full border-2 border-[#2A1155] bg-white px-4 py-1.5 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition-colors hover:bg-[#EDE9FE] dark:border-white/25 dark:bg-[#131B2E] dark:text-white"
				data-type="post"
			>
				Blog Posts
			</button>
			<button
				type="button"
				class="filter-pill cursor-pointer rounded-full border-2 border-[#2A1155] bg-white px-4 py-1.5 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition-colors hover:bg-[#EDE9FE] dark:border-white/25 dark:bg-[#131B2E] dark:text-white"
				data-type="podcast"
			>
				Podcasts
			</button>
			<button
				type="button"
				class="filter-pill cursor-pointer rounded-full border-2 border-[#2A1155] bg-white px-4 py-1.5 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition-colors hover:bg-[#EDE9FE] dark:border-white/25 dark:bg-[#131B2E] dark:text-white"
				data-type="author"
			>
				Authors
			</button>
			<button
				type="button"
				class="filter-pill cursor-pointer rounded-full border-2 border-[#2A1155] bg-white px-4 py-1.5 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition-colors hover:bg-[#EDE9FE] dark:border-white/25 dark:bg-[#131B2E] dark:text-white"
				data-type="guest"
			>
				Guests
			</button>
		</div>

		<!-- Status & Summary Line -->
		<div
			id="search-status-bar"
			class="flex min-h-5 max-w-4xl flex-wrap items-center justify-between gap-2 font-mono text-xs font-bold text-[#2A1155]/70 dark:text-slate-400"
		>
			<span id="search-count-text"></span>
			<div class="flex items-center gap-2">
				<span
					id="search-clairic-pill"
					class="hidden rounded-full border border-[#2A1155]/30 bg-[#EDE9FE] px-2.5 py-0.5 font-mono text-[11px] font-extrabold text-[#7C3AED] dark:bg-purple-950/80 dark:text-purple-200"
				></span>
				<span id="search-powered-by" class="text-[11px]">
					Sanity Semantic Search · Clairic
				</span>
			</div>
		</div>

		<!-- Empty State: Ready to Search (Initial) -->
		<div
			id="state-ready"
			class="duo-card hand-border my-4 flex max-w-4xl flex-col items-center justify-center p-8 text-center md:p-12"
		>
			<div class="mb-3 flex size-12 items-center justify-center rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] text-[#7C3AED] dark:bg-purple-950/60 dark:text-[#C084FC]">
				<svg
					class="size-6"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
			</div>
			<h2 class="mb-1 font-display text-2xl font-black text-[#2A1155] dark:text-white">
				Ready to explore?
			</h2>
			<p class="mb-6 max-w-md text-sm font-medium text-[#2A1155]/75 dark:text-slate-300">
				Type a query above to search blog posts, podcast episodes, authors, and guests, or click a quick topic below:
			</p>
			<div class="flex max-w-lg flex-wrap items-center justify-center gap-2">
				<span class="font-mono text-xs font-bold text-[#2A1155]/70 dark:text-slate-400">
					Quick search:
				</span>
				{
					["Sanity", "Firebase", "Amplify", "Astro", "Cloudflare", "Svelte", "MCP"].map(
						(topic) => (
							<button
								type="button"
								class="topic-suggestion-btn cursor-pointer rounded-xl border-2 border-[#2A1155] bg-white px-3 py-1 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition-colors hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#0B1326] dark:text-white"
								data-topic={topic}
							>
								{topic}
							</button>
						),
					)
				}
			</div>
		</div>

		<!-- Loading State -->
		<div
			id="state-loading"
			class="my-4 hidden max-w-4xl flex-col items-center justify-center p-12 text-center"
		>
			<div
				class="mb-3 inline-block size-8 animate-spin rounded-full border-2 border-solid border-[#7C3AED] border-r-transparent"
				role="status"
			>
				<span class="sr-only">Loading...</span>
			</div>
			<p class="font-display text-sm font-bold text-[#2A1155]/75 dark:text-slate-300">
				Searching content...
			</p>
		</div>

		<!-- State: Error / Unavailable -->
		<div
			id="state-error"
			class="duo-card hand-border my-4 hidden max-w-4xl flex-col items-center justify-center p-8 text-center md:p-12"
		>
			<h2 class="mb-1 font-display text-xl font-black text-[#2A1155] dark:text-white">
				Search Service Unavailable
			</h2>
			<p
				class="mb-4 max-w-md text-sm font-medium text-[#2A1155]/75 dark:text-slate-300"
				id="error-message"
			>
				The search service encountered an error. You can still browse our latest content directly.
			</p>
			<div class="flex flex-wrap justify-center gap-3">
				<a href="/blog" class="tactile-btn px-5 py-2 text-xs">
					Browse Blog Posts
				</a>
				<a href="/podcasts" class="tactile-btn-secondary px-5 py-2 text-xs font-extrabold">
					Browse Podcasts
				</a>
			</div>
		</div>

		<!-- State: No Results Found -->
		<div
			id="state-no-results"
			class="duo-card hand-border my-4 hidden max-w-4xl flex-col items-center justify-center p-8 text-center md:p-12"
		>
			<h2 class="mb-1 font-display text-xl font-black text-[#2A1155] dark:text-white">
				No results found
			</h2>
			<p
				class="max-w-md text-sm font-medium text-[#2A1155]/75 dark:text-slate-300"
				id="no-results-text"
			>
				We could not find any matches for your query. Try searching for different keywords or click "Ask Agent AJ" above.
			</p>
		</div>

		<!-- Results Container -->
		<div
			id="search-results-list"
			class="hidden max-w-4xl flex-col gap-4"
			role="region"
			aria-label="Search Results"
		></div>
	</div>
</BaseLayout>

<script>
	interface SearchHit {
		id: string;
		type: string;
		title: string;
		slug: string;
		href: string;
		excerpt?: string;
		date?: string;
	}

	interface ApiResponse {
		query: string;
		type?: string;
		total: number;
		hits: SearchHit[];
		semantic: boolean;
		extraction?: {
			model: string;
			source: "clairic" | "fastpath";
			intent: string;
			contentType?: string;
			searchQuery: string;
			latencyMs: number;
		};
	}

	const input = document.getElementById("search-input") as HTMLInputElement | null;
	const clearBtn = document.getElementById("search-clear-btn");
	const statusCount = document.getElementById("search-count-text");
	const askAgentBtn = document.getElementById("search-mode-ai-btn");
	const askAgentQuerySpan = document.getElementById("search-ask-agent-query");
	const clairicPill = document.getElementById("search-clairic-pill");

	const stateReady = document.getElementById("state-ready");
	const stateLoading = document.getElementById("state-loading");
	const stateError = document.getElementById("state-error");
	const stateNoResults = document.getElementById("state-no-results");
	const noResultsText = document.getElementById("no-results-text");
	const resultsList = document.getElementById("search-results-list");

	let selectedType: string = "all";
	let currentQuery: string = "";
	let debounceTimer: ReturnType<typeof setTimeout> | null = null;
	let currentAbortController: AbortController | null = null;

	function showState(state: "ready" | "loading" | "error" | "no-results" | "results") {
		if (stateReady) stateReady.classList.toggle("hidden", state !== "ready");
		if (stateLoading) stateLoading.classList.toggle("hidden", state !== "loading");
		if (stateError) stateError.classList.toggle("hidden", state !== "error");
		if (stateNoResults) stateNoResults.classList.toggle("hidden", state !== "no-results");
		if (resultsList) resultsList.classList.toggle("hidden", state !== "results");
	}

	askAgentBtn?.addEventListener("click", () => {
		const q = input?.value.trim() || "";
		const win = window as unknown as {
			openAgentAjDrawer?: (prompt?: string) => void;
		};
		win.openAgentAjDrawer?.(q || undefined);
	});

	function getBadgeInfo(type: string): { label: string; badgeClass: string } {
		switch (type) {
			case "post":
				return {
					label: "✏️ Blog Post",
					badgeClass: "bg-[#EDE9FE] text-[#7C3AED] dark:bg-purple-950/80 dark:text-purple-200",
				};
			case "podcast":
				return {
					label: "🎧 Podcast Episode",
					badgeClass: "bg-[#FEF08A] text-[#713F12]",
				};
			case "author":
				return {
					label: "🐾 Author",
					badgeClass: "bg-[#BAE6FD] text-[#0369A1]",
				};
			case "guest":
				return {
					label: "🎙️ Guest",
					badgeClass: "bg-[#86EFAC] text-[#166534]",
				};
			default:
				return {
					label: type || "Content",
					badgeClass: "bg-[#EDE9FE] text-[#7C3AED]",
				};
		}
	}

	function renderHits(hits: SearchHit[]) {
		if (!resultsList) return;
		resultsList.innerHTML = "";

		for (const hit of hits) {
			const type = hit.type || "post";
			const href = hit.href || `/${type}/${hit.slug}`;
			const title = hit.title || "Untitled";
			const excerpt = hit.excerpt || "";
			const badge = getBadgeInfo(type);

			const card = document.createElement("article");
			card.className =
				"duo-card hand-border group relative flex flex-col gap-2 p-5 transition-all hover:-translate-y-1 hover:border-[#7C3AED] dark:hover:border-[#C084FC]";

			card.innerHTML = `
				<div class="flex items-center justify-between gap-2">
					<span class="inline-flex items-center gap-1.5 rounded-full border border-[#2A1155]/30 px-3 py-0.5 font-mono text-xs font-extrabold uppercase tracking-wider ${badge.badgeClass}">
						${badge.label}
					</span>
				</div>
				<h2 class="font-display text-xl font-black text-[#2A1155] group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC] transition-colors">
					<a href="${href}" class="hover:underline">
						${title}
					</a>
				</h2>
				${excerpt ? `<p class="text-sm font-medium text-[#2A1155]/75 dark:text-slate-300 line-clamp-2 leading-relaxed">${excerpt}</p>` : ""}
			`;

			resultsList.appendChild(card);
		}
	}

	async function performSearch(query: string, type: string) {
		const trimmed = query.trim();
		if (askAgentQuerySpan) {
			askAgentQuerySpan.textContent = trimmed ? `: "${trimmed}"` : "";
		}
		if (!trimmed || trimmed.length < 2) {
			showState("ready");
			if (statusCount) statusCount.textContent = "";
			if (clairicPill) clairicPill.classList.add("hidden");
			return;
		}

		if (currentAbortController) {
			currentAbortController.abort();
		}
		currentAbortController = new AbortController();

		showState("loading");

		try {
			const endpoint = `/api/search?q=${encodeURIComponent(trimmed)}&type=${encodeURIComponent(type)}`;
			const res = await fetch(endpoint, {
				signal: currentAbortController.signal,
			});

			if (!res.ok) {
				throw new Error(`Search returned HTTP ${res.status}`);
			}

			const data = (await res.json()) as ApiResponse;
			const hits = data.hits || [];

			if (clairicPill && data.extraction) {
				clairicPill.textContent = `⚡ ${data.extraction.source}: ${data.extraction.intent} (${data.extraction.latencyMs}ms)`;
				clairicPill.classList.remove("hidden");
			}

			if (hits.length === 0) {
				if (noResultsText) {
					noResultsText.textContent = `No matches found for "${trimmed}". Click "Ask Agent AJ" above to ask in the side drawer.`;
				}
				if (statusCount) {
					statusCount.textContent = "0 results found";
				}
				showState("no-results");
			} else {
				if (statusCount) {
					statusCount.textContent = `Found ${data.total} result${data.total === 1 ? "" : "s"}`;
				}
				renderHits(hits);
				showState("results");
			}
		} catch (err: unknown) {
			if (err instanceof Error && err.name === "AbortError") {
				return;
			}
			console.warn("Search error:", err);
			showState("error");
			if (statusCount) statusCount.textContent = "Search unavailable";
		}
	}

	function handleQueryChange() {
		const val = input?.value ?? "";
		currentQuery = val;
		if (clearBtn) {
			clearBtn.classList.toggle("hidden", !val);
		}
		if (askAgentQuerySpan) {
			askAgentQuerySpan.textContent = val.trim() ? `: "${val.trim()}"` : "";
		}

		const url = new URL(window.location.href);
		if (val.trim()) {
			url.searchParams.set("q", val.trim());
		} else {
			url.searchParams.delete("q");
		}
		window.history.replaceState({}, "", url.toString());

		if (debounceTimer) clearTimeout(debounceTimer);
		debounceTimer = setTimeout(() => {
			performSearch(currentQuery, selectedType);
		}, 250);
	}

	if (input) {
		input.addEventListener("input", handleQueryChange);
	}

	if (clearBtn) {
		clearBtn.addEventListener("click", () => {
			if (input) {
				input.value = "";
				input.focus();
				handleQueryChange();
			}
		});
	}

	document.querySelectorAll(".filter-pill").forEach((pill) => {
		pill.addEventListener("click", () => {
			document.querySelectorAll(".filter-pill").forEach((p) => {
				p.classList.remove("active-pill", "bg-[#7C3AED]", "text-white");
				p.classList.add("bg-white", "text-[#2A1155]", "dark:bg-[#131B2E]", "dark:text-white");
			});
			pill.classList.add("active-pill", "bg-[#7C3AED]", "text-white");
			pill.classList.remove("bg-white", "text-[#2A1155]", "dark:bg-[#131B2E]");

			selectedType = pill.getAttribute("data-type") || "all";
			performSearch(currentQuery, selectedType);
		});
	});

	document.querySelectorAll(".topic-suggestion-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			const topic = btn.getAttribute("data-topic");
			if (topic && input) {
				input.value = topic;
				handleQueryChange();
				input.focus();
			}
		});
	});

	const initialParams = new URLSearchParams(window.location.search);
	const initialQuery = initialParams.get("q");
	const initialMode = initialParams.get("mode");
	if (initialQuery && input) {
		input.value = initialQuery;
		currentQuery = initialQuery;
		if (clearBtn) clearBtn.classList.remove("hidden");
		performSearch(initialQuery, selectedType);
		if (initialMode === "ai") {
			const win = window as unknown as {
				openAgentAjDrawer?: (prompt?: string) => void;
			};
			win.openAgentAjDrawer?.(initialQuery);
		}
	} else {
		showState("ready");
	}
</script>
