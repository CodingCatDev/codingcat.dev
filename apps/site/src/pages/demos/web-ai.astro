							/>
							<div class="flex flex-wrap gap-2">
								<button type="button" data-sample-query="How do I expose browser tools to AI agents with WebMCP and registerTool?" class="rag-preset-btn rounded-lg border border-[#2A1155]/30 px-2.5 py-1 font-mono text-[11px] hover:bg-[#7C3AED]/10 dark:border-white/20">
									WebMCP registerTool
								</button>
								<button type="button" data-sample-query="Run offline LLM inference in Chrome with Gemini Nano and Prompt API" class="rag-preset-btn rounded-lg border border-[#2A1155]/30 px-2.5 py-1 font-mono text-[11px] hover:bg-[#7C3AED]/10 dark:border-white/20">
									Gemini Nano Offline
								</button>
								<button type="button" data-sample-query="WebGPU shaders and OPFS local vector storage with Transformers.js" class="rag-preset-btn rounded-lg border border-[#2A1155]/30 px-2.5 py-1 font-mono text-[11px] hover:bg-[#7C3AED]/10 dark:border-white/20">
									WebGPU + OPFS RAG
								</button>
								<button type="button" data-sample-query="Fallback from local browser AI to Firebase AI Logic and Cloudflare Workers" class="rag-preset-btn rounded-lg border border-[#2A1155]/30 px-2.5 py-1 font-mono text-[11px] hover:bg-[#7C3AED]/10 dark:border-white/20">
									Hybrid Cloud Fallback
								</button>
							</div>
							<div class="pt-1 flex items-center gap-3">
								<button
									type="button"
									id="btn-run-webgpu-rag"
									class="tactile-btn px-5 py-2.5 text-xs font-extrabold"
								>
									<span>Compute Local Cosine Similarity</span>
									<span class="text-[#86EFAC]">&rarr;</span>
								</button>
								<span id="webgpu-compute-time" class="font-mono text-xs font-bold text-[#7C3AED] dark:text-[#86EFAC]">
									Ready
								</span>
							</div>
						</div>
					</div>

					<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] space-y-3">
						<h3 class="font-display text-lg font-black text-[#2A1155] dark:text-white">
							Top-K Local Vector Matches (Cosine Similarity)
						</h3>
						<div id="webgpu-rag-results" class="space-y-3">
							<a href="/post/webmcp-browser-native-model-context-protocol-guide" class="block rounded-xl border-2 border-[#2A1155] bg-white p-3.5 transition hover:border-[#7C3AED] dark:border-white/15 dark:bg-[#131B2E]">
								<div class="flex items-center justify-between gap-2">
									<span class="font-mono text-[11px] font-bold text-[#7C3AED] dark:text-[#C084FC]">Apr 14, 2026</span>
									<span class="rounded-md bg-[#86EFAC]/25 px-2 py-0.5 font-mono text-xs font-extrabold text-[#14532D] dark:text-[#86EFAC]">Cosine: 0.942 (94%)</span>
								</div>
								<div class="mt-1 font-display text-sm font-black text-[#2A1155] dark:text-white">WebMCP Explained: Exposing Browser-Native AI Tools with document.modelContext</div>
								<p class="mt-1 text-xs text-[#2A1155]/75 dark:text-slate-300">Deep dive into the W3C WebMCP specification, imperative registerTool() lifecycles with AbortController, and declarative HTML tool forms.</p>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Web AI Stack Architectural Trade-Off Comparison Table -->
		<section class="duo-card hand-border p-6 sm:p-10 space-y-5">
			<h2 class="font-display text-2xl sm:text-3xl font-black text-[#2A1155] dark:text-white">
				Web AI &amp; Agent Architecture Trade-Off Matrix
			</h2>
			<p class="text-sm sm:text-base text-[#2A1155]/80 dark:text-slate-300">
				How modern browser-native AI capabilities compare across latency, privacy, token economics, and ideal production workloads:
			</p>
			<div class="overflow-x-auto rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-4 dark:border-white/20 dark:bg-[#0B1326]">
				<table class="m-0 w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b-2 border-[#2A1155]/20 font-display font-black dark:border-white/15">
							<th class="py-3 pr-4">Web AI Layer</th>
							<th class="px-4 py-3">Browser API / Standard</th>
							<th class="px-4 py-3">Network Latency &amp; Cost</th>
							<th class="py-3 pl-4">Best Production Use Case</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-[#2A1155]/10 dark:divide-white/10">
						<tr>
							<td class="py-3 pr-4 font-bold">WebMCP (Client-Side Agent Tools)</td>
							<td class="px-4 py-3 font-mono text-xs"><code>document.modelContext.registerTool</code> &amp; <code>&lt;form toolname&gt;</code></td>
							<td class="px-4 py-3 font-mono text-xs text-[#14532D] dark:text-[#86EFAC]">0ms IPC / 90% fewer agent tokens</td>
							<td class="py-3 pl-4 text-xs">Exposing authenticated in-tab actions (search, filters, checkout, speaker kits) to browser AI assistants without fragile DOM scraping.</td>
						</tr>
						<tr>
							<td class="py-3 pr-4 font-bold">Chrome Built-in AI (Gemini Nano)</td>
							<td class="px-4 py-3 font-mono text-xs"><code>LanguageModel</code>, <code>Summarizer</code>, <code>Rewriter</code>, <code>Translator</code></td>
							<td class="px-4 py-3 font-mono text-xs text-[#14532D] dark:text-[#86EFAC]">0ms RTT / $0 per 1M tokens</td>
							<td class="py-3 pl-4 text-xs">Privacy-sensitive drafting, instant article summaries, offline-capable UI helpers, and zero-cost pre-classification.</td>
						</tr>
						<tr>
							<td class="py-3 pr-4 font-bold">Client-Side WebGPU / WebNN</td>
							<td class="px-4 py-3 font-mono text-xs"><code>navigator.gpu</code> + Transformers.js v3 / MediaPipe + OPFS</td>
							<td class="px-4 py-3 font-mono text-xs text-[#14532D] dark:text-[#86EFAC]">0ms RTT / Local GPU Shaders</td>
							<td class="py-3 pl-4 text-xs">Local 384-d embeddings, client-side RAG over OPFS/IndexedDB, and real-time vision/audio inference.</td>
						</tr>
						<tr>
							<td class="py-3 pr-4 font-bold">Hybrid Edge AI Fallback</td>
							<td class="px-4 py-3 font-mono text-xs">Firebase AI Logic (Gemini Flash) / Cloudflare Workers</td>
							<td class="px-4 py-3 font-mono text-xs text-[#7C3AED] dark:text-[#C084FC]">120ms to 380ms RTT / Metered API</td>
							<td class="py-3 pl-4 text-xs">Fallback for devices without local NPU/GPU weights or complex multi-step reasoning and large context windows.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	</div>

	<script is:inline>
		(function () {
			function initWebAiPlayground() {
				const rootPanel = document.getElementById("panel-webmcp");
				if (!rootPanel || rootPanel.dataset.webaiInitialized === "true") {
					return;
				}
				rootPanel.dataset.webaiInitialized = "true";

				// 1. Register interactive WebMCP tools on document.modelContext / navigator.modelContext
				const toolRegistry = new Map();

				const tools = [
					{
						name: "search_content",
						description:
							"Search CodingCat.dev tutorials, blog posts, courses, and podcasts by technical topic",
						annotations: { readOnlyHint: true, untrustedContentHint: true },
						inputSchema: {
							type: "object",
							properties: {
								query: {
									type: "string",
									description:
										"Keyword or technology (e.g. WebMCP, Gemini Nano, WebGPU, Astro)",
								},
							},
							required: ["query"],
						},
						execute: async ({ query }) => {
							const res = await fetch(
								"/api/search?q=" + encodeURIComponent(query || "WebMCP")
							);
							if (!res.ok) throw new Error("Search HTTP " + res.status);
							return await res.json();
						},
					},
					{
						name: "estimate_inference_budget",
						description:
							"Calculate monthly token cost savings when offloading prompts to Chrome Built-in AI (Gemini Nano) vs cloud LLM APIs",
						annotations: { readOnlyHint: true, untrustedContentHint: false },
						inputSchema: {
							type: "object",
							properties: {
								monthlyActiveUsers: {
									type: "number",
									description: "Monthly active users triggering AI features",
								},
								promptsPerUser: {
									type: "number",
									description: "Average prompts per user per month",
								},
								localOffloadRatio: {
									type: "number",
									description:
										"Fraction (0.0 to 1.0) handled locally by Chrome Gemini Nano",
								},
							},
							required: [
								"monthlyActiveUsers",
								"promptsPerUser",
								"localOffloadRatio",
							],
						},
						execute: async ({
							monthlyActiveUsers = 50000,
							promptsPerUser = 25,
							localOffloadRatio = 0.72,
						}) => {
							const totalPrompts = monthlyActiveUsers * promptsPerUser;
							const avgTokensPerPrompt = 1200;
							const totalTokens = totalPrompts * avgTokensPerPrompt;
							const cloudCostPerMillion = 0.35;
							const cloudOnlyMonthlyUsd = Number(
								((totalTokens / 1_000_000) * cloudCostPerMillion).toFixed(2)
							);
							const hybridMonthlyUsd = Number(
								(cloudOnlyMonthlyUsd * (1 - localOffloadRatio)).toFixed(2)
							);
							return {
								totalMonthlyPrompts: totalPrompts,
								totalMonthlyTokens: totalTokens,
								localGeminiNanoOffloadPercent:
									Math.round(localOffloadRatio * 100) + "%",
								cloudOnlyMonthlyCostUsd: cloudOnlyMonthlyUsd,
								hybridBrowserEdgeCostUsd: hybridMonthlyUsd,
								monthlySavingsUsd: Number(
									(cloudOnlyMonthlyUsd - hybridMonthlyUsd).toFixed(2)
								),
							};
						},
					},
					{
						name: "extract_page_headings",
						description:
							"Extract the structured H1-H3 semantic outline of the current page for low-token agent navigation",
						annotations: { readOnlyHint: true, untrustedContentHint: false },
						inputSchema: {
							type: "object",
							properties: {
								maxDepth: {
									type: "number",
									description: "Maximum heading level to include (2 or 3)",
								},
							},
						},
						execute: async ({ maxDepth = 3 } = {}) => {
							const selector = maxDepth === 2 ? "h1, h2" : "h1, h2, h3";
							const nodes = Array.from(document.querySelectorAll(selector));
							return {
								url: window.location.href,
								headingCount: nodes.length,
								outline: nodes.map((el) => ({
									tag: el.tagName.toLowerCase(),
									text: (el.textContent || "").trim(),
								})),
							};
						},
					},
				];

				const mc =
					document.modelContext ||
					(typeof navigator !== "undefined" && navigator.modelContext);

				for (const t of tools) {
					toolRegistry.set(t.name, t);
					if (mc && typeof mc.registerTool === "function") {
						try {
							mc.registerTool(t);
						} catch (_) {
							// Ignore duplicate registration if already registered by BaseLayout
						}
					}
				}

				// Update Top Telemetry Strip
				const elWebmcp = document.getElementById("status-webmcp");
				if (elWebmcp) {
					elWebmcp.textContent = mc
						? `Native API Active (${toolRegistry.size} tools)`
						: `Polyfill Ready (${toolRegistry.size} tools)`;
				}

				async function probeBuiltInAi() {
					const elPrompt = document.getElementById("status-prompt-api");
					const elSum = document.getElementById("status-summarizer-api");
					const elGpu = document.getElementById("status-webgpu");
					const elDiag = document.getElementById("builtin-diag-dump");

					const diag = {
						userAgent: navigator.userAgent,
						webmcp: {
							documentModelContext: Boolean(document.modelContext),
							navigatorModelContext: Boolean(navigator.modelContext),
							registeredTools: Array.from(toolRegistry.keys()),
						},
						builtInAi: {
							LanguageModel: "unavailable",
							Summarizer: "unavailable",
							Rewriter: "unavailable",
						},
						hybridFallback: {
							sdkPattern: "firebase/ai (InferenceMode.PREFER_ON_DEVICE)",
							edgeEndpoint: "/api/ai/hybrid-fallback",
							cloudModel: "gemini-flash",
						},
						webgpu: {
							supported: Boolean(navigator.gpu),
							adapter: null,
						},
					};

					try {
						const lm =
							window.LanguageModel || (window.ai && window.ai.languageModel);
						if (lm && typeof lm.availability === "function") {
							diag.builtInAi.LanguageModel = await lm.availability();
						} else if (lm && typeof lm.capabilities === "function") {
							const caps = await lm.capabilities();
							diag.builtInAi.LanguageModel = caps.available || "available";
						}
					} catch (e) {
						diag.builtInAi.LanguageModel = "error: " + String(e);
					}

					try {
						const sum =
							window.Summarizer || (window.ai && window.ai.summarizer);
						if (sum && typeof sum.availability === "function") {
							diag.builtInAi.Summarizer = await sum.availability();
						}
					} catch (_) {}

					try {
						const rew = window.Rewriter || (window.ai && window.ai.rewriter);
						if (rew && typeof rew.availability === "function") {
							diag.builtInAi.Rewriter = await rew.availability();
						}
					} catch (_) {}

					if (
						navigator.gpu &&
						typeof navigator.gpu.requestAdapter === "function"
					) {
						try {
							const adapter = await navigator.gpu.requestAdapter();
							if (adapter) {
								const info = adapter.info || {};
								diag.webgpu.adapter = {
									vendor: info.vendor || "GPU Adapter",
									architecture: info.architecture || "WebGPU",
								};
							}
						} catch (_) {}
					}

					if (elPrompt) {
						elPrompt.textContent =
							diag.builtInAi.LanguageModel === "unavailable"
								? "Hybrid Fallback Ready"
								: `Gemini Nano (${diag.builtInAi.LanguageModel})`;
					}
					if (elSum) {
						elSum.textContent =
							diag.builtInAi.Summarizer === "unavailable"
								? "Hybrid Fallback Ready"
								: `Available (${diag.builtInAi.Summarizer})`;
					}
					if (elGpu) {
						elGpu.textContent = diag.webgpu.supported
							? "navigator.gpu Active"
							: "Float32 SIMD Fallback";
					}
					if (elDiag) {
						elDiag.textContent = JSON.stringify(diag, null, 2);
					}
				}

				probeBuiltInAi();

				// Tab switching logic
				const tabBtns = document.querySelectorAll(".webai-tab-btn");
				const panels = {
					webmcp: document.getElementById("panel-webmcp"),
					builtin: document.getElementById("panel-builtin"),
					webgpu: document.getElementById("panel-webgpu"),
				};

				tabBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						const target = btn.getAttribute("data-tab-target");
						tabBtns.forEach((b) => {
							const isMatch = b.getAttribute("data-tab-target") === target;
							b.setAttribute("aria-selected", isMatch ? "true" : "false");
							b.className = isMatch
								? "webai-tab-btn tactile-btn px-5 py-2.5 text-sm font-extrabold"
								: "webai-tab-btn tactile-btn-secondary px-5 py-2.5 text-sm font-extrabold";
						});
						Object.entries(panels).forEach(([k, panel]) => {
							if (!panel) return;
							if (k === target) {
								panel.classList.remove("hidden");
							} else {
								panel.classList.add("hidden");
							}
						});
					});
				});

				// Tab 1: Imperative Tool Selector & Runner
				const selectEl = document.getElementById("webmcp-tool-select");
				const argsEl = document.getElementById("webmcp-tool-args");
				const schemaEl = document.getElementById("webmcp-schema-preview");
				const outEl = document.getElementById("webmcp-tool-output");
				const latencyEl = document.getElementById("webmcp-exec-latency");
				const runBtn = document.getElementById("btn-run-webmcp-tool");

				const defaultArgs = {
					search_content: JSON.stringify({ query: "WebMCP" }, null, 2),
					estimate_inference_budget: JSON.stringify(
						{
							monthlyActiveUsers: 50000,
							promptsPerUser: 25,
							localOffloadRatio: 0.72,
						},
						null,
						2
					),
					extract_page_headings: JSON.stringify({ maxDepth: 3 }, null, 2),
				};

				function renderSelectedToolSchema() {
					if (!selectEl || !schemaEl) return;
					const tool = toolRegistry.get(selectEl.value);
					if (!tool) return;
					if (argsEl && defaultArgs[selectEl.value]) {
						argsEl.value = defaultArgs[selectEl.value];
					}
					schemaEl.textContent = JSON.stringify(
						{
							name: tool.name,
							description: tool.description,
							annotations: tool.annotations,
							inputSchema: tool.inputSchema,
						},
						null,
						2
					);
				}

				if (selectEl) {
					selectEl.addEventListener("change", renderSelectedToolSchema);
					renderSelectedToolSchema();
				}

				if (runBtn) {
					runBtn.addEventListener("click", async () => {
						const name = selectEl ? selectEl.value : "search_content";
						const tool = toolRegistry.get(name);
						if (!tool || !outEl) return;
						let parsedArgs = {};
						try {
							parsedArgs = JSON.parse(argsEl ? argsEl.value : "{}");
						} catch (err) {
							outEl.textContent = "Invalid JSON input: " + String(err);
							return;
						}
						outEl.textContent = "Executing WebMCP tool '" + name + "'...";
						const t0 = performance.now();
						try {
							const res = await tool.execute(parsedArgs);
							const elapsed = (performance.now() - t0).toFixed(2);
							if (latencyEl)
								latencyEl.textContent = `Executed in ${elapsed} ms`;
							outEl.textContent = JSON.stringify(res, null, 2);
						} catch (err) {
							outEl.textContent = JSON.stringify(
								{ error: String(err) },
								null,
								2
							);
						}
					});
				}

				// Extract Declarative WebMCP Schema from <form toolname="...">
				const declForm = document.getElementById("declarative-webmcp-form");
				const declOut = document.getElementById("declarative-schema-output");
				function updateDeclarativeContract() {
					if (!declForm || !declOut) return;
					const properties = {};
					const required = [];
					const inputs = declForm.querySelectorAll(
						"input[name], select[name], textarea[name]"
					);
					inputs.forEach((inp) => {
						const propName = inp.getAttribute("name");
						if (!propName) return;
						const desc = inp.getAttribute("toolparamdescription") || "";
						if (inp.tagName.toLowerCase() === "select") {
							const opts = Array.from(inp.querySelectorAll("option")).map(
								(o) => o.value
							);
							properties[propName] = {
								type: "string",
								enum: opts,
								description: desc,
							};
						} else {
							properties[propName] = { type: "string", description: desc };
						}
						if (inp.hasAttribute("required")) required.push(propName);
					});
					const synthesized = {
						protocol: "webmcp-declarative/1.0",
						toolname: declForm.getAttribute("toolname"),
						tooldescription: declForm.getAttribute("tooldescription"),
						toolautosubmit:
							declForm.getAttribute("toolautosubmit") === "true",
						action: declForm.getAttribute("action"),
						method: (declForm.getAttribute("method") || "GET").toUpperCase(),
						inputSchema: {
							type: "object",
							properties,
							required,
						},
					};
					declOut.textContent = JSON.stringify(synthesized, null, 2);
				}
				updateDeclarativeContract();
				if (declForm) {
					declForm.addEventListener("submit", async (e) => {
						e.preventDefault();
						const fd = new FormData(declForm);
						const q = fd.get("q") || "Astro";
						const type = fd.get("type") || "post";
						if (selectEl) selectEl.value = "search_content";
						if (argsEl)
							argsEl.value = JSON.stringify(
								{ query: `${q} (${type})` },
								null,
								2
							);
						if (runBtn) runBtn.click();
					});
				}

				// Tab 2: Built-in AI Runner with Live Firebase AI Logic / Edge Fallback
				const btnBuiltIn = document.getElementById("btn-run-builtin-ai");
				const taskSelect = document.getElementById("builtin-task-select");
				const modeSelect = document.getElementById("builtin-mode-select");
				const promptInput = document.getElementById("builtin-input-text");
				const builtInOut = document.getElementById("builtin-output-box");
				const routeBadge = document.getElementById("builtin-route-badge");
				const telemetryPill = document.getElementById("builtin-telemetry-pill");

				if (btnBuiltIn) {
					btnBuiltIn.addEventListener("click", async () => {
						const task = taskSelect ? taskSelect.value : "prompt";
						const mode = modeSelect ? modeSelect.value : "PREFER_ON_DEVICE";
						const text = promptInput ? promptInput.value.trim() : "";
						if (!builtInOut) return;

						const t0 = performance.now();

						// 1. Try on-device Chrome Built-in AI first if PREFER_ON_DEVICE
						if (mode === "PREFER_ON_DEVICE") {
							builtInOut.textContent =
								"Probing local Chrome Built-in AI (Gemini Nano) session...";
							try {
								if (task === "prompt") {
									const lm =
										window.LanguageModel ||
										(window.ai && window.ai.languageModel);
									if (lm && typeof lm.create === "function") {
										const avail =
											typeof lm.availability === "function"
												? await lm.availability()
												: "available";
										if (avail !== "unavailable" && avail !== "no") {
											if (routeBadge)
												routeBadge.textContent =
													"Route: Local Chrome Gemini Nano (0ms RTT)";
											const session = await lm.create({
												systemPrompt:
													"You are Alex Patterson from CodingCat.dev. Explain web architecture concisely in plain English with zero em-dashes.",
											});
											const result = await session.prompt(text);
											const elapsed = (performance.now() - t0).toFixed(1);
											builtInOut.textContent = result;
											if (telemetryPill)
												telemetryPill.textContent = `Local Gemini Nano | ${elapsed} ms | $0.00`;
											if (typeof session.destroy === "function")
												session.destroy();
											return;
										}
									}
								} else if (task === "summarize") {
									const sum =
										window.Summarizer || (window.ai && window.ai.summarizer);
									if (sum && typeof sum.create === "function") {
										const avail =
											typeof sum.availability === "function"
												? await sum.availability()
												: "available";
										if (avail !== "unavailable" && avail !== "no") {
											if (routeBadge)
												routeBadge.textContent =
													"Route: Local Chrome Summarizer API (Gemini Nano)";
											const summarizer = await sum.create({
												type: "key-points",
												format: "markdown",
												length: "medium",
											});
											const result = await summarizer.summarize(text);
											const elapsed = (performance.now() - t0).toFixed(1);
											builtInOut.textContent = result;
											if (telemetryPill)
												telemetryPill.textContent = `Local Summarizer | ${elapsed} ms | $0.00`;
											if (typeof summarizer.destroy === "function")
												summarizer.destroy();
											return;
										}
									}
								} else if (task === "rewrite") {
									const rew =
										window.Rewriter || (window.ai && window.ai.rewriter);
									if (rew && typeof rew.create === "function") {
										const avail =
											typeof rew.availability === "function"
												? await rew.availability()
												: "available";
										if (avail !== "unavailable" && avail !== "no") {
											if (routeBadge)
												routeBadge.textContent =
													"Route: Local Chrome Rewriter API (Gemini Nano)";
											const rewriter = await rew.create({
												tone: "more-casual",
												length: "as-is",
											});
											const result = await rewriter.rewrite(text);
											const elapsed = (performance.now() - t0).toFixed(1);
											builtInOut.textContent = result;
											if (telemetryPill)
												telemetryPill.textContent = `Local Rewriter | ${elapsed} ms | $0.00`;
											if (typeof rewriter.destroy === "function")
												rewriter.destroy();
											return;
										}
									}
								}
							} catch (_) {
								// Fall through to live Hybrid Edge AI endpoint
							}
						}

						// 2. Execute live Hybrid Edge Fallback (/api/ai/hybrid-fallback)
						if (routeBadge) {
							routeBadge.textContent =
								mode === "ONLY_IN_CLOUD"
									? "Routing to Firebase AI Logic / Edge Cloud (ONLY_IN_CLOUD)..."
									: "Local Gemini Nano unavailable -> Routing to Firebase AI Logic / Edge Fallback...";
						}
						builtInOut.textContent =
							"Executing live Hybrid Edge AI inference via /api/ai/hybrid-fallback...";

						try {
							const res = await fetch("/api/ai/hybrid-fallback", {
								method: "POST",
								headers: { "content-type": "application/json" },
								body: JSON.stringify({
									prompt: text,
									task,
									mode,
								}),
							});
							const data = await res.json();
							if (!res.ok || !data.text) {
								throw new Error(data.error || "HTTP " + res.status);
							}
							const elapsed = Math.round(performance.now() - t0);
							builtInOut.textContent = data.text;
							if (routeBadge) {
								routeBadge.textContent = `Route: ${data.route} [${data.model}]`;
							}
							if (telemetryPill) {
								telemetryPill.textContent = `${data.provider} | ~${data.tokenEstimate} tokens | ${elapsed} ms`;
							}
						} catch (err) {
							builtInOut.textContent =
								"Hybrid Edge Fallback error: " + String(err);
						}
					});
				}

				// Tab 3: Client-Side WebGPU / Float32 Cosine Similarity Engine
				const corpus = [
					{
						title:
							"WebMCP Explained: Exposing Browser-Native AI Tools with document.modelContext",
						href: "/post/webmcp-browser-native-model-context-protocol-guide",
						date: "Apr 14, 2026",
						keywords: [
							"webmcp",
							"modelcontext",
							"registertool",
							"toolname",
							"declarative",
							"imperative",
							"browser",
							"agents",
							"dom",
							"schema",
						],
						summary:
							"Deep dive into the W3C WebMCP specification, imperative registerTool() lifecycles with AbortController, and declarative HTML tool forms.",
					},
					{
						title:
							"Chrome Built-in AI and Gemini Nano: A Production Guide to the Prompt, Summarizer, and Rewriter APIs",
						href: "/post/chrome-built-in-ai-gemini-nano-prompt-api-guide",
						date: "Feb 18, 2026",
						keywords: [
							"chrome",
							"built-in",
							"gemini",
							"nano",
							"languagemodel",
							"prompt",
							"summarizer",
							"rewriter",
							"offline",
							"on-device",
							"inference",
						],
						summary:
							"Complete TypeScript implementation for Chrome's built-in Gemini Nano APIs, including model download progress, token quotas, and session cloning.",
					},
					{
						title:
							"Zero-Backend Client-Side RAG in the Browser with WebGPU, Transformers.js, MediaPipe, and OPFS",
						href: "/post/client-side-webgpu-rag-transformers-js-mediapipe-opfs",
						date: "Jun 09, 2026",
						keywords: [
							"webgpu",
							"rag",
							"transformers.js",
							"mediapipe",
							"opfs",
							"embeddings",
							"vector",
							"cosine",
							"shaders",
							"local",
							"storage",
						],
						summary:
							"How to compute 384-dimensional embeddings on client GPUs via WebGPU shaders and persist vector indexes in Origin Private File System (OPFS).",
					},
					{
						title:
							"Hybrid Web AI Architecture: Routing Between Browser Gemini Nano, Firebase AI Logic, and Edge Workers",
						href: "/post/hybrid-web-ai-routing-gemini-nano-firebase-ai-logic-workers",
						date: "Aug 11, 2026",
						keywords: [
							"hybrid",
							"routing",
							"fallback",
							"firebase",
							"ai",
							"logic",
							"cloudflare",
							"workers",
							"gemini",
							"flash",
							"latency",
							"cost",
						],
						summary:
							"Building an adaptive capability router that executes fast prompts on local Gemini Nano and falls back to Firebase AI Logic or Cloudflare Workers.",
					},
					{
						title:
							"Architecting the Agent-Ready Web: Combining Client-Side WebMCP, Streamable HTTP MCP, and RFC 9727 Discovery",
						href: "/post/agent-ready-web-architecture-webmcp-streamable-mcp-llms-txt",
						date: "Sep 22, 2026",
						keywords: [
							"agent-ready",
							"webmcp",
							"streamable",
							"mcp",
							"llms.txt",
							"rfc",
							"9727",
							"discovery",
							"markdown",
							"negotiation",
						],
						summary:
							"How CodingCat.dev pairs client-side WebMCP tools with edge Streamable HTTP MCP servers, RFC 9727 API catalogs, and Markdown content negotiation.",
					},
				];

				const vocab = Array.from(
					new Set(corpus.flatMap((doc) => doc.keywords))
				);

				function embedTextFloat32(text) {
					const vec = new Float32Array(vocab.length);
					const lower = String(text || "").toLowerCase();
					let norm = 0;
					for (let i = 0; i < vocab.length; i++) {
						const term = vocab[i];
						let weight = lower.includes(term) ? 1.0 : 0.05;
						if (lower.split(/\W+/).includes(term)) weight += 0.85;
						vec[i] = weight;
						norm += weight * weight;
					}
					const mag = Math.sqrt(norm) || 1;
					for (let i = 0; i < vec.length; i++) {
						vec[i] = vec[i] / mag;
					}
					return vec;
				}

				function cosineSimFloat32(a, b) {
					let dot = 0;
					for (let i = 0; i < a.length; i++) {
						dot += a[i] * b[i];
					}
					return Math.min(0.99, Math.max(0.12, dot));
				}

				const docVectors = corpus.map((doc) => ({
					...doc,
					vec: embedTextFloat32(
						doc.keywords.join(" ") + " " + doc.title + " " + doc.summary
					),
				}));

				const ragInput = document.getElementById("webgpu-rag-query");
				const ragBtn = document.getElementById("btn-run-webgpu-rag");
				const ragResults = document.getElementById("webgpu-rag-results");
				const ragTime = document.getElementById("webgpu-compute-time");

				function runClientSideVectorSearch() {
					if (!ragInput || !ragResults) return;
					const t0 = performance.now();
					const qVec = embedTextFloat32(ragInput.value);
					const scored = docVectors
						.map((d) => ({
							...d,
							score: cosineSimFloat32(qVec, d.vec),
						}))
						.sort((a, b) => b.score - a.score);
					const elapsedUs = ((performance.now() - t0) * 1000).toFixed(1);
					if (ragTime) {
						ragTime.textContent = `Computed ${vocab.length}-d Float32 cosine similarity in ${elapsedUs} µs (0 network bytes)`;
					}
					ragResults.innerHTML = scored
						.slice(0, 4)
						.map((item) => {
							const pct = Math.round(item.score * 100);
							return `
								<a href="${item.href}" class="block rounded-xl border-2 border-[#2A1155] bg-white p-3.5 transition hover:border-[#7C3AED] dark:border-white/15 dark:bg-[#131B2E]">
									<div class="flex items-center justify-between gap-2">
										<span class="font-mono text-[11px] font-bold text-[#7C3AED] dark:text-[#C084FC]">${item.date}</span>
										<span class="rounded-md bg-[#86EFAC]/25 px-2 py-0.5 font-mono text-xs font-extrabold text-[#14532D] dark:text-[#86EFAC]">Cosine: ${item.score.toFixed(3)} (${pct}%)</span>
									</div>
									<div class="mt-1 font-display text-sm font-black text-[#2A1155] dark:text-white">${item.title}</div>
									<p class="mt-1 text-xs text-[#2A1155]/75 dark:text-slate-300">${item.summary}</p>
								</a>
							`;
						})
						.join("");
				}

				if (ragBtn) {
					ragBtn.addEventListener("click", runClientSideVectorSearch);
				}
				document.querySelectorAll(".rag-preset-btn").forEach((btn) => {
					btn.addEventListener("click", () => {
						const q = btn.getAttribute("data-sample-query");
						if (ragInput && q) {
							ragInput.value = q;
							runClientSideVectorSearch();
						}
					});
				});
				runClientSideVectorSearch();
			}

			// Run immediately if DOM is ready, plus on DOMContentLoaded and soft-navigation cc:page-load events
			initWebAiPlayground();
			document.addEventListener("DOMContentLoaded", initWebAiPlayground);
			window.addEventListener("cc:page-load", initWebAiPlayground);
		})();
	</script>
</BaseLayout>
