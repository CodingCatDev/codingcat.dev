---
import AjAnimatedMascot from "@/components/AjAnimatedMascot.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title =
	"Interactive Web AI, WebMCP & Chrome Built-in AI Playground | CodingCat.dev";
const description =
	"Live browser AI architecture lab featuring a WebMCP (document.modelContext & declarative HTML tool) inspector, Chrome Built-in AI (Gemini Nano Prompt, Summarizer, Rewriter) sandbox with Firebase AI Logic hybrid fallback, and client-side WebGPU semantic vector search.";

const initialToolSchemaJson = JSON.stringify(
	{
		name: "search_content",
		description:
			"Search CodingCat.dev tutorials, blog posts, courses, and podcasts by technical topic",
		annotations: { readOnlyHint: true, untrustedContentHint: true },
		inputSchema: {
			type: "object",
			properties: {
				query: {
					type: "string",
					description:
						"Keyword or technology (e.g. WebMCP, Gemini Nano, WebGPU, Astro)",
				},
			},
			required: ["query"],
		},
	},
	null,
	2,
);

const initialDeclarativeContractJson = JSON.stringify(
	{
		protocol: "webmcp-declarative/1.0",
		toolname: "search_codingcat_catalog",
		tooldescription:
			"Search CodingCat.dev courses, podcasts, and blog posts by keyword and content pillar",
		toolautosubmit: true,
		action: "/api/search",
		method: "GET",
		inputSchema: {
			type: "object",
			properties: {
				q: {
					type: "string",
					description:
						"Technical keyword or framework name (for example: Astro, Sanity, WebMCP, Firebase)",
				},
				type: {
					type: "string",
					enum: ["post", "course", "podcast"],
					description: "CodingCat.dev content pillar filter (post, course, podcast)",
				},
			},
			required: ["q"],
		},
	},
	null,
	2,
);

const firebaseHybridCodeSnippet = `import { initializeApp } from "firebase/app";
import { getAI, getGenerativeModel, GoogleAIBackend, InferenceMode } from "firebase/ai";

const app = initializeApp(firebaseConfig);
const ai = getAI(app, { backend: new GoogleAIBackend() });

// Automatically routes to Chrome Built-in AI (Gemini Nano) when available,
// and falls back to Gemini Flash in the cloud via Firebase AI Logic:
const hybridModel = getGenerativeModel(ai, {
  mode: InferenceMode.PREFER_ON_DEVICE,
  inCloudParams: { model: "gemini-flash-latest" },
});

const result = await hybridModel.generateContent(prompt);`;
---

<BaseLayout title={title} description={description} canonical="/demos/web-ai">
	<Breadcrumbs
		links={[
			{ title: "Developers", href: "/developers" },
			{ title: "Web AI & WebMCP Playground" },
		]}
	/>

	<div class="mx-auto max-w-6xl py-6 md:py-10 space-y-10">
		<!-- Hero Card -->
		<section class="duo-card hand-border p-6 sm:p-10">
			<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
				<div class="space-y-4 max-w-3xl">
					<div class="flex flex-wrap items-center gap-2">
						<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200">
							⚡ Interactive Client-Side Web AI Lab
						</span>
						<span class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#2A1155] bg-[#86EFAC]/30 px-3 py-1 font-mono text-xs font-bold text-[#14532D] dark:border-emerald-400/40 dark:bg-emerald-950/60 dark:text-[#86EFAC]">
							WebMCP + Gemini Nano + Firebase Hybrid AI + WebGPU
						</span>
					</div>
					<h1 class="font-display text-3xl sm:text-5xl font-black tracking-tight text-[#2A1155] dark:text-white">
						browser-native <span class="text-[#7C3AED] dark:text-[#C084FC]">web ai &amp; webmcp</span> playground
					</h1>
					<p class="text-base sm:text-lg text-[#2A1155]/85 dark:text-slate-200 leading-relaxed">
						Test our production client-side Web AI stack directly in your browser. Inspect and execute live <strong>WebMCP</strong> tools registered on <code>document.modelContext</code> and declarative HTML forms, probe <strong>Chrome Built-in AI (Gemini Nano)</strong> APIs with live <strong>Firebase AI Logic &amp; Edge</strong> fallback, and run zero-backend <strong>WebGPU / Float32</strong> semantic vector search.
					</p>
					<div class="flex flex-wrap gap-3 pt-2">
						<a href="/post/webmcp-browser-native-model-context-protocol-guide" class="tactile-btn px-5 py-2.5 text-sm">
							<span>Read WebMCP Guide</span>
							<span class="text-[#86EFAC]">&rarr;</span>
						</a>
						<a href="/post/chrome-built-in-ai-gemini-nano-prompt-api-guide" class="tactile-btn-secondary px-5 py-2.5 text-sm font-extrabold">
							Read Built-in AI Guide &rarr;
						</a>
						<a href="/post/hybrid-web-ai-routing-gemini-nano-firebase-ai-logic-workers" class="tactile-btn-secondary px-5 py-2.5 text-sm font-extrabold">
							Read Hybrid Routing Guide &rarr;
						</a>
						<a href="/developers" class="tactile-btn-secondary px-5 py-2.5 text-sm font-extrabold">
							Agent Discovery Docs
						</a>
					</div>
				</div>
				<div class="hidden lg:flex shrink-0 items-center justify-center pr-2">
					<AjAnimatedMascot
						variant="full-body"
						state="ship-it-laptop"
						angle="three-quarter-left"
						cls="w-36 h-auto"
						caption="WebMCP Ready!"
					/>
				</div>
			</div>

			<!-- Live Browser Environment Telemetry Strip -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t-2 border-[#2A1155]/15 dark:border-white/10">
				<div class="rounded-2xl border-2 border-[#2A1155]/20 bg-[#FAF9FC] p-3.5 dark:border-white/15 dark:bg-[#0B1326]">
					<div class="font-mono text-[11px] uppercase tracking-wider text-[#2A1155]/60 dark:text-slate-400">
						WebMCP Context
					</div>
					<div id="status-webmcp" class="mt-1 font-mono text-sm font-extrabold text-[#7C3AED] dark:text-[#C084FC]">
						Polyfill Ready (3 tools)
					</div>
				</div>
				<div class="rounded-2xl border-2 border-[#2A1155]/20 bg-[#FAF9FC] p-3.5 dark:border-white/15 dark:bg-[#0B1326]">
					<div class="font-mono text-[11px] uppercase tracking-wider text-[#2A1155]/60 dark:text-slate-400">
						Chrome Prompt API
					</div>
					<div id="status-prompt-api" class="mt-1 font-mono text-sm font-extrabold text-[#7C3AED] dark:text-[#C084FC]">
						Hybrid Fallback Ready
					</div>
				</div>
				<div class="rounded-2xl border-2 border-[#2A1155]/20 bg-[#FAF9FC] p-3.5 dark:border-white/15 dark:bg-[#0B1326]">
					<div class="font-mono text-[11px] uppercase tracking-wider text-[#2A1155]/60 dark:text-slate-400">
						Summarizer / Rewriter
					</div>
					<div id="status-summarizer-api" class="mt-1 font-mono text-sm font-extrabold text-[#7C3AED] dark:text-[#C084FC]">
						Hybrid Fallback Ready
					</div>
				</div>
				<div class="rounded-2xl border-2 border-[#2A1155]/20 bg-[#FAF9FC] p-3.5 dark:border-white/15 dark:bg-[#0B1326]">
					<div class="font-mono text-[11px] uppercase tracking-wider text-[#2A1155]/60 dark:text-slate-400">
						WebGPU Compute
					</div>
					<div id="status-webgpu" class="mt-1 font-mono text-sm font-extrabold text-[#7C3AED] dark:text-[#C084FC]">
						Float32 SIMD Ready
					</div>
				</div>
			</div>
		</section>

		<!-- Interactive 3-Tab Switcher -->
		<section class="duo-card hand-border p-6 sm:p-8" aria-label="Interactive Web AI Playground Tabs">
			<div class="flex flex-wrap gap-3 border-b-2 border-[#2A1155]/15 pb-5 dark:border-white/10" role="tablist">
				<button
					type="button"
					role="tab"
					id="tab-btn-webmcp"
					aria-selected="true"
					aria-controls="panel-webmcp"
					data-tab-target="webmcp"
					class="webai-tab-btn tactile-btn px-5 py-2.5 text-sm font-extrabold"
				>
					1. WebMCP Inspector &amp; Tool Runner
				</button>
				<button
					type="button"
					role="tab"
					id="tab-btn-builtin"
					aria-selected="false"
					aria-controls="panel-builtin"
					data-tab-target="builtin"
					class="webai-tab-btn tactile-btn-secondary px-5 py-2.5 text-sm font-extrabold"
				>
					2. Chrome Built-in AI &amp; Firebase Hybrid Fallback
				</button>
				<button
					type="button"
					role="tab"
					id="tab-btn-webgpu"
					aria-selected="false"
					aria-controls="panel-webgpu"
					data-tab-target="webgpu"
					class="webai-tab-btn tactile-btn-secondary px-5 py-2.5 text-sm font-extrabold"
				>
					3. Client-Side WebGPU Vector RAG
				</button>
			</div>

			<!-- TAB 1: WEBMCP INSPECTOR & TOOL RUNNER -->
			<div id="panel-webmcp" role="tabpanel" aria-labelledby="tab-btn-webmcp" class="mt-6 space-y-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
					<!-- Imperative WebMCP Registry -->
					<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="font-display text-xl font-black text-[#2A1155] dark:text-white">
								Imperative API (<code>document.modelContext</code>)
							</h2>
							<span class="rounded-full bg-[#7C3AED]/15 px-3 py-0.5 font-mono text-xs font-bold text-[#7C3AED] dark:text-[#C084FC]">
								registerTool()
							</span>
						</div>
						<p class="text-sm text-[#2A1155]/80 dark:text-slate-300">
							Select any WebMCP tool registered on this page to inspect its typed JSON Schema contract and execute its in-tab handler with same-origin session locality.
						</p>

						<div class="space-y-3">
							<label for="webmcp-tool-select" class="block font-mono text-xs font-bold uppercase tracking-wider text-[#2A1155] dark:text-slate-200">
								Registered Browser Tool
							</label>
							<select
								id="webmcp-tool-select"
								class="w-full rounded-xl border-2 border-[#2A1155] bg-white px-3.5 py-2.5 font-mono text-sm font-bold text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-white"
							>
								<option value="search_content">search_content (Live CodingCat.dev Search API)</option>
								<option value="estimate_inference_budget">estimate_inference_budget (Local vs. Cloud Token Calculator)</option>
								<option value="extract_page_headings">extract_page_headings (DOM Outline Extractor)</option>
							</select>

							<label for="webmcp-tool-args" class="block font-mono text-xs font-bold uppercase tracking-wider text-[#2A1155] dark:text-slate-200">
								JSON Arguments Payload
							</label>
							<textarea
								id="webmcp-tool-args"
								rows="3"
								class="w-full rounded-xl border-2 border-[#2A1155] bg-white p-3 font-mono text-xs text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-[#86EFAC]"
							>&#123;"query": "WebMCP"&#125;</textarea>

							<div class="flex flex-wrap items-center gap-3">
								<button
									type="button"
									id="btn-run-webmcp-tool"
									class="tactile-btn px-5 py-2.5 text-xs font-extrabold"
								>
									<span>Execute WebMCP Tool</span>
									<span class="text-[#86EFAC]">&rarr;</span>
								</button>
								<span id="webmcp-exec-latency" class="font-mono text-xs font-bold text-[#7C3AED] dark:text-[#86EFAC]">
									Ready
								</span>
							</div>
						</div>

						<div>
							<div class="font-mono text-xs font-bold uppercase tracking-wider text-[#2A1155]/70 dark:text-slate-400 mb-1.5">
								Registered Tool Schema &amp; Annotations
							</div>
							<pre id="webmcp-schema-preview" class="max-h-48 overflow-auto rounded-xl border-2 border-[#2A1155] bg-[#0B1326] p-3.5 font-mono text-xs text-slate-100">{initialToolSchemaJson}</pre>
						</div>
					</div>

					<!-- Execution Output & Declarative HTML Form -->
					<div class="space-y-6">
						<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] space-y-3">
							<div class="flex items-center justify-between">
								<h3 class="font-display text-lg font-black text-[#2A1155] dark:text-white">
									Live Tool Execution Response
								</h3>
								<span class="font-mono text-xs text-[#86EFAC] bg-[#0B1326] px-2.5 py-1 rounded-md border border-white/10">
									JSON-RPC / Structured Result
								</span>
							</div>
							<pre id="webmcp-tool-output" class="max-h-52 overflow-auto rounded-xl border-2 border-[#2A1155] bg-[#0B1326] p-4 font-mono text-xs text-[#86EFAC]">Click "Execute WebMCP Tool" to run the registered handler in your browser session.</pre>
						</div>

						<!-- Declarative WebMCP HTML Form -->
						<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] space-y-4">
							<div class="flex items-center justify-between gap-2">
								<h3 class="font-display text-lg font-black text-[#2A1155] dark:text-white">
									Declarative API (<code>&lt;form toolname="..."&gt;</code>)
								</h3>
								<span class="rounded-full bg-[#86EFAC]/20 px-3 py-0.5 font-mono text-xs font-bold text-[#14532D] dark:text-[#86EFAC]">
									Zero-JS Schema Discovery
								</span>
							</div>
							<p class="text-xs sm:text-sm text-[#2A1155]/80 dark:text-slate-300">
								This HTML form includes standard W3C WebMCP attributes (<code>toolname</code>, <code>tooldescription</code>, and <code>toolparamdescription</code>) so browser agents can synthesize a tool contract without executing custom scripts.
							</p>

							<form
								id="declarative-webmcp-form"
								action="/api/search"
								method="get"
								toolname="search_codingcat_catalog"
								tooldescription="Search CodingCat.dev courses, podcasts, and blog posts by keyword and content pillar"
								toolautosubmit="true"
								class="grid grid-cols-1 sm:grid-cols-3 gap-3"
							>
								<div>
									<label for="decl-q" class="block font-mono text-[11px] font-bold uppercase text-[#2A1155] dark:text-slate-300">
										Topic Keyword (<code>q</code>)
									</label>
									<input
										id="decl-q"
										type="text"
										name="q"
										value="Astro"
										required
										toolparamdescription="Technical keyword or framework name (for example: Astro, Sanity, WebMCP, Firebase)"
										class="mt-1 w-full rounded-xl border-2 border-[#2A1155] bg-white px-3 py-2 font-mono text-xs text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-white"
									/>
								</div>
								<div>
									<label for="decl-type" class="block font-mono text-[11px] font-bold uppercase text-[#2A1155] dark:text-slate-300">
										Content Pillar (<code>type</code>)
									</label>
									<select
										id="decl-type"
										name="type"
										toolparamdescription="CodingCat.dev content pillar filter (post, course, podcast)"
										class="mt-1 w-full rounded-xl border-2 border-[#2A1155] bg-white px-3 py-2 font-mono text-xs text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-white"
									>
										<option value="post">Blog Posts (post)</option>
										<option value="course">Courses (course)</option>
										<option value="podcast">Podcasts (podcast)</option>
									</select>
								</div>
								<div class="flex items-end">
									<button type="submit" class="tactile-btn-secondary w-full py-2 text-xs font-extrabold">
										Inspect &amp; Test Form
									</button>
								</div>
							</form>

							<div>
								<div class="font-mono text-[11px] font-bold uppercase tracking-wider text-[#2A1155]/70 dark:text-slate-400 mb-1">
									Auto-Extracted Declarative Tool Contract from DOM
								</div>
								<pre id="declarative-schema-output" class="max-h-40 overflow-auto rounded-xl border-2 border-[#2A1155] bg-[#0B1326] p-3 font-mono text-xs text-[#C084FC]">{initialDeclarativeContractJson}</pre>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- TAB 2: CHROME BUILT-IN AI (GEMINI NANO) & FIREBASE HYBRID FALLBACK -->
			<div id="panel-builtin" role="tabpanel" aria-labelledby="tab-btn-builtin" class="mt-6 hidden space-y-6">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
					<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="font-display text-xl font-black text-[#2A1155] dark:text-white">
								Chrome Built-in AI &amp; Firebase Hybrid Router
							</h2>
							<span class="rounded-full bg-[#C5E86C]/30 px-3 py-0.5 font-mono text-xs font-bold text-[#2A1155] dark:text-[#C5E86C]">
								PREFER_ON_DEVICE
							</span>
						</div>
						<p class="text-sm text-[#2A1155]/80 dark:text-slate-300">
							Run zero-cost, on-device inference via Chrome's <code>window.LanguageModel</code>, <code>Summarizer</code>, or <code>Rewriter</code> APIs when Gemini Nano is available locally, or automatically route through our live <strong>Firebase AI Logic / Cloudflare Edge Fallback</strong> endpoint (<code>/api/ai/hybrid-fallback</code>).
						</p>

						<div class="space-y-3">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
								<div>
									<label for="builtin-task-select" class="block font-mono text-xs font-bold uppercase tracking-wider text-[#2A1155] dark:text-slate-200">
										Web AI Task API
									</label>
									<select
										id="builtin-task-select"
										class="mt-1 w-full rounded-xl border-2 border-[#2A1155] bg-white px-3 py-2 font-mono text-xs font-bold text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-white"
									>
										<option value="prompt">Prompt API (LanguageModel)</option>
										<option value="summarize">Summarizer API (key-points)</option>
										<option value="rewrite">Rewriter API (more-casual)</option>
									</select>
								</div>
								<div>
									<label for="builtin-mode-select" class="block font-mono text-xs font-bold uppercase tracking-wider text-[#2A1155] dark:text-slate-200">
										Firebase AI InferenceMode
									</label>
									<select
										id="builtin-mode-select"
										class="mt-1 w-full rounded-xl border-2 border-[#2A1155] bg-white px-3 py-2 font-mono text-xs font-bold text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-white"
									>
										<option value="PREFER_ON_DEVICE">PREFER_ON_DEVICE (Local Nano &rarr; Edge Fallback)</option>
										<option value="ONLY_IN_CLOUD">ONLY_IN_CLOUD (Force Firebase / Edge Cloud)</option>
									</select>
								</div>
							</div>

							<label for="builtin-input-text" class="block font-mono text-xs font-bold uppercase tracking-wider text-[#2A1155] dark:text-slate-200">
								Input Context / Developer Prompt
							</label>
							<textarea
								id="builtin-input-text"
								rows="4"
								class="w-full rounded-xl border-2 border-[#2A1155] bg-white p-3 font-mono text-xs text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-white"
							>Explain why exposing structured tools via WebMCP (document.modelContext) is 10x faster and more reliable than DOM screen-scraping for browser AI agents.</textarea>

							<div class="flex flex-wrap items-center gap-3">
								<button
									type="button"
									id="btn-run-builtin-ai"
									class="tactile-btn px-5 py-2.5 text-xs font-extrabold"
								>
									<span>Run Hybrid Inference</span>
									<span class="text-[#86EFAC]">&rarr;</span>
								</button>
								<span id="builtin-route-badge" class="font-mono text-xs font-bold text-[#7C3AED] dark:text-[#86EFAC]">
									Route: Ready (PREFER_ON_DEVICE)
								</span>
							</div>
						</div>

						<div>
							<div class="font-mono text-[11px] font-bold uppercase tracking-wider text-[#2A1155]/70 dark:text-slate-400 mb-1">
								Firebase AI Logic SDK Hybrid Configuration (<code>firebase/ai</code>)
							</div>
							<pre class="max-h-44 overflow-auto rounded-xl border-2 border-[#2A1155] bg-[#0B1326] p-3 font-mono text-[11px] text-[#C084FC]">{firebaseHybridCodeSnippet}</pre>
						</div>
					</div>

					<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] space-y-4">
						<div class="flex items-center justify-between">
							<h3 class="font-display text-lg font-black text-[#2A1155] dark:text-white">
								Live Inference Output &amp; Route Telemetry
							</h3>
							<span id="builtin-telemetry-pill" class="font-mono text-xs text-[#C5E86C] bg-[#0B1326] px-2.5 py-1 rounded-md border border-white/10">
								Standby
							</span>
						</div>
						<pre id="builtin-output-box" class="min-h-[180px] max-h-64 overflow-auto whitespace-pre-wrap rounded-xl border-2 border-[#2A1155] bg-[#0B1326] p-4 font-mono text-xs text-slate-100 leading-relaxed">Click "Run Hybrid Inference" to execute on local Chrome Gemini Nano or fall back to our live Edge AI endpoint (/api/ai/hybrid-fallback).</pre>

						<div class="rounded-xl border border-[#2A1155]/20 bg-white/60 p-3.5 dark:border-white/10 dark:bg-[#131B2E]/60">
							<div class="font-mono text-xs font-bold text-[#2A1155] dark:text-[#C084FC]">
