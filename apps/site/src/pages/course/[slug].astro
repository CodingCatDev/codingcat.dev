---
/**
 * `/course/[slug]` | Individual Course Detail & Lessons Page.
 */
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CoverMedia from "@/components/CoverMedia.astro";
import ExcalidrawBlueprintCard from "@/components/ExcalidrawBlueprintCard.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { courseQuery } from "@/lib/sanity/queries";
import type { CoverImage as CoverImageType } from "@/lib/sanity/types.gen";

interface CourseLesson {
	_id?: string;
	title?: string | null;
	slug?: string | null;
	excerpt?: string | null;
	youtube?: string | null;
	videoCloudinary?: { asset?: { _ref?: string } } | null;
}

interface CourseSection {
	title?: string | null;
	lesson?: CourseLesson[] | null;
}

interface CourseDetail {
	_id: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	videoCloudinary?: { asset?: { _ref?: string } } | null;
	youtube?: string | null;
	content?: Array<{
		_type: string;
		children?: Array<{ text?: string }>;
		[key: string]: unknown;
	}> | null;
	sections?: CourseSection[] | null;
}

const { sanity } = Astro.locals;
const { slug } = Astro.params;

const course = (
	slug ? await sanity.loadQuery(courseQuery, { slug }) : null
) as unknown as CourseDetail | null;
if (!course?._id) {
	return new Response(null, { status: 404 });
}

const sections: CourseSection[] = course.sections ?? [];
const allLessons: CourseLesson[] = sections.flatMap((sec) =>
	(sec?.lesson ?? []).filter((l): l is CourseLesson => Boolean(l?.slug)),
);
const firstLesson = allLessons[0] ?? null;

// Strip legacy blocks mentioning contacting @BrittneyPostma or @codercatdev
const sanitizedContent = (course.content ?? []).filter((block) => {
	const blockText = Array.isArray(block?.children)
		? block.children.map((child) => child?.text ?? "").join("")
		: "";
	return !/brittneypostma|codercatdev/i.test(blockText);
});
---

<BaseLayout
	title={`${course.title} | CodingCat.dev Course`}
	description={course.excerpt}
	ogFallback={{
		title: course.title,
		subtitle: course.excerpt,
		type: "Blog",
	}}
	canonical={`/course/${slug}`}
>
	<Breadcrumbs
		links={[
			{ title: "Courses", href: "/courses" },
			{ title: course.title },
		]}
	/>

	<article class="min-w-0 max-w-full py-6">
		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<div class="flex flex-wrap items-center gap-3">
				<div class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
					🧶 CodingCat.dev Course
				</div>
				{
					allLessons.length > 0 && (
						<span class="rounded-full border-2 border-[#2A1155]/30 bg-white/80 px-3 py-1 font-mono text-xs font-bold text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-slate-200">
							{allLessons.length} {allLessons.length === 1 ? "Lesson" : "Lessons"}
						</span>
					)
				}
			</div>
			{
				firstLesson?.slug && (
					<a
						href={`/course/${slug}/lesson/${firstLesson.slug}`}
						class="tactile-btn inline-flex items-center gap-2 rounded-xl border-2 border-[#2A1155] bg-[#7C3AED] px-5 py-2.5 font-display text-sm font-black text-white shadow-sketch-sm transition hover:bg-[#6D28D9] dark:border-white/80"
					>
						Start Course →
					</a>
				)
			}
		</div>

		<h1 class="mb-8 break-words font-display text-3xl font-black leading-tight tracking-tight text-[#2A1155] dark:text-white sm:text-4xl md:text-6xl">
			{course.title}
		</h1>

		<div class="mb-10">
			<CoverMedia
				image={course.coverImage}
				video={course.videoCloudinary}
				youtube={course.youtube}
			/>
		</div>

		<ExcalidrawBlueprintCard
			title={course.title}
			kind="course"
			tags={sections.map((s) => s?.title)}
		/>

		{
			sanitizedContent.length > 0 && (
				<div class="my-8">
					<PortableTextContent
						value={sanitizedContent}
						class="mx-auto prose-violet lg:prose-xl"
					/>
				</div>
			)
		}

		{
			sections.length > 0 && (
				<section class="my-12">
					<h2 class="mb-6 font-display text-3xl font-black text-[#2A1155] dark:text-white">
						course lessons<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
					</h2>
					<div class="grid gap-6">
						{sections.map((sec, sIdx) => (
							<div class="duo-card hand-border p-6">
								<div class="mb-4 flex items-center gap-3">
									<span class="inline-flex size-9 items-center justify-center rounded-full border-2 border-[#2A1155] bg-[#7C3AED] font-display font-black text-white shadow-sketch-sm dark:border-white/50">
										{sIdx + 1}
									</span>
									<h3 class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
										{sec?.title || `Section ${sIdx + 1}`}
									</h3>
								</div>
								{sec?.lesson && sec.lesson.length > 0 && (
									<ul class="grid gap-3 sm:grid-cols-2">
										{sec.lesson.map((lesson, lIdx) => {
											const lessonHref = lesson?.slug
												? `/course/${slug}/lesson/${lesson.slug}`
												: null;
											const hasVideo = Boolean(
												lesson?.youtube || lesson?.videoCloudinary?.asset?._ref,
											);
											return (
												<li>
													{lessonHref ? (
														<a
															href={lessonHref}
															class="group flex h-full flex-col justify-between gap-3 rounded-xl border-2 border-[#2A1155] bg-[#FAF9FC] p-4 shadow-sketch-sm transition hover:-translate-y-0.5 hover:border-[#7C3AED] hover:bg-[#F3E8FF]/60 dark:border-white/20 dark:bg-[#0B1326] dark:hover:border-[#C084FC] dark:hover:bg-[#131B2E]"
														>
															<div class="flex items-start gap-3">
																<span class="mt-0.5 inline-flex shrink-0 items-center justify-center rounded-md border border-[#7C3AED]/40 bg-[#EDE9FE] px-2 py-0.5 font-mono text-xs font-extrabold text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-[#C084FC]">
																	{sIdx + 1}.{lIdx + 1}
																</span>
																<div class="min-w-0 flex-1">
																	<span class="block font-bold text-[#2A1155] transition group-hover:text-[#7C3AED] dark:text-slate-100 dark:group-hover:text-[#C084FC]">
																		{lesson?.title || `Lesson ${lIdx + 1}`}
																	</span>
																	{lesson?.excerpt && (
																		<p class="mt-1 line-clamp-2 text-xs text-slate-600 dark:text-slate-400">
																			{lesson.excerpt}
																		</p>
																	)}
																</div>
															</div>
															<div class="flex items-center justify-between border-t border-[#2A1155]/10 pt-2.5 font-mono text-[11px] font-bold text-[#7C3AED] dark:border-white/10 dark:text-[#C084FC]">
																<span>
																	{hasVideo ? "▶ Video + Lesson" : "📖 Written Lesson"}
																</span>
																<span class="transition group-hover:translate-x-0.5">
																	Start Lesson →
																</span>
															</div>
														</a>
													) : (
														<div class="flex items-start gap-3 rounded-xl border-2 border-[#2A1155] bg-[#FAF9FC] p-4 shadow-sketch-sm dark:border-white/20 dark:bg-[#0B1326]">
															<span class="font-mono text-xs font-extrabold text-[#7C3AED] dark:text-[#C084FC]">
																{sIdx + 1}.{lIdx + 1}
															</span>
															<span class="font-bold text-[#2A1155] dark:text-slate-100">
																{lesson?.title || `Lesson ${lIdx + 1}`}
															</span>
														</div>
													)}
												</li>
											);
										})}
									</ul>
								)}
							</div>
						))}
					</div>
				</section>
			)
		}
	</article>
</BaseLayout>
