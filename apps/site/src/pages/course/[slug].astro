---
/**
 * `/course/[slug]` | Individual Course Detail & Lessons Page.
 */
import Avatar from "@/components/Avatar.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentGrid from "@/components/ContentGrid.astro";
import CoverMedia from "@/components/CoverMedia.astro";
import ExcalidrawBlueprintCard from "@/components/ExcalidrawBlueprintCard.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TagPills from "@/components/TagPills.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import {
	type RelatedCandidate,
	resolveRelatedContentList,
} from "@/lib/related-content";
import { courseQuery, relatedCandidatesQuery } from "@/lib/sanity/queries";
import type { CoverImage as CoverImageType } from "@/lib/sanity/types.gen";
import { matchTopicsForText } from "@/lib/topics";

interface CourseLesson {
	_id?: string;
	title?: string | null;
	slug?: string | null;
	excerpt?: string | null;
	youtube?: string | null;
	videoCloudinary?: { asset?: { _ref?: string } } | null;
	tags?: Array<{ label?: string | null; value?: string | null }> | null;
}

interface CourseSection {
	title?: string | null;
	lesson?: CourseLesson[] | null;
}

interface CourseDetail {
	_id: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	ogImage?: CoverImageType | null;
	videoCloudinary?: { asset?: { _ref?: string } } | null;
	youtube?: string | null;
	author?: Array<{
		_id: string;
		title: string;
		slug?: string | null;
		coverImage?: CoverImageType | null;
	}> | null;
	tags?: Array<{ label?: string | null; value?: string | null }> | null;
	relatedContent?: RelatedCandidate[] | null;
	content?: Array<{
		_type: string;
		children?: Array<{ text?: string }>;
		[key: string]: unknown;
	}> | null;
	sections?: CourseSection[] | null;
}

const { sanity } = Astro.locals;
const { slug } = Astro.params;

const course = (
	slug ? await sanity.loadQuery(courseQuery, { slug }) : null
) as unknown as CourseDetail | null;
if (!course?._id) {
	return new Response(null, { status: 404 });
}

const candidates = ((await sanity.loadQuery(relatedCandidatesQuery, {
	skip: course._id,
})) ?? []) as unknown as RelatedCandidate[];
const matchedTopics = matchTopicsForText(
	`${course.title ?? ""} ${course.excerpt ?? ""}`,
);
const more = resolveRelatedContentList(course, candidates, {
	limit: 2,
	preferSameType: false,
	currentTopics: matchedTopics,
});
const authors = course.author ?? [];

const sections: CourseSection[] = course.sections ?? [];
const allLessons: CourseLesson[] = sections.flatMap((sec) =>
	(sec?.lesson ?? []).filter((l): l is CourseLesson => Boolean(l?.slug)),
);
const firstLesson = allLessons[0] ?? null;

const ogSocialImage = course.ogImage
	? sanity.resolveOpenGraphImage(course.ogImage, 1200, 630)
	: course.coverImage
		? sanity.resolveOpenGraphImage(course.coverImage, 1200, 630)
		: undefined;

// Strip legacy blocks mentioning contacting @BrittneyPostma or @codercatdev
const sanitizedContent = (course.content ?? []).filter((block) => {
	const blockText = Array.isArray(block?.children)
		? block.children.map((child) => child?.text ?? "").join("")
		: "";
	return !/brittneypostma|codercatdev/i.test(blockText);
});
---

<BaseLayout
	title={`${course.title} | CodingCat.dev Course`}
	description={course.excerpt}
	image={ogSocialImage}
	ogFallback={{
		title: course.title,
		subtitle: course.excerpt,
		type: "Blog",
	}}
	canonical={`/course/${slug}`}
>
	<div class="mx-auto max-w-4xl">
		<Breadcrumbs
			links={[
				{ title: "Courses", href: "/courses" },
				{ title: course.title },
			]}
		/>
	</div>

	<article class="mx-auto min-w-0 max-w-4xl py-6">
		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<div class="flex flex-wrap items-center gap-3">
				<div class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
					🧶 CodingCat.dev Course
				</div>
				{
					allLessons.length > 0 && (
						<span class="rounded-full border-2 border-[#2A1155]/30 bg-white/80 px-3 py-1 font-mono text-xs font-bold text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-slate-200">
							{allLessons.length} {allLessons.length === 1 ? "Lesson" : "Lessons"}
						</span>
					)
				}
				<TagPills
					title={course.title}
					excerpt={course.excerpt}
					tags={course.tags}
					size="md"
				/>
			</div>
			<div class="flex flex-wrap items-center gap-2.5">
				<a
					href={
						course.youtube ||
						firstLesson?.youtube ||
						"https://www.youtube.com/@codingcatdev/playlists?sub_confirmation=1"
					}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-xl border-2 border-[#2A1155] bg-white px-4 py-2.5 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition hover:border-[#FF0000] hover:bg-[#FEF2F2] hover:text-[#DC2626] dark:border-white/25 dark:bg-[#131B2E] dark:text-white dark:hover:border-red-400"
				>
					<span>▶ Watch Course Playlist on YouTube ↗</span>
				</a>
				{
					firstLesson?.slug && (
						<a
							href={`/course/${slug}/lesson/${firstLesson.slug}`}
							class="tactile-btn inline-flex items-center gap-2 rounded-xl border-2 border-[#2A1155] bg-[#7C3AED] px-5 py-2.5 font-display text-sm font-black text-white shadow-sketch-sm transition hover:bg-[#6D28D9] dark:border-white/80"
						>
							Start Course →
						</a>
					)
				}
			</div>
		</div>

		<h1 class="mb-8 break-words font-display text-3xl font-black leading-tight tracking-tight text-[#2A1155] dark:text-white sm:text-4xl md:text-6xl">
			{course.title}
		</h1>

		<div class="mb-10">
			<CoverMedia
				image={course.coverImage}
				video={course.videoCloudinary}
				youtube={course.youtube}
			/>
		</div>

		{
			authors.length > 0 && (
				<div class="mb-8 flex flex-wrap gap-2.5">
					{authors.map((author) => (
						<Avatar
							name={author.title}
							href={author.slug ? `/author/${author.slug}` : undefined}
							coverImage={author.coverImage}
						/>
					))}
				</div>
			)
		}

		{
			sections.length > 0 && (
				<section id="course-lessons-section" class="my-10">
					<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
						<h2 class="font-display text-3xl font-black text-[#2A1155] dark:text-white">
							course lessons<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
						</h2>
						<span class="font-mono text-xs font-bold text-[#2A1155]/70 dark:text-slate-400">
							{sections.length} {sections.length === 1 ? "Section" : "Sections"} &middot; {allLessons.length} {allLessons.length === 1 ? "Lesson" : "Lessons"}
						</span>
					</div>
					<div class="grid grid-cols-1 min-w-0 gap-6">
						{sections.map((sec, sIdx) => (
							<div class="duo-card hand-border-rect min-w-0 max-w-full overflow-hidden p-4 sm:p-6">
								<div class="mb-4 flex min-w-0 items-center gap-3">
									<span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-[#2A1155] bg-[#7C3AED] font-display font-black text-white shadow-sketch-sm dark:border-white/50">
										{sIdx + 1}
									</span>
									<h3 class="min-w-0 font-display text-xl font-black text-[#2A1155] dark:text-white sm:text-2xl">
										{sec?.title || `Section ${sIdx + 1}`}
									</h3>
								</div>
								{sec?.lesson && sec.lesson.length > 0 && (
									<ul class="grid grid-cols-1 min-w-0 gap-3 sm:grid-cols-2">
										{sec.lesson.map((lesson, lIdx) => {
											const lessonHref = lesson?.slug
												? `/course/${slug}/lesson/${lesson.slug}`
												: null;
											const hasVideo = Boolean(
												lesson?.youtube || lesson?.videoCloudinary?.asset?._ref,
											);
											return (
												<li class="min-w-0">
													{lessonHref ? (
														<a
															href={lessonHref}
															class="group flex h-full min-w-0 max-w-full flex-col justify-between gap-3 overflow-hidden rounded-xl border-2 border-[#2A1155] bg-[#FAF9FC] p-4 shadow-sketch-sm transition hover:-translate-y-0.5 hover:border-[#7C3AED] hover:bg-[#F3E8FF]/60 dark:border-white/20 dark:bg-[#0B1326] dark:hover:border-[#C084FC] dark:hover:bg-[#131B2E]"
														>
															<div class="flex min-w-0 items-start gap-3">
																<span class="mt-0.5 inline-flex shrink-0 items-center justify-center rounded-md border border-[#7C3AED]/40 bg-[#EDE9FE] px-2 py-0.5 font-mono text-xs font-extrabold text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-[#C084FC]">
																	{sIdx + 1}.{lIdx + 1}
																</span>
																<div class="min-w-0 flex-1">
																	<span class="block break-words font-bold text-[#2A1155] transition group-hover:text-[#7C3AED] dark:text-slate-100 dark:group-hover:text-[#C084FC]">
																		{lesson?.title || `Lesson ${lIdx + 1}`}
																	</span>
																	{lesson?.excerpt && (
																		<p class="mt-1 line-clamp-2 text-xs text-slate-600 dark:text-slate-400">
																			{lesson.excerpt}
																		</p>
																	)}
																	<div class="mt-2 flex flex-wrap items-center gap-1">
																		<TagPills
																			as="span"
																			title={lesson?.title}
																			excerpt={lesson?.excerpt}
																			tags={lesson?.tags}
																			maxCount={3}
																			size="sm"
																		/>
																	</div>
																</div>
															</div>
															<div class="flex items-center justify-between border-t border-[#2A1155]/10 pt-2.5 font-mono text-[11px] font-bold text-[#7C3AED] dark:border-white/10 dark:text-[#C084FC]">
																<span>
																	{hasVideo ? "▶ Video + Lesson" : "📖 Written Lesson"}
																</span>
																<span class="transition group-hover:translate-x-0.5">
																	Start Lesson →
																</span>
															</div>
														</a>
													) : (
														<div class="flex min-w-0 items-start gap-3 rounded-xl border-2 border-[#2A1155] bg-[#FAF9FC] p-4 shadow-sketch-sm dark:border-white/20 dark:bg-[#0B1326]">
															<span class="shrink-0 font-mono text-xs font-extrabold text-[#7C3AED] dark:text-[#C084FC]">
																{sIdx + 1}.{lIdx + 1}
															</span>
															<span class="min-w-0 break-words font-bold text-[#2A1155] dark:text-slate-100">
																{lesson?.title || `Lesson ${lIdx + 1}`}
															</span>
														</div>
													)}
												</li>
											);
										})}
									</ul>
								)}
							</div>
						))}
					</div>
				</section>
			)
		}

		{
			sanitizedContent.length > 0 && (
				<section id="course-overview-section" class="my-12">
					<h2 class="mb-6 font-display text-3xl font-black text-[#2A1155] dark:text-white">
						course overview<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
					</h2>
					<PortableTextContent
						value={sanitizedContent}
						class="mx-auto prose-violet lg:prose-xl lg:max-w-4xl"
					/>
				</section>
			)
		}

		<ExcalidrawBlueprintCard
			title={course.title}
			kind="course"
			tags={sections.map((s) => s?.title)}
		/>
	</article>

	{
		more.length > 0 && (
			<aside class="mx-auto max-w-4xl">
				<hr class="my-12 border-t-2 border-dashed border-[#2A1155]/25 dark:border-white/15" />
				<SectionHeader title="related deep dives" href="/blog" />
				<ContentGrid items={more as unknown as ContentListItem[]} />
			</aside>
		)
	}
</BaseLayout>
