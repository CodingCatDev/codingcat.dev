---
/**
 * `/course/[slug]` | Individual Course Detail & Lesson Map Page.
 */
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CoverMedia from "@/components/CoverMedia.astro";
import ExcalidrawBlueprintCard from "@/components/ExcalidrawBlueprintCard.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { courseQuery } from "@/lib/sanity/queries";
import type { CoverImage as CoverImageType } from "@/lib/sanity/types.gen";

interface CourseLesson {
	_id?: string;
	title?: string | null;
	slug?: string | null;
	excerpt?: string | null;
}

interface CourseSection {
	title?: string | null;
	lesson?: CourseLesson[] | null;
}

interface CourseDetail {
	_id: string;
	title: string;
	slug?: string | null;
	excerpt?: string | null;
	coverImage?: CoverImageType | null;
	videoCloudinary?: { asset?: { _ref?: string } } | null;
	youtube?: string | null;
	content?: Array<{ _type: string; [key: string]: unknown }> | null;
	sections?: CourseSection[] | null;
}

const { sanity } = Astro.locals;
const { slug } = Astro.params;

const course = (
	slug ? await sanity.loadQuery(courseQuery, { slug }) : null
) as unknown as CourseDetail | null;
if (!course?._id) {
	return new Response(null, { status: 404 });
}

const sections: CourseSection[] = course.sections ?? [];
---

<BaseLayout
	title={`${course.title} | CodingCat.dev Course`}
	description={course.excerpt}
	ogFallback={{
		title: course.title,
		subtitle: course.excerpt,
		type: "Blog",
	}}
	canonical={`/course/${slug}`}
>
	<Breadcrumbs
		links={[
			{ title: "Courses", href: "/courses" },
			{ title: course.title },
		]}
	/>

	<article class="py-6">
		<div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#B4A7D6]/40 bg-[#4B2E83]/60 px-4 py-1 font-mono text-xs font-bold uppercase tracking-wider text-[#C5E86C]">
			🧶 Interactive CodingCat.dev Course
		</div>

		<h1 class="mb-8 font-display text-4xl font-black leading-tight tracking-tight text-[#F8FAFC] md:text-6xl">
			{course.title}
		</h1>

		<div class="mb-10">
			<CoverMedia
				image={course.coverImage}
				video={course.videoCloudinary}
				youtube={course.youtube}
			/>
		</div>

		<ExcalidrawBlueprintCard
			title={course.title}
			kind="course"
			tags={sections.map((s) => s?.title)}
		/>

		{
			course.content && (
				<div class="my-8">
					<PortableTextContent
						value={course.content}
						class="mx-auto prose-violet lg:prose-xl"
					/>
				</div>
			)
		}

		{
			sections.length > 0 && (
				<section class="my-12">
					<h2 class="mb-6 font-display text-3xl font-black text-[#C5E86C]">
						course modules & lessons.
					</h2>
					<div class="grid gap-6">
						{sections.map((sec, sIdx) => (
							<div class="duo-card p-6">
								<div class="mb-4 flex items-center gap-3">
									<span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#C5E86C] font-display font-black text-[#0F172A]">
										{sIdx + 1}
									</span>
									<h3 class="text-2xl font-extrabold text-[#F8FAFC]">
										{sec?.title || `Module ${sIdx + 1}`}
									</h3>
								</div>
								{sec?.lesson && sec.lesson.length > 0 && (
									<ul class="grid gap-3 sm:grid-cols-2">
										{sec.lesson.map((lesson, lIdx) => (
											<li class="flex items-start gap-3 rounded-xl border border-[#B4A7D6]/25 bg-[#0F172A] p-3.5">
												<span class="font-mono text-xs font-bold text-[#C5E86C]">
													{sIdx + 1}.{lIdx + 1}
												</span>
												<span class="font-bold text-[#F8FAFC]">
													{lesson?.title || `Lesson ${lIdx + 1}`}
												</span>
											</li>
										))}
									</ul>
								)}
							</div>
						))}
					</div>
				</section>
			)
		}
	</article>
</BaseLayout>
