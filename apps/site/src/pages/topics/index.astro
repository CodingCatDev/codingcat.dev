---
/**
 * `/topics` | Canonical Two-Tier Vendor, Framework, Language & Topic Hubs Directory.
 *
 * Tier 1: Featured Partner & Core Stack Hubs showcase grid with official light/dark brand lockups.
 * Tier 2: Categorized, scannable logo-pill & compact badge directory across all 6 engineering categories.
 */
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FEATURED_TOPICS, TOPIC_CATEGORIES, TOPICS } from "@/lib/topics";
---

<BaseLayout
	title="Topics & Vendor Hubs | CodingCat.dev"
	description="Browse CodingCat.dev courses, podcast episodes, and blog posts across technology and official vendor hubs: Sanity, Firebase, AWS Amplify, Astro, Cloudflare, TypeScript, React, Hono, D1, Better-Auth, Svelte, and AI Agents."
	canonical="/topics"
>
	<Breadcrumbs links={[{ title: "Topics & Vendors" }]} />

	<section class="py-6 md:py-10" id="topics-directory-root">
		<div class="mx-auto max-w-4xl text-center">
			<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
				🏷️ Official Vendor &amp; Technology Hubs ({TOPICS.length})
			</span>
			<h1 class="mt-4 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-6xl">
				explore by <span class="text-[#7C3AED] dark:text-[#C084FC]">topic</span>
				<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
			</h1>
			<p class="font-hand mx-auto mt-3 max-w-2xl text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
				Select any partner vendor, framework, language, or engineering topic to explore its courses, podcast episodes, and blog posts.
			</p>
		</div>

		{/* Interactive Category Tabs + Live Search Bar */}
		<div class="duo-card hand-border mx-auto mt-10 max-w-6xl p-5">
			<div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-center">
				<div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Filter topics by category">
					<button
						type="button"
						data-topics-cat="all"
						aria-selected="true"
						class="topics-cat-tab rounded-full border-2 border-[#2A1155] bg-[#7C3AED] px-4 py-1.5 font-display text-xs font-black text-white shadow-sketch-sm transition hover:-translate-y-0.5 dark:border-white/50 cursor-pointer"
					>
						All Hubs ({TOPICS.length})
					</button>
					<button
						type="button"
						data-topics-cat="featured"
						aria-selected="false"
						class="topics-cat-tab rounded-full border-2 border-[#2A1155] bg-white px-4 py-1.5 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition hover:-translate-y-0.5 hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#131B2E] dark:text-slate-100 cursor-pointer"
					>
						★ Featured Stack ({FEATURED_TOPICS.length})
					</button>
					{
						TOPIC_CATEGORIES.map((cat) => (
							<button
								type="button"
								data-topics-cat={cat.id}
								aria-selected="false"
								class="topics-cat-tab rounded-full border-2 border-[#2A1155] bg-white px-4 py-1.5 font-display text-xs font-black text-[#2A1155] shadow-sketch-sm transition hover:-translate-y-0.5 hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#131B2E] dark:text-slate-100 cursor-pointer"
							>
								{cat.shortLabel}
							</button>
						))
					}
				</div>

				<div class="flex items-center gap-3">
					<div class="relative w-full sm:w-72">
						<input
							type="search"
							placeholder="Search vendors, frameworks & tags..."
							aria-label="Search topics and vendor hubs"
							data-topics-search
							class="w-full rounded-full border-2 border-[#2A1155] bg-white px-4 py-2 font-sans text-xs font-bold text-[#2A1155] placeholder-[#2A1155]/45 focus:border-[#7C3AED] focus:outline-none dark:border-white/25 dark:bg-[#0B1326] dark:text-white dark:placeholder-slate-400 dark:focus:border-[#C084FC]"
						/>
					</div>
				</div>
			</div>

			<div class="mt-3 flex items-center justify-between border-t border-dashed border-[#2A1155]/15 pt-3 font-mono text-xs font-bold text-[#2A1155]/75 dark:border-white/15 dark:text-slate-300">
				<span data-topics-count>
					Showing all {TOPICS.length} topic &amp; vendor hubs
				</span>
				<button
					type="button"
					data-topics-reset
					class="hidden font-mono text-xs font-extrabold text-[#7C3AED] hover:underline dark:text-[#C084FC] cursor-pointer"
				>
					Reset Filters ✕
				</button>
			</div>
		</div>

		{/* TIER 1: Featured Partner & Core Stack Hubs Showcase Grid */}
		<div class="mt-12" data-featured-showcase-section>
			<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
				<div>
					<span class="font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:text-[#C084FC]">
						★ Tier 1 · Flagship Partner &amp; Stack Hubs
					</span>
					<h2 class="mt-1 font-display text-3xl font-black text-[#2A1155] dark:text-white">
						featured vendor &amp; core stack hubs<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
					</h2>
				</div>
				<span class="font-mono text-xs font-bold text-[#2A1155]/65 dark:text-slate-400">
					Architecture diagrams + full course, podcast &amp; blog feeds
				</span>
			</div>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					FEATURED_TOPICS.map((topic) => (
						<a
							href={`/topic/${topic.slug}`}
							data-featured-hub-card
							data-topic-cat={topic.category}
							data-topic-haystack={`${topic.title} ${topic.slug} ${(topic.aliases ?? []).join(" ")} ${topic.tagline} ${topic.description} ${topic.keywords.join(" ")}`.toLowerCase()}
							class="duo-card hand-border group flex flex-col justify-between p-6 transition-all duration-200 hover:-translate-y-1.5 hover:border-[#7C3AED] dark:hover:border-[#C084FC]"
						>
							<div>
								<div class="mb-4 flex items-center justify-between gap-3">
									<span class="rounded-full border border-[#2A1155]/30 bg-[#EDE9FE] px-3 py-1 font-mono text-[11px] font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/30 dark:bg-purple-950/80 dark:text-purple-200">
										{topic.badge}
									</span>
									<span class="rounded-full border border-[#2A1155] bg-[#FEF08A] px-2.5 py-0.5 font-mono text-[10px] font-extrabold uppercase text-[#713F12]">
										★ Core Hub
									</span>
								</div>

								{/* Official Vendor / Brand Lockup Box (only for kind === "brand") */}
								{topic.kind === "brand" && topic.logoLight && topic.logoDark && (
									<div class="mb-4 flex h-16 items-center justify-center rounded-2xl border-2 border-[#2A1155]/20 bg-[#FAF9FC] px-5 py-3 dark:border-white/15 dark:bg-[#0B1326]">
										<img
											src={topic.logoLight}
											alt={`${topic.title} logo`}
											class="max-h-10 w-auto object-contain dark:hidden"
											loading="lazy"
										/>
										<img
											src={topic.logoDark}
											alt={`${topic.title} logo`}
											class="hidden max-h-10 w-auto object-contain dark:block"
											loading="lazy"
										/>
									</div>
								)}

								<h3 class="font-display text-2xl font-black text-[#2A1155] transition-colors group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
									{topic.title}
								</h3>
								<p class="font-hand mt-1 text-xl font-bold text-[#7C3AED] dark:text-[#C084FC]">
									{topic.tagline}
								</p>
								<p class="mt-2 text-sm font-medium leading-relaxed text-[#2A1155]/75 dark:text-slate-300 line-clamp-2">
									{topic.description}
								</p>
							</div>

							<div class="mt-5 flex items-center justify-between border-t-2 border-dashed border-[#2A1155]/15 pt-4 dark:border-white/15">
								<span class="font-mono text-xs font-bold text-[#2A1155]/70 dark:text-slate-400">
									Courses · Podcasts · Blog
								</span>
								<span class="tactile-btn px-3.5 py-1.5 text-xs">
									<span>Explore</span>
									<span class="text-[#86EFAC]">&rarr;</span>
								</span>
							</div>
						</a>
					))
				}
			</div>
		</div>

		{/* TIER 2: Categorized Compact Technology & Topic Directory */}
		<div class="mt-16 space-y-10" data-categorized-directory-root>
			<div>
				<span class="font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:text-[#C084FC]">
					📚 Tier 2 · Complete A-Z Categorized Index
				</span>
				<h2 class="mt-1 font-display text-3xl font-black text-[#2A1155] dark:text-white">
					all technology &amp; topic hubs by category<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
				</h2>
			</div>

			{
				TOPIC_CATEGORIES.map((cat) => {
					const catTopics = TOPICS.filter((t) => t.category === cat.id);
					return (
						<section
							data-topic-category-group={cat.id}
							class="duo-card hand-border p-6"
						>
							<div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b-2 border-dashed border-[#2A1155]/15 pb-3 dark:border-white/15">
								<div class="flex items-center gap-2.5">
									<span class="rounded-full border border-[#2A1155] bg-[#EDE9FE] px-3 py-1 font-mono text-xs font-extrabold text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/80 dark:text-purple-200">
										{cat.badge}
									</span>
									<h3 class="font-display text-xl font-black text-[#2A1155] dark:text-white">
										{cat.label}
									</h3>
								</div>
								<span class="font-mono text-xs font-bold text-[#2A1155]/65 dark:text-slate-400">
									{catTopics.length} hubs
								</span>
							</div>

							<div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
								{catTopics.map((topic) => (
									<a
										href={`/topic/${topic.slug}`}
										data-topic-card
										data-topic-cat={topic.category}
										data-topic-featured={topic.featured ? "true" : "false"}
										data-topic-haystack={`${topic.title} ${topic.slug} ${(topic.aliases ?? []).join(" ")} ${topic.tagline} ${topic.description} ${topic.keywords.join(" ")}`.toLowerCase()}
										class="group flex items-center justify-between gap-3 rounded-2xl border-2 border-[#2A1155]/25 bg-white px-3.5 py-2.5 transition-all hover:-translate-y-0.5 hover:border-[#7C3AED] hover:bg-[#EDE9FE]/50 dark:border-white/20 dark:bg-[#0B1326] dark:hover:border-[#C084FC] dark:hover:bg-purple-950/40 shadow-sketch-sm"
									>
										<div class="flex min-w-0 items-center gap-2.5">
											{topic.kind === "brand" && topic.symbolLight ? (
												<div class="flex size-8 shrink-0 items-center justify-center rounded-xl border border-[#2A1155]/15 bg-[#FAF9FC] p-1.5 dark:border-white/15 dark:bg-[#131B2E]">
													<img
														src={topic.symbolLight}
														alt=""
														aria-hidden="true"
														class="h-4 w-auto object-contain dark:hidden"
														loading="lazy"
													/>
													<img
														src={topic.symbolDark || topic.symbolLight}
														alt=""
														aria-hidden="true"
														class="hidden h-4 w-auto object-contain dark:block"
														loading="lazy"
													/>
												</div>
											) : (
												<div class="flex size-8 shrink-0 items-center justify-center rounded-xl border border-dashed border-[#7C3AED]/40 bg-[#EDE9FE]/60 font-mono text-sm font-black text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-[#C084FC]">
													#
												</div>
											)}
											<div class="min-w-0">
												<div class="flex items-center gap-1.5">
													<span class="truncate font-display text-sm font-black text-[#2A1155] group-hover:text-[#7C3AED] dark:text-white dark:group-hover:text-[#C084FC]">
														{topic.title}
													</span>
													{topic.featured && (
														<span
															class="text-[10px] text-[#CA8A04] dark:text-[#FACC15]"
															title="Featured Core Hub"
														>
															★
														</span>
													)}
												</div>
												<p class="truncate font-mono text-[10px] font-medium text-[#2A1155]/60 dark:text-slate-400">
													{topic.tagline}
												</p>
											</div>
										</div>
										<span
											class="shrink-0 font-mono text-xs font-extrabold text-[#7C3AED] transition-transform group-hover:translate-x-0.5 dark:text-[#C084FC]"
											aria-hidden="true"
										>
											&rarr;
										</span>
									</a>
								))}
							</div>
						</section>
					);
				})
			}
		</div>

		<div
			data-topics-empty
			class="duo-card hand-border my-12 hidden p-10 text-center"
		>
			<p class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
				No matching topic hubs found.
			</p>
			<p class="font-hand mt-2 text-xl font-bold text-[#4C1D95] dark:text-purple-200">
				Try clearing the search query or selecting "All Hubs".
			</p>
		</div>
	</section>
</BaseLayout>

<script is:inline>
	(function () {
		function initTopicsDirectory() {
			var root = document.getElementById("topics-directory-root");
			if (!root || root.dataset.bound === "true") return;
			root.dataset.bound = "true";

			var tabs = Array.from(root.querySelectorAll("[data-topics-cat]"));
			var searchInput = root.querySelector("[data-topics-search]");
			var featuredSection = root.querySelector("[data-featured-showcase-section]");
			var featuredCards = Array.from(
				root.querySelectorAll("[data-featured-hub-card]"),
			);
			var catGroups = Array.from(
				root.querySelectorAll("[data-topic-category-group]"),
			);
			var cards = Array.from(root.querySelectorAll("[data-topic-card]"));
			var countEl = root.querySelector("[data-topics-count]");
			var resetBtn = root.querySelector("[data-topics-reset]");
			var emptyBox = root.querySelector("[data-topics-empty]");

			var activeCat = "all";
			var activeQuery = "";

			function applyFilter() {
				var q = activeQuery.trim().toLowerCase();
				var visibleCount = 0;

				// 1. Filter Tier 1 Featured Showcase
				var visibleFeatured = 0;
				for (var f = 0; f < featuredCards.length; f++) {
					var fCard = featuredCards[f];
					var fCat = fCard.dataset.topicCat || "";
					var fHay = fCard.dataset.topicHaystack || "";
					var fMatchCat =
						activeCat === "all" ||
						activeCat === "featured" ||
						fCat === activeCat;
					var fMatchQuery = !q || fHay.indexOf(q) !== -1;
					var fShow = fMatchCat && fMatchQuery;
					fCard.classList.toggle("hidden", !fShow);
					if (fShow) visibleFeatured++;
				}
				if (featuredSection) {
					featuredSection.classList.toggle("hidden", visibleFeatured === 0);
				}

				// 2. Filter Tier 2 Categorized Directory
				for (var i = 0; i < cards.length; i++) {
					var card = cards[i];
					var cat = card.dataset.topicCat || "";
					var isFeatured = card.dataset.topicFeatured === "true";
					var hay = card.dataset.topicHaystack || "";

					var matchesCat = false;
					if (activeCat === "all") {
						matchesCat = true;
					} else if (activeCat === "featured") {
						matchesCat = isFeatured;
					} else {
						matchesCat = cat === activeCat;
					}

					var matchesQuery = !q || hay.indexOf(q) !== -1;
					var visible = matchesCat && matchesQuery;
					card.classList.toggle("hidden", !visible);
					if (visible) visibleCount++;
				}

				for (var g = 0; g < catGroups.length; g++) {
					var group = catGroups[g];
					var groupCards = Array.from(
						group.querySelectorAll("[data-topic-card]"),
					);
					var hasAnyVisible = groupCards.some(function (c) {
						return !c.classList.contains("hidden");
					});
					group.classList.toggle("hidden", !hasAnyVisible);
				}

				for (var t = 0; t < tabs.length; t++) {
					var tab = tabs[t];
					var isActive = (tab.dataset.topicsCat || "all") === activeCat;
					tab.setAttribute("aria-selected", isActive ? "true" : "false");
					if (isActive) {
						tab.classList.add(
							"bg-[#7C3AED]",
							"text-white",
							"dark:border-white/50",
						);
						tab.classList.remove(
							"bg-white",
							"text-[#2A1155]",
							"dark:bg-[#131B2E]",
							"dark:text-slate-100",
						);
					} else {
						tab.classList.remove(
							"bg-[#7C3AED]",
							"text-white",
							"dark:border-white/50",
						);
						tab.classList.add(
							"bg-white",
							"text-[#2A1155]",
							"dark:bg-[#131B2E]",
							"dark:text-slate-100",
						);
					}
				}

				if (countEl) {
					countEl.textContent =
						"Showing " +
						visibleCount +
						" of " +
						cards.length +
						" topic & vendor hubs";
				}

				var hasFilter = activeCat !== "all" || q.length > 0;
				if (resetBtn) {
					resetBtn.classList.toggle("hidden", !hasFilter);
				}
				if (emptyBox) {
					emptyBox.classList.toggle(
						"hidden",
						visibleCount > 0 || visibleFeatured > 0,
					);
				}
			}

			for (var b = 0; b < tabs.length; b++) {
				(function (tab) {
					tab.addEventListener("click", function () {
						activeCat = tab.dataset.topicsCat || "all";
						applyFilter();
					});
				})(tabs[b]);
			}

			if (searchInput) {
				searchInput.addEventListener("input", function () {
					activeQuery = searchInput.value || "";
					applyFilter();
				});
			}

			if (resetBtn) {
				resetBtn.addEventListener("click", function () {
					activeCat = "all";
					activeQuery = "";
					if (searchInput) searchInput.value = "";
					applyFilter();
				});
			}
		}

		document.addEventListener("DOMContentLoaded", initTopicsDirectory);
		window.addEventListener("load", initTopicsDirectory);
		document.addEventListener("astro:page-load", initTopicsDirectory);
		initTopicsDirectory();
	})();
</script>
