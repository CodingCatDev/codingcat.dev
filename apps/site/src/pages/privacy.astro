---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Privacy Policy | CodingCat.dev";
const description =
	"Privacy Policy for CodingCat.dev detailing our data collection practices, newsletter handling, cookie usage, and user rights.";
---

<BaseLayout title={title} description={description} canonical="/privacy">
	<Breadcrumbs links={[{ title: "Privacy Policy" }]} />

	<section class="mx-auto max-w-3xl py-6 md:py-10">
		<div class="duo-card hand-border p-8 md:p-12">
			<header class="mb-8">
				<h1 class="font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-5xl">
					privacy <span class="text-[#7C3AED] dark:text-[#C084FC]">policy</span>
				</h1>
				<p class="mt-2 font-mono text-xs font-bold uppercase tracking-wider text-[#2A1155]/65 dark:text-slate-400">
					Last updated: October 2026
				</p>
			</header>

			<div class="prose prose-violet dark:prose-invert max-w-none space-y-6 text-base leading-relaxed">
				<section>
					<h2 class="font-display text-2xl font-black">1. Introduction</h2>
					<p>
						CodingCat.dev ("we", "our", or "us") respects your privacy and is committed to protecting the personal data you share with us. This Privacy Policy explains how we collect, use, and safeguard your information when you visit https://codingcat.dev, take our courses, read our blog posts, listen to our podcasts, or subscribe to our newsletter.
					</p>
				</section>

				<section>
					<h2 class="font-display text-2xl font-black">2. Information We Collect</h2>
					<ul class="list-disc space-y-2 pl-6">
						<li>
							<strong>Newsletter Subscriptions:</strong> When you subscribe to our newsletter via our website form, we collect your email address via Buttondown Email. You can unsubscribe at any time.
						</li>
						<li>
							<strong>Anonymous Usage &amp; Analytics:</strong> We use privacy-preserving edge analytics on Cloudflare to understand traffic trends and popular content without cross-site tracking.
						</li>
						<li>
							<strong>Contact &amp; Booking Inquiries:</strong> If you submit a podcast booking or sponsorship inquiry, we collect your name, email address, company name, and session details to process your request.
						</li>
					</ul>
				</section>

				<section>
					<h2 class="font-display text-2xl font-black">3. Cookies and Local Storage</h2>
					<p>
						CodingCat.dev does not use third-party advertising cookies. We use local storage for user-selected preferences such as light and dark chalkboard themes.
					</p>
				</section>

				<section>
					<h2 class="font-display text-2xl font-black">4. Contact Information</h2>
					<p>
						Questions regarding this Privacy Policy can be sent to:{" "}
						<a href="mailto:alex@codingcat.dev" class="font-bold text-[#7C3AED] hover:underline dark:text-[#C084FC]">
							alex@codingcat.dev
						</a>.
					</p>
				</section>
			</div>
		</div>
	</section>
</BaseLayout>
