---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import InfiniteContentGrid from "@/components/InfiniteContentGrid.astro";
import Pagination from "@/components/Pagination.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TopicFilterStrip from "@/components/TopicFilterStrip.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { resolvePage } from "@/lib/pagination";
import { morePostQuery, postCountQuery } from "@/lib/sanity/queries";

const { sanity } = Astro.locals;

const count = await sanity.loadQuery(postCountQuery);
const resolved = resolvePage({
	raw: Astro.params.num,
	count,
	base: "blog",
	redirect: Astro.redirect,
});
if (!resolved.ok) {
	return resolved.response;
}
const { page, totalPages, offset, limit } = resolved.bounds;
const initialQuery = Astro.url.searchParams.get("q")?.trim() || "";

const posts = await sanity.loadQuery(morePostQuery, {
	skip: "none",
	offset,
	limit,
});

const title = page === 1 ? "Blog" : `Blog: Page ${page}`;
const ogCardImageUrl = sanity
	.urlForImage(posts[0]?.coverImage ?? undefined)
	?.width(640)
	.height(360)
	.fit("crop")
	.url();
---

<BaseLayout
	title={`${title} | CodingCat.dev`}
	description="Purrfect web development tutorials, articles, and guides."
	ogFallback={{
		title,
		subtitle: "Purrfect web development tutorials, articles, and guides.",
		type: "Blog",
		image: ogCardImageUrl,
	}}
	canonical={`/blog/page/${page}`}
>
	<Fragment slot="head">
		{page > 1 && <link rel="prev" href={`/blog/page/${page - 1}`} />}
		{page < totalPages && <link rel="next" href={`/blog/page/${page + 1}`} />}
	</Fragment>

	<Breadcrumbs
		links={[
			{ title: "Blog", href: "/blog" },
			{ title: `Page ${page}` },
		]}
	/>

	<div class="mb-24">
		<SectionHeader title={page === 1 ? "all blog posts" : `blog posts (page ${page})`} showHr={false} />
		<TopicFilterStrip
			label="Filter by Topic & Vendor:"
			basePath="/blog"
			allLabel="All Blog Posts"
		/>
		<InfiniteContentGrid
			type="post"
			items={posts as ContentListItem[]}
			skipId="none"
			initialOffset={offset + posts.length}
			totalCount={count}
			initialQuery={initialQuery}
			showSearch={true}
			searchPlaceholder="Filter blog posts by title or keyword..."
			priorityCount={2}
			nounPlural="blog posts"
		/>
		<noscript>
			<Pagination base="blog" page={page} totalPages={totalPages} />
		</noscript>
	</div>
</BaseLayout>
