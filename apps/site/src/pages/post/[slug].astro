---
import Avatar from "@/components/Avatar.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentGrid from "@/components/ContentGrid.astro";
import CoverMedia from "@/components/CoverMedia.astro";
import ExcalidrawBlueprintCard from "@/components/ExcalidrawBlueprintCard.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SponsorCard from "@/components/SponsorCard.astro";
import TranscriptModal from "@/components/TranscriptModal.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { morePostQuery, postQuery } from "@/lib/sanity/queries";
import {
	articleSchema,
	breadcrumbSchema,
	extractFaqsFromPortableText,
	faqSchema,
	videoObjectSchema,
} from "@/lib/structured-data";
import { matchTopicsForText } from "@/lib/topics";

const { sanity } = Astro.locals;
const { slug } = Astro.params;

const post = slug ? await sanity.loadQuery(postQuery, { slug }) : null;
if (!post?._id) {
	return new Response(null, { status: 404 });
}

const more = await sanity.loadQuery(morePostQuery, {
	skip: post._id,
	offset: 0,
	limit: 2,
});

const path = `/post/${slug}`;
const origin = Astro.locals.siteUrl.origin;
const coverThumbnail = sanity.resolveOpenGraphImage(
	post.coverImage ?? undefined,
);
const ogCardImageUrl = sanity
	.urlForImage(post.coverImage ?? undefined)
	?.width(640)
	.height(360)
	.fit("crop")
	.url();
const authors = post.author ?? [];
const transcriptText =
	post.transcript?.fullText || post.transcript?.summary || undefined;
const matchedTopics = matchTopicsForText(
	`${post.title ?? ""} ${post.excerpt ?? ""}`,
);
const videoSchema = post.youtube
	? videoObjectSchema(
			origin,
			{
				title: post.title,
				description: post.excerpt,
				uploadDate: post.date,
				thumbnailUrl: coverThumbnail?.url,
				youtubeUrl: post.youtube,
				durationSeconds: post.transcript?.durationSeconds,
				transcript: transcriptText,
			},
			path,
		)
	: null;
const faqNode = faqSchema(extractFaqsFromPortableText(post.content));
---

<BaseLayout
	title={post.title}
	description={post.excerpt}
	ogFallback={{
		title: post.title,
		subtitle: post.excerpt,
		type: "Blog",
		author: authors[0]?.title,
		image: ogCardImageUrl,
	}}
	type="article"
	publishedAt={post.date}
	modifiedAt={post._updatedAt}
	authors={authors.map((a) => a.title)}
	canonical={path}
	schema={[
		articleSchema(
			origin,
			{
				title: post.title,
				excerpt: post.excerpt,
				date: post.date,
				_updatedAt: post._updatedAt,
				imageUrl: coverThumbnail?.url,
				authors,
			},
			path,
		),
		breadcrumbSchema(origin, [
			{ name: "Blog", path: "/blog" },
			{ name: post.title, path },
		]),
		...(videoSchema ? [videoSchema] : []),
		...(faqNode ? [faqNode] : []),
	]}
>
	<Breadcrumbs links={[{ title: "Blog", href: "/blog" }, { title: post.title }]} />

	<article class="min-w-0 max-w-full py-4">
		{/* Post Badge & Matched Official Vendor / Topic Logo Pills */}
		<div class="mb-4 flex flex-wrap items-center gap-2">
			<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
				✏️ Blog Post
			</span>
			{post.date && (
				<span class="rounded-full border border-[#2A1155]/30 bg-white px-3.5 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-slate-200">
					<FormattedDate dateString={post.date} />
				</span>
			)}
			{matchedTopics.map((topic) => (
				<a
					href={`/topic/${topic.slug}`}
					class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-white px-3.5 py-1 font-display text-xs font-black text-[#2A1155] transition-all hover:-translate-y-0.5 hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#131B2E] dark:text-white dark:hover:bg-purple-950/60 shadow-sketch-sm"
				>
					{topic.symbolLight && (
						<img
							src={topic.symbolLight}
							alt=""
							aria-hidden="true"
							class="h-3.5 w-auto object-contain dark:hidden"
						/>
					)}
					{topic.symbolDark && (
						<img
							src={topic.symbolDark}
							alt=""
							aria-hidden="true"
							class="hidden h-3.5 w-auto object-contain dark:block"
						/>
					)}
					<span>{topic.title}</span>
				</a>
			))}
		</div>

		<h1 class="mb-8 break-words font-display text-3xl font-black leading-tight tracking-tight text-balance text-[#2A1155] dark:text-white sm:text-4xl md:text-6xl">
			{post.title}
		</h1>

		<div class="mb-8 overflow-hidden rounded-3xl border-2 border-[#2A1155] bg-[#2A1155] shadow-sketch dark:border-white/25 dark:bg-[#060E20] md:mb-12">
			<CoverMedia
				image={post.coverImage}
				video={post.videoCloudinary}
				youtube={post.youtube}
			/>
		</div>

		<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
			<div class="flex flex-wrap gap-2.5">
				{
					authors.map((author) => (
						<Avatar
							name={author.title}
							href={author.slug ? `/author/${author.slug}` : undefined}
							coverImage={author.coverImage}
						/>
					))
				}
			</div>

			{
				(post.transcript || post.youtube) && (
					<div>
						<TranscriptModal
							title={post.title}
							slug={post.slug}
							transcriptId={post.transcript?._id}
							youtube={post.youtube}
						/>
					</div>
				)
			}
		</div>

		{
			post.sponsor && post.sponsor.length > 0 && (
				<section class="my-10 flex flex-col">
					<h2 class="mb-4 font-display text-2xl font-black text-[#2A1155] dark:text-white">
						Sponsors<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
					</h2>
					<SponsorCard sponsors={post.sponsor} />
				</section>
			)
		}

		<ExcalidrawBlueprintCard title={post.title} kind="post" />

		<PortableTextContent
			value={post.content}
			class="mx-auto prose-violet lg:prose-xl"
		/>

		{
			post.transcript?.summary && (
				<section class="duo-card hand-border mx-auto my-8 max-w-4xl p-6">
					<h2 class="mb-3 font-display text-xl font-black text-[#2A1155] dark:text-white">
						✏️ Video Summary
					</h2>
					<p class="leading-relaxed text-[#2A1155]/80 dark:text-slate-300">
						{post.transcript.summary}
					</p>
				</section>
			)
		}
	</article>

	{
		more.length > 0 && (
			<aside class="mb-24">
				<SectionHeader
					title="recent blog posts"
					href="/blog"
					linkText="All Blog Posts"
				/>
				<ContentGrid items={more as ContentListItem[]} priorityCount={0} />
			</aside>
		)
	}
</BaseLayout>
