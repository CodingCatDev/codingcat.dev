---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageQuery } from "@/lib/sanity/queries";
import { breadcrumbSchema } from "@/lib/structured-data";

const { sanity } = Astro.locals;
const { slug } = Astro.params;

const page = slug ? await sanity.loadQuery(pageQuery, { slug }) : null;
if (!page?._id) {
	return new Response(null, { status: 404 });
}

const path = `/${slug}`;
const origin = Astro.locals.siteUrl.origin;
const ogCardImageUrl = sanity
	.urlForImage(page.coverImage ?? undefined)
	?.width(640)
	.height(360)
	.fit("crop")
	.url();
---

<BaseLayout
	title={page.title}
	description={page.excerpt}
	ogFallback={{
		title: page.title,
		subtitle: page.excerpt,
		image: ogCardImageUrl,
	}}
	canonical={path}
	schema={[breadcrumbSchema(origin, [{ name: page.title, path }])]}
>
	<Breadcrumbs links={[{ title: page.title }]} />

	<article class="duo-card hand-border my-8 p-8 md:p-12">
		<h1 class="mb-8 font-display text-4xl font-black leading-tight tracking-tight text-balance text-[#2A1155] dark:text-white md:text-6xl">
			{page.title}
		</h1>
		<PortableTextContent
			value={page.content}
			class="mx-auto prose-violet lg:prose-xl"
		/>
	</article>
</BaseLayout>
