---
/**
 * `/sign-in` | CodingCat.dev Better-Auth Sign-In Page (Email OTP, Magic Link, Google OAuth & MCP OAuth 2.1).
 * Zero em-dashes used.
 */
import AjAnimatedMascot from "@/components/AjAnimatedMascot.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;

const query = Astro.url.searchParams;
const clientId = query.get("client_id") || "";
const redirectUri = query.get("redirect_uri") || "";
const redirectPath = query.get("redirect") || "/mascot-lab";

// If this is an OAuth authorization redirect, the authorize endpoint can be linked directly
const authorizeTarget = `/oauth2/authorize?${query.toString()}`;
---

<BaseLayout
	title="Sign In | CodingCat.dev"
	description="Sign in to CodingCat.dev Studio Portals, Mascot Lab, and Model Context Protocol (MCP) sessions via Better-Auth."
>
	<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
		<div class="duo-card hand-border max-w-md w-full p-8 text-center">
			<div class="mx-auto mb-4 flex justify-center">
				<AjAnimatedMascot
					id="signin-aj"
					variant="head"
					state="idle-wave"
					angle="three-quarter-right"
					cls="w-24 h-24"
					showYarnBall={false}
				/>
			</div>

			<h1 class="font-display text-3xl font-black text-[#2A1155] dark:text-white mb-2">
				Sign In to CodingCat.dev
			</h1>
			<p class="text-sm font-medium text-[#2A1155]/80 dark:text-slate-300 mb-6 leading-relaxed">
				Authenticate with Better-Auth via a 6-digit One-Time Password (OTP), 1-click Magic Link, or Google OAuth.
			</p>

			{clientId && redirectUri ? (
				<div class="space-y-4">
					<div class="rounded-xl bg-[#EDE9FE] dark:bg-slate-800/70 p-4 text-left text-xs text-[#2A1155] dark:text-slate-300 border-2 border-[#2A1155] dark:border-slate-700 space-y-1.5">
						<div class="flex justify-between">
							<span class="font-bold">Application</span>
							<span class="font-mono font-bold text-[#7C3AED] dark:text-purple-300">
								Custom MCP / Gemini
							</span>
						</div>
						<div class="flex justify-between">
							<span class="font-bold">Access</span>
							<span>Public Content &amp; Agent Tools</span>
						</div>
					</div>

					<a
						href={authorizeTarget}
						id="authorize-button"
						class="tactile-btn block w-full py-3.5 px-4 text-center text-base font-extrabold"
					>
						Authorize &amp; Continue
					</a>

					<script is:inline>
						if (window.opener || window.parent !== window) {
							const btn = document.getElementById("authorize-button");
							if (btn) {
								setTimeout(() => btn.click(), 300);
							}
						}
					</script>
				</div>
			) : (
				<div class="space-y-4 text-left" id="better-auth-signin-root" data-redirect={redirectPath}>
					<button
						type="button"
						id="btn-signin-google"
						class="w-full flex items-center justify-center gap-2.5 rounded-xl border-2 border-[#2A1155] bg-white px-4 py-3 text-sm font-extrabold text-[#2A1155] hover:bg-purple-50 dark:border-purple-400/40 dark:bg-[#0B1326] dark:text-white dark:hover:bg-slate-800 transition-colors cursor-pointer"
					>
						<svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
							<path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.8C6.2 7.2 8.9 5 12 5z"/>
							<path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.6l3.7 2.9c2.2-2 3.7-5 3.7-8.7z"/>
							<path fill="#FBBC05" d="M5.3 14.8c-.2-.8-.4-1.6-.4-2.5s.2-1.7.4-2.5L1.6 7C.6 9 0 11.2 0 13.5s.6 4.5 1.6 6.5l3.7-2.9z"/>
							<path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5l-3.7 2.8C3.5 20.9 7.4 24 12 24z"/>
						</svg>
						<span>Continue with Google</span>
					</button>

					<div class="relative flex items-center py-1">
						<div class="flex-grow border-t border-[#2A1155]/20 dark:border-slate-700"></div>
						<span class="flex-shrink mx-3 text-[11px] font-mono uppercase tracking-wider text-[#2A1155]/60 dark:text-slate-400">
							or Email OTP / Magic Link
						</span>
						<div class="flex-grow border-t border-[#2A1155]/20 dark:border-slate-700"></div>
					</div>

					<form id="signin-otp-request-form" class="space-y-3">
						<div>
							<label
								for="signin-email"
								class="block font-mono text-xs font-extrabold uppercase tracking-wider text-[#2A1155] dark:text-purple-200 mb-1.5"
							>
								Email Address
							</label>
							<input
								id="signin-email"
								name="email"
								type="email"
								required
								placeholder="you@company.com"
								class="w-full rounded-xl border-2 border-[#2A1155] bg-white px-3.5 py-2.5 text-sm font-bold text-[#2A1155] dark:border-purple-400/40 dark:bg-[#0B1326] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#7C3AED]"
							/>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
							<button
								type="submit"
								id="btn-signin-send-otp"
								class="tactile-btn w-full justify-center py-3 px-4 text-xs font-extrabold cursor-pointer"
							>
								<span>Send 6-Digit OTP</span>
								<span class="text-[#86EFAC]">&rarr;</span>
							</button>
							<button
								type="button"
								id="btn-signin-send-magic"
								class="rounded-xl border-2 border-[#7C3AED] bg-[#7C3AED]/10 px-4 py-3 text-xs font-extrabold text-[#7C3AED] dark:text-[#C084FC] hover:bg-[#7C3AED]/20 transition-colors cursor-pointer"
							>
								Send Magic Link &#9993;
							</button>
						</div>
					</form>

					<form id="signin-otp-verify-form" class="hidden space-y-3 p-4 rounded-xl border-2 border-[#7C3AED]/40 bg-[#7C3AED]/5">
						<label
							for="signin-otp-code"
							class="block font-mono text-xs font-extrabold uppercase tracking-wider text-[#2A1155] dark:text-purple-200"
						>
							Enter 6-Digit Verification Code
						</label>
						<input
							id="signin-otp-code"
							name="otp"
							type="text"
							inputmode="numeric"
							pattern="[0-9]{6}"
							maxlength="6"
							autocomplete="one-time-code"
							placeholder="123456"
							class="w-full rounded-xl border-2 border-[#2A1155] bg-white px-4 py-2.5 text-center font-mono text-lg font-extrabold tracking-[0.35em] text-[#2A1155] dark:border-purple-400/40 dark:bg-[#0B1326] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#7C3AED]"
						/>
						<button
							type="submit"
							id="btn-signin-verify-otp"
							class="tactile-btn w-full justify-center py-3 px-4 text-xs font-extrabold cursor-pointer"
						>
							<span>Verify Code &amp; Sign In</span>
							<span class="text-[#86EFAC]">&rarr;</span>
						</button>
					</form>

					<div id="signin-feedback" class="hidden text-xs p-3 rounded-xl border"></div>

					<div class="pt-2 text-center">
						<a
							href={redirectPath}
							class="font-mono text-xs font-bold text-[#7C3AED] hover:underline dark:text-[#C084FC]"
						>
							Return to {redirectPath}
						</a>
					</div>
				</div>
			)}
		</div>
	</div>

	<script>
		const root = document.getElementById("better-auth-signin-root");
		const redirect = root?.getAttribute("data-redirect") || "/mascot-lab";
		const emailInput = document.getElementById("signin-email") as HTMLInputElement | null;
		const otpReqForm = document.getElementById("signin-otp-request-form") as HTMLFormElement | null;
		const otpVerifyForm = document.getElementById("signin-otp-verify-form") as HTMLFormElement | null;
		const otpCodeInput = document.getElementById("signin-otp-code") as HTMLInputElement | null;
		const sendOtpBtn = document.getElementById("btn-signin-send-otp");
		const sendMagicBtn = document.getElementById("btn-signin-send-magic");
		const verifyOtpBtn = document.getElementById("btn-signin-verify-otp");
		const googleBtn = document.getElementById("btn-signin-google");
		const feedbackEl = document.getElementById("signin-feedback");

		function showFeedback(msg: string, ok: boolean) {
			if (!feedbackEl) return;
			feedbackEl.textContent = msg;
			feedbackEl.className = ok
				? "text-xs p-3 rounded-xl border border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-bold"
				: "text-xs p-3 rounded-xl border border-red-500/40 bg-red-500/10 text-red-600 dark:text-red-300 font-bold";
		}

		googleBtn?.addEventListener("click", async () => {
			googleBtn.setAttribute("disabled", "true");
			try {
				const res = await fetch("/api/auth/sign-in/social", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ provider: "google", callbackURL: redirect }),
				});
				const data = await res.json().catch(() => ({}));
				if (res.ok && data.url) {
					window.location.href = data.url;
					return;
				}
				showFeedback(data.message || "Could not start Google Sign-In.", false);
			} catch {
				showFeedback("Network error starting Google Sign-In.", false);
			} finally {
				googleBtn.removeAttribute("disabled");
			}
		});

		otpReqForm?.addEventListener("submit", async (e) => {
			e.preventDefault();
			const email = emailInput?.value.trim().toLowerCase() || "";
			if (!email || !email.includes("@")) {
				showFeedback("Please enter a valid email address.", false);
				return;
			}
			sendOtpBtn?.setAttribute("disabled", "true");
			try {
				const res = await fetch("/api/auth/email-otp/send-verification-otp", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, type: "sign-in" }),
				});
				const data = await res.json().catch(() => ({}));
				if (res.ok && (data.success || data.status)) {
					otpVerifyForm?.classList.remove("hidden");
					otpCodeInput?.focus();
					showFeedback(`✓ Sent a 6-digit OTP code to ${email}.`, true);
					return;
				}
				showFeedback(data.message || "Could not send 6-digit OTP code.", false);
			} catch {
				showFeedback("Network error sending OTP code.", false);
			} finally {
				sendOtpBtn?.removeAttribute("disabled");
			}
		});

		sendMagicBtn?.addEventListener("click", async () => {
			const email = emailInput?.value.trim().toLowerCase() || "";
			if (!email || !email.includes("@")) {
				showFeedback("Please enter your email address first.", false);
				return;
			}
			sendMagicBtn.setAttribute("disabled", "true");
			try {
				const res = await fetch("/api/auth/sign-in/magic-link", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, callbackURL: redirect }),
				});
				const data = await res.json().catch(() => ({}));
				if (res.ok && (data.status || data.success !== false)) {
					showFeedback(`✓ Sent a 1-click Magic Link to ${email}.`, true);
					return;
				}
				showFeedback(data.message || "Could not send Magic Link.", false);
			} catch {
				showFeedback("Network error sending Magic Link.", false);
			} finally {
				sendMagicBtn.removeAttribute("disabled");
			}
		});

		otpVerifyForm?.addEventListener("submit", async (e) => {
			e.preventDefault();
			const email = emailInput?.value.trim().toLowerCase() || "";
			const otp = otpCodeInput?.value.replace(/\D/g, "").trim() || "";
			if (otp.length !== 6) {
				showFeedback("Please enter the 6-digit code from your email.", false);
				return;
			}
			verifyOtpBtn?.setAttribute("disabled", "true");
			try {
				const res = await fetch("/api/auth/sign-in/email-otp", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, otp }),
				});
				const data = await res.json().catch(() => ({}));
				if (res.ok && (data.token || data.user)) {
					window.location.href = redirect;
					return;
				}
				showFeedback(data.message || "Invalid or expired 6-digit code.", false);
			} catch {
				showFeedback("Network error verifying code.", false);
			} finally {
				verifyOtpBtn?.removeAttribute("disabled");
			}
		});
	</script>
</BaseLayout>
