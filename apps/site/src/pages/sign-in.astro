---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;

const query = Astro.url.searchParams;
const clientId = query.get("client_id") || "";
const redirectUri = query.get("redirect_uri") || "";

// If this is an OAuth authorization redirect, the authorize endpoint can be linked directly
const authorizeTarget = `/oauth2/authorize?${query.toString()}`;
---

<BaseLayout
	title="Sign In — CodingCat.dev"
	description="Link your custom assistant or agent to CodingCat.dev"
>
	<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
		<div class="max-w-md w-full bg-slate-900/80 border border-slate-800 rounded-2xl p-8 backdrop-blur shadow-2xl text-center">
			<div class="w-16 h-16 mx-auto mb-6 bg-purple-600/20 text-purple-400 rounded-2xl flex items-center justify-center text-3xl font-bold border border-purple-500/30">
				🐱
			</div>
			
			<h1 class="text-2xl font-bold text-white mb-2">Connect to CodingCat.dev</h1>
			<p class="text-slate-400 text-sm mb-6 leading-relaxed">
				Authorize your AI assistant or Model Context Protocol (MCP) client to search and retrieve web development tutorials, blog posts, and podcasts.
			</p>

			{clientId && redirectUri ? (
				<div class="space-y-4">
					<div class="bg-slate-800/60 rounded-xl p-4 text-left text-xs text-slate-300 border border-slate-700/50 space-y-1.5">
						<div class="flex justify-between">
							<span class="text-slate-400 font-medium">Application</span>
							<span class="font-mono text-purple-300">Custom MCP / Gemini</span>
						</div>
						<div class="flex justify-between">
							<span class="text-slate-400 font-medium">Access</span>
							<span>Public Content & Agent Tools</span>
						</div>
					</div>

					<a
						href={authorizeTarget}
						id="authorize-button"
						class="block w-full py-3.5 px-4 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-xl transition shadow-lg shadow-purple-500/25 active:scale-[0.99]"
					>
						Authorize &amp; Continue
					</a>

					<script is:inline>
						// Auto-proceed if opened in automated webview popup
						if (window.opener || window.parent !== window) {
							const btn = document.getElementById("authorize-button");
							if (btn) {
								setTimeout(() => btn.click(), 300);
							}
						}
					</script>
				</div>
			) : (
				<div class="space-y-4">
					<p class="text-slate-400 text-sm">
						CodingCat.dev provides open content and agent tools via Model Context Protocol.
					</p>
					<a
						href="/"
						class="inline-block py-2.5 px-6 bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium rounded-xl transition border border-slate-700"
					>
						Back to Home
					</a>
				</div>
			)}
		</div>
	</div>
</BaseLayout>
