---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ShortsShelf from "@/components/ShortsShelf.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { mergeAndDedupeShorts, shortsPageQuery } from "@/lib/sanity/queries";
import { breadcrumbSchema, videoObjectSchema } from "@/lib/structured-data";

const { sanity } = Astro.locals;
const origin = Astro.locals.siteUrl.origin;

const rawShorts = await sanity.loadQuery(shortsPageQuery);
const shorts = mergeAndDedupeShorts(rawShorts);

const videoSchemas = shorts
	.slice(0, 12)
	.map((s) =>
		videoObjectSchema(
			origin,
			{
				title: s.title,
				description: s.description || s.title,
				uploadDate: s.publishedAt,
				thumbnailUrl: s.youtubeShortId
					? `https://i.ytimg.com/vi/${s.youtubeShortId}/hqdefault.jpg`
					: undefined,
				youtubeUrl:
					s.youtube ||
					(s.youtubeShortId
						? `https://www.youtube.com/shorts/${s.youtubeShortId}`
						: undefined),
				durationSeconds: s.duration ?? 60,
			},
			`/shorts#${s.slug || s.youtubeShortId || s._id}`,
		),
	)
	.filter((node): node is NonNullable<typeof node> => Boolean(node));
---

<BaseLayout
	title="Purrfect Tech Shorts"
	description="Watch bite-sized 60-second vertical explainers on AI agents, web development architecture, and modern engineering benchmarks from CodingCat.dev."
	ogFallback={{ title: "Purrfect Tech Shorts", subtitle: "60-Second Engineering Deep Dives" }}
	canonical="/shorts"
	schema={[
		breadcrumbSchema(origin, [{ name: "Shorts", path: "/shorts" }]),
		...videoSchemas,
	]}
>
	<Breadcrumbs links={[{ title: "Shorts" }]} />
	<ShortsShelf
		title="Purrfect Tech Shorts"
		description="60-second vertical engineering breakdowns, AI tool benchmarks, and architectural deep dives."
		shorts={shorts}
		showViewAll={false}
	/>
</BaseLayout>
