---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CoverMedia from "@/components/CoverMedia.astro";
import InfiniteContentGrid from "@/components/InfiniteContentGrid.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import UserSocials from "@/components/UserSocials.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { resolvePartnerUrl, SPONSOR_SOCIALS_BY_SLUG } from "@/lib/partner-links";
import { sponsorQueryWithRelated } from "@/lib/sanity/queries";
import { breadcrumbSchema } from "@/lib/structured-data";

const { sanity } = Astro.locals;
const { slug } = Astro.params;

const sponsor = slug
	? await sanity.loadQuery(sponsorQueryWithRelated, { slug })
	: null;
if (!sponsor?._id) {
	return new Response(null, { status: 404 });
}

const path = `/sponsor/${slug}`;
const origin = Astro.locals.siteUrl.origin;
const ogCardImageUrl = sanity
	.urlForImage(sponsor.coverImage ?? undefined)
	?.width(640)
	.url();
const rawExcerpt = sponsor.excerpt?.trim();
const description =
	rawExcerpt && rawExcerpt.toLowerCase() !== "fix me"
		? rawExcerpt
		: `${sponsor.title}: Official partner supporting podcasts and web development tutorials on CodingCat.dev.`;

const allRelatedPosts = (sponsor.related?.post ?? []) as ContentListItem[];
const allRelatedPodcasts = (sponsor.related?.podcast ?? []) as ContentListItem[];
const INITIAL_BATCH = 8;
const relatedPosts = allRelatedPosts.slice(0, INITIAL_BATCH);
const relatedPodcasts = allRelatedPodcasts.slice(0, INITIAL_BATCH);
const partnerUrl = sponsor.url ? resolvePartnerUrl(sponsor.url) : undefined;
const sponsorSocials = {
	...(slug ? SPONSOR_SOCIALS_BY_SLUG[slug] : undefined),
	...(sponsor.socials ?? {}),
};
---

<BaseLayout
	title={`${sponsor.title}: Sponsor | CodingCat.dev`}
	ogTitle={sponsor.title}
	description={description}
	ogFallback={{
		title: sponsor.title,
		subtitle: description,
		type: "Sponsor",
		image: ogCardImageUrl,
	}}
	canonical={path}
	schema={[
		breadcrumbSchema(origin, [
			{ name: "Sponsors", path: "/sponsors/page/1" },
			{ name: sponsor.title, path },
		]),
	]}
>
	<Breadcrumbs
		links={[{ title: "Sponsors", href: "/sponsors/page/1" }, { title: sponsor.title }]}
	/>

	<div class="flex w-full flex-col gap-8">
		<div class="duo-card hand-border flex flex-col items-start gap-6 p-6 sm:flex-row sm:items-center md:p-8">
			<div class="shrink-0 overflow-hidden rounded-2xl border-2 border-[#2A1155] bg-[#2A1155] dark:border-white/25 dark:bg-[#060E20]">
				<CoverMedia
					image={sponsor.coverImage}
					width={640}
					height={360}
					sizes="(max-width: 768px) 160px, 256px"
					class="h-auto max-h-32 w-40 object-contain md:w-64"
				/>
			</div>
			<div class="flex flex-col gap-3">
				<span class="w-fit rounded-full border border-[#2A1155]/30 bg-[#EDE9FE] px-3 py-0.5 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/30 dark:bg-purple-950/80 dark:text-purple-200">
					🤝 Official Partner &amp; Sponsor
				</span>
				<h1 class="font-display text-3xl font-black tracking-tight text-[#2A1155] dark:text-white md:text-5xl">
					{sponsor.title}
				</h1>
				<UserSocials socials={sponsorSocials} />
				{partnerUrl && (
					<div class="pt-1">
						<a
							href={partnerUrl}
							target="_blank"
							rel="noopener noreferrer sponsored"
							class="tactile-btn inline-flex px-5 py-2 text-xs"
						>
							<span>Visit {sponsor.title}</span>
							<span class="text-[#86EFAC]">&nearr;</span>
						</a>
					</div>
				)}
			</div>
		</div>

		{
			sponsor.content && (
				<article class="duo-card hand-border p-6 md:p-8">
					<PortableTextContent
						value={sponsor.content}
						class="mx-auto prose-violet lg:prose-xl"
					/>
				</article>
			)
		}

		{
			relatedPodcasts.length > 0 && (
				<aside>
					<SectionHeader title="sponsored episodes" />
					<InfiniteContentGrid
						type="podcast"
						items={relatedPodcasts}
						refId={sponsor._id}
						initialOffset={relatedPodcasts.length}
						totalCount={allRelatedPodcasts.length}
						showSearch={allRelatedPodcasts.length > 4}
						searchPlaceholder={`Filter ${sponsor.title} episodes...`}
						priorityCount={0}
						nounPlural="episodes"
					/>
				</aside>
			)
		}

		{
			relatedPosts.length > 0 && (
				<aside class="mb-24">
					<SectionHeader title="sponsored blog posts" />
					<InfiniteContentGrid
						type="post"
						items={relatedPosts}
						refId={sponsor._id}
						initialOffset={relatedPosts.length}
						totalCount={allRelatedPosts.length}
						showSearch={allRelatedPosts.length > 4}
						searchPlaceholder={`Filter ${sponsor.title} blog posts...`}
						priorityCount={0}
						nounPlural="blog posts"
					/>
				</aside>
			)
		}
	</div>
</BaseLayout>
