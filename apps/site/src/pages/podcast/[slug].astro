---
import Avatar from "@/components/Avatar.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentGrid from "@/components/ContentGrid.astro";
import CoverMedia from "@/components/CoverMedia.astro";
import ExcalidrawBlueprintCard from "@/components/ExcalidrawBlueprintCard.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PodcastListen from "@/components/PodcastListen.astro";
import PodcastPicks from "@/components/PodcastPicks.astro";
import PortableTextContent from "@/components/portable-text/PortableTextContent.astro";
import PtYouTube from "@/components/portable-text/PtYouTube.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SponsorCard from "@/components/SponsorCard.astro";
import TagPills from "@/components/TagPills.astro";
import TranscriptModal from "@/components/TranscriptModal.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import {
	type ExplicitRelatedVideo,
	type RelatedCandidate,
	resolveRelatedContentList,
	resolveRelatedVideo,
} from "@/lib/related-content";
import { podcastQuery, relatedCandidatesQuery } from "@/lib/sanity/queries";
import { getSanityServerClient } from "@/lib/sanity/write-client";
import {
	articleSchema,
	breadcrumbSchema,
	extractFaqsFromPortableText,
	faqSchema,
	podcastEpisodeSchema,
	videoObjectSchema,
} from "@/lib/structured-data";
import { matchTopicsForText } from "@/lib/topics";

const { sanity } = Astro.locals;
const { slug } = Astro.params;
const wantsDraftPreview =
	sanity.preview.enabled ||
	Astro.url.searchParams.get("sanity-preview-perspective") === "drafts";

let podcast = slug ? await sanity.loadQuery(podcastQuery, { slug }) : null;
if (!podcast?._id && slug && wantsDraftPreview) {
	try {
		const { client } = getSanityServerClient();
		podcast = (await client.fetch(podcastQuery, { slug })) as typeof podcast;
	} catch {
		// Fall through to 404 if draft fetch fails
	}
}
if (!podcast?._id) {
	return new Response(null, { status: 404 });
}
const isDraftPreview =
	wantsDraftPreview || String(podcast._id).startsWith("drafts.");

const candidates = ((await sanity.loadQuery(relatedCandidatesQuery, {
	skip: podcast._id,
})) ?? []) as unknown as RelatedCandidate[];

const path = `/podcast/${slug}`;
const origin = Astro.locals.siteUrl.origin;
const coverThumbnail = sanity.resolveOpenGraphImage(
	podcast.coverImage ?? undefined,
);
const ogSocialImage = podcast.ogImage
	? sanity.resolveOpenGraphImage(podcast.ogImage, 1200, 630)
	: podcast.coverImage
		? sanity.resolveOpenGraphImage(podcast.coverImage, 1200, 630)
		: undefined;
const ogCardImageUrl = sanity
	.urlForImage(podcast.coverImage ?? undefined)
	?.width(640)
	.height(360)
	.fit("crop")
	.url();
const authors = podcast.author ?? [];
const guests = podcast.guest ?? [];
const audioUrl = podcast.spotify?.enclosures?.at(0)?.url;
const transcriptText =
	podcast.transcript?.fullText || podcast.transcript?.summary || undefined;
const matchedTopics = matchTopicsForText(
	`${podcast.title ?? ""} ${podcast.excerpt ?? ""}`,
);
const podcastWithRelated = podcast as typeof podcast & {
	tags?: Array<{ label?: string | null; value?: string | null }> | null;
	relatedVideo?: ExplicitRelatedVideo | null;
	relatedContent?: RelatedCandidate[] | null;
};
const resolvedRelatedVideo = !podcast.youtube
	? resolveRelatedVideo(podcastWithRelated, candidates, matchedTopics)
	: null;
const more = resolveRelatedContentList(podcastWithRelated, candidates, {
	limit: 2,
	preferSameType: true,
	currentTopics: matchedTopics,
});
const videoSchema = podcast.youtube
	? videoObjectSchema(
			origin,
			{
				title: podcast.title,
				description: podcast.excerpt,
				uploadDate: podcast.date,
				thumbnailUrl: coverThumbnail?.url,
				youtubeUrl: podcast.youtube,
				durationSeconds: podcast.transcript?.durationSeconds,
				transcript: transcriptText,
			},
			path,
		)
	: null;
const faqNode = faqSchema(extractFaqsFromPortableText(podcast.content));
---

<BaseLayout
	title={podcast.title}
	description={podcast.excerpt}
	image={ogSocialImage}
	ogFallback={{
		title: podcast.title,
		subtitle: podcast.excerpt,
		type: "Podcast",
		author: authors[0]?.title,
		episode: podcast.episode,
		image: ogCardImageUrl,
	}}
	type="article"
	publishedAt={podcast.date}
	modifiedAt={podcast._updatedAt}
	authors={[...authors, ...guests].map((person) => person.title)}
	canonical={path}
	schema={[
		podcastEpisodeSchema(
			origin,
			{
				title: podcast.title,
				excerpt: podcast.excerpt,
				date: podcast.date,
				imageUrl: coverThumbnail?.url,
				season: podcast.season,
				episode: podcast.episode,
				audioUrl,
				transcript: transcriptText,
			},
			path,
		),
		articleSchema(
			origin,
			{
				title: podcast.title,
				excerpt: podcast.excerpt,
				date: podcast.date,
				_updatedAt: podcast._updatedAt,
				imageUrl: coverThumbnail?.url,
				authors,
			},
			path,
		),
		breadcrumbSchema(origin, [
			{ name: "Podcasts", path: "/podcasts" },
			{ name: podcast.title, path },
		]),
		...(videoSchema ? [videoSchema] : []),
		...(faqNode ? [faqNode] : []),
	]}
>
	<div class="mx-auto max-w-4xl">
		<Breadcrumbs
			links={[{ title: "Podcasts", href: "/podcasts" }, { title: podcast.title }]}
		/>
	</div>

	<article class="mx-auto min-w-0 max-w-4xl py-4">
		{isDraftPreview && (
			<div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border-2 border-amber-500/40 bg-amber-500/10 px-5 py-3.5 text-xs">
				<div class="flex flex-wrap items-center gap-2.5">
					<span class="rounded-full bg-amber-500/20 px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300">
						👁️ Draft Episode Preview
					</span>
					<span class="font-semibold text-foreground">
						Viewing unpublished Sanity draft ({(podcast as any).workflowStage || "in post-production"}). Review show notes, unlisted rough cut, and speaker links before release.
					</span>
				</div>
				{podcast.youtube && (
					<a
						href={podcast.youtube}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 rounded-xl border border-amber-500/40 bg-card px-3 py-1.5 font-mono text-[11px] font-bold text-foreground hover:bg-muted transition-colors"
					>
						▶ Open Unlisted YouTube Video &nearr;
					</a>
				)}
			</div>
		)}
		{/* Episode Badge & Matched Vendor / Topic Pills */}
		<div class="mb-4 flex flex-wrap items-center gap-2">
			<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
				🎧 Podcast Episode
				{podcast.season && podcast.episode
					? ` · S${podcast.season}E${podcast.episode}`
					: ""}
			</span>
			{podcast.date && (
				<span class="rounded-full border border-[#2A1155]/30 bg-white px-3.5 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#2A1155] dark:border-white/20 dark:bg-[#131B2E] dark:text-slate-200">
					<FormattedDate dateString={podcast.date} />
				</span>
			)}
			<TagPills
				title={podcast.title}
				excerpt={podcast.excerpt}
				tags={podcastWithRelated.tags}
				size="md"
			/>
		</div>

		<h1 class="mb-8 break-words font-display text-3xl font-black leading-tight tracking-tight text-balance text-[#2A1155] dark:text-white sm:text-4xl md:text-6xl">
			{podcast.title}
		</h1>

		<div class="mb-8 overflow-hidden rounded-3xl border-2 border-[#2A1155] bg-[#2A1155] shadow-sketch dark:border-white/25 dark:bg-[#060E20] md:mb-12">
			<CoverMedia
				image={podcast.coverImage}
				video={podcast.videoCloudinary}
				youtube={podcast.youtube}
			/>
		</div>

		<div class="max-w-2xl sm:max-w-none">
			<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
				<div class="flex flex-wrap gap-2.5">
					{
						authors.map((person) => (
							<Avatar
								name={person.title}
								href={person.slug ? `/author/${person.slug}` : undefined}
								coverImage={person.coverImage}
							/>
						))
					}
					{
						guests.map((person) => (
							<Avatar
								name={person.title}
								href={person.slug ? `/guest/${person.slug}` : undefined}
								coverImage={person.coverImage}
							/>
						))
					}
				</div>

				{
					(podcast.transcript || podcast.youtube) && (
						<div class="flex flex-wrap items-center gap-3">
							<TranscriptModal
								title={podcast.title}
								slug={podcast.slug}
								transcriptId={podcast.transcript?._id}
								youtube={podcast.youtube}
							/>
						</div>
					)
				}
			</div>

			<PodcastListen
				title={podcast.title}
				audioUrl={audioUrl}
				youtube={podcast.youtube}
				spotifyLink={podcast.spotify?.link}
				listenLinks={podcast.listenLinks}
			/>
		</div>

		{
			podcast.sponsor && podcast.sponsor.length > 0 && (
				<section class="my-10 flex flex-col">
					<h2 class="mb-4 font-display text-2xl font-black text-[#2A1155] dark:text-white">
						Episode Sponsors<span class="text-[#7C3AED] dark:text-[#C084FC]">.</span>
					</h2>
					<SponsorCard sponsors={podcast.sponsor} />
				</section>
			)
		}

		<div class="my-4 md:my-8">
			<PortableTextContent
				value={podcast.content}
				class="mx-auto prose-violet lg:prose-xl lg:max-w-4xl"
			/>
		</div>

		{
			podcast.transcript?.summary && (
				<section class="duo-card hand-border my-8 p-6">
					<h2 class="mb-3 font-display text-xl font-black text-[#2A1155] dark:text-white">
						✏️ Episode Summary
					</h2>
					<p class="leading-relaxed text-[#2A1155]/80 dark:text-slate-300">
						{podcast.transcript.summary}
					</p>
				</section>
			)
		}

		<ExcalidrawBlueprintCard
			title={podcast.title}
			kind="podcast"
			tags={guests.map((g) => g.title)}
		/>

		{
			!podcast.youtube && resolvedRelatedVideo && (
				<section class="my-10 rounded-3xl border-2 border-[#2A1155] bg-[#FAF9FC] p-6 shadow-sketch dark:border-white/25 dark:bg-[#131B2E]">
					<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
						<div>
							<div class="flex flex-wrap items-center gap-2">
								<span class="inline-flex items-center gap-1.5 rounded-full border border-[#FF0000]/40 bg-[#FF0000]/10 px-3 py-0.5 font-mono text-[11px] font-extrabold uppercase tracking-wider text-[#DC2626] dark:border-[#FF0000]/50 dark:bg-[#FF0000]/20 dark:text-red-300">
									▶ Watch on @CodingCatDev YouTube
								</span>
								{resolvedRelatedVideo.contentTypeLabel && (
									<span class="inline-flex items-center rounded-full border border-[#7C3AED]/35 bg-[#EDE9FE] px-2.5 py-0.5 font-mono text-[11px] font-bold text-[#4C1D95] dark:border-purple-400/35 dark:bg-purple-950/70 dark:text-purple-200">
										{resolvedRelatedVideo.contentTypeLabel}
									</span>
								)}
							</div>
							<h2 class="mt-2 font-display text-2xl font-black text-[#2A1155] dark:text-white">
								Watch the Related Video Deep Dive: {resolvedRelatedVideo.title}
							</h2>
							<p class="mt-1 text-sm font-medium text-[#2A1155]/75 dark:text-slate-300">
								{resolvedRelatedVideo.description}
							</p>
						</div>
						{resolvedRelatedVideo.href && (
							<a
								href={resolvedRelatedVideo.href}
								class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border-2 border-[#2A1155] bg-white px-3.5 py-1.5 font-mono text-xs font-extrabold text-[#2A1155] shadow-sketch-sm transition hover:border-[#7C3AED] hover:bg-[#EDE9FE] hover:text-[#7C3AED] dark:border-white/25 dark:bg-[#0B1326] dark:text-white dark:hover:border-[#C084FC]"
							>
								<span>View Full Page →</span>
							</a>
						)}
					</div>
					<PtYouTube
						node={{ _type: "youtube", youtube: resolvedRelatedVideo.youtube }}
						coverImage={resolvedRelatedVideo.coverImage}
						index={0}
						isInline={false}
					/>
				</section>
			)
		}
	</article>

	<div class="mx-auto max-w-4xl">
		<PodcastPicks picks={podcast.pick} />
	</div>

	{
		more.length > 0 && (
			<aside class="mb-24">
				<SectionHeader
					title="related episodes"
					href="/podcasts"
					linkText="All Episodes"
				/>
				<ContentGrid items={more as ContentListItem[]} priorityCount={0} />
			</aside>
		)
	}
</BaseLayout>
