---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContentGrid from "@/components/ContentGrid.astro";
import Pagination from "@/components/Pagination.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TopicFilterStrip from "@/components/TopicFilterStrip.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContentListItem } from "@/lib/content";
import { resolvePage } from "@/lib/pagination";
import { morePodcastQuery, podcastCountQuery } from "@/lib/sanity/queries";

const { sanity } = Astro.locals;

const count = await sanity.loadQuery(podcastCountQuery);
const resolved = resolvePage({
	raw: Astro.params.num,
	count,
	base: "podcasts",
	redirect: Astro.redirect,
});
if (!resolved.ok) {
	return resolved.response;
}
const { page, totalPages, offset, limit } = resolved.bounds;

const items = await sanity.loadQuery(morePodcastQuery, {
	skip: "none",
	offset,
	limit,
});

const title = page === 1 ? "Podcasts" : `Podcasts: Page ${page}`;
const ogCardImageUrl = sanity
	.urlForImage(items[0]?.coverImage ?? undefined)
	?.width(640)
	.height(360)
	.fit("crop")
	.url();
---

<BaseLayout
	title={`${title} | CodingCat.dev`}
	description="Purrfect Web Development podcast episodes, interviews, and conversations."
	ogFallback={{
		title,
		subtitle:
			"Purrfect Web Development podcast episodes, interviews, and conversations.",
		type: "Podcast",
		image: ogCardImageUrl,
	}}
	canonical={`/podcasts/page/${page}`}
>
	<Fragment slot="head">
		{page > 1 && <link rel="prev" href={`/podcasts/page/${page - 1}`} />}
		{page < totalPages && <link rel="next" href={`/podcasts/page/${page + 1}`} />}
	</Fragment>

	<Breadcrumbs
		links={[
			{ title: "Podcasts", href: "/podcasts" },
			{ title: `Page ${page}` },
		]}
	/>

	<div class="mb-24">
		<SectionHeader title={`podcasts (page ${page})`} showHr={false} />
		<TopicFilterStrip label="Filter by Topic & Vendor:" />
		<ContentGrid items={items as ContentListItem[]} />
		<Pagination base="podcasts" page={page} totalPages={totalPages} />
	</div>
</BaseLayout>
