---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Developer Documentation & Agent APIs | CodingCat.dev";
const description =
	"Developer guides, APIs, Model Context Protocol (MCP) server endpoints, and agent integration documentation for CodingCat.dev.";
const origin = Astro.locals.siteUrl.origin;
---

<BaseLayout title={title} description={description} canonical="/developers">
	<Breadcrumbs links={[{ title: "Developers & Agent Docs" }]} />

	<section class="mx-auto max-w-4xl py-6 md:py-10">
		<div class="duo-card hand-border p-8 md:p-12">
			<header class="mb-8">
				<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200">
					🤖 Agent-Ready &amp; Open APIs
				</span>
				<h1 class="mt-3 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-5xl">
					developer &amp; <span class="text-[#7C3AED] dark:text-[#C084FC]">agent docs</span>
				</h1>
				<p class="font-hand mt-2 text-2xl font-bold text-[#7C3AED] dark:text-[#C084FC]">
					Machine-readable manifests, Streamable HTTP MCP endpoints, and Markdown content negotiation.
				</p>
			</header>

			<div class="prose prose-violet dark:prose-invert max-w-none space-y-8 text-base leading-relaxed">
				<section>
					<h2 class="font-display text-2xl font-black">Discovery Manifests</h2>
					<div class="overflow-x-auto rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-4 dark:border-white/20 dark:bg-[#0B1326]">
						<table class="m-0 w-full border-collapse text-left text-sm">
							<thead>
								<tr class="border-b-2 border-[#2A1155]/20 font-display font-black dark:border-white/15">
									<th class="py-2 pr-4">Standard</th>
									<th class="px-4 py-2">Endpoint</th>
									<th class="py-2 pl-4">Description</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-[#2A1155]/10 dark:divide-white/10">
								<tr>
									<td class="py-2.5 pr-4 font-mono text-xs font-bold">RFC 9727 API Catalog</td>
									<td class="px-4 py-2.5 font-mono text-xs"><a href="/.well-known/api-catalog">/.well-known/api-catalog</a></td>
									<td class="py-2.5 pl-4 text-xs">IANA linkset discovery for all public APIs</td>
								</tr>
								<tr>
									<td class="py-2.5 pr-4 font-mono text-xs font-bold">OpenAPI 3.1</td>
									<td class="px-4 py-2.5 font-mono text-xs"><a href="/openapi.json">/openapi.json</a></td>
									<td class="py-2.5 pl-4 text-xs">Complete machine-readable OpenAPI schema</td>
								</tr>
								<tr>
									<td class="py-2.5 pr-4 font-mono text-xs font-bold">MCP Server Card</td>
									<td class="px-4 py-2.5 font-mono text-xs"><a href="/.well-known/mcp/server-card.json">/.well-known/mcp/server-card.json</a></td>
									<td class="py-2.5 pl-4 text-xs">Model Context Protocol server capability card</td>
								</tr>
								<tr>
									<td class="py-2.5 pr-4 font-mono text-xs font-bold">ARD AI Catalog</td>
									<td class="px-4 py-2.5 font-mono text-xs"><a href="/.well-known/ai-catalog.json">/.well-known/ai-catalog.json</a></td>
									<td class="py-2.5 pl-4 text-xs">Agentic Resource Discovery manifest</td>
								</tr>
								<tr>
									<td class="py-2.5 pr-4 font-mono text-xs font-bold">Agent Skills</td>
									<td class="px-4 py-2.5 font-mono text-xs"><a href="/.well-known/agent-skills/index.json">/.well-known/agent-skills/index.json</a></td>
									<td class="py-2.5 pl-4 text-xs">Cloudflare Agent Skills Discovery index</td>
								</tr>
								<tr>
									<td class="py-2.5 pr-4 font-mono text-xs font-bold">LLM Directories</td>
									<td class="px-4 py-2.5 font-mono text-xs"><a href="/llms.txt">/llms.txt</a> · <a href="/llms-full.txt">/llms-full.txt</a></td>
									<td class="py-2.5 pl-4 text-xs">Context-window-friendly LLM directories</td>
								</tr>
								<tr>
									<td class="py-2.5 pr-4 font-mono text-xs font-bold">Agent Guide</td>
									<td class="px-4 py-2.5 font-mono text-xs"><a href="/AGENTS.md">/AGENTS.md</a></td>
									<td class="py-2.5 pl-4 text-xs">Root-level agent capability guide</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				<section>
					<h2 class="font-display text-2xl font-black">Search API</h2>
					<p>Perform semantic and keyword search across courses, blog posts, podcasts, authors, and guests:</p>
					<pre class="overflow-x-auto rounded-2xl border-2 border-[#2A1155] bg-[#0B1326] p-4 text-sm text-slate-100"><code>GET {origin}/api/search?q=sanity HTTP/1.1
Accept: application/json</code></pre>
				</section>

				<section>
					<h2 class="font-display text-2xl font-black">Streamable Model Context Protocol (MCP)</h2>
					<p>Agents can invoke MCP tools over HTTP POST:</p>
					<pre class="overflow-x-auto rounded-2xl border-2 border-[#2A1155] bg-[#0B1326] p-4 text-sm text-slate-100"><code>POST {origin}/api/mcp HTTP/1.1
Content-Type: application/json

&#123;
  "jsonrpc": "2.0",
  "method": "tools/call",
  "params": &#123;
    "name": "search_content",
    "arguments": &#123; "query": "sanity content releases" &#125;
  &#125;,
  "id": 1
&#125;</code></pre>
				</section>
			</div>
		</div>
	</section>
</BaseLayout>
