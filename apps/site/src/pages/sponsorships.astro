---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ExcalidrawDiagram from "@/components/ExcalidrawDiagram.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMultiCalendarAvailableSlots } from "@/lib/google-calendar";
import { SPONSOR_PACKAGE_TIERS } from "@/lib/sanity/write-client";

const { slots: kickoffSlots, liveVerified: calendarLiveVerified } =
	await getMultiCalendarAvailableSlots(6, 15);

const metrics = {
	subscribers: "61.2K+",
	totalViews: "405K+",
	tier1GeoShare: "21.1%",
	shortPlatforms: "7 Platforms",
};

const formatUsd = (cents: number) =>
	new Intl.NumberFormat("en-US", {
		style: "currency",
		currency: "USD",
		maximumFractionDigits: 0,
	}).format(cents / 100);
---

<BaseLayout
	title="Sponsor CodingCat.dev: B2B DevTool Multi-Channel Launch Bundles"
	description="Put your developer tool, AI platform, or cloud infrastructure in front of 61K+ engineers across YouTube, 7 short-form video networks, and canonical SEO + Agent-Ready (AEO) articles."
>
	<Breadcrumbs links={[{ title: "Sponsorships" }]} />

	<div class="w-full flex flex-col gap-8 md:gap-12 my-8 md:my-12">
		<header class="flex flex-col gap-5">
			<div class="flex flex-col gap-2">
				<span class="w-fit rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
					🚀 B2B Developer Marketing &amp; Multi-Channel Distribution
				</span>
				<h1 class="mt-2 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white md:text-6xl">
					launch your devtool across <span class="text-[#7C3AED] dark:text-[#C084FC]">codingcat.dev</span>
				</h1>
				<p class="font-hand text-2xl font-bold text-[#4C1D95] dark:text-purple-200 max-w-3xl">
					Stop buying isolated one-off shout-outs. Partner with Alex Patterson for end-to-end technical deep-dives, 7-platform vertical Shorts syndication, canonical SEO &amp; Agent-Ready (AEO / WebMCP / <code>llms.txt</code>) articles, and live ROI Deal Room telemetry.
				</p>
			</div>

			<!-- Verified First-Party Telemetry Banner -->
			<div class="duo-card hand-border grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-6">
				<div class="flex flex-col gap-1">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">YouTube Subscribers</span>
					<span class="text-2xl font-bold text-foreground">{metrics.subscribers}</span>
					<span class="text-xs text-primary font-medium">✓ Verified First-Party YouTube API</span>
				</div>
				<div class="flex flex-col gap-1">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">US / CA / UK / AU Share</span>
					<span class="text-2xl font-bold text-foreground">{metrics.tier1GeoShare}</span>
					<span class="text-xs text-primary font-medium">✓ #1 Watch-Time Engagement per Viewer</span>
				</div>
				<div class="flex flex-col gap-1">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Short-Form Video Network</span>
					<span class="text-2xl font-bold text-foreground">{metrics.shortPlatforms}</span>
					<span class="text-xs text-primary font-medium">✓ YT, X, LinkedIn, BSky, Threads, Masto, IG/TT</span>
				</div>
				<div class="flex flex-col gap-1">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Canonical SEO &amp; AEO</span>
					<span class="text-2xl font-bold text-foreground">WebMCP + llms.txt</span>
					<span class="text-xs text-primary font-medium">✓ Syndicated to Dev.to &amp; Hashnode</span>
				</div>
			</div>

			<ExcalidrawDiagram
				title="Multi-Channel Sponsor Flywheel"
				caption="1 Recording Session -> 7 Short-Form Video Networks + Canonical AEO Blog + Live Deal Room"
				compact={true}
				nodes={[
					{
						id: "kickoff",
						badge: "Step 1",
						label: "15-Min Kickoff",
						sublabel: "Pick slot & lock 50%",
						color: "green",
					},
					{
						id: "record",
						badge: "Step 2",
						label: "Deep-Dive + Shorts",
						sublabel: "YouTube + 7 Platforms",
						color: "blue",
					},
					{
						id: "dealroom",
						badge: "Step 3",
						label: "AEO Blog & ROI Room",
						sublabel: "WebMCP + Live Telemetry",
						color: "orange",
					},
				]}
				edges={[
					{ from: "kickoff", to: "record", label: "studio session" },
					{ from: "record", to: "dealroom", label: "syndicate everywhere" },
				]}
			/>
		</header>

		<!-- Sponsorship Tiers Grid -->
		<section aria-labelledby="tiers-heading" class="flex flex-col gap-4">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
				<div>
					<h2 id="tiers-heading" class="text-2xl font-bold tracking-tight">
						Multi-Channel Launch Bundles &amp; Rate Card
					</h2>
					<p class="text-sm text-muted-foreground">
						All packages use milestone billing: <strong>50% upfront deposit</strong> to lock your production &amp; calendar slot, and <strong>50% upon publication</strong>. (Includes Dedicated Video, Integrated Mid-Roll Ad, Quick Shout-Out, Blog Post / Newsletter, and Video Series options.)
					</p>
				</div>
				<a
					href="#sponsorship-form"
					class="text-xs font-semibold text-primary hover:underline shrink-0"
				>
					Prefer to talk first? Pick a 15-min Sponsor Kickoff Slot below &darr;
				</a>
			</div>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					SPONSOR_PACKAGE_TIERS.map((tier, idx) => (
						<article
							class={`flex flex-col justify-between rounded-2xl border p-6 shadow-xs transition-colors ${
								idx === 0
									? "border-primary bg-primary/5 ring-1 ring-primary"
									: "border-border bg-card hover:border-primary/50"
							}`}
						>
							<div class="flex flex-col gap-3">
								<span class="text-xs font-mono font-semibold uppercase tracking-wider text-primary">
									{tier.tagline}
								</span>
								<h3 class="text-xl font-bold tracking-tight">
									{tier.name}
								</h3>
								<div class="flex items-baseline gap-2">
									<p class="text-3xl font-bold text-foreground">
										{formatUsd(tier.totalAmountCents)}
									</p>
									<span class="text-xs text-muted-foreground font-medium">
										({formatUsd(tier.depositAmountCents)} 50% deposit)
									</span>
								</div>
								<p class="text-sm text-muted-foreground leading-relaxed">
									{tier.description}
								</p>
								<ul class="mt-2 flex flex-col gap-1.5 text-xs text-foreground">
									{tier.deliverables.map((d) => (
										<li class="flex items-start gap-2">
											<span class="text-primary font-bold">✓</span>
											<span>{d.title}</span>
										</li>
									))}
								</ul>
							</div>
							<div class="mt-6 pt-4 border-t border-border/60 flex items-center justify-between">
								<button
									type="button"
									class="tier-select-btn text-xs font-semibold uppercase tracking-wider text-primary hover:underline cursor-pointer"
									data-tier-id={tier.id}
									data-tier-name={tier.name}
								>
									Launch Deal Room ({formatUsd(tier.depositAmountCents)} Deposit) &rarr;
								</button>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- Inquiry & Instant Deal Room Generator Form -->
		<section class="max-w-2xl rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-xs" aria-labelledby="form-heading">
			<h2 id="form-heading" class="text-2xl font-bold tracking-tight mb-2">
				Open Your Sponsor Deal Room
			</h2>
			<p class="text-sm text-muted-foreground mb-6">
				Select your package below to immediately open your dedicated Deal Room with 50% deposit Stripe Checkout, Net-15 corporate invoice generation, and direct Google Calendar scheduling.
			</p>

			<div
				id="form-feedback-success"
				class="hidden mb-6 p-4 rounded-lg bg-green-500/10 border border-green-500/20 text-green-700 dark:text-green-300 text-sm"
				role="status"
			>
				<strong>Deal Room Ready!</strong> Redirecting you now...
			</div>

			<div
				id="form-feedback-error"
				class="hidden mb-6 p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-700 dark:text-red-300 text-sm"
				role="alert"
			>
			</div>

			<form
				id="sponsorship-form"
				method="POST"
				action="/api/sponsorship"
				class="flex flex-col gap-4"
				toolname="submit_sponsorship_inquiry"
				tooldescription="Submit sponsorship inquiry and open a CodingCat.dev Sponsor Deal Room"
			>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label for="name" class="block text-sm font-medium mb-1">
							Your Name <span class="text-red-500">*</span>
						</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							placeholder="Jane Doe"
							class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
							toolparamdescription="Contact person name"
						/>
					</div>

					<div>
						<label for="email" class="block text-sm font-medium mb-1">
							Work Email <span class="text-red-500">*</span>
						</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							placeholder="jane@company.com"
							class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
							toolparamdescription="Contact work email address"
						/>
					</div>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label for="company" class="block text-sm font-medium mb-1">
							Company / Product Name <span class="text-red-500">*</span>
						</label>
						<input
							type="text"
							id="company"
							name="company"
							required
							placeholder="Acme DevTools"
							class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
							toolparamdescription="Company or brand name"
						/>
					</div>

					<div>
						<label for="website" class="block text-sm font-medium mb-1">
							Product URL
						</label>
						<input
							type="url"
							id="website"
							name="website"
							placeholder="https://acme.dev"
							class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
							toolparamdescription="Company website URL"
						/>
					</div>
				</div>

				<div>
					<label for="tier" class="block text-sm font-medium mb-1">
						Launch Package <span class="text-red-500">*</span>
					</label>
					<select
						id="tier"
						name="tier"
						required
						class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
						toolparamdescription="Selected sponsorship package tier"
					>
						<option value="" disabled selected>Select a sponsorship package</option>
						{
							SPONSOR_PACKAGE_TIERS.map((t) => (
								<option value={t.id}>
									{t.name} ({formatUsd(t.totalAmountCents)} total &middot; {formatUsd(t.depositAmountCents)} 50% deposit)
								</option>
							))
						}
					</select>
				</div>

				<div>
					<div class="flex items-center justify-between gap-2 mb-1.5">
						<label class="block text-sm font-medium">
							Optional: Lock a 15-Min Sponsor Kickoff Call Now
						</label>
						{calendarLiveVerified && (
							<span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-primary/10 text-primary">
								✓ Multi-Calendar Conflict-Free
							</span>
						)}
					</div>
					<p class="text-xs text-muted-foreground mb-2.5">
						Select a time below to automatically receive a Google Calendar invite upon opening your Deal Room, or skip and schedule later inside your Deal Room.
					</p>
					<input type="hidden" id="kickoffSlotStartAt" name="kickoffSlotStartAt" value="" />
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="kickoff-slot-grid">
						{
							kickoffSlots.map((slot) => (
								<button
									type="button"
									data-kickoff-start={slot.startAt}
									class="kickoff-slot-btn p-2.5 rounded-lg border border-border bg-background hover:border-primary text-left transition-all cursor-pointer flex flex-col gap-0.5"
								>
									<span class="font-semibold text-xs text-foreground">{slot.displayDate}</span>
									<span class="text-[11px] text-muted-foreground font-mono">{slot.displayTime}</span>
								</button>
							))
						}
					</div>
					<button
						type="button"
						id="clear-kickoff-slot"
						class="hidden mt-1.5 text-xs text-muted-foreground hover:text-foreground underline cursor-pointer"
					>
						Clear selected kickoff slot (schedule later in Deal Room)
					</button>
				</div>

				<div>
					<label for="message" class="block text-sm font-medium mb-1">
						Launch Goals, Target Window, &amp; Key Features
					</label>
					<textarea
						id="message"
						name="message"
						rows="4"
						placeholder="Tell us about your SDK/platform, target launch date, and what you want developers to build or try..."
						class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						toolparamdescription="Sponsorship inquiry details or campaign goals"
					></textarea>
				</div>

				<button
					type="submit"
					id="submit-btn"
					class="mt-2 inline-flex items-center justify-center rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary transition-colors cursor-pointer"
				>
					Create Deal Room &amp; View Deposit Options &rarr;
				</button>
			</form>
		</section>
	</div>
</BaseLayout>

<script>
	const form = document.getElementById("sponsorship-form") as HTMLFormElement | null;
	const successEl = document.getElementById("form-feedback-success");
	const errorEl = document.getElementById("form-feedback-error");
	const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
	const tierSelect = document.getElementById("tier") as HTMLSelectElement | null;
	const kickoffInput = document.getElementById("kickoffSlotStartAt") as HTMLInputElement | null;
	const clearKickoffBtn = document.getElementById("clear-kickoff-slot") as HTMLButtonElement | null;
	const kickoffSlotBtns = document.querySelectorAll(".kickoff-slot-btn");

	kickoffSlotBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const startAt = btn.getAttribute("data-kickoff-start") || "";
			if (kickoffInput && kickoffInput.value === startAt) {
				kickoffInput.value = "";
				btn.classList.remove("border-primary", "bg-primary/5", "ring-1", "ring-primary");
				btn.classList.add("border-border", "bg-background");
				if (clearKickoffBtn) clearKickoffBtn.classList.add("hidden");
				return;
			}
			kickoffSlotBtns.forEach((b) => {
				b.classList.remove("border-primary", "bg-primary/5", "ring-1", "ring-primary");
				b.classList.add("border-border", "bg-background");
			});
			btn.classList.add("border-primary", "bg-primary/5", "ring-1", "ring-primary");
			btn.classList.remove("border-border", "bg-background");
			if (kickoffInput) kickoffInput.value = startAt;
			if (clearKickoffBtn) clearKickoffBtn.classList.remove("hidden");
		});
	});

	if (clearKickoffBtn) {
		clearKickoffBtn.addEventListener("click", () => {
			if (kickoffInput) kickoffInput.value = "";
			kickoffSlotBtns.forEach((b) => {
				b.classList.remove("border-primary", "bg-primary/5", "ring-1", "ring-primary");
				b.classList.add("border-border", "bg-background");
			});
			clearKickoffBtn.classList.add("hidden");
		});
	}

	document.querySelectorAll(".tier-select-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			const tierId = btn.getAttribute("data-tier-id");
			if (tierSelect && tierId) {
				tierSelect.value = tierId;
				tierSelect.scrollIntoView({ behavior: "smooth", block: "center" });
				tierSelect.focus();
			}
		});
	});

	if (form && submitBtn) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			if (errorEl) errorEl.classList.add("hidden");
			if (successEl) successEl.classList.add("hidden");

			const formData = new FormData(form);
			const payload = {
				name: formData.get("name"),
				email: formData.get("email"),
				company: formData.get("company"),
				website: formData.get("website"),
				tier: formData.get("tier"),
				message: formData.get("message"),
				kickoffSlotStartAt: formData.get("kickoffSlotStartAt") || undefined,
			};

			submitBtn.disabled = true;
			submitBtn.textContent = "Opening Deal Room...";

			try {
				const res = await fetch("/api/sponsorship", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				});

				const result = (await res.json()) as {
					success?: boolean;
					message?: string;
					portalUrl?: string;
					dealRoomUrl?: string;
				};

				if (res.ok && result.success) {
					form.reset();
					const targetUrl = result.portalUrl || result.dealRoomUrl;
					if (targetUrl) {
						if (successEl) {
							successEl.innerHTML = `<strong>Deal Room created!</strong> Opening your Deal Room portal... <br><a class="underline font-semibold" href="${targetUrl}">Click here if not redirected automatically &rarr;</a>`;
							successEl.classList.remove("hidden");
						}
						window.location.href = targetUrl;
					} else {
						if (successEl) successEl.classList.remove("hidden");
					}
				} else {
					if (errorEl) {
						errorEl.textContent = result.message || "Failed to submit inquiry. Please try again.";
						errorEl.classList.remove("hidden");
					}
				}
			} catch {
				if (errorEl) {
					errorEl.textContent = "A network error occurred. Please try again.";
					errorEl.classList.remove("hidden");
				}
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = "Create Deal Room & View Deposit Options →";
			}
		});
	}
</script>
