---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ExcalidrawDiagram from "@/components/ExcalidrawDiagram.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMultiCalendarAvailableSlots } from "@/lib/google-calendar";

const searchParams = Astro.url.searchParams;
const initialTrack =
	searchParams.get("track") === "sponsored"
		? "sponsored"
		: searchParams.get("track") === "full-stack-launch"
			? "full-stack-launch"
			: searchParams.get("track") === "sponsor-kickoff"
				? "sponsor-kickoff"
				: "editorial";
const initialCompany = searchParams.get("company") || "";
const initialName = searchParams.get("name") || "";
const initialEmail = searchParams.get("email") || "";
const initialPortalToken = searchParams.get("portalToken") || "";
const initialSlotParam = searchParams.get("slot") || "";
const initialStartDate = searchParams.get("startDate") || undefined;
const initialPreMeetingFor = searchParams.get("preMeetingFor") || "";

const [
	{ slots: upcomingSlots, liveVerified },
	{ slots: preMeetingSlots },
] = await Promise.all([
	getMultiCalendarAvailableSlots(
		9,
		initialTrack === "sponsor-kickoff" ? 15 : 45,
		initialStartDate,
	),
	getMultiCalendarAvailableSlots(6, 15, initialStartDate),
]);

const title = "Book a Podcast and Showcase Session | CodingCat.dev";
const description =
	"Schedule your guest appearance or fast-track sponsored showcase on the CodingCat.dev Podcast. Choose your track, complete intake questions, and sign your E-SIGN digital media release.";
---

<BaseLayout title={title} description={description}>
	<Breadcrumbs links={[{ title: "Book Session" }]} />

	<div class="w-full flex flex-col gap-8 md:gap-12 my-8 md:my-12 max-w-4xl mx-auto">
		<!-- Header -->
		<header class="flex flex-col gap-4">
			<div class="flex flex-col gap-2">
				<span class="w-fit rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200 hand-border shadow-sketch-sm">
					🎙️ CodingCat.dev Studio &amp; Google Calendar Sync
				</span>
				<h1 class="mt-2 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white md:text-6xl">
					podcast <span class="text-[#7C3AED] dark:text-[#C084FC]">recording session.</span>
				</h1>
				<p class="font-hand text-2xl font-bold text-[#4C1D95] dark:text-purple-200">
					Join Alex Patterson for an in-depth conversation exploring AI agents, web engineering, cloud infrastructure, and modern developer tooling.
				</p>
			</div>

			<!-- Session Metadata Pill Strip -->
			<div class="flex flex-wrap items-center gap-3 text-xs font-medium">
				<div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-border bg-card">
					<span class="text-muted-foreground">Host:</span>
					<span class="text-foreground font-semibold">Alex Patterson</span>
				</div>
				<div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-border bg-card">
					<span class="text-muted-foreground">Duration:</span>
					<span class="text-foreground font-semibold">45 Minutes</span>
				</div>
				<div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-border bg-card">
					<span class="text-muted-foreground">Recording Window:</span>
					<span class="text-primary font-semibold">8:00 AM &ndash; 5:00 PM PT / ET</span>
				</div>
				<div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-border bg-card">
					<span class="text-muted-foreground">Calendar Sync:</span>
					<span class="text-foreground font-semibold">Google Calendar Appointment Schedule</span>
				</div>
			</div>

			<ExcalidrawDiagram
				title="Podcast Studio Booking Flow"
				caption="Live Google Calendar FreeBusy check + E-SIGN release + automatic Google Calendar invite"
				compact={true}
				nodes={[
					{
						id: "track",
						badge: "Step 1",
						label: "Choose Track",
						sublabel: "Editorial or Fast-Track",
						color: "green",
					},
					{
						id: "slot",
						badge: "Step 2",
						label: "Pick Live Slot",
						sublabel: "Live Google Calendar sync",
						color: "blue",
					},
					{
						id: "studio",
						badge: "Step 3",
						label: "E-SIGN & Record!",
						sublabel: "Instant calendar invite",
						color: "orange",
					},
				]}
				edges={[
					{ from: "track", to: "slot", label: "check FreeBusy" },
					{ from: "slot", to: "studio", label: "auto-invite!" },
				]}
			/>
		</header>

		<!-- Interactive Booking & Release Form Container -->
		<div id="booking-container" class="flex flex-col gap-8">
			<!-- Step 0: Select Track (Editorial vs Sponsored Fast-Track) -->
			<section class="flex flex-col gap-4 p-6 rounded-2xl border border-border bg-card/60 backdrop-blur-xs">
				<div class="flex items-center justify-between">
					<h2 class="text-lg font-bold flex items-center gap-2">
						<span class="flex items-center justify-center size-6 rounded-full bg-primary text-primary-foreground text-xs font-bold">1</span>
						Choose Your Session Track
					</h2>
					<span class="text-xs text-muted-foreground">Editorial vs. Guaranteed Launch Showcase</span>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<button
						type="button"
						data-track="editorial"
						class={`track-btn p-4 rounded-xl border text-left transition-all cursor-pointer flex flex-col justify-between gap-3 ${
							initialTrack === "editorial"
								? "border-primary bg-primary/5 ring-1 ring-primary"
								: "border-border bg-card hover:bg-muted/50"
						}`}
					>
						<div class="flex flex-col gap-1">
							<div class="flex items-center justify-between">
								<span class="text-xs font-mono uppercase tracking-wider text-muted-foreground font-semibold">
									Editorial Track
								</span>
								<span class="text-sm font-bold text-foreground">Free</span>
							</div>
							<span class="text-base font-bold text-foreground">
								Standard Guest Application &amp; Invited Speakers
							</span>
							<p class="text-xs text-muted-foreground leading-relaxed">
								For invited engineering guests, open-source maintainers, and non-promotional architectural deep-dives.
							</p>
						</div>
						<span class="text-xs font-semibold text-primary">
							Includes Google Calendar booking &amp; E-SIGN release
						</span>
					</button>

					<button
						type="button"
						data-track="sponsored"
						class={`track-btn p-4 rounded-xl border text-left transition-all cursor-pointer flex flex-col justify-between gap-3 ${
							initialTrack !== "editorial"
								? "border-primary bg-primary/5 ring-1 ring-primary"
								: "border-border bg-card hover:bg-muted/50"
						}`}
					>
						<div class="flex flex-col gap-1">
							<div class="flex items-center justify-between">
								<span class="text-xs font-mono uppercase tracking-wider text-primary font-semibold">
									Fast-Track Showcase
								</span>
								<span class="text-sm font-bold text-primary">$2,000 ($1,000 Deposit)</span>
							</div>
							<span class="text-base font-bold text-foreground">
								Sponsored Podcast &amp; Multi-Channel Launch
							</span>
							<p class="text-xs text-muted-foreground leading-relaxed">
								Priority recording slot + 4 vertical Shorts across 7 platforms + 60s mid-roll + canonical blog &amp; Deal Room telemetry.
							</p>
						</div>
						<span class="text-xs font-semibold text-primary">
							50% deposit ($1,000) locks slot &middot; 50% on publish
						</span>
					</button>
				</div>
			</section>

			<!-- Step 1: Select Recording Slot -->
			<section class="flex flex-col gap-4 p-6 rounded-2xl border border-border bg-card/60 backdrop-blur-xs">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
					<h2 class="text-lg font-bold flex items-center gap-2 flex-wrap">
						<span class="flex items-center justify-center size-6 rounded-full bg-primary text-primary-foreground text-xs font-bold">2</span>
						Select Preferred Recording Window
						{liveVerified && (
							<span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-primary/10 text-primary">
								✓ Live Calendar FreeBusy Verified
							</span>
						)}
					</h2>
					<span id="slot-window-status" class="text-xs text-muted-foreground font-mono">
						Showing available slots (Pacific Time)
					</span>
				</div>

				<!-- Date & Week Range Controls (Schedule Further Out) -->
				<div class="flex flex-col md:flex-row md:items-center justify-between gap-3 p-3 rounded-xl border border-border bg-muted/30">
					<div class="flex flex-wrap items-center gap-1.5">
						<span class="text-xs font-semibold text-muted-foreground mr-1">Jump to:</span>
						<button
							type="button"
							data-jump-offset="0"
							class="date-jump-btn px-2.5 py-1 rounded-lg text-xs font-semibold border border-primary bg-primary/10 text-primary cursor-pointer transition-colors"
						>
							Next Available
						</button>
						<button
							type="button"
							data-jump-offset="7"
							class="date-jump-btn px-2.5 py-1 rounded-lg text-xs font-medium border border-border bg-background hover:border-primary text-foreground cursor-pointer transition-colors"
						>
							+1 Week
						</button>
						<button
							type="button"
							data-jump-offset="14"
							class="date-jump-btn px-2.5 py-1 rounded-lg text-xs font-medium border border-border bg-background hover:border-primary text-foreground cursor-pointer transition-colors"
						>
							+2 Weeks
						</button>
						<button
							type="button"
							data-jump-offset="30"
							class="date-jump-btn px-2.5 py-1 rounded-lg text-xs font-medium border border-border bg-background hover:border-primary text-foreground cursor-pointer transition-colors"
						>
							+1 Month
						</button>
						<button
							type="button"
							data-jump-date="2026-12-07"
							class="date-jump-btn px-2.5 py-1 rounded-lg text-xs font-medium border border-border bg-background hover:border-primary text-foreground cursor-pointer transition-colors"
						>
							Post-re:Invent (Dec 7+)
						</button>
					</div>

					<div class="flex items-center gap-2">
						<button
							type="button"
							id="btn-prev-week"
							class="px-2.5 py-1 rounded-lg text-xs font-semibold border border-border bg-background hover:bg-muted text-foreground cursor-pointer transition-colors disabled:opacity-40"
							title="Previous week"
						>
							&larr; Earlier
						</button>
						<input
							type="date"
							id="slot-date-picker"
							aria-label="Choose starting date for available recording slots"
							class="rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-mono text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						/>
						<button
							type="button"
							id="btn-next-week"
							class="px-2.5 py-1 rounded-lg text-xs font-semibold border border-border bg-background hover:bg-muted text-foreground cursor-pointer transition-colors"
							title="Next week"
						>
							Later &rarr;
						</button>
					</div>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3" id="slot-grid">
					{
						upcomingSlots.map((slot, index) => (
							<button
								type="button"
								data-slot-id={slot.id}
								data-slot-start={slot.startAt}
								class={`slot-btn p-3 rounded-xl border border-border text-left transition-all hover:border-primary cursor-pointer flex flex-col gap-1 ${index === 0 ? "border-primary bg-primary/5 ring-1 ring-primary" : "bg-card hover:bg-muted/50"}`}
							>
								<span class="font-semibold text-sm text-foreground">{slot.displayDate}</span>
								<span class="text-xs text-muted-foreground font-mono">{slot.displayTime}</span>
							</button>
						))
					}
				</div>

				<!-- Hybrid Pre-Meeting Toggle (15-min Google Meet) -->
				<div class="mt-2 rounded-xl border border-border bg-muted/30 p-4 flex flex-col gap-3">
					<label class="flex items-start gap-2.5 cursor-pointer">
						<input
							type="checkbox"
							id="chk-request-pre-meeting"
							class="mt-0.5 rounded border-border text-primary focus:ring-primary"
						/>
						<div class="flex flex-col gap-0.5">
							<span class="text-xs font-bold text-foreground">
								Also add a 15-minute Google Meet Pre-Meeting / Tech Check (Optional)
							</span>
							<span class="text-[11px] text-muted-foreground">
								Pre-meetings automatically generate a Google Meet room on your calendar invite. Your 45-minute recording session uses StreamYard (<code>https://streamyard.com/c4kv26is93</code>) once approved.
							</span>
						</div>
					</label>

					<div id="pre-meeting-slot-container" class="hidden flex-col gap-2 pt-2 border-t border-border/60">
						<span class="text-xs font-semibold text-foreground">
							Select 15-Minute Google Meet Pre-Call Slot:
						</span>
						<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5" id="pre-meeting-slot-grid">
							{
								preMeetingSlots.map((slot, index) => (
									<button
										type="button"
										data-pre-slot-start={slot.startAt}
										class={`pre-slot-btn p-2.5 rounded-lg border text-left transition-all cursor-pointer flex flex-col gap-0.5 ${
											index === 0
												? "border-primary bg-primary/10 ring-1 ring-primary"
												: "border-border bg-background hover:border-primary"
										}`}
									>
										<span class="font-semibold text-xs text-foreground">{slot.displayDate}</span>
										<span class="text-[11px] text-muted-foreground font-mono">{slot.displayTime}</span>
									</button>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<!-- Step 2: Guest Intake Information -->
			<section class="flex flex-col gap-4 p-6 rounded-2xl border border-border bg-card/60 backdrop-blur-xs">
				<h2 class="text-lg font-bold flex items-center gap-2">
					<span class="flex items-center justify-center size-6 rounded-full bg-primary text-primary-foreground text-xs font-bold">3</span>
					Guest Interview Intake
				</h2>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
					<div class="flex flex-col gap-1.5">
						<label for="guest-name" class="font-semibold text-foreground">
							Full Legal Name <span class="text-destructive">*</span>
						</label>
						<input
							type="text"
							id="guest-name"
							value={initialName}
							required
							placeholder="e.g. Jane Doe"
							class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						/>
					</div>

					<div class="flex flex-col gap-1.5">
						<label for="guest-email" class="font-semibold text-foreground">
							Email Address <span class="text-destructive">*</span>
						</label>
						<input
							type="email"
							id="guest-email"
							value={initialEmail}
							required
							placeholder="e.g. jane@example.com"
							class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						/>
					</div>

					<div class="flex flex-col gap-1.5 sm:col-span-2">
						<label for="guest-topics" class="font-semibold text-foreground">
							Proposed Topics &amp; Key Talking Points <span class="text-destructive">*</span>
						</label>
						<textarea
							id="guest-topics"
							rows="3"
							required
							placeholder="What technologies, architectural challenges, or live demos would you like to cover?"
							class="w-full rounded-lg border border-border bg-background p-3 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						></textarea>
					</div>

					<div class="flex flex-col gap-1.5">
						<label for="guest-url" class="font-semibold text-foreground">
							Social Handle or Product URL
						</label>
						<input
							type="url"
							id="guest-url"
							placeholder="https://x.com/yourhandle"
							class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						/>
					</div>

					<div class="flex flex-col gap-1.5">
						<label for="guest-project" class="font-semibold text-foreground">
							Current Flagship Project / Company
						</label>
						<input
							type="text"
							id="guest-project"
							value={initialCompany}
							placeholder="e.g. Open-source library, startup, or engineering team"
							class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						/>
					</div>
				</div>
			</section>

			<!-- Step 3: Mandatory E-Signature Media Release Form -->
			<section class="flex flex-col gap-4 p-6 rounded-2xl border border-border bg-card/60 backdrop-blur-xs">
				<div class="flex items-center justify-between">
					<h2 class="text-lg font-bold flex items-center gap-2">
						<span class="flex items-center justify-center size-6 rounded-full bg-primary text-primary-foreground text-xs font-bold">4</span>
						Digital Appearance &amp; Media Release Agreement
					</h2>
					<span class="text-xs font-mono bg-muted text-muted-foreground px-2 py-0.5 rounded">
						Terms v1.0 &middot; E-SIGN Valid
					</span>
				</div>

				<!-- Legal Terms Scrollbox -->
				<div class="rounded-lg border border-border bg-muted/40 p-3 max-h-32 overflow-y-auto text-xs font-mono text-muted-foreground leading-relaxed">
					CODINGCAT.DEV PODCAST APPEARANCE RELEASE AGREEMENT (v1.0)<br /><br />
					1. GRANT OF RIGHTS: The Participant grants CodingCat.dev the irrevocable, worldwide, perpetual right to record, edit, broadcast, stream, and commercially distribute their voice, video likeness, conversation, and biographical materials across any digital distribution channels.<br /><br />
					2. CLIPPING &amp; TRANSCRIPTS: The Producer retains sole discretion to create derivative works, short-form clips (YouTube Shorts, X, LinkedIn, Bluesky, Threads, Mastodon, TikTok, Reels), and word-by-word transcripts.<br /><br />
					3. COMMERCIAL &amp; SPONSORSHIP USE: Producer may monetize the show through sponsorships and dynamic ad insertion without financial compensation unless agreed separately.<br /><br />
					4. ELECTRONIC SIGNATURE VALIDITY: Executing this release electronically carries the full legal force of a handwritten physical signature pursuant to 15 U.S.C. &sect; 7001 (E-SIGN Act).
				</div>

				<!-- Consent Checkboxes -->
				<div class="flex flex-col gap-2 rounded-lg border border-border bg-muted/20 p-3 text-xs">
					<label class="flex items-start gap-2 cursor-pointer">
						<input type="checkbox" id="consent-recording" checked class="mt-0.5 rounded border-border text-primary focus:ring-primary" />
						<span class="text-foreground">I grant recording, streaming, and full distribution rights for this session.</span>
					</label>
					<label class="flex items-start gap-2 cursor-pointer">
						<input type="checkbox" id="consent-commercial" checked class="mt-0.5 rounded border-border text-primary focus:ring-primary" />
						<span class="text-foreground">I consent to commercial monetization, sponsorships, and podcast syndication.</span>
					</label>
					<label class="flex items-start gap-2 cursor-pointer">
						<input type="checkbox" id="consent-likeness" checked class="mt-0.5 rounded border-border text-primary focus:ring-primary" />
						<span class="text-foreground">I grant rights to use my likeness in show promotions and multi-platform social clips.</span>
					</label>
				</div>

				<!-- Signature Pad: Dual Mode Canvas / Typed -->
				<div class="flex flex-col gap-3">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Execute Digital Signature</span>
						<div class="flex rounded-md border border-border bg-muted p-0.5 text-xs">
							<button type="button" id="btn-mode-draw" class="rounded px-2.5 py-1 font-medium bg-background text-foreground shadow-xs">
								Draw Freehand
							</button>
							<button type="button" id="btn-mode-type" class="rounded px-2.5 py-1 font-medium text-muted-foreground hover:text-foreground">
								Type Name
							</button>
						</div>
					</div>

					<!-- Canvas Pad -->
					<div id="canvas-container" class="relative rounded-xl border-2 border-dashed border-border bg-background overflow-hidden h-36">
						<canvas id="signature-canvas" width="600" height="144" class="w-full h-full touch-none cursor-crosshair block"></canvas>
						<div id="canvas-hint" class="pointer-events-none absolute inset-0 flex items-center justify-center text-xs text-muted-foreground">
							Draw signature using finger, stylus, or mouse
						</div>
					</div>

					<!-- Typed Fallback -->
					<div id="typed-container" class="hidden flex-col gap-2">
						<input
							type="text"
							id="typed-input"
							placeholder="Type your full legal name to sign"
							class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
						/>
						<div class="rounded-lg border border-border bg-muted/40 p-4 text-center font-serif italic text-2xl tracking-wider text-foreground">
							<span id="typed-preview">Signature Preview</span>
						</div>
					</div>

					<div class="flex items-center justify-between text-xs">
						<span id="sig-status" class="text-muted-foreground">Awaiting signature...</span>
						<button type="button" id="btn-clear-sig" class="text-muted-foreground hover:text-foreground">
							Clear Signature
						</button>
					</div>
				</div>

				<!-- Validation Error Banner -->
				<div id="form-error" class="hidden rounded-lg border border-destructive/30 bg-destructive/10 p-3 text-xs text-destructive">
				</div>

				<!-- Submit Button -->
				<div class="pt-2 flex justify-end">
					<button
						type="button"
						id="btn-confirm-booking"
						class="w-full sm:w-auto px-8 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:bg-primary/90 transition-all shadow-md cursor-pointer flex items-center justify-center gap-2"
					>
						<span>Confirm Session &amp; Sign Release</span>
					</button>
				</div>
			</section>
		</div>

		<!-- Step 4: Success View (Initially Hidden) -->
		<div id="booking-confirmed-card" class="hidden flex-col gap-6 p-8 rounded-2xl border border-primary/30 bg-card text-center shadow-lg">
			<div class="mx-auto flex size-16 items-center justify-center rounded-full bg-primary/10 text-primary">
				<svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
				</svg>
			</div>

			<div class="flex flex-col gap-2">
				<h2 id="confirmed-heading" class="text-2xl font-bold tracking-tight text-foreground">
					Session Booked &amp; E-SIGN Release Recorded!
				</h2>
				<p id="confirmed-summary" class="text-sm text-muted-foreground max-w-lg mx-auto">
					Your E-SIGN appearance release with <strong class="text-foreground">Alex Patterson</strong> has been saved to Sanity and synced with Google Calendar.
				</p>
			</div>

			<!-- Google Calendar Event / Invite Box -->
			<div class="flex flex-col gap-3 p-5 rounded-xl border border-border bg-muted/50 text-left max-w-lg mx-auto w-full">
				<span id="confirmed-calendar-badge" class="text-xs font-semibold uppercase tracking-wider text-primary">
					Google Calendar Sync
				</span>
				<p id="confirmed-slot-display" class="text-sm font-bold text-foreground"></p>
				<a
					id="confirmed-calendar-link"
					href="/book"
					target="_blank"
					rel="noopener noreferrer"
					class="px-5 py-3 rounded-xl bg-primary text-primary-foreground text-sm font-semibold text-center hover:bg-primary/90 transition-colors"
				>
					Add / View Session in Google Calendar &nearr;
				</a>
				<a
					id="confirmed-portal-link"
					href="/sponsorships"
					class="hidden px-5 py-3 rounded-xl border border-primary bg-primary/10 text-primary text-sm font-semibold text-center hover:bg-primary/20 transition-colors"
				>
					Open Deal Room &amp; Private Sanity Asset Vault &rarr;
				</a>
				<p id="confirmed-calendar-note" class="text-[11px] text-muted-foreground">
					An opaque calendar hold and E-SIGN receipt have been created for your selected window. Once approved, your StreamYard recording studio link (https://streamyard.com/c4kv26is93) is sent automatically.
				</p>
			</div>

			<div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
				<a
					href="/"
					class="px-5 py-2.5 rounded-lg border border-border text-xs font-semibold hover:bg-muted transition-colors"
				>
					Return to CodingCat.dev Home
				</a>
				<a
					href="/podcasts"
					class="px-5 py-2.5 rounded-lg bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 transition-colors"
				>
					Explore Recent Episodes
				</a>
			</div>
		</div>

		<!-- Footer -->
		<footer class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-border">
			<div class="flex flex-col gap-1 text-center sm:text-left">
				<span class="text-xs font-semibold text-foreground">CodingCat.dev Studio</span>
				<span class="text-xs text-muted-foreground">Powered by CodingCat.dev &amp; Sanity Content Operating System</span>
			</div>
		</footer>
	</div>
</BaseLayout>

<script is:inline define:vars={{ initialTrack, initialPortalToken, initialSlotParam, initialPreMeetingFor }}>
	(function () {
		let selectedTrack = initialTrack || "editorial";
		let selectedSlotStart = initialSlotParam || "";
		let selectedPreMeetingSlotStart = "";
		let signatureMode = "draw";
		let hasDrawn = false;
		let isDrawing = false;

		const chkPreMeeting = document.getElementById("chk-request-pre-meeting");
		const preMeetingContainer = document.getElementById("pre-meeting-slot-container");
		const preSlotButtons = document.querySelectorAll(".pre-slot-btn");
		if (preSlotButtons.length > 0) {
			selectedPreMeetingSlotStart = preSlotButtons[0].getAttribute("data-pre-slot-start") || "";
		}
		preSlotButtons.forEach((btn) => {
			btn.addEventListener("click", () => {
				preSlotButtons.forEach((b) => {
					b.classList.remove("border-primary", "bg-primary/10", "ring-1", "ring-primary");
					b.classList.add("border-border", "bg-background");
				});
				btn.classList.add("border-primary", "bg-primary/10", "ring-1", "ring-primary");
				btn.classList.remove("border-border", "bg-background");
				selectedPreMeetingSlotStart = btn.getAttribute("data-pre-slot-start") || "";
			});
		});
		if (chkPreMeeting && preMeetingContainer) {
			chkPreMeeting.addEventListener("change", () => {
				if (chkPreMeeting.checked) {
					preMeetingContainer.classList.remove("hidden");
					preMeetingContainer.classList.add("flex");
				} else {
					preMeetingContainer.classList.add("hidden");
					preMeetingContainer.classList.remove("flex");
				}
			});
		}

		// Track selection
		const trackButtons = document.querySelectorAll(".track-btn");
		trackButtons.forEach((btn) => {
			btn.addEventListener("click", () => {
				trackButtons.forEach((b) => {
					b.classList.remove("border-primary", "bg-primary/5", "ring-1", "ring-primary");
					b.classList.add("border-border", "bg-card");
				});
				btn.classList.add("border-primary", "bg-primary/5", "ring-1", "ring-primary");
				btn.classList.remove("border-border", "bg-card");
				selectedTrack = btn.getAttribute("data-track") || "editorial";
			});
		});

		// Slot selection & dynamic date-range fetching
		const slotGrid = document.getElementById("slot-grid");
		const datePicker = document.getElementById("slot-date-picker");
		const btnPrevWeek = document.getElementById("btn-prev-week");
		const btnNextWeek = document.getElementById("btn-next-week");
		const jumpButtons = document.querySelectorAll(".date-jump-btn");
		const slotWindowStatus = document.getElementById("slot-window-status");

		function toYmd(d) {
			return d.toISOString().slice(0, 10);
		}

		const minDateObj = new Date(Date.now() + 24 * 60 * 60 * 1000);
		const maxDateObj = new Date(Date.now() + 180 * 24 * 60 * 60 * 1000);
		let currentStartDate = toYmd(minDateObj);

		if (datePicker && datePicker instanceof HTMLInputElement) {
			datePicker.min = toYmd(minDateObj);
			datePicker.max = toYmd(maxDateObj);
			datePicker.value = currentStartDate;
		}

		function bindSlotButtons() {
			const slotButtons = document.querySelectorAll(".slot-btn");
			if (slotButtons.length > 0 && !selectedSlotStart) {
				selectedSlotStart = slotButtons[0].getAttribute("data-slot-start") || "";
			}
			slotButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					slotButtons.forEach((b) => {
						b.classList.remove("border-primary", "bg-primary/5", "ring-1", "ring-primary");
						b.classList.add("bg-card");
					});
					btn.classList.add("border-primary", "bg-primary/5", "ring-1", "ring-primary");
					btn.classList.remove("bg-card");
					selectedSlotStart = btn.getAttribute("data-slot-start") || "";
				});
			});
		}

		bindSlotButtons();

		async function loadSlotsForDate(startDateYmd) {
			if (!slotGrid) return;
			currentStartDate = startDateYmd;
			if (datePicker && datePicker instanceof HTMLInputElement) {
				datePicker.value = startDateYmd;
			}
			if (slotWindowStatus) {
				slotWindowStatus.textContent = `Checking availability from ${startDateYmd}...`;
			}
			slotGrid.classList.add("opacity-60", "pointer-events-none");

			try {
				const res = await fetch(
					`/api/calendar/freebusy?startDate=${encodeURIComponent(startDateYmd)}&limit=9`,
				);
				const data = await res.json();
				const slots = Array.isArray(data.slots) ? data.slots : [];

				if (slots.length === 0) {
					slotGrid.innerHTML =
						'<div class="col-span-full p-4 rounded-xl border border-border bg-card text-xs text-muted-foreground text-center">No open windows found in that week. Try clicking <strong>Later &rarr;</strong> or picking another date.</div>';
				} else {
					selectedSlotStart = slots[0].startAt || "";
					slotGrid.innerHTML = slots
						.map(
							(slot, idx) => `
							<button
								type="button"
								data-slot-id="${slot.id}"
								data-slot-start="${slot.startAt}"
								class="slot-btn p-3 rounded-xl border text-left transition-all hover:border-primary cursor-pointer flex flex-col gap-1 ${
									idx === 0
										? "border-primary bg-primary/5 ring-1 ring-primary"
										: "border-border bg-card hover:bg-muted/50"
								}"
							>
								<span class="font-semibold text-sm text-foreground">${slot.displayDate}</span>
								<span class="text-xs text-muted-foreground font-mono">${slot.displayTime}</span>
							</button>
						`,
						)
						.join("");
					bindSlotButtons();
				}

				if (slotWindowStatus) {
					slotWindowStatus.textContent = `Showing available slots from ${startDateYmd} (Pacific Time)`;
				}
			} catch {
				if (slotWindowStatus) {
					slotWindowStatus.textContent = "Could not refresh calendar slots. Try again.";
				}
			} finally {
				slotGrid.classList.remove("opacity-60", "pointer-events-none");
			}
		}

		jumpButtons.forEach((btn) => {
			btn.addEventListener("click", () => {
				jumpButtons.forEach((b) => {
					b.classList.remove("border-primary", "bg-primary/10", "text-primary", "font-semibold");
					b.classList.add("border-border", "bg-background", "text-foreground", "font-medium");
				});
				btn.classList.add("border-primary", "bg-primary/10", "text-primary", "font-semibold");
				btn.classList.remove("border-border", "bg-background", "text-foreground", "font-medium");

				const explicitDate = btn.getAttribute("data-jump-date");
				if (explicitDate) {
					loadSlotsForDate(explicitDate);
					return;
				}
				const offsetDays = Number(btn.getAttribute("data-jump-offset") || "0");
				const target = new Date(minDateObj.getTime() + offsetDays * 24 * 60 * 60 * 1000);
				loadSlotsForDate(toYmd(target));
			});
		});

		if (datePicker && datePicker instanceof HTMLInputElement) {
			datePicker.addEventListener("change", () => {
				if (datePicker.value) {
					loadSlotsForDate(datePicker.value);
				}
			});
		}

		if (btnPrevWeek) {
			btnPrevWeek.addEventListener("click", () => {
				const cur = new Date(`${currentStartDate}T12:00:00Z`);
				const prev = new Date(
					Math.max(minDateObj.getTime(), cur.getTime() - 7 * 24 * 60 * 60 * 1000),
				);
				loadSlotsForDate(toYmd(prev));
			});
		}

		if (btnNextWeek) {
			btnNextWeek.addEventListener("click", () => {
				const cur = new Date(`${currentStartDate}T12:00:00Z`);
				const next = new Date(
					Math.min(maxDateObj.getTime(), cur.getTime() + 7 * 24 * 60 * 60 * 1000),
				);
				loadSlotsForDate(toYmd(next));
			});
		}

		// Mode Toggling (Draw vs Type)
		const btnDraw = document.getElementById("btn-mode-draw");
		const btnType = document.getElementById("btn-mode-type");
		const canvasContainer = document.getElementById("canvas-container");
		const typedContainer = document.getElementById("typed-container");
		const typedInput = document.getElementById("typed-input");
		const typedPreview = document.getElementById("typed-preview");
		const guestNameInput = document.getElementById("guest-name");

		if (btnDraw && btnType && canvasContainer && typedContainer) {
			btnDraw.addEventListener("click", () => {
				signatureMode = "draw";
				btnDraw.classList.add("bg-background", "text-foreground", "shadow-xs");
				btnDraw.classList.remove("text-muted-foreground");
				btnType.classList.remove("bg-background", "text-foreground", "shadow-xs");
				btnType.classList.add("text-muted-foreground");
				canvasContainer.classList.remove("hidden");
				typedContainer.classList.add("hidden");
				typedContainer.classList.remove("flex");
			});

			btnType.addEventListener("click", () => {
				signatureMode = "type";
				btnType.classList.add("bg-background", "text-foreground", "shadow-xs");
				btnType.classList.remove("text-muted-foreground");
				btnDraw.classList.remove("bg-background", "text-foreground", "shadow-xs");
				btnDraw.classList.add("text-muted-foreground");
				canvasContainer.classList.add("hidden");
				typedContainer.classList.remove("hidden");
				typedContainer.classList.add("flex");

				if (typedInput && !typedInput.value && guestNameInput && guestNameInput.value) {
					typedInput.value = guestNameInput.value;
					if (typedPreview) typedPreview.textContent = guestNameInput.value;
				}
			});
		}

		if (typedInput && typedPreview) {
			typedInput.addEventListener("input", (e) => {
				const val = e.target.value.trim();
				typedPreview.textContent = val || "Signature Preview";
			});
		}

		// HTML5 Canvas Drawing Logic
		const canvas = document.getElementById("signature-canvas");
		const hint = document.getElementById("canvas-hint");
		const statusText = document.getElementById("sig-status");
		const btnClear = document.getElementById("btn-clear-sig");

		if (canvas && canvas instanceof HTMLCanvasElement) {
			const ctx = canvas.getContext("2d");

			const getPos = (e) => {
				const rect = canvas.getBoundingClientRect();
				const scaleX = canvas.width / rect.width;
				const scaleY = canvas.height / rect.height;
				return {
					x: (e.clientX - rect.left) * scaleX,
					y: (e.clientY - rect.top) * scaleY,
				};
			};

			canvas.addEventListener("pointerdown", (e) => {
				if (!ctx) return;
				isDrawing = true;
				const pos = getPos(e);
				ctx.beginPath();
				ctx.moveTo(pos.x, pos.y);
				ctx.lineWidth = 3;
				ctx.lineCap = "round";
				ctx.lineJoin = "round";
				ctx.strokeStyle = "#2563eb";
				if (hint) hint.classList.add("hidden");
			});

			canvas.addEventListener("pointermove", (e) => {
				if (!isDrawing || !ctx) return;
				const pos = getPos(e);
				ctx.lineTo(pos.x, pos.y);
				ctx.stroke();
				hasDrawn = true;
				if (statusText) statusText.textContent = "Signature recorded";
			});

			const stop = () => {
				isDrawing = false;
			};

			canvas.addEventListener("pointerup", stop);
			canvas.addEventListener("pointerleave", stop);

			if (btnClear) {
				btnClear.addEventListener("click", () => {
					if (!ctx) return;
					ctx.clearRect(0, 0, canvas.width, canvas.height);
					hasDrawn = false;
					if (hint) hint.classList.remove("hidden");
					if (statusText) statusText.textContent = "Awaiting signature...";
				});
			}
		}

		// Submission Logic
		const btnConfirm = document.getElementById("btn-confirm-booking");
		const formError = document.getElementById("form-error");
		const bookingContainer = document.getElementById("booking-container");
		const confirmedCard = document.getElementById("booking-confirmed-card");
		const confirmedCalLink = document.getElementById("confirmed-calendar-link");

		if (btnConfirm) {
			btnConfirm.addEventListener("click", async () => {
				if (formError) formError.classList.add("hidden");

				const name = guestNameInput ? guestNameInput.value.trim() : "";
				const emailInput = document.getElementById("guest-email");
				const email = emailInput ? emailInput.value.trim() : "";
				const topicsInput = document.getElementById("guest-topics");
				const topics = topicsInput ? topicsInput.value.trim() : "";
				const urlInput = document.getElementById("guest-url");
				const socialUrl = urlInput ? urlInput.value.trim() : "";
				const projectInput = document.getElementById("guest-project");
				const company = projectInput ? projectInput.value.trim() : "";

				const chkRecording = document.getElementById("consent-recording");
				const chkCommercial = document.getElementById("consent-commercial");
				const chkLikeness = document.getElementById("consent-likeness");

				if (!name) {
					showError("Please enter your full legal name.");
					return;
				}
				if (!email || !email.includes("@")) {
					showError("Please enter a valid email address.");
					return;
				}
				if (!topics) {
					showError("Please provide key talking points for the interview.");
					return;
				}
				if (
					(chkRecording && !chkRecording.checked) ||
					(chkCommercial && !chkCommercial.checked) ||
					(chkLikeness && !chkLikeness.checked)
				) {
					showError("You must agree to all appearance release checkboxes to proceed.");
					return;
				}

				let signatureData = name;
				if (signatureMode === "draw") {
					if (!hasDrawn) {
						showError("Please provide your freehand signature on the canvas pad.");
						return;
					}
					if (canvas && canvas instanceof HTMLCanvasElement) {
						signatureData = canvas.toDataURL("image/png");
					}
				} else {
					const typedVal = typedInput ? typedInput.value.trim() : "";
					if (!typedVal) {
						showError("Please type your name to sign the release.");
						return;
					}
					signatureData = typedVal;
				}

				btnConfirm.setAttribute("disabled", "true");
				btnConfirm.textContent = "Saving E-SIGN Release & Booking...";

				try {
					const wantsPreMeeting = Boolean(chkPreMeeting && chkPreMeeting.checked);
					const res = await fetch("/api/booking", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							portalToken: initialPortalToken || undefined,
							preMeetingForBookingId: initialPreMeetingFor || undefined,
							guestName: name,
							guestEmail: email,
							company,
							socialUrl,
							track: selectedTrack,
							slotStartAt: selectedSlotStart,
							requestPreMeeting: wantsPreMeeting,
							preMeetingSlotStartAt: wantsPreMeeting ? selectedPreMeetingSlotStart : undefined,
							topics,
							signatureMode,
							signatureData,
							consentRecording: chkRecording ? chkRecording.checked : true,
							consentCommercial: chkCommercial ? chkCommercial.checked : true,
							consentLikeness: chkLikeness ? chkLikeness.checked : true,
						}),
					});

					const data = await res.json();
					if (res.ok && data.success) {
						const confirmedHeading = document.getElementById("confirmed-heading");
						const confirmedSummary = document.getElementById("confirmed-summary");
						const confirmedSlotDisplay = document.getElementById("confirmed-slot-display");
						const confirmedBadge = document.getElementById("confirmed-calendar-badge");
						const confirmedNote = document.getElementById("confirmed-calendar-note");
						const confirmedPortalLink = document.getElementById("confirmed-portal-link");

						if (confirmedSlotDisplay && selectedSlotStart) {
							try {
								confirmedSlotDisplay.textContent = `Scheduled Window: ${new Date(selectedSlotStart).toLocaleString("en-US", { dateStyle: "full", timeStyle: "short" })}`;
							} catch {
								confirmedSlotDisplay.textContent = `Scheduled Window: ${selectedSlotStart}`;
							}
						}

						if (data.calendarInviteSent) {
							if (confirmedHeading) {
								confirmedHeading.textContent = "Google Calendar Invite Sent & E-SIGN Release Recorded!";
							}
							if (confirmedBadge) {
								confirmedBadge.textContent = "✓ Confirmed Google Calendar Invite Sent";
							}
							if (confirmedNote) {
								confirmedNote.textContent = `A confirmed Google Calendar invitation has been sent to ${email} and placed on Alex Patterson's studio calendar.`;
							}
						} else if (data.calendarEventStatus === "tentative") {
							if (confirmedHeading) {
								confirmedHeading.textContent = "Editorial Hold Created & E-SIGN Release Recorded!";
							}
							if (confirmedBadge) {
								confirmedBadge.textContent = "✓ Tentative Studio Calendar Hold Created";
							}
							if (confirmedNote) {
								confirmedNote.textContent = "Your requested time is held on Alex Patterson's studio calendar pending editorial review. Use the button above to add a hold to your own Google Calendar.";
							}
						}

						if (confirmedSummary && data.message) {
							confirmedSummary.textContent = data.message;
						}

						const calHref = data.calendarEventUrl || data.addToCalendarUrl || data.appointmentScheduleUrl;
						if (confirmedCalLink && calHref) {
							confirmedCalLink.setAttribute("href", calHref);
						}

						if (data.portalUrl && confirmedPortalLink) {
							confirmedPortalLink.setAttribute("href", `${data.portalUrl}#vault`);
							confirmedPortalLink.classList.remove("hidden");
						}

						if (bookingContainer) bookingContainer.classList.add("hidden");
						if (confirmedCard) {
							confirmedCard.classList.remove("hidden");
							confirmedCard.classList.add("flex");
						}
						window.scrollTo({ top: 0, behavior: "smooth" });
					} else {
						showError(data.message || "Failed to save booking session. Please try again.");
						btnConfirm.removeAttribute("disabled");
						btnConfirm.textContent = "Confirm Session & Sign Release";
					}
				} catch {
					showError("Failed to reserve booking session. Please try again.");
					btnConfirm.removeAttribute("disabled");
					btnConfirm.textContent = "Confirm Session & Sign Release";
				}
			});
		}

		function showError(msg) {
			if (!formError) return;
			formError.textContent = msg;
			formError.classList.remove("hidden");
			formError.scrollIntoView({ behavior: "smooth", block: "center" });
		}
	})();
</script>
