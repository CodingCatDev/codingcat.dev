---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Contact Us | CodingCat.dev";
const description =
	"Get in touch with CodingCat.dev for sponsorships, podcast guest inquiries, speaking, or developer partnerships.";
---

<BaseLayout title={title} description={description} canonical="/contact">
	<Breadcrumbs links={[{ title: "Contact" }]} />

	<section class="mx-auto max-w-3xl py-6 md:py-10">
		<div class="duo-card hand-border p-8 md:p-12">
			<header class="mb-8">
				<span class="inline-flex items-center gap-2 rounded-full border-2 border-[#2A1155] bg-[#EDE9FE] px-4 py-1 font-mono text-xs font-extrabold uppercase tracking-wider text-[#7C3AED] dark:border-purple-400/40 dark:bg-purple-950/60 dark:text-purple-200">
					📬 Say Hello
				</span>
				<h1 class="mt-3 font-display text-4xl font-black tracking-tight text-[#2A1155] dark:text-white sm:text-5xl">
					contact <span class="text-[#7C3AED] dark:text-[#C084FC]">codingcat.dev</span>
				</h1>
				<p class="font-hand mt-2 text-2xl font-bold text-[#7C3AED] dark:text-[#C084FC]">
					Questions, podcast guest ideas, or partnership inquiries? Reach out anytime.
				</p>
			</header>

			<div class="grid gap-6 sm:grid-cols-2">
				<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] shadow-sketch-sm">
					<h2 class="font-display text-xl font-black text-[#2A1155] dark:text-white">
						✉️ Direct Email
					</h2>
					<p class="mt-2 text-sm font-medium text-[#2A1155]/75 dark:text-slate-300">
						For editorial questions or general inquiries, email Alex directly:
					</p>
					<a
						href="mailto:alex@codingcat.dev"
						class="mt-4 inline-flex font-mono text-sm font-extrabold text-[#7C3AED] hover:underline dark:text-[#C084FC]"
					>
						alex@codingcat.dev &rarr;
					</a>
				</div>

				<div class="rounded-2xl border-2 border-[#2A1155] bg-[#FAF9FC] p-5 dark:border-white/20 dark:bg-[#0B1326] shadow-sketch-sm">
					<h2 class="font-display text-xl font-black text-[#2A1155] dark:text-white">
						🎙️ Podcast Guest Booking
					</h2>
					<p class="mt-2 text-sm font-medium text-[#2A1155]/75 dark:text-slate-300">
						Building an exciting developer tool or open-source project? Book a live studio session:
					</p>
					<a
						href="/book"
						class="mt-4 inline-flex font-mono text-sm font-extrabold text-[#7C3AED] hover:underline dark:text-[#C084FC]"
					>
						Book a Podcast Session &rarr;
					</a>
				</div>
			</div>

			<div class="mt-6 rounded-2xl border-2 border-[#2A1155] bg-[#EDE9FE] p-6 dark:border-purple-400/30 dark:bg-purple-950/50 shadow-sketch-sm">
				<h2 class="font-display text-2xl font-black text-[#2A1155] dark:text-white">
					🚀 Sponsorships &amp; Multi-Channel Launches
				</h2>
				<p class="mt-2 text-sm font-medium text-[#2A1155]/80 dark:text-purple-200/90">
					Put your SDK, AI platform, or cloud infrastructure in front of 61K+ engineers across YouTube, 7 short-form video networks, and canonical AEO blog posts.
				</p>
				<div class="mt-4">
					<a href="/sponsorships" class="tactile-btn inline-flex px-6 py-2.5 text-xs">
						<span>View Sponsorship Packages &amp; Deal Room</span>
						<span class="text-[#86EFAC]">&rarr;</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
