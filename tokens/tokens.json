        "$description": "Chunky rounded display font for H1 and H2 headlines"
      },
      "sans": {
        "$value": ["Plus Jakarta Sans", "Inter", "system-ui", "sans-serif"],
        "$type": "fontFamily",
        "$description": "UI Sans & long-form prose font"
      },
      "mono": {
        "$value": ["JetBrains Mono", "monospace"],
        "$type": "fontFamily",
        "$description": "Code blocks, terminal snippets, badge tags, and metadata"
      },
      "hand": {
        "$value": ["Virgil", "Caveat", "Architects Daughter", "cursive", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Excalidraw hand-drawn diagram annotations, sticky notes, and explanations"
      }
    }
  },
  "radius": {
    "handBorder": {
      "$value": "255px 15px 225px 15px / 15px 225px 15px 255px",
      "$type": "dimension",
      "$description": "Organic hand-drawn border radius (.hand-border)"
    },
    "handBorderRect": {
      "$value": "20px 8px 18px 10px",
      "$type": "dimension",
      "$description": "Organic rectangular card border radius (.hand-border-rect)"
    },
    "xl": { "$value": "12px", "$type": "dimension" },
    "2xl": { "$value": "16px", "$type": "dimension" },
    "3xl": { "$value": "24px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
