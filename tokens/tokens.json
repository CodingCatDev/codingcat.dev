    },
    "sketchLightSm": {
      "$value": "2px 2px 0px 0px #2A1155",
      "$type": "shadow"
    },
    "sketchLightLg": {
      "$value": "6px 7px 0px 0px #2A1155",
      "$type": "shadow"
    },
    "sketchDark": {
      "$value": "3px 4px 0px 0px rgba(0, 0, 0, 0.75)",
